# Install as /etc/steamy-relay/relay.env, owned by root, mode 0600.
# Never place real values in this example or the client.
RYUU_API_KEY=
DEPOTBOX_API_KEY=
DAILY_UPSTREAM_LIMIT=100
CACHE_DIR=/var/cache/steamy-relay
# Total daily payload delivery, including cache hits: 2 GiB by default.
DAILY_TRANSFER_BYTES=2147483648
