<UserControl x:Class="Steamy.Views.TransparencyNotice" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:Steamy.Controls">
  <UserControl.Resources>
    <Style x:Key="NoticeCard" TargetType="Border"><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="NoticeHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
    <Style x:Key="NoticeBody" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="20"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
  </UserControl.Resources>
  <Border x:Name="NoticeFrame" MaxWidth="780" MaxHeight="680" Margin="12" Padding="20" CornerRadius="28" Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" controls:SurfaceMotion.RevealOnShow="True">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="NoticeHeader" Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Image Source="{StaticResource SteamyBrandImage}" Width="52" Height="52" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        <StackPanel Grid.Column="1"><TextBlock Text="WELCOME TO STEAMY" FontSize="10" FontWeight="Bold" Foreground="#73CDBC" Margin="0,0,0,6"/><TextBlock x:Name="NoticeTitle" Text="Your library. Your choices." TextWrapping="Wrap" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock x:Name="NoticeSubtitle" Text="A quick look at your data and optional tools before you begin." Style="{StaticResource NoticeBody}" Margin="0,7,0,0"/></StackPanel>
      </Grid>
      <ScrollViewer x:Name="NoticeScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="NoticeScroll_Changed" MinHeight="0">
        <StackPanel Margin="0,0,14,0">
          <Border Style="{StaticResource NoticeCard}"><StackPanel><TextBlock Text="Your data stays with you" Style="{StaticResource NoticeHeading}"/><TextBlock Text="Preferences, encrypted keys, library, playtime and caches use your Steamy data folder: Roaming by default. Change it in Settings → Transparency. Installed games keep their own folders." Style="{StaticResource NoticeBody}"/></StackPanel></Border>
          <Border Style="{StaticResource NoticeCard}"><StackPanel><TextBlock Text="Understand a detection" Style="{StaticResource NoticeHeading}"/><TextBlock Text="A false positive is a mistaken detection. A warning can also indicate a real threat or an unwanted app. A familiar name or a working game does not prove a file is safe." Style="{StaticResource NoticeBody}"/></StackPanel></Border>
          <Border Style="{StaticResource NoticeCard}"><StackPanel><TextBlock Text="Optional tools can change files" Style="{StaticResource NoticeHeading}"/><TextBlock Text="Some tools patch executables, replace DLLs or inject code. Review the exact detection and original source. SmartScreen reputation warnings differ from malware verdicts. Backups depend on the selected operation; clearing a cache does not restore a modified game." Style="{StaticResource NoticeBody}"/></StackPanel></Border>
          <Border Style="{StaticResource NoticeCard}"><StackPanel><TextBlock Text="Know what runs in the background" Style="{StaticResource NoticeHeading}"/><TextBlock Text="Enabled playtime tracking can continue after closing Steamy; disable it in Settings. Game information and images load from Steam. Account sync and download providers receive the information needed for the selected service." Style="{StaticResource NoticeBody}"/></StackPanel></Border>
          <Border Style="{StaticResource NoticeCard}"><StackPanel><TextBlock Text="Inspect first, choose for yourself" Style="{StaticResource NoticeHeading}"/><TextBlock Text="Transparency shows file locations and can calculate a local SHA-256 hash without running or uploading a file. A hash identifies bytes, not safety. Browsing never installs a fix; you choose tools and targets. This notice appears again for a new version or explanation." Style="{StaticResource NoticeBody}"/></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
      <StackPanel x:Name="NoticeFooter" Grid.Row="2" Margin="0,20,0,0"><TextBlock x:Name="ReadHint" Text="Scroll through to enable confirmation." Style="{StaticResource CaptionStyle}" Margin="0,0,0,9"/><CheckBox x:Name="Acknowledge" IsEnabled="False" Checked="AcknowledgementChanged" Unchecked="AcknowledgementChanged"><TextBlock Text="I’ve read this and understand that detected files need review." TextWrapping="Wrap"/></CheckBox><WrapPanel x:Name="NoticeFooterButtons" HorizontalAlignment="Right" Margin="0,18,0,0"><ui:Button Content="Close Steamy" Click="Close_Click" Appearance="Transparent" Margin="0,0,12,0"/><ui:Button x:Name="ContinueButton" Content="Continue" Appearance="Primary" IsEnabled="False" Click="Continue_Click"/></WrapPanel></StackPanel>
    </Grid>
  </Border>
</UserControl>
