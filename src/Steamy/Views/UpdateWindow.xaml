<Window x:Class="Steamy.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Steamy.Controls"
        Title="Steamy update"
        Width="620" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Border Margin="20" CornerRadius="16" Padding="26,24,26,20"
          Background="{DynamicResource SurfaceElevatedBrush}"
          BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
          MouseLeftButtonDown="Card_MouseLeftButtonDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="Black" />
    </Border.Effect>
    <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
    <Border.Triggers>
      <EventTrigger RoutedEvent="FrameworkElement.Loaded">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.3">
              <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Border.Triggers>

    <StackPanel>
      <!-- Header -->
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
          <ui:SymbolIcon x:Name="HeaderIcon" Symbol="ArrowSync24" FontSize="24"
                         Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,2,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
          <TextBlock x:Name="SubtitleText" FontSize="12.5" Margin="0,3,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                     Typography.NumeralAlignment="Tabular" />
        </StackPanel>
      </Grid>

      <!-- What's new -->
      <TextBlock Text="WHAT'S NEW" FontSize="10.5" FontWeight="SemiBold" Margin="0,22,0,8"
                 Foreground="{DynamicResource TextTertiaryBrush}" />
      <Border CornerRadius="12" Background="{DynamicResource AppBackgroundBrush}" Padding="16,12">
        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="NotesPanel" Margin="0,0,14,0" />
        </ScrollViewer>
      </Border>

      <TextBlock x:Name="DownloadsWarning" Visibility="Collapsed" FontSize="12" Margin="0,12,0,0"
                 Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />

      <!-- Progress while updating -->
      <StackPanel x:Name="ProgressArea" Visibility="Collapsed" Margin="0,18,0,0">
        <controls:SmoothProgressBar x:Name="Bar" Maximum="100" Height="6" />
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                     Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="PercentText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0"
                     Foreground="{DynamicResource TextPrimaryBrush}" Typography.NumeralAlignment="Tabular" />
        </Grid>
      </StackPanel>

      <TextBlock x:Name="ErrorText" Visibility="Collapsed" FontSize="12" Margin="0,14,0,0"
                 Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />

      <!-- Actions -->
      <Grid Margin="0,22,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <ui:Button x:Name="ReleasePageButton" Content="Release page" Icon="{ui:SymbolIcon Open16}"
                     Appearance="Transparent" Click="ReleasePage_Click" FontSize="12.5" Padding="8,5" />
          <ui:Button x:Name="SkipButton" Content="Skip this version" Appearance="Transparent" Click="Skip_Click"
                     FontSize="12.5" Padding="8,5" Margin="2,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <ui:Button x:Name="LaterButton" Content="Later" Appearance="Secondary" Click="Later_Click" MinWidth="90" />
          <ui:Button x:Name="PrimaryButton" Content="Update now" Icon="{ui:SymbolIcon ArrowDownload20}"
                     Appearance="Primary" Click="Primary_Click" Margin="8,0,0,0" MinWidth="120" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</Window>
