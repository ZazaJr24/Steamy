<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Steamy</RootNamespace>
    <AssemblyName>Steamy</AssemblyName>
    <Version>0.8.1.2</Version>
    <FileVersion>0.8.1.2</FileVersion>
    <AssemblyVersion>0.8.1.2</AssemblyVersion>
    <Product>Steamy</Product>
    <Company>ZazaJr24</Company>
    <Authors>ZazaJr24</Authors>
    <Description>A Windows app to browse and launch Steam and PC games, manage game downloads, and configure tools such as Steamless and Goldberg.</Description>
    <Copyright>Copyright (c) 2026 ZazaJr24. All rights reserved.</Copyright>
    <RepositoryUrl>https://github.com/ZazaJr24/Steamy</RepositoryUrl>
    <ApplicationIcon>Resources\Brand\steamy.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <Platforms>AnyCPU</Platforms>
    <LangVersion>latest</LangVersion>
    <EnableDiscordIntegration Condition="'$(EnableDiscordIntegration)' == ''">false</EnableDiscordIntegration>
    <DiscordApplicationId Condition="'$(DiscordApplicationId)' == ''">1559657404994429101</DiscordApplicationId>
  </PropertyGroup>
  <ItemGroup>
    <None Update="tool-preparation-capabilities.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdParty\UcOnline\LICENSE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdParty\UcOnline\SOURCE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Steamy.RelayClient"><HintPath>..\..\lib\Steamy.RelayClient.dll</HintPath><Private>true</Private></Reference>
    <InternalsVisibleTo Include="Steamy.UiTests" />
    <AssemblyMetadata Include="DiscordApplicationId" Value="$(DiscordApplicationId)" />
    <AssemblyMetadata Include="DiscordIntegrationEnabled" Value="$(EnableDiscordIntegration)" />
    <ProjectReference Include="..\PlayTimeTracker\PlayTimeTracker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Steamy.Core\Steamy.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableDiscordIntegration)' == 'true' and Exists('$(MSBuildProjectDirectory)\..\..\tools\DiscordSocialSdk\runtime\Discord.Sdk.dll')">
    <Content Include="..\..\tools\DiscordSocialSdk\runtime\**\*" Link="Tools\Discord\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\tools\ControllerHost\runtime\Steamy.ControllerHost.exe')">
    <Content Include="..\..\tools\ControllerHost\runtime\**\*" Link="Tools\ControllerHost\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyPlayTimeTracker" AfterTargets="Build;Publish">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\PlayTimeTracker\PlayTimeTracker.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="TrackerAssembly" />
    </MSBuild>
    <ItemGroup>
      <TrackerFiles Include="@(TrackerAssembly->'%(RootDir)%(Directory)PlayTimeTracker.exe');@(TrackerAssembly->'%(RootDir)%(Directory)PlayTimeTracker.dll');@(TrackerAssembly->'%(RootDir)%(Directory)PlayTimeTracker.deps.json');@(TrackerAssembly->'%(RootDir)%(Directory)PlayTimeTracker.runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(TrackerFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TrackerFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="XamlAnimatedGif" Version="2.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.20" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.20" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
  </ItemGroup>

  <!-- Images used from XAML go in as WPF resources so they can be referenced by pack URI. -->
  <ItemGroup>
    <Resource Include="Resources\Fonts\GoogleSans-Regular.ttf" />
    <Resource Include="Resources\Fonts\GoogleSans-Medium.ttf" />
    <Resource Include="Resources\Fonts\GoogleSans-SemiBold.ttf" />
    <Resource Include="Resources\Fonts\GoogleSans-Bold.ttf" />
    <None Update="Resources\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Resources\steamless.png" />
    <Resource Include="Resources\Brand\steamy-256.png" />
    <Resource Include="Resources\Brand\steamy.ico" />
    <Resource Include="Resources\GifProviders\*.png" />
    <None Update="Resources\GifProviders\SOURCE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Resources\LiquidGlass\GlassyEffect.ps" />
    <Resource Include="Resources\LiquidGlass\ClearGlass.ps" />
    <None Update="Resources\LiquidGlass\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Resources\LiquidGlass\UPSTREAM-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\spotlight.json" LogicalName="Steamy.spotlight.json" />
    <None Include="Resources\LICENSE-CloudRedirect.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\appid.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Data\appid.json')" />
  </ItemGroup>

  <!-- DepotDownloaderMod is downloaded on demand from tools/DepotDownloaderMod in this repository. -->

  <!-- CreamAPI replacement DLLs bundled for the DLC Unlocker (CreamAPI mode). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\CreamAPI\steam_api.dll" LogicalName="CreamAPI.steam_api.dll" />
    <EmbeddedResource Include="Resources\CreamAPI\steam_api64.dll" LogicalName="CreamAPI.steam_api64.dll" />
  </ItemGroup>
</Project>
