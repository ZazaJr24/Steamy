<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Steamy</RootNamespace>
    <AssemblyName>Steamy</AssemblyName>
    <Version>0.1.6</Version>
    <FileVersion>0.1.6</FileVersion>
    <AssemblyVersion>0.1.6</AssemblyVersion>
    <Product>Steamy</Product>
    <Copyright>Copyright (c) 2026 ZazaJr24 · Steamy License</Copyright>
    <ApplicationIcon />
    <Platforms>AnyCPU</Platforms>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="SharpCompress" Version="0.39.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
  </ItemGroup>

  <!-- Images used from XAML go in as WPF resources so they can be referenced by pack URI. -->
  <ItemGroup>
    <Resource Include="Resources\steamless.png" />
  </ItemGroup>

  <!-- Localization resource files -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.de-DE.resx" />
    <Compile Update="Resources\Strings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\LICENSE-CloudRedirect.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\appid.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Data\appid.json')" />
  </ItemGroup>

  <!-- Only DepotDownloaderMod is bundled; all other tools are downloaded at runtime. -->
  <ItemGroup>
    <None Include="Tools\DepotDownloaderMod\**\*" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- CreamAPI replacement DLLs bundled for the DLC Unlocker (CreamAPI mode). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\CreamAPI\steam_api.dll" LogicalName="CreamAPI.steam_api.dll" />
    <EmbeddedResource Include="Resources\CreamAPI\steam_api64.dll" LogicalName="CreamAPI.steam_api64.dll" />
  </ItemGroup>
</Project>
