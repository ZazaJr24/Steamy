<ui:FluentWindow x:Class="Steamy.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:Steamy.Pages" xmlns:services="clr-namespace:Steamy.Services"
                 xmlns:controls="clr-namespace:Steamy.Controls"
                 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                 FontFamily="{DynamicResource SteamyFontFamily}"
                 UseLayoutRounding="True" SnapsToDevicePixels="True"
                 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed"
                 RenderOptions.ClearTypeHint="Auto" RenderOptions.BitmapScalingMode="HighQuality"
                 Title="Steamy"
                 Height="900"
                 Width="1440"
                 MinHeight="620"
                 MinWidth="980"
                 WindowState="Normal"
                 WindowStartupLocation="CenterScreen"
                 WindowStyle="None"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 BorderBrush="Transparent" BorderThickness="0"
                 Icon="pack://application:,,,/Steamy;component/Resources/Brand/steamy.ico"
                 Background="{DynamicResource AppBackgroundBrush}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="ShellBoolVis" />
    <Style x:Key="ShellPillButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="8,4" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource GalleryKeyboardFocus}" />
      <Setter Property="controls:CardMotion.IsEnabled" Value="True" />
      <Setter Property="controls:CardMotion.HoverScale" Value="1" />
      <Setter Property="controls:CardMotion.HoverLift" Value="0" />
      <Setter Property="controls:CardMotion.HoverDuration" Value="150" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid Background="Transparent">
          <Grid x:Name="MotionSurface">
            <Border x:Name="Chrome" CornerRadius="15" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Grid>
        <ControlTemplate.Triggers>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="controls:ShellNavigation.IsSelected" Value="False" /></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHoverBrush}" /></MultiTrigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="ToolMenuButton" TargetType="Button" BasedOn="{StaticResource ShellPillButton}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="14,12" /><Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="44" />
      <Setter Property="controls:CardMotion.IsEnabled" Value="False" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" CornerRadius="14" Padding="{TemplateBinding Padding}" Background="{DynamicResource CardHoverGlassBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHoverBrush}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHoverBrush}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="ShellDownloadGlassButton" TargetType="Button" BasedOn="{StaticResource GalleryCardButton}">
      <Setter Property="controls:CardMotion.IsEnabled" Value="True" />
      <Setter Property="controls:CardMotion.HoverScale" Value="1.055" />
      <Setter Property="controls:CardMotion.HoverLift" Value="-1.5" />
      <Setter Property="controls:CardMotion.HoverDuration" Value="160" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid Background="Transparent"><Grid x:Name="MotionSurface"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /></Grid></Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ui:NavigationViewContentPresenter"
           BasedOn="{StaticResource {x:Type ui:NavigationViewContentPresenter}}">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style TargetType="ui:NavigationViewItem" BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}">
      <Setter Property="NavigationCacheMode" Value="Disabled" />
      <Setter Property="Border.CornerRadius" Value="12" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="FontSize" Value="13" />
      <Style.Triggers>
        <Trigger Property="IsActive" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource SidebarSelectedForegroundBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </ui:FluentWindow.Resources>
  <Grid Background="{DynamicResource WorkspaceBackgroundBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0" Panel.ZIndex="9" Width="164" Margin="0,8,8,0" HorizontalAlignment="Right"
                 shell:WindowChrome.IsHitTestVisibleInChrome="True"
                 Title=""
                 Height="36"
                 ShowMinimize="True" ShowMaximize="True" ShowClose="True" CanMaximize="True"
                 Background="Transparent" controls:RoundedClip.Radius="18"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 ButtonsForeground="{Binding Foreground, RelativeSource={RelativeSource Self}}"
                 BorderBrush="Transparent" BorderThickness="0">
      <ui:TitleBar.Resources><Style TargetType="ui:TitleBarButton" BasedOn="{StaticResource {x:Type ui:TitleBarButton}}"><Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="36"/></Style></ui:TitleBar.Resources>
    </ui:TitleBar>

    <Grid x:Name="WorkspaceLayer" Grid.RowSpan="2">
        <controls:ShellBackdropView x:Name="WorkspaceBackdrop" BaseBrush="{DynamicResource WorkspaceBackgroundBrush}" FadeColor="{DynamicResource WorkspaceColor}" />
        <controls:BoundedNavigationView x:Name="RootNavigation"
                        PaneDisplayMode="Left"
                        Template="{StaticResource GlassNavigationTemplate}"
                        OpenPaneLength="232"
                        CompactPaneLength="56"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleVisible="True"
                        IsTopSeparatorVisible="False"
                        IsFooterSeparatorVisible="False"
                        PaneTitle=""
                        Transition="None"
                        IsPaneOpen="False" Tag="Home"
                        BorderBrush="Transparent" BorderThickness="0"
                        Background="Transparent">
        <ui:NavigationView.Header>
          <Border Height="0" Visibility="Collapsed" />
        </ui:NavigationView.Header>
        <ui:NavigationView.PaneHeader>
          <Grid Margin="16,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="{StaticResource SteamyBrandImage}" Width="34" Height="34"
                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Steamy" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Steam toolkit" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,1,0,0" />
            </StackPanel>
          </Grid>
        </ui:NavigationView.PaneHeader>

        <ui:NavigationView.PaneFooter>
          <TextBlock x:Name="VersionLabel" Margin="18,6,14,12" FontSize="10.5"
                     Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
        </ui:NavigationView.PaneFooter>

        <ui:NavigationView.MenuItems>
          <ui:NavigationViewItem Content="Dashboard"
                                 Icon="{ui:SymbolIcon Home24}"
                                 TargetPageType="{x:Type pages:DashboardPage}" />
          <ui:NavigationViewItem Content="Games"
                                 Icon="{ui:SymbolIcon Games24}"
                                 TargetPageType="{x:Type pages:LibraryPage}" />
          <ui:NavigationViewItem Content="Tools" Icon="{ui:SymbolIcon Wrench24}">
            <ui:NavigationViewItem.MenuItems>
              <ui:NavigationViewItem Content="BetterSteamTools" Icon="{ui:SymbolIcon Box24}" TargetPageType="{x:Type pages:BetterSteamToolsPage}" />
              <ui:NavigationViewItem Content="Steamless"
                                     Icon="{ui:ImageIcon '/Steamy;component/Resources/steamless.png'}"
                                     TargetPageType="{x:Type pages:SteamlessPage}" />
              <ui:NavigationViewItem Content="Denuvo Activation"
                                     Icon="{ui:SymbolIcon Key24}"
                                     TargetPageType="{x:Type pages:DenuvoActivationPage}" />
              <ui:NavigationViewItem Content="DLC Unlocker"
                                     Icon="{ui:SymbolIcon LockOpen24}"
                                     TargetPageType="{x:Type pages:CreamApiPage}" />
              <ui:NavigationViewItem Content="GreenLuma"
                                     Icon="{ui:SymbolIcon People24}"
                                     TargetPageType="{x:Type pages:FamilySharePage}" />
              <ui:NavigationViewItem Content="Goldberg"
                                     Icon="{ui:SymbolIcon Games24}"
                                     TargetPageType="{x:Type pages:GoldbergPage}" />
            </ui:NavigationViewItem.MenuItems>
          </ui:NavigationViewItem>

          <ui:NavigationViewItem Content="Friends" Visibility="{x:Static services:DiscordIntegration.Visibility}" Icon="{ui:SymbolIcon People24}" TargetPageType="{x:Type pages:FriendsPage}" />
          <ui:NavigationViewItem Content="Community" Visibility="{x:Static services:DiscordIntegration.Visibility}" Icon="{ui:SymbolIcon Globe24}" TargetPageType="{x:Type pages:CommunityPage}" />
          <ui:NavigationViewItem Content="Controllers" Icon="{ui:SymbolIcon Games24}" TargetPageType="{x:Type pages:ControllersPage}" />
          <ui:NavigationViewItem Content="Fixes" Icon="{ui:SymbolIcon Shield24}">
            <ui:NavigationViewItem.MenuItems>
              <ui:NavigationViewItem Content="Game Fixes"
                                     Icon="{ui:SymbolIcon ShieldTask24}"
                                     TargetPageType="{x:Type pages:GameFixesPage}" />
              <ui:NavigationViewItem Content="Hypervisor Fixes" Icon="{ui:SymbolIcon Shield24}"
                                     TargetPageType="{x:Type pages:HypervisorFixesPage}" />
            </ui:NavigationViewItem.MenuItems>
          </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>

        <ui:NavigationView.FooterMenuItems>
          <ui:NavigationViewItem Content="Downloads"
                                 Icon="{ui:SymbolIcon ArrowDownload24}"
                                 TargetPageType="{x:Type pages:DownloadsPage}" />
          <ui:NavigationViewItem Content="Settings"
                                 Icon="{ui:SymbolIcon Settings24}"
                                 TargetPageType="{x:Type pages:SettingsPage}" />
        </ui:NavigationView.FooterMenuItems>
      </controls:BoundedNavigationView>
    </Grid>

    <Grid x:Name="PersistentNavigation" Grid.RowSpan="2" Panel.ZIndex="5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Height="36" Width="540" controls:RoundedClip.Radius="18" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Grid.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"><MenuItem Header="{Binding SpotlightPlaybackLabel}" Command="{Binding ToggleSpotlightCommand}" /><MenuItem Header="Refresh spotlight" Command="{Binding RefreshCommand}" /></ContextMenu></Grid.ContextMenu>
      <controls:ShellBackdropView IsPageBackdrop="{Binding IsPageBackdrop, ElementName=WorkspaceBackdrop}" IsGlass="True" PreferSharpArtwork="False" SamplePageSurface="True" IncludePageContent="False" FrostRadius="8" BaseBrush="{DynamicResource WorkspaceBackgroundBrush}" />
      <Border x:Name="NavigationSurface" CornerRadius="18" Padding="3" BorderThickness="1" BorderBrush="{DynamicResource ShellChromeBorderBrush}" Background="{DynamicResource LauncherBackgroundBrush}">
        <Grid>
        <Border x:Name="NavigationSheen" CornerRadius="14" Background="{DynamicResource ShellChromeSheenBrush}" IsHitTestVisible="False" />
        <Grid x:Name="ShellPillItems" Height="28" VerticalAlignment="Center" UseLayoutRounding="True" SnapsToDevicePixels="True" controls:PillMotion.IsEnabled="True" controls:PillMotion.FollowPointer="False">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="{x:Static services:DiscordIntegration.TextColumnWidth}" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="{x:Static services:DiscordIntegration.IconColumnWidth}" /><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
          <Border x:Name="NavigationHighlight" Grid.ColumnSpan="8" CornerRadius="14" HorizontalAlignment="Left" IsHitTestVisible="False" Background="#30FFFFFF" />
          <Button Content="Home" Style="{StaticResource ShellPillButton}" Tag="{x:Type pages:DashboardPage}" Click="ShellRoute_Click" />
          <Button Grid.Column="1" Content="Games" Style="{StaticResource ShellPillButton}" Tag="{x:Type pages:LibraryPage}" Click="ShellRoute_Click" />
          <Button x:Name="ShellFriendsHubButton" Visibility="{x:Static services:DiscordIntegration.Visibility}" Grid.Column="2" Content="Friends" Style="{StaticResource ShellPillButton}" Tag="{x:Type pages:FriendsPage}" Click="ShellRoute_Click" />
          <Button x:Name="ShellToolsButton" Grid.Column="3" Content="Tools" Style="{StaticResource ShellPillButton}" Click="ShellTools_Click" />
          <Button x:Name="ShellFixesButton" Grid.Column="4" Content="Fixes" Style="{StaticResource ShellPillButton}" Click="ShellFixes_Click" />
          <Button x:Name="ShellFriendsButton" Visibility="{x:Static services:DiscordIntegration.Visibility}" Grid.Column="5" Style="{StaticResource ShellPillButton}" Tag="{x:Type pages:FriendsPage}" Click="ShellRoute_Click" ToolTip="{Binding NavigationSocialTooltip}" AutomationProperties.Name="Friends"><ui:SymbolIcon Symbol="People24" FontSize="18" /></Button>
          <Button x:Name="ShellSettingsButton" Grid.Column="6" Style="{StaticResource ShellPillButton}" Tag="{x:Type pages:SettingsPage}" Click="ShellRoute_Click" AutomationProperties.Name="Settings"><ui:SymbolIcon Symbol="Settings24" FontSize="17" /></Button>
          <Button x:Name="ShellDownloadsButton" Grid.Column="7" Style="{StaticResource ShellPillButton}" Tag="{x:Type pages:DownloadsPage}" Click="ShellRoute_Click" ToolTip="{Binding Summary}" AutomationProperties.Name="Downloads" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Grid><ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18"/><Ellipse x:Name="DownloadActiveDot" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding Job.IsActive, Converter={StaticResource ShellBoolVis}}"/></Grid></Button>
        </Grid>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="ToolsMenuLayer" Grid.RowSpan="2" Panel.ZIndex="4" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
      <Border x:Name="ToolsDropdown" Width="560" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,54,0,0" CornerRadius="24" controls:RoundedClip.Radius="24" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
              controls:SurfaceMotion.RevealOnShow="True" controls:SurfaceMotion.Duration="150" controls:SurfaceMotion.StartScale="1" controls:SurfaceMotion.Lift="4">
        <Grid>
          <controls:ShellBackdropView IsPageBackdrop="{Binding IsPageBackdrop, ElementName=WorkspaceBackdrop}" IsGlass="True" PreferSharpArtwork="False" SamplePageSurface="True" IncludePageContent="True" FrostRadius="12" BaseBrush="{DynamicResource WorkspaceBackgroundBrush}" />
          <Border Background="{DynamicResource GlassSurfaceBrush}" />
        <StackPanel Margin="18">
          <StackPanel x:Name="FixesMenuSection">
            <TextBlock Text="Fixes" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,10" />
            <UniformGrid Columns="2">
              <Button x:Name="GameFixesMenuButton" Style="{StaticResource ToolMenuButton}" Tag="{x:Type pages:GameFixesPage}" Click="ShellRoute_Click" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ShieldTask24" Margin="0,0,10,0" /><TextBlock Text="Game fixes" /></StackPanel></Button>
              <Button Style="{StaticResource ToolMenuButton}" Tag="{x:Type pages:HypervisorFixesPage}" Click="ShellRoute_Click" Margin="5,0,0,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Shield24" Margin="0,0,10,0" /><TextBlock Text="Hypervisor fixes" /></StackPanel></Button>
            </UniformGrid>
          </StackPanel>
          <StackPanel x:Name="ToolsMenuSection">
            <TextBlock Text="Tools" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,10" />
            <UniformGrid Columns="2">
              <Button x:Name="SteamToolsMenuButton" Style="{StaticResource ToolMenuButton}" Tag="{x:Type pages:BetterSteamToolsPage}" Click="ShellRoute_Click" Content="BetterSteamTools" Margin="0,0,5,5" />
              <Button Style="{StaticResource ToolMenuButton}" Tag="{x:Type pages:SteamlessPage}" Click="ShellRoute_Click" Content="Steamless" Margin="5,0,0,5" />
              <Button Style="{StaticResource ToolMenuButton}" Tag="{x:Type pages:DenuvoActivationPage}" Click="ShellRoute_Click" Content="Denuvo activation" Margin="0,5,5,5" />
              <Button Style="{StaticResource ToolMenuButton}" Tag="{x:Type pages:CreamApiPage}" Click="ShellRoute_Click" Content="DLC configuration" Margin="5,5,0,5" />
              <Button Style="{StaticResource ToolMenuButton}" Tag="{x:Type pages:FamilySharePage}" Click="ShellRoute_Click" Content="GreenLuma" Margin="0,5,5,5" />
              <Button Style="{StaticResource ToolMenuButton}" Tag="{x:Type pages:GoldbergPage}" Click="ShellRoute_Click" Content="Goldberg" Margin="5,5,0,5" />
              <Button Style="{StaticResource ToolMenuButton}" Tag="{x:Type pages:UcOnlinePage}" Click="ShellRoute_Click" Content="UC Online" Margin="0,5,5,0" />
              <Button Style="{StaticResource ToolMenuButton}" Tag="{x:Type pages:ControllersPage}" Click="ShellRoute_Click" Content="Controllers" Margin="5,5,0,0" />
            </UniformGrid>
          </StackPanel>
        </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Button x:Name="NotificationBell" Grid.RowSpan="2" Panel.ZIndex="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,180,0" Width="36" Height="36" MinHeight="36" Padding="8" Click="Notifications_Click" Style="{StaticResource ShellPillButton}" ToolTip="{Binding Tooltip}" AutomationProperties.Name="Notifications" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Grid><ui:SymbolIcon Symbol="Alert24" FontSize="19" /><Border Background="{DynamicResource SocialActionBrush}" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-7,0" Visibility="{Binding BadgeVisibility}"><TextBlock Text="{Binding BadgeLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SocialOwnTextBrush}" TextAlignment="Center" /></Border></Grid>
    </Button>
    <Popup x:Name="NotificationsPopup" PlacementTarget="{Binding ElementName=NotificationBell}" Placement="Bottom" VerticalOffset="10" StaysOpen="False" AllowsTransparency="True">
      <Border x:Name="NotificationCenterBorder" Width="400" MaxHeight="540" CornerRadius="18" Background="{DynamicResource SocialNotificationBrush}" BorderBrush="{DynamicResource SocialEdgeBrush}" BorderThickness="1" controls:RoundedClip.Radius="18"><controls:NotificationCenterPanel x:Name="NotificationPanel" /></Border>
    </Popup>
    <ItemsControl x:Name="NotificationToasts" Grid.RowSpan="2" Panel.ZIndex="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22" Width="354" ItemsSource="{Binding Toasts}">
      <ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=OverlayLayer}" Value="Visible"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
      <ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="{DynamicResource SocialNotificationBrush}" BorderBrush="{DynamicResource SocialEdgeBrush}" BorderThickness="1" CornerRadius="20" Margin="0,0,0,10" Padding="4">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ui:Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Appearance="Transparent" Background="Transparent" BorderThickness="0" Padding="12" HorizontalContentAlignment="Stretch">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource SocialAccentSoftBrush}" Margin="0,0,12,0" controls:RoundedClip.Radius="18"><Grid><TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SocialAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image controls:AsyncArtwork.Private="True" controls:AsyncArtwork.Width="120" controls:AsyncArtwork.Height="120" controls:AsyncArtwork.Url="{Binding AvatarUrl}" Stretch="UniformToFill" /></Grid></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding CountLabel}" FontSize="10" Foreground="{DynamicResource SocialAccentBrush}" /><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Body}" FontSize="12" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="36" Margin="0,4,0,0" /></StackPanel></Grid>
            </ui:Button>
            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss16}" Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Appearance="Transparent" Background="Transparent" BorderThickness="0" Padding="5" MinHeight="24" VerticalAlignment="Top" Margin="0,5,5,0" ToolTip="Dismiss notification" AutomationProperties.Name="Dismiss notification" />
          </Grid>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>

    <ContentControl x:Name="VoiceCallHost" Grid.Row="2" />
    <!-- Dimmed layer for cards shown on top of the app, e.g. the update prompt -->
    <Grid x:Name="OverlayLayer" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="6" Visibility="Collapsed" Background="{DynamicResource ScrimBrush}" Opacity="0">
      <controls:ShellBackdropView x:Name="SetupBackdrop" IsPageBackdrop="True" BaseBrush="{DynamicResource WorkspaceBackgroundBrush}" Visibility="Collapsed" />
      <ContentControl x:Name="OverlayHost" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
    </Grid>
  </Grid>
</ui:FluentWindow>
