<ui:FluentWindow x:Class="Steamy.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:Steamy.Pages"
                 xmlns:res="clr-namespace:Steamy.Resources"
                 Title="Steamy"
                 Height="900"
                 Width="1440"
                 MinHeight="620"
                 MinWidth="980"
                 WindowState="Maximized"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource AppBackgroundBrush}">
  <Grid Background="{DynamicResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0"
                 Title="Steamy"
                 Height="34"
                 Background="{DynamicResource AppBackgroundBrush}"
                 Foreground="{DynamicResource TextSecondaryBrush}" />

    <Grid Grid.Row="1">
        <ui:NavigationView x:Name="RootNavigation"
                        PaneDisplayMode="Left"
                        OpenPaneLength="184"
                        CompactPaneLength="52"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleVisible="True"
                        IsFooterSeparatorVisible="True"
                        PaneTitle="Steamy"
                        Transition="None"
                        IsPaneOpen="True"
                        Background="{DynamicResource SidebarBackgroundBrush}">
        <ui:NavigationView.Header>
          <Border Height="0" Visibility="Collapsed" />
        </ui:NavigationView.Header>
        <ui:NavigationView.PaneHeader>
          <Border Margin="12,12,12,14"
                  Padding="10,9"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                  BorderThickness="1"
                  CornerRadius="14">
            <StackPanel Orientation="Horizontal">
              <Border Width="34" Height="34" CornerRadius="10">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0284C7" Offset="0" />
                    <GradientStop Color="#6366F1" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <ui:SymbolIcon Symbol="Games24" Foreground="White" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Steamy" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14" FontWeight="Bold" />
                <TextBlock Text="Steam Modding Suite" Foreground="{DynamicResource TextTertiaryBrush}"
                           FontSize="10.5" Margin="0,1,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
        </ui:NavigationView.PaneHeader>

        <ui:NavigationView.MenuItems>
          <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Dashboard}"
                                 Icon="{ui:SymbolIcon Home24}"
                                 TargetPageType="{x:Type pages:DashboardPage}" />
          <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Games}"
                                 Icon="{ui:SymbolIcon Apps24}"
                                 TargetPageType="{x:Type pages:LibraryPage}" />

          <ui:NavigationViewItemSeparator />

          <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Tools}" Icon="{ui:SymbolIcon Wrench24}">
            <ui:NavigationViewItem.MenuItems>
              <ui:NavigationViewItem Content="Steamless"
                                     Icon="{ui:ImageIcon '/Steamy;component/Resources/steamless.png'}"
                                     TargetPageType="{x:Type pages:SteamlessPage}" />
              <ui:NavigationViewItem Content="Denuvo Activation"
                                     Icon="{ui:SymbolIcon Key24}"
                                     TargetPageType="{x:Type pages:DenuvoActivationPage}" />
              <ui:NavigationViewItem Content="DLC Unlocker"
                                     Icon="{ui:SymbolIcon LockOpen24}"
                                     TargetPageType="{x:Type pages:CreamApiPage}" />
              <ui:NavigationViewItem Content="GreenLuma"
                                     Icon="{ui:SymbolIcon People24}"
                                     TargetPageType="{x:Type pages:FamilySharePage}" />
              <ui:NavigationViewItem Content="Goldberg"
                                     Icon="{ui:SymbolIcon Games24}"
                                     TargetPageType="{x:Type pages:GoldbergPage}" />
              <ui:NavigationViewItem Content="BetterSteamTools"
                                     Icon="{ui:SymbolIcon KeyMultiple24}"
                                     TargetPageType="{x:Type pages:BetterSteamToolsPage}" />
              <ui:NavigationViewItem Content="ScreamAPI"
                                     Icon="{ui:SymbolIcon GlobeShield24}"
                                     TargetPageType="{x:Type pages:ScreamApiPage}" />
              <ui:NavigationViewItem Content="XStore Unlocker"
                                     Icon="{ui:SymbolIcon XboxConsole24}"
                                     TargetPageType="{x:Type pages:XStoreUnlockerPage}" />
              <ui:NavigationViewItem Content="SteamAutoCracker"
                                     Icon="{ui:SymbolIcon Flash24}"
                                     TargetPageType="{x:Type pages:AutoSteamCrackerPage}" />
            </ui:NavigationViewItem.MenuItems>
          </ui:NavigationViewItem>

          <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Utilities}" Icon="{ui:SymbolIcon Toolbox24}">
            <ui:NavigationViewItem.MenuItems>
              <ui:NavigationViewItem Content="Achievement Manager"
                                     Icon="{ui:SymbolIcon Trophy24}"
                                     TargetPageType="{x:Type pages:SteamAchievementManagerPage}" />
            </ui:NavigationViewItem.MenuItems>
          </ui:NavigationViewItem>

          <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Fixes}" Icon="{ui:SymbolIcon Shield24}">
            <ui:NavigationViewItem.MenuItems>
              <ui:NavigationViewItem Content="Game Fixes"
                                     Icon="{ui:SymbolIcon ShieldTask24}"
                                     TargetPageType="{x:Type pages:GameFixesPage}" />
            </ui:NavigationViewItem.MenuItems>
          </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>

        <ui:NavigationView.FooterMenuItems>
          <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Downloads}"
                                 Icon="{ui:SymbolIcon ArrowDownload24}"
                                 TargetPageType="{x:Type pages:DownloadsPage}" />
          <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Settings}"
                                 Icon="{ui:SymbolIcon Settings24}"
                                 TargetPageType="{x:Type pages:SettingsPage}" />
        </ui:NavigationView.FooterMenuItems>
      </ui:NavigationView>
    </Grid>

    <!-- Dimmed layer for cards shown on top of the app, e.g. the update prompt -->
    <Grid x:Name="OverlayLayer" Grid.Row="1" Visibility="Collapsed" Background="#B8050608" Opacity="0">
      <ContentControl x:Name="OverlayHost" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
    </Grid>
  </Grid>
</ui:FluentWindow>
