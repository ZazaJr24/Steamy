<UserControl x:Class="Steamy.Controls.VoiceCallBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" FontFamily="{DynamicResource SteamyFontFamily}" Visibility="{Binding BarVisibility}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Steamy;component/Resources/SocialStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border Background="{DynamicResource SocialNotificationBrush}" BorderBrush="{DynamicResource SocialBorderBrush}" BorderThickness="0,1,0,0" Padding="24,8">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#43B581" Margin="0,0,10,0" /><TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" /><TextBlock Text="{Binding State}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0" /><TextBlock Text="{Binding TalkHint}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" VerticalAlignment="Center" /></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><ui:Button Content="{Binding MuteLabel}" Command="{Binding MuteCommand}" Style="{StaticResource SocialQuietButton}" /><ui:Button Content="{Binding DeafLabel}" Command="{Binding DeafenCommand}" Style="{StaticResource SocialQuietButton}" /><ui:Button x:Name="VoiceSettingsButton" Icon="{ui:SymbolIcon Settings20}" Click="VoiceSettings_Click" Style="{StaticResource SocialQuietButton}" AutomationProperties.Name="Voice settings" /><ui:Button Content="{Binding LeaveLabel}" Command="{Binding LeaveCommand}" Style="{StaticResource SocialQuietButton}" Foreground="{DynamicResource DangerBrush}" /></StackPanel>
   <Popup x:Name="VoiceSettingsPopup" PlacementTarget="{Binding ElementName=VoiceSettingsButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-10">
    <Border Width="350" MaxHeight="560" Padding="20" CornerRadius="18" Background="{DynamicResource SocialNotificationBrush}" BorderBrush="{DynamicResource SocialEdgeBrush}" BorderThickness="1" DataContext="{Binding PlacementTarget.DataContext, ElementName=VoiceSettingsPopup}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock Text="Voice settings" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />
      <TextBlock Text="Microphone" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" DisplayMemberPath="Name" Style="{StaticResource SocialCombo}" />
      <Slider Minimum="0" Maximum="200" Value="{Binding InputVolume}" Margin="0,8,0,12" AutomationProperties.Name="Microphone volume" />
      <TextBlock Text="Output" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Name" Style="{StaticResource SocialCombo}" />
      <Slider Minimum="0" Maximum="200" Value="{Binding OutputVolume}" Margin="0,8,0,16" AutomationProperties.Name="Speaker volume" />
      <CheckBox Content="Push to talk" IsChecked="{Binding PushToTalk}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
      <ComboBox ItemsSource="{Binding TalkKeys}" SelectedValue="{Binding PushToTalkKey}" SelectedValuePath="Key" DisplayMemberPath="Value" Style="{StaticResource SocialCombo}" Margin="0,8,0,12" AutomationProperties.Name="Push to talk key" />
      <ItemsControl ItemsSource="{Binding Participants}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Ellipse Width="6" Height="6" Margin="0,0,8,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Speaking}" Value="True"><Setter Property="Fill" Value="#43B581" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" /><TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" /></Grid><Slider Minimum="0" Maximum="200" Value="{Binding Volume}" Margin="0,6,0,0" AutomationProperties.Name="Participant volume" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <ui:Button Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource SocialQuietButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
     </StackPanel></ScrollViewer>
    </Border>
   </Popup>
  </Grid>
 </Border>
</UserControl>
