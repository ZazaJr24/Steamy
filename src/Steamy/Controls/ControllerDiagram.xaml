<UserControl x:Class="Steamy.Controls.ControllerDiagram"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 AutomationProperties.Name="PlayStation controller button map">
 <UserControl.Resources>
  <Style x:Key="MapButton" TargetType="ToggleButton">
   <Setter Property="Foreground" Value="#D7DCE7" /><Setter Property="FontSize" Value="14" />
   <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
   <Setter Property="Background" Value="#31353F" /><Setter Property="BorderBrush" Value="#677080" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Face" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#495063" /></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="#6573E8" /><Setter TargetName="Face" Property="BorderBrush" Value="#CCD4FF" /><Setter Property="Foreground" Value="White" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="White" /><Setter TargetName="Face" Property="BorderThickness" Value="2" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Viewbox Stretch="Uniform" MaxHeight="264" HorizontalAlignment="Stretch">
  <Canvas x:Name="Diagram" Width="640" Height="300">
   <Path Data="M 158,67 C 126,61 102,77 88,108 L 50,229 C 34,282 71,297 99,268 L 157,214 C 202,223 233,217 263,213 L 377,213 C 407,217 438,223 483,214 L 541,268 C 569,297 606,282 590,229 L 552,108 C 538,77 514,61 482,67 Z"
    Stroke="#616A7B" StrokeThickness="1.5"><Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#444B5A" /><GradientStop Color="#242832" Offset="1" /></LinearGradientBrush></Path.Fill></Path>
   <Path Data="M 210,83 L 235,83 M 405,83 L 430,83" Stroke="#8898FB" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
   <Rectangle Canvas.Left="249" Canvas.Top="86" Width="142" Height="75" RadiusX="13" RadiusY="13" Fill="#20242D" Stroke="#586174" />
   <Path Data="M 275,101 L 365,101 M 275,108 L 365,108" Stroke="#313846" StrokeThickness="1" />
   <ToggleButton Tag="L2" Content="L2" Canvas.Left="115" Canvas.Top="17" Width="88" Height="32" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map left trigger L2" />
   <ToggleButton Tag="L1" Content="L1" Canvas.Left="110" Canvas.Top="51" Width="98" Height="28" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map left shoulder L1" />
   <ToggleButton Tag="R2" Content="R2" Canvas.Left="437" Canvas.Top="17" Width="88" Height="32" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map right trigger R2" />
   <ToggleButton Tag="R1" Content="R1" Canvas.Left="432" Canvas.Top="51" Width="98" Height="28" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map right shoulder R1" />
   <ToggleButton Tag="Share" Content="Share" FontSize="9" Canvas.Left="211" Canvas.Top="101" Width="32" Height="34" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map Share button" />
   <ToggleButton Tag="Options" Content="⋮" Canvas.Left="397" Canvas.Top="101" Width="32" Height="34" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map Options button" />
   <ToggleButton Tag="DpadUp" Content="↑" Canvas.Left="144" Canvas.Top="104" Width="30" Height="30" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map D-pad up" />
   <ToggleButton Tag="DpadDown" Content="↓" Canvas.Left="144" Canvas.Top="164" Width="30" Height="30" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map D-pad down" />
   <ToggleButton Tag="DpadLeft" Content="←" Canvas.Left="114" Canvas.Top="134" Width="30" Height="30" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map D-pad left" />
   <ToggleButton Tag="DpadRight" Content="→" Canvas.Left="174" Canvas.Top="134" Width="30" Height="30" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map D-pad right" />
   <ToggleButton Tag="Triangle" Content="△" Foreground="#8DDDC2" Canvas.Left="467" Canvas.Top="100" Width="34" Height="34" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map Triangle to virtual Xbox output" />
   <ToggleButton Tag="Square" Content="□" Foreground="#D6A3E5" Canvas.Left="432" Canvas.Top="135" Width="34" Height="34" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map Square to virtual Xbox output" />
   <ToggleButton Tag="Circle" Content="○" Foreground="#EEABBA" Canvas.Left="502" Canvas.Top="135" Width="34" Height="34" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map Circle to virtual Xbox output" />
   <ToggleButton Tag="Cross" Content="×" Foreground="#A9C6FA" Canvas.Left="467" Canvas.Top="170" Width="34" Height="34" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map Cross to virtual Xbox output" />
   <Ellipse Canvas.Left="215" Canvas.Top="170" Width="64" Height="64" Fill="#1B1E26" Stroke="#515B6D" />
   <ToggleButton Tag="L3" Content="L3" FontSize="12" Canvas.Left="222" Canvas.Top="177" Width="50" Height="50" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map left stick press L3" />
   <Ellipse Canvas.Left="361" Canvas.Top="170" Width="64" Height="64" Fill="#1B1E26" Stroke="#515B6D" />
   <ToggleButton Tag="R3" Content="R3" FontSize="12" Canvas.Left="368" Canvas.Top="177" Width="50" Height="50" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map right stick press R3" />
   <ToggleButton Tag="PS" Content="PS" FontSize="11" Canvas.Left="303" Canvas.Top="176" Width="34" Height="30" Style="{StaticResource MapButton}" Click="SelectButton" AutomationProperties.Name="Map PlayStation guide button" />
   <TextBlock Canvas.Left="203" Canvas.Top="266" Width="234" Text="DUALSHOCK 4  /  DUALSENSE" TextAlignment="Center" Foreground="#8C95A7" FontSize="10" />
  </Canvas>
 </Viewbox>
</UserControl>
