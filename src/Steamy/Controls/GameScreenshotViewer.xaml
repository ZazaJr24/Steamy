<UserControl x:Class="Steamy.Controls.GameScreenshotViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Steamy.Controls"
    FontFamily="{DynamicResource SteamyFontFamily}" Focusable="True"
    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
    AutomationProperties.Name="Game screenshot preview"
    UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Background="#C0090B10">
    <Border x:Name="ViewerCard" HorizontalAlignment="Center" VerticalAlignment="Center"
        CornerRadius="18" Background="#181A20" BorderBrush="#55FFFFFF" BorderThickness="1" controls:RoundedClip.Radius="18">
      <Grid>
        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="ViewerStatus" Foreground="White" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32" MouseLeftButtonUp="Retry_Click"/>
        <Button x:Name="CloseImageButton" Click="Close_Click" Width="36" Height="36" Padding="0" Margin="12"
            HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" ToolTip="Close (Esc)"
            FocusVisualStyle="{StaticResource GalleryKeyboardFocus}" Foreground="White" AutomationProperties.Name="Close screenshot preview">
          <Button.Template><ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="18" Background="#B824262C" BorderBrush="#55FFFFFF" BorderThickness="1"><ui:SymbolIcon Symbol="Dismiss24" FontSize="18" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#E8404248"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></Button.Template>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
