<UserControl x:Class="Steamy.Controls.BackgroundOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <StackPanel>
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,20,0">
        <TextBlock Text="Artwork ambient" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="Use game artwork colors, or switch off for a fixed background." FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
      <ui:ToggleSwitch x:Name="AmbientToggle" Grid.Column="1" VerticalAlignment="Center" Checked="Ambient_Changed" Unchecked="Ambient_Changed" AutomationProperties.Name="Artwork ambient" />
    </Grid>
    <Border x:Name="ColorPanel" CornerRadius="12" Padding="12" Background="#0CFFFFFF" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="Background color" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="Choose any color · #RRGGBB" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ColorButton" Width="36" Height="36" Margin="0,0,8,0" Padding="3" Click="PickColor_Click" ToolTip="Choose any background color" AutomationProperties.Name="Choose background color">
            <Border x:Name="ColorSwatch" CornerRadius="6" BorderBrush="#60FFFFFF" BorderThickness="1" Width="26" Height="26" />
          </Button>
          <TextBox x:Name="ColorHex" Width="104" Height="36" VerticalContentAlignment="Center" Padding="9,0" MaxLength="7" TextChanged="ColorHex_Changed" LostFocus="ColorHex_LostFocus" AutomationProperties.Name="Background color HEX" />
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock x:Name="ColorError" Text="Enter a valid color, for example #182838." FontSize="11" Margin="0,6,0,0" Foreground="#F5A97F" Visibility="Collapsed" />
  </StackPanel>
</UserControl>
