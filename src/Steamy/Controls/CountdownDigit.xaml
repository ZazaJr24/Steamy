<UserControl x:Class="Steamy.Controls.CountdownDigit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="52" Height="62" Foreground="#F0F1F7" Focusable="False">
  <Border CornerRadius="10" BorderBrush="#254B5069" BorderThickness="1" Background="#FF1C1E29" ClipToBounds="True">
    <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="Number" Text="00" FontFamily="Segoe UI" FontSize="25" FontWeight="SemiBold"
                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" TextAlignment="Center">
        <TextBlock.RenderTransform><TranslateTransform x:Name="DigitMotion" /></TextBlock.RenderTransform>
      </TextBlock>
      <TextBlock x:Name="Unit" FontSize="8" Foreground="#ADAFC1" TextAlignment="Center" Margin="0,3,0,0" />
    </StackPanel>
  </Border>
</UserControl>
