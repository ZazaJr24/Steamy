<Page x:Class="Steamy.Pages.ToolRunnerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Page.Resources>

  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" Padding="26,22,26,40">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

      <!-- Header -->
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>
        <ui:Button Grid.Column="1"
                   Icon="{ui:SymbolIcon Info24}"
                   Command="{Binding ToggleInfoCommand}"
                   Appearance="Secondary"
                   Style="{StaticResource IconButtonStyle}"
                   ToolTip="Show tool information"
                   VerticalAlignment="Center" />
      </Grid>

      <!-- Status strip -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="15"
              Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AccentSoftBrush}">
            <TextBlock Text="⚙"
                       FontSize="19"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Status}" Style="{StaticResource CardTitleStyle}" />
            <TextBlock Text="{Binding DisplayPath}"
                       Style="{StaticResource TertiaryTextStyle}"
                       FontSize="11"
                       Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Margin="0,0,12,0" HorizontalAlignment="Right">
              <TextBlock Text="Version" Style="{StaticResource TertiaryTextStyle}" FontSize="10.5" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding ToolVersion}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
            </StackPanel>
            <ui:Button Content="Refresh"
                       Command="{Binding RefreshStatusCommand}"
                       Appearance="Secondary" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Workflow -->
      <Border Style="{StaticResource SurfaceCardStyle}" Padding="18" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Tool workflow" Style="{StaticResource CardTitleStyle}" FontSize="15" Margin="0,0,0,6" />
          <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,0,0,16"
                     Text="Tools are downloaded automatically from GitHub. You can also browse for a local executable." />

          <!-- Auto-download button -->
          <ui:Button Content="{Binding DownloadButtonText}"
                     Command="{Binding DownloadCommand}"
                     Appearance="Primary"
                     HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Center"
                     Height="40"
                     Margin="0,0,0,14"
                     Visibility="{Binding HasAutoDownload, Converter={StaticResource BooleanToVisibilityConverter}}" />

          <!-- Download progress -->
          <StackPanel Margin="0,0,0,14"
                      Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" HorizontalAlignment="Center" />
            <TextBlock Text="Downloading from GitHub…"
                       Style="{StaticResource MutedTextStyle}"
                       FontSize="12"
                       TextAlignment="Center"
                       Margin="0,6,0,0" />
          </StackPanel>

          <TextBlock Text="Executable" Style="{StaticResource PillTextStyle}" Margin="0,0,0,6" />
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{Binding ExecutablePlaceholder}"
                        LostFocus="ExecutablePathBox_LostFocus"
                        VerticalAlignment="Center" />
            <ui:Button Grid.Column="1"
                       Content="Browse…"
                       Click="BrowseExecutableButton_Click"
                       Appearance="Secondary"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>

          <TextBlock Text="Working directory (optional)" Style="{StaticResource PillTextStyle}" Margin="0,0,0,6" />
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Defaults to the tool's own folder"
                        VerticalAlignment="Center" />
            <ui:Button Grid.Column="1"
                       Content="Choose…"
                       Click="BrowseWorkingDirectoryButton_Click"
                       Appearance="Secondary"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>

          <TextBlock Text="Arguments (optional)" Style="{StaticResource PillTextStyle}" Margin="0,0,0,6" />
          <ui:TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                      PlaceholderText="Leave empty to start the tool normally"
                      Margin="0,0,0,14" />

          <CheckBox IsChecked="{Binding SettingsModel.ConfirmBeforeDelete}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Margin="0,0,0,14">
            <TextBlock Text="I keep a backup of any game file this tool modifies, so the change stays reversible."
                       TextWrapping="Wrap" FontSize="12.5" />
          </CheckBox>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding LastMessage}"
                       Style="{StaticResource MutedTextStyle}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <ui:Button Grid.Column="1"
                       Content="Cancel"
                       Command="{Binding CancelRunCommand}"
                       IsEnabled="{Binding IsBusy}"
                       Appearance="Secondary"
                       Margin="10,0,8,0" />
            <ui:Button Grid.Column="2"
                       Content="Run"
                       Command="{Binding RunCommand}"
                       IsEnabled="{Binding CanRun}"
                       Appearance="Primary" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Done popup -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="18"
              Margin="0,0,0,14"
              Visibility="{Binding ShowDone, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="21" VerticalAlignment="Top">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DoneSuccess}" Value="True">
                      <Setter Property="Background" Value="#1F42D39A" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="!" />
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DoneSuccess}" Value="True">
                        <Setter Property="Text" Value="✓" />
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>
            <TextBlock Grid.Column="1"
                       Text="{Binding DoneTitle}"
                       Style="{StaticResource CardTitleStyle}"
                       FontSize="15"
                       Margin="12,0,12,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <ui:Button Grid.Column="2"
                       Content="Dismiss"
                       Command="{Binding DismissDoneCommand}"
                       Appearance="Secondary"
                       VerticalAlignment="Center" />
          </Grid>

          <TextBlock Text="{Binding DoneMessage}"
                     Style="{StaticResource MutedTextStyle}"
                     FontSize="12.5"
                     Margin="0,12,0,0"
                     TextWrapping="Wrap" />

          <Border Background="{DynamicResource SurfaceSubtleBrush}"
                  CornerRadius="10"
                  Padding="12,10"
                  Margin="0,12,0,0"
                  Visibility="{Binding HasOutput, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding Output}"
                         TextWrapping="Wrap"
                         FontSize="10.5"
                         FontFamily="Consolas"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </ScrollViewer>
          </Border>

          <ui:Button Content="Close"
                     Command="{Binding CloseDoneCommand}"
                     Appearance="Primary"
                     HorizontalAlignment="Right"
                     Margin="0,14,0,0" />
        </StackPanel>
      </Border>

      <!-- Info card -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="16"
              Margin="0,0,0,14"
              Visibility="{Binding IsInfoVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <TextBlock Text="Tool information" Style="{StaticResource CardTitleStyle}" FontSize="14" />
          <TextBlock Text="{Binding InfoText}"
                     Style="{StaticResource MutedTextStyle}"
                     FontSize="12"
                     Margin="0,6,0,0"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding DownloadUrl}"
                     Style="{StaticResource TertiaryTextStyle}"
                     FontSize="11"
                     Margin="0,8,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
