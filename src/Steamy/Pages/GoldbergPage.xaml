<Page x:Class="Steamy.Pages.GoldbergPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Steamy.ViewModels"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis" />
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
      <Setter Property="Margin" Value="0,20,0,8"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="KeyText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
      <Setter Property="Width" Value="64"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <!-- Selectable mode card -->
    <Style x:Key="ModeCard" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Card" CornerRadius="10" Padding="14,12" BorderThickness="1.5"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="OptionCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="ToggleRow" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="ToggleTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="ToggleHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,1,56,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    </Style>
  </Page.Resources>

  <Grid Margin="36,28,36,24">

    <!-- ═══════════ Left ═══════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
      <StackPanel MaxWidth="760">

        <!-- Header -->
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Goldberg" Style="{StaticResource PageTitleStyle}"/>
          <Border Margin="14,2,0,0" Padding="10,4" CornerRadius="8" VerticalAlignment="Center">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsEmuInstalled}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock FontSize="11" FontWeight="SemiBold">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding EmuVersion}"/>
                  <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEmuInstalled}" Value="False">
                      <Setter Property="Text" Value="Not installed"/>
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
        </StackPanel>
        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Steam emulator (gbe_fork by Detanup01). Downloaded and kept up to date from GitHub automatically — pick a game, choose a mode, Apply."/>

        <!-- Busy -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
          <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding BusyText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Defender blocked -->
        <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="10"
                Background="{DynamicResource WarningSoftBrush}"
                Visibility="{Binding DefenderBlocked, Converter={StaticResource BoolVis}}">
          <StackPanel>
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}">
              <Run FontWeight="SemiBold" Text="Windows Defender blocked the emulator."/>
              <Run Text="Emulator DLLs are often flagged as unwanted software. Add an exclusion for the folder below in Windows Security, then retry."/>
            </TextBlock>
            <TextBlock Text="{Binding EmuFolder}" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <ui:Button Content="Retry" Command="{Binding InstallEmuCommand}" Appearance="Primary" Height="30" FontSize="12"/>
              <ui:Button Content="Open folder" Command="{Binding OpenEmuFolderCommand}" Appearance="Secondary"
                         Height="30" FontSize="12" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Game -->
        <TextBlock Text="GAME" Style="{StaticResource SectionLabel}"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ui:TextBox Text="{Binding GameFolder, UpdateSourceTrigger=PropertyChanged, Delay=600}"
                      PlaceholderText="Game folder…" FontSize="12.5" Padding="12,9"/>
          <ui:Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseGameCommand}"
                     Appearance="Secondary" Margin="6,0,0,0" Height="40" FontSize="12" Padding="14,0"/>
        </Grid>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="AppID" Style="{StaticResource FieldLabel}" Width="72"/>
          <ui:TextBox Grid.Column="1" Text="{Binding AppId, UpdateSourceTrigger=PropertyChanged}"
                      FontFamily="Consolas" FontSize="12.5" Padding="10,7"/>
          <TextBlock Grid.Column="2" Text="{Binding GameName}" Margin="12,0,0,0" FontSize="13"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- Mode -->
        <TextBlock Text="MODE" Style="{StaticResource SectionLabel}"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <RadioButton Style="{StaticResource ModeCard}" GroupName="GbeMode" IsChecked="{Binding UseNormalMode}">
            <StackPanel>
              <TextBlock Text="Normal" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock Text="Replaces steam_api(64).dll. Start the game as usual." FontSize="11.5" TextWrapping="Wrap"
                         Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Grid.Column="2" Style="{StaticResource ModeCard}" GroupName="GbeMode" IsChecked="{Binding ColdClientSelected}">
            <StackPanel>
              <TextBlock Text="ColdClient loader" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock Text="Keeps original files. Start via the loader — best for protected games." FontSize="11.5"
                         TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
          </RadioButton>
        </Grid>
        <Grid Margin="0,8,0,0" Visibility="{Binding UseColdClient, Converter={StaticResource BoolVis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Game exe" Style="{StaticResource FieldLabel}" Width="72"/>
          <ui:TextBox Grid.Column="1" Text="{Binding ExePath, UpdateSourceTrigger=LostFocus}"
                      PlaceholderText="Main game .exe" FontSize="12" Padding="10,7"/>
          <ui:Button Grid.Column="2" Content="…" Command="{Binding BrowseExeCommand}"
                     Appearance="Secondary" Margin="6,0,0,0" Height="34" Width="40" Padding="0"/>
        </Grid>
        <Grid Margin="0,8,0,0" Visibility="{Binding UseColdClient, Converter={StaticResource BoolVis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Arguments" Style="{StaticResource FieldLabel}" Width="72"/>
          <ui:TextBox Grid.Column="1" Text="{Binding LaunchArgs, UpdateSourceTrigger=LostFocus}"
                      PlaceholderText="optional launch parameters, e.g. -dx11 -windowed" FontSize="12" Padding="10,7"/>
        </Grid>

        <!-- Options -->
        <TextBlock Text="ACCOUNT" Style="{StaticResource SectionLabel}"/>
        <Border Style="{StaticResource OptionCard}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="10"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Width="72"/>
            <ui:TextBox Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="10,7"/>
            <TextBlock Grid.Column="3" Text="Language" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="4" ItemsSource="{x:Static vm:GoldbergViewModel.Languages}"
                      SelectedItem="{Binding Language}" FontSize="12"/>
            <TextBlock Grid.Row="2" Text="Steam ID" Style="{StaticResource FieldLabel}" Width="72"/>
            <ui:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SteamId, UpdateSourceTrigger=LostFocus}"
                        PlaceholderText="optional — 7656119…" FontFamily="Consolas" FontSize="12" Padding="10,7"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Text="Country" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
            <ui:TextBox Grid.Row="2" Grid.Column="4" Text="{Binding Country, UpdateSourceTrigger=LostFocus}"
                        MaxLength="2" FontSize="12" Padding="10,7"/>
          </Grid>
        </Border>

        <TextBlock Text="GAME" Style="{StaticResource SectionLabel}"/>
        <Border Style="{StaticResource OptionCard}">
          <StackPanel>
            <Grid Style="{StaticResource ToggleRow}">
              <StackPanel>
                <TextBlock Text="Unlock all DLCs" Style="{StaticResource ToggleTitle}"/>
                <TextBlock Text="Report every DLC as owned" Style="{StaticResource ToggleHint}"/>
              </StackPanel>
              <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding UnlockAllDlc}"/>
            </Grid>
            <Grid Style="{StaticResource ToggleRow}">
              <StackPanel>
                <TextBlock Text="Portable saves" Style="{StaticResource ToggleTitle}"/>
                <TextBlock Text="Keep saves in the game folder (GSE Saves) instead of %AppData%" Style="{StaticResource ToggleHint}"/>
              </StackPanel>
              <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding PortableSaves}"/>
            </Grid>
            <Grid Style="{StaticResource ToggleRow}">
              <StackPanel>
                <TextBlock Text="Offline mode" Style="{StaticResource ToggleTitle}"/>
                <TextBlock Text="Pretend Steam is offline — helps games that try to reach online services" Style="{StaticResource ToggleHint}"/>
              </StackPanel>
              <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Offline}"/>
            </Grid>
            <Grid Style="{StaticResource ToggleRow}">
              <StackPanel>
                <TextBlock Text="LAN only" Style="{StaticResource ToggleTitle}"/>
                <TextBlock Text="Block the game's internet connections (analytics etc.), LAN play still works" Style="{StaticResource ToggleHint}"/>
              </StackPanel>
              <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding LanOnly}"/>
            </Grid>
            <Grid Style="{StaticResource ToggleRow}">
              <StackPanel>
                <TextBlock Text="Disable networking" Style="{StaticResource ToggleTitle}"/>
                <TextBlock Text="No emulator networking at all (no LAN multiplayer)" Style="{StaticResource ToggleHint}"/>
              </StackPanel>
              <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding DisableNetworking}"/>
            </Grid>
            <Grid Style="{StaticResource ToggleRow}" Margin="0">
              <StackPanel>
                <TextBlock Text="Record playtime" Style="{StaticResource ToggleTitle}"/>
                <TextBlock Text="Track how long you play each game" Style="{StaticResource ToggleHint}"/>
              </StackPanel>
              <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding RecordPlaytime}"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="OVERLAY &amp; ACHIEVEMENTS" Style="{StaticResource SectionLabel}"/>
        <Border Style="{StaticResource OptionCard}">
          <StackPanel>
            <Grid Style="{StaticResource ToggleRow}">
              <StackPanel>
                <TextBlock Text="In-game overlay" Style="{StaticResource ToggleTitle}"/>
                <TextBlock Text="Steam-like overlay with achievement list (experimental build)" Style="{StaticResource ToggleHint}"/>
              </StackPanel>
              <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding OverlayEnabled}"/>
            </Grid>
            <StackPanel Visibility="{Binding OverlayEnabled, Converter={StaticResource BoolVis}}">
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Hotkey" Style="{StaticResource FieldLabel}" Width="72"/>
                <ui:TextBox Grid.Column="1" Text="{Binding OverlayHotkey, UpdateSourceTrigger=LostFocus}"
                            FontFamily="Consolas" FontSize="12" Padding="10,7"/>
                <TextBlock Grid.Column="3" Text="Popups" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="4" ItemsSource="{x:Static vm:GoldbergViewModel.NotificationPositions}"
                          SelectedItem="{Binding NotificationPosition}" FontSize="12"/>
              </Grid>
              <Grid Style="{StaticResource ToggleRow}">
                <TextBlock Text="Achievement popups" Style="{StaticResource ToggleTitle}" VerticalAlignment="Center"/>
                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding AchievementPopups}"/>
              </Grid>
              <Grid Style="{StaticResource ToggleRow}">
                <TextBlock Text="Show FPS" Style="{StaticResource ToggleTitle}" VerticalAlignment="Center"/>
                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding ShowFps}"/>
              </Grid>
              <Grid Style="{StaticResource ToggleRow}">
                <TextBlock Text="Screenshots (F12)" Style="{StaticResource ToggleTitle}" VerticalAlignment="Center"/>
                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Screenshots}"/>
              </Grid>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,12"/>
            <Grid Style="{StaticResource ToggleRow}">
              <StackPanel>
                <TextBlock Text="Achievement list" Style="{StaticResource ToggleTitle}"/>
                <TextBlock Text="Names + icons from Steam (needs a free Steam Web API key)" Style="{StaticResource ToggleHint}"/>
              </StackPanel>
              <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding AchievementsEnabled}"/>
            </Grid>
            <ui:PasswordBox FontSize="12" Padding="10,7"
                            Password="{Binding WebApiKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            PlaceholderText="Steam Web API key (steamcommunity.com/dev/apikey) — stored encrypted"
                            Visibility="{Binding AchievementsEnabled, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ui:Button Content="Apply Goldberg" Command="{Binding ApplyCommand}"
                     Appearance="Primary" Height="46" FontSize="14" FontWeight="SemiBold"
                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          <ui:Button Grid.Column="1" ToolTip="Launch via ColdClientLoader" Command="{Binding LaunchCommand}"
                     Appearance="Secondary" Height="46" Width="46" Margin="6,0,0,0" Padding="0"
                     HorizontalContentAlignment="Center"
                     Visibility="{Binding UseColdClient, Converter={StaticResource BoolVis}}">
            <ui:SymbolIcon Symbol="Play24" FontSize="18"/>
          </ui:Button>
          <ui:Button Grid.Column="2" ToolTip="Open game folder" Command="{Binding OpenGameFolderCommand}"
                     Appearance="Secondary" Height="46" Width="46" Margin="4,0,0,0" Padding="0"
                     HorizontalContentAlignment="Center">
            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="18"/>
          </ui:Button>
        </Grid>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ui:Button Grid.Column="1" Content="Update emulator" Command="{Binding InstallEmuCommand}"
                     Appearance="Secondary" Height="28" FontSize="10.5" Padding="10,2"/>
          <ui:Button Grid.Column="2" Content="Restore original" Command="{Binding RestoreCommand}"
                     ToolTip="Remove Goldberg from this game and restore the original files"
                     Appearance="Danger" Height="28" FontSize="10.5" Padding="10,2" Margin="4,0,0,0"/>
        </Grid>
        <!-- Last action -->
        <TextBlock Text="{Binding ActionStatus}" FontSize="11.5" Margin="2,14,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextTertiaryBrush}"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
