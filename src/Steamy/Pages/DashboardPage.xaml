<Page x:Class="Steamy.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Borderless surface: depth comes from the fill, not from outlines -->
    <Style x:Key="SoftPanel" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Padding" Value="22" />
    </Style>

    <Style x:Key="PanelTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Margin" Value="0,18" />
    </Style>

    <!-- Plain clickable content (cover cards) -->
    <Style x:Key="DashPlainButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Quick action tile: tinted fill, lifts slightly on hover -->
    <Style x:Key="QuickTile" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Height" Value="128" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
              <Border CornerRadius="22" Background="{TemplateBinding Background}" />
              <Border x:Name="Shine" CornerRadius="22" Background="#FFFFFF" Opacity="0" />
              <ContentPresenter Margin="20,18" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shine" Property="Opacity" Value="0.045" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.16" />
                      <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.16" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                      <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shine" Property="Opacity" Value="0.02" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- List row that only shows a fill on hover -->
    <Style x:Key="RowButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="14" Padding="12,11" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TileIcon" TargetType="Border">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="CornerRadius" Value="23" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="TileTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="TileSubtitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <LinearGradientBrush x:Key="TileBlue" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#303B82F6" Offset="0" />
      <GradientStop Color="#0D3B82F6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TileGreen" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2B22C55E" Offset="0" />
      <GradientStop Color="#0B22C55E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TilePurple" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#30A855F7" Offset="0" />
      <GradientStop Color="#0DA855F7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TileAmber" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2DF59E0B" Offset="0" />
      <GradientStop Color="#0CF59E0B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroShade" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#F20E0F12" Offset="0" />
      <GradientStop Color="#B00E0F12" Offset="0.45" />
      <GradientStop Color="#100E0F12" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBottomShade" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#000E0F12" Offset="0.4" />
      <GradientStop Color="#B00E0F12" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WelcomeGlow" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#343B82F6" Offset="0" />
      <GradientStop Color="#18A855F7" Offset="0.55" />
      <GradientStop Color="#00A855F7" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style x:Key="StatIcon" TargetType="Border">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusDot" TargetType="Ellipse">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOk}" Value="True">
          <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StatusAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Appearance" Value="Secondary" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOk}" Value="False">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StorageBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
      <Setter Property="Height" Value="6" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsStorageLow}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="HeroButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </Page.Resources>

  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" Padding="34,28,34,48">
    <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

      <!-- Greeting + search -->
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Greeting}" FontSize="30" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:ProgressRing Width="18" Height="18" Margin="0,0,12,0" IsIndeterminate="True"
                           Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
          <ui:TextBox x:Name="DashboardSearch"
                      Width="300"
                      PlaceholderText="Search games…"
                      Icon="{ui:SymbolIcon Search24}"
                      VerticalAlignment="Center"
                      KeyDown="DashboardSearch_KeyDown" />
          <ui:Button Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0" Appearance="Transparent"
                     Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}"
                     ToolTip="Rescan library and re-check tools" />
        </StackPanel>
      </Grid>

      <!-- Stats: plain numbers, no boxes -->
      <WrapPanel Margin="0,0,0,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,40,0">
          <Border Style="{StaticResource StatIcon}" Background="#1F3B82F6">
            <ui:SymbolIcon Symbol="Games24" FontSize="17" Foreground="#6FA0F8" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding InstalledCount}" Style="{StaticResource StatValue}" />
            <TextBlock Text="Games" Style="{StaticResource StatLabel}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,40,0">
          <Border Style="{StaticResource StatIcon}" Background="#1F22C55E">
            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="17" Foreground="#5FD08A" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding ActiveDownloadCount}" Style="{StaticResource StatValue}" />
            <TextBlock Text="Downloading" Style="{StaticResource StatLabel}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,40,0">
          <Border Style="{StaticResource StatIcon}" Background="#1FA855F7">
            <ui:SymbolIcon Symbol="TopSpeed24" FontSize="17" Foreground="#C08BFA" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentSpeed}" Style="{StaticResource StatValue}" />
            <TextBlock Text="Speed" Style="{StaticResource StatLabel}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Style="{StaticResource StatIcon}" Background="#1FF59E0B">
            <ui:SymbolIcon Symbol="Storage24" FontSize="17" Foreground="#F5B544" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding StorageFree}" Style="{StaticResource StatValue}" />
            <TextBlock Text="Free space" Style="{StaticResource StatLabel}" />
          </StackPanel>
        </StackPanel>
      </WrapPanel>

      <!-- Hero: running download, else most recently updated game, else first-run welcome -->
      <Grid Height="250" Margin="0,0,0,28">
        <Border CornerRadius="26" Background="{DynamicResource SurfaceElevatedBrush}" />
        <Border CornerRadius="26" Visibility="{Binding HasHeroArt, Converter={StaticResource BoolToVis}}">
          <Border.Background>
            <ImageBrush ImageSource="{Binding HeroImage}" Stretch="UniformToFill" />
          </Border.Background>
        </Border>
        <Border CornerRadius="26" Background="{StaticResource HeroShade}"
                Visibility="{Binding HasHeroArt, Converter={StaticResource BoolToVis}}" />
        <Border CornerRadius="26" Background="{StaticResource HeroBottomShade}"
                Visibility="{Binding HasHeroArt, Converter={StaticResource BoolToVis}}" />

        <!-- Download in progress -->
        <StackPanel DataContext="{Binding HeroDownload}" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Width="580" Margin="34,0,34,28"
                    Visibility="{Binding DataContext.ShowDownloadHero, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
          <Border Style="{StaticResource StatePill}" HorizontalAlignment="Left">
            <TextBlock Text="{Binding StateLabel}" Style="{StaticResource StatePillText}" />
          </Border>
          <TextBlock Text="{Binding GameName}" FontSize="30" FontWeight="SemiBold" Foreground="White"
                     Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:SmoothProgressBar Style="{StaticResource JobProgressBar}" Height="6" Minimum="0" Maximum="100"
                                        SmoothValue="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" Foreground="White" FontWeight="SemiBold" FontSize="14"
                       Typography.NumeralAlignment="Tabular" Margin="14,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <ui:Button Style="{StaticResource PauseButton}" Margin="0,0,8,0" Appearance="Primary" Content="Pause" CornerRadius="12"
                       Icon="{ui:SymbolIcon Pause24}" CommandParameter="{Binding}"
                       Command="{Binding DataContext.DownloadActions.PauseCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
            <ui:Button Style="{StaticResource ResumeButton}" Margin="0,0,8,0" Appearance="Primary" Content="Resume" CornerRadius="12"
                       Icon="{ui:SymbolIcon Play24}" CommandParameter="{Binding}"
                       Command="{Binding DataContext.DownloadActions.ResumeCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
            <ui:Button Style="{StaticResource StartButton}" Margin="0,0,8,0" Appearance="Primary" Content="Start" CornerRadius="12"
                       Icon="{ui:SymbolIcon Play24}" CommandParameter="{Binding}"
                       Command="{Binding DataContext.DownloadActions.StartCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
            <ui:Button Style="{StaticResource HeroButton}" Content="Downloads" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowDownload24}"
                       Command="{Binding DataContext.NavigateDownloadsCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
          </StackPanel>
        </StackPanel>

        <!-- Most recently updated game -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="640" Margin="34,0,34,28"
                    Visibility="{Binding ShowGameHero, Converter={StaticResource BoolToVis}}">
          <Border Background="#30FFFFFF" CornerRadius="10" Padding="10,4" HorizontalAlignment="Left">
            <TextBlock Text="RECENTLY UPDATED" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
          </Border>
          <TextBlock Text="{Binding HeroGame.Name}" FontSize="32" FontWeight="SemiBold" Foreground="White"
                     Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding HeroGameDetail}" Foreground="#D0D4DE" FontSize="13" Margin="0,4,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <ui:Button Style="{StaticResource HeroButton}" Content="Play" Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                       Command="{Binding PlayGameCommand}" CommandParameter="{Binding HeroGame}" />
            <ui:Button Style="{StaticResource HeroButton}" Content="Open folder" Appearance="Secondary" Icon="{ui:SymbolIcon FolderOpen24}"
                       Command="{Binding OpenGameFolderCommand}" CommandParameter="{Binding HeroGame}" />
            <ui:Button Style="{StaticResource HeroButton}" Content="Library" Appearance="Secondary" Icon="{ui:SymbolIcon Library24}"
                       Command="{Binding NavigateLibraryCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- First run: nothing found yet -->
        <Grid Visibility="{Binding ShowWelcomeHero, Converter={StaticResource BoolToVis}}">
          <Border CornerRadius="26" Background="{StaticResource WelcomeGlow}" />
          <ui:SymbolIcon Symbol="Games24" FontSize="200" Opacity="0.07" Foreground="{DynamicResource TextPrimaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,64,0" />
          <StackPanel VerticalAlignment="Center" Margin="38,0,38,0" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Welcome to Steamy" FontSize="32" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Point the app at your Steam folder to see your games here, then set up DepotDownloader and your fixes source." />
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
              <ui:Button Style="{StaticResource HeroButton}" Content="Open Settings" Appearance="Primary" Icon="{ui:SymbolIcon Settings24}"
                         Command="{Binding NavigateSettingsCommand}" />
              <ui:Button Style="{StaticResource HeroButton}" Content="Browse games" Appearance="Secondary" Icon="{ui:SymbolIcon Apps24}"
                         Command="{Binding NavigateLibraryCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- Quick actions -->
      <TextBlock Text="Quick actions" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
      <UniformGrid Columns="4" Margin="-6,0,-6,26">
        <Button Style="{StaticResource QuickTile}" Background="{StaticResource TileBlue}" Command="{Binding NavigateDepotDownloaderCommand}">
          <Grid>
            <Border Style="{StaticResource TileIcon}" Background="#2E3B82F6" VerticalAlignment="Top">
              <ui:SymbolIcon Symbol="CloudArrowDown24" FontSize="22" Foreground="#6FA0F8" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" />
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock Text="Download" Style="{StaticResource TileTitle}" />
              <TextBlock Text="Depot downloader" Style="{StaticResource TileSubtitle}" />
            </StackPanel>
          </Grid>
        </Button>

        <Button Style="{StaticResource QuickTile}" Background="{StaticResource TileGreen}" Command="{Binding NavigateFixesCommand}">
          <Grid>
            <Border Style="{StaticResource TileIcon}" Background="#2E22C55E" VerticalAlignment="Top">
              <ui:SymbolIcon Symbol="ShieldTask24" FontSize="22" Foreground="#5FD08A" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" />
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock Text="Game Fixes" Style="{StaticResource TileTitle}" />
              <TextBlock Text="Apply fixes" Style="{StaticResource TileSubtitle}" />
            </StackPanel>
          </Grid>
        </Button>

        <Button Style="{StaticResource QuickTile}" Background="{StaticResource TilePurple}" Command="{Binding NavigateDlcUnlockerCommand}">
          <Grid>
            <Border Style="{StaticResource TileIcon}" Background="#2EA855F7" VerticalAlignment="Top">
              <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="22" Foreground="#C08BFA" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" />
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock Text="DLC Unlocker" Style="{StaticResource TileTitle}" />
              <TextBlock Text="Unlock all DLCs" Style="{StaticResource TileSubtitle}" />
            </StackPanel>
          </Grid>
        </Button>

        <Button Style="{StaticResource QuickTile}" Background="{StaticResource TileAmber}" Command="{Binding NavigateSteamlessCommand}">
          <Grid>
            <Border Style="{StaticResource TileIcon}" Background="#2EF59E0B" VerticalAlignment="Top">
              <ui:SymbolIcon Symbol="Wrench24" FontSize="22" Foreground="#F5B544" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" />
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock Text="Steamless" Style="{StaticResource TileTitle}" />
              <TextBlock Text="Unpack EXE" Style="{StaticResource TileSubtitle}" />
            </StackPanel>
          </Grid>
        </Button>
      </UniformGrid>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.75*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" MinWidth="310" />
        </Grid.ColumnDefinitions>

        <!-- Your games -->
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Your games" Style="{StaticResource SectionHeading}" />
            <ui:Button Grid.Column="1" Content="View all" Appearance="Transparent" BorderThickness="0"
                       Command="{Binding NavigateLibraryCommand}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding RecentGames}" Margin="-7,0,-7,0"
                        Visibility="{Binding HasRecentGames, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource DashPlainButton}" Margin="7" Tag="{Binding}" Click="GameCover_Click" ToolTip="{Binding Name}">
                  <Grid Height="270">
                    <Border CornerRadius="20" Background="{Binding CoverColor}" />
                    <TextBlock Text="{Binding CoverGlyph}" FontSize="56" Foreground="#35FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsArtworkFallback, Converter={StaticResource BoolToVis}}" />
                    <Border CornerRadius="20">
                      <Border.Background>
                        <ImageBrush ImageSource="{Binding ArtworkImage}" Stretch="UniformToFill" />
                      </Border.Background>
                    </Border>
                    <Border CornerRadius="0,0,20,20" Height="140" VerticalAlignment="Bottom" Background="{StaticResource CoverFadeBrush}" />
                    <Border Background="#CC0E0F12" CornerRadius="9" Padding="8,3" Margin="12"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="{Binding UpdateRequired, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="Update" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,16">
                      <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Size}" FontSize="11" Foreground="#C7CBD8" Margin="0,4,0,0" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Style="{StaticResource SoftPanel}" Padding="36,40"
                  Visibility="{Binding ShowNoGames, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" MaxWidth="440">
              <Border Width="64" Height="64" CornerRadius="32" Background="#1F3B82F6" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Games24" FontSize="28" Foreground="#6FA0F8" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="No installed games found" FontSize="17" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" />
              <TextBlock Text="{Binding NoGamesDetail}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"
                         TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <ui:Button Style="{StaticResource HeroButton}" Content="Set Steam folder" Appearance="Primary" Command="{Binding NavigateSettingsCommand}" />
                <ui:Button Style="{StaticResource HeroButton}" Content="Browse games" Appearance="Secondary" Margin="0" Command="{Binding NavigateLibraryCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- One calm side panel: downloads, storage, setup -->
        <StackPanel Grid.Column="2" Margin="0,46,0,0">
          <Border Style="{StaticResource SoftPanel}">
            <StackPanel>
              <!-- Downloads -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Downloads" Style="{StaticResource PanelTitle}" />
                <Border Grid.Column="1" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" Background="{DynamicResource SurfaceSubtleBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding JobCountLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
                <ui:Button Grid.Column="2" Content="Open" Appearance="Transparent" BorderThickness="0" Command="{Binding NavigateDownloadsCommand}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding ActiveJobs}" Margin="0,14,0,0"
                            Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,16">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Grid Width="40" Height="56" VerticalAlignment="Top">
                        <Border CornerRadius="10" Background="{Binding CoverColor}">
                          <TextBlock Text="{Binding CoverGlyph}" FontSize="15" Foreground="#AAFFFFFF"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="10">
                          <Border.Background>
                            <ImageBrush ImageSource="{Binding PortraitArtUrl}" Stretch="UniformToFill" />
                          </Border.Background>
                        </Border>
                      </Grid>
                      <StackPanel Grid.Column="1" Margin="14,2,0,0">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding GameName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Typography.NumeralAlignment="Tabular" />
                        </Grid>
                        <controls:SmoothProgressBar Style="{StaticResource JobProgressBar}" Height="5" Minimum="0" Maximum="100"
                                                    SmoothValue="{Binding Progress, Mode=OneWay}" Margin="0,9,0,7" />
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" />
                          <TextBlock Grid.Column="1" Text="{Binding Speed}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"
                                     Typography.NumeralAlignment="Tabular" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowNoJobs, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Nothing downloading right now." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
                <ui:Button Content="New download" Appearance="Secondary" Icon="{ui:SymbolIcon CloudArrowDown24}" CornerRadius="12"
                           HorizontalAlignment="Stretch" Margin="0,12,0,0" Command="{Binding NavigateDepotDownloaderCommand}" />
              </StackPanel>

              <Border Style="{StaticResource Divider}" />

              <!-- Storage -->
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Storage" Style="{StaticResource PanelTitle}" />
                <TextBlock Grid.Column="1" Text="{Binding StorageFree}" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              </Grid>
              <ProgressBar Style="{StaticResource StorageBar}" Margin="0,12,0,0"
                           Value="{Binding StorageUsedPercent, Mode=OneWay}" />
              <TextBlock Text="{Binding StorageSummary}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5" Margin="0,8,0,0" />

              <Border Style="{StaticResource Divider}" />

              <!-- Setup -->
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Setup" Style="{StaticResource PanelTitle}" />
                <TextBlock Grid.Column="1" Text="{Binding StatusSummary}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5"
                           VerticalAlignment="Center" />
              </Grid>
              <ItemsControl ItemsSource="{Binding StatusItems}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Top" Margin="0,6,12,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                      </StackPanel>
                      <ui:Button Grid.Column="2" Style="{StaticResource StatusAction}" Margin="10,0,0,0"
                                 Content="{Binding ActionLabel}" Command="{Binding Action}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- More tools -->
          <Border Style="{StaticResource SoftPanel}" Padding="10" Margin="0,16,0,0">
            <StackPanel>
              <Button Style="{StaticResource RowButton}" Command="{Binding NavigateDenuvoActivationCommand}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="17" Background="#1FF59E0B">
                    <ui:SymbolIcon Symbol="Key24" FontSize="16" Foreground="#F5B544" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="Denuvo Activation" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                             Margin="12,0,0,0" VerticalAlignment="Center" />
                  <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button Style="{StaticResource RowButton}" Command="{Binding NavigateSettingsCommand}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource SurfaceSubtleBrush}">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="Settings" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                             Margin="12,0,0,0" VerticalAlignment="Center" />
                  <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Page>
