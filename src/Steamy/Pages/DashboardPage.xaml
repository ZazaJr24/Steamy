<Page x:Class="Steamy.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      ScrollViewer.CanContentScroll="False"
      UseLayoutRounding="True" SnapsToDevicePixels="True"
      Background="{DynamicResource WorkspaceBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="CoverCardButton" TargetType="Button">
      <Setter Property="controls:CardMotion.IsEnabled" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Grid x:Name="MotionSurface">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <Border x:Name="Ring" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12" Opacity="0" IsHitTestVisible="False" />
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <ScrollViewer x:Name="DashboardScroll" Style="{StaticResource DashboardScrollHostStyle}" Padding="28,22,28,30">
    <StackPanel MaxWidth="1440" RequestBringIntoView="Dashboard_RequestBringIntoView">
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Discover" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
        <ui:TextBox x:Name="DashboardSearch" Grid.Column="1" Width="340" Height="38"
                    Visibility="{Binding DashboardSearchEnabled, Converter={StaticResource BoolToVis}}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Search games or App ID" Icon="{ui:SymbolIcon Search24}"
                    KeyDown="DashboardSearch_KeyDown" GotKeyboardFocus="DashboardSearch_GotKeyboardFocus" LostKeyboardFocus="DashboardSearch_LostKeyboardFocus"
                    ToolTip="Type to search. Enter opens Games; Escape clears the search." />
        <ui:Button Grid.Column="2" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowSync24}" Margin="8,0,0,0"
                   Command="{Binding RefreshCommand}" ToolTip="Refresh spotlight" AutomationProperties.Name="Refresh spotlight" />
      </Grid>

      <Border x:Name="DashboardSearchPanel" CornerRadius="14" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" Padding="12" Margin="0,0,0,24"
              Visibility="{Binding ShowSearchPanel, Converter={StaticResource BoolToVis}}" LostKeyboardFocus="DashboardSearch_LostKeyboardFocus">
        <StackPanel>
          <TextBlock Text="{Binding SearchStatus}" Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="8,2,0,8" AutomationProperties.LiveSetting="Polite" />
          <ItemsControl x:Name="SearchMatches" ItemsSource="{Binding SearchMatches}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,7"
                         CommandParameter="{Binding Item}" Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="70" Height="35" CornerRadius="6" Background="{DynamicResource SurfaceElevatedBrush}" Margin="0,0,12,0">
                    <Border CornerRadius="6"><Border.Background><ImageBrush ImageSource="{Binding Game.HeaderImage}" Stretch="UniformToFill" /></Border.Background></Border>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
              </ui:Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Visibility="{Binding HasActivityNotice, Converter={StaticResource BoolToVis}}" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,18">
        <TextBlock Text="{Binding ActivityNotice}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
      </Border>

      <Border x:Name="DashboardHero" Height="420" CornerRadius="24" Background="{DynamicResource SolidSurfaceBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,28"
              Visibility="{Binding HasSpotlight, Converter={StaticResource BoolToVis}}" DataContext="{Binding FeaturedGame}">
        <Grid>
          <Border x:Name="SpotlightArtworkFrame" Height="418" CornerRadius="23" RenderOptions.BitmapScalingMode="HighQuality">
            <Image Source="{Binding HeroArtwork}" Stretch="UniformToFill" StretchDirection="DownOnly" RenderTransformOrigin="0.5,0.5">
              <Image.RenderTransform><ScaleTransform x:Name="ArtworkZoom" /></Image.RenderTransform>
            </Image>
          </Border>
          <Border CornerRadius="23" IsHitTestVisible="False">
            <Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <GradientStop Color="#A6090D15" Offset="0" /><GradientStop Color="#50090D15" Offset="0.45" /><GradientStop Color="#00090D15" Offset="0.82" />
            </LinearGradientBrush></Border.Background>
          </Border>
          <Border CornerRadius="23" IsHitTestVisible="False">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#00090D15" Offset="0.2" /><GradientStop Color="#50090D15" Offset="0.57" /><GradientStop Color="#ED090D15" Offset="1" />
            </LinearGradientBrush></Border.Background>
          </Border>
          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26" CornerRadius="20" Padding="12,7" Background="#990B1422" BorderBrush="#4078B5FF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="5" Height="5" Fill="#8AC4FF" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="SPOTLIGHT" FontSize="10" FontWeight="SemiBold" Foreground="#D7EBFF" />
            </StackPanel>
          </Border>
          <ItemsControl x:Name="SpotlightPreviews" ItemsSource="{Binding DataContext.SpotlightPreviews, RelativeSource={RelativeSource AncestorType=Page}}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,74,24,0" Width="106">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Button Style="{StaticResource CoverCardButton}" Height="52" Margin="0,0,0,8" ToolTip="{Binding Game.Name}"
                      Command="{Binding DataContext.SelectFeaturedCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                <Border CornerRadius="8" BorderThickness="2" Padding="2" Background="#C00B1422">
                  <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#39475A" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="#79B5FF" /></DataTrigger></Style.Triggers>
                  </Style></Border.Style>
                  <Border CornerRadius="5"><Border.Background><ImageBrush ImageSource="{Binding Game.HeaderImage}" Stretch="UniformToFill" /></Border.Background></Border>
                </Border>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid x:Name="SpotlightFooter" VerticalAlignment="Bottom" Margin="26,26">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="SpotlightDetails" Grid.ColumnSpan="2" HorizontalAlignment="Left" MaxWidth="720">
              <TextBlock x:Name="SpotlightTitle" Text="{Binding Game.Name}" FontSize="46" FontWeight="Bold" Foreground="#F6F8FC" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="116" ToolTip="{Binding Game.Name}" />
              <TextBlock Text="{Binding Publisher}" Foreground="#A4B9D5" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
              <TextBlock Foreground="#B9C9DF" FontSize="11" Margin="0,12,0,0" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding ReleaseStatus, Mode=OneWay}" /><Run Text="  /  " /><Run Text="{Binding ReleaseLabel, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="{Binding Description}" Foreground="#CAD6E6" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                         Height="40" LineHeight="20" LineStackingStrategy="BlockLineHeight" Margin="0,12,0,0" />
            </StackPanel>
            <StackPanel x:Name="SpotlightActions" Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Left"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
              <Border x:Name="SpotlightCountdown" CornerRadius="11" Padding="14,8" BorderBrush="#5C7EB0" BorderThickness="1" Margin="0,0,10,0" MinWidth="118"
                      ToolTip="Steam release countdown. The date does not confirm download availability.">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#D11D3D64" Offset="0" /><GradientStop Color="#DA0D192B" Offset="1" /></LinearGradientBrush></Border.Background>
                <StackPanel><TextBlock Text="RELEASE COUNTDOWN" Foreground="#99BCE9" FontSize="8.5" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding FeaturedGame.Countdown}" Foreground="#F4F8FF" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <ui:Button Content="{Binding FeaturedDownloadLabel}" Appearance="Primary" Background="#347FF0" Foreground="White" BorderBrush="#5798FF"
                         Icon="{ui:SymbolIcon ArrowDownload24}" Padding="14,10" Height="52" VerticalAlignment="Center" Command="{Binding DownloadFeaturedCommand}"
                         ToolTip="Choose a source and check whether downloadable depots are available" />
              <ui:Button Content="View game" Icon="{ui:SymbolIcon Games24}" Foreground="#E2ECFA" Background="#600C1726" BorderBrush="#354D6E" BorderThickness="1"
                         Appearance="Transparent" Padding="12,10" Height="52" VerticalAlignment="Center" Margin="10,0,0,0" Command="{Binding ViewFeaturedCommand}" />
            </StackPanel>
            <StackPanel x:Name="SpotlightPaging" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="18,0,0,0"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
              <ui:Button Content="{Binding SpotlightPlaybackLabel}" Command="{Binding ToggleSpotlightCommand}" Appearance="Transparent" Foreground="#E2ECFA" Padding="8" Margin="0,0,8,0" AutomationProperties.Name="Pause or resume spotlight" />
              <TextBlock Text="{Binding FeaturedPosition}" FontSize="11" Foreground="#AFC0D9" VerticalAlignment="Center" Margin="0,0,12,0" />
              <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" Foreground="#E2ECFA" Background="#600B1422" Appearance="Transparent" Width="38" Height="38" Padding="8" Command="{Binding PreviousFeaturedCommand}" ToolTip="Previous spotlight" AutomationProperties.Name="Previous spotlight" />
              <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" Foreground="#E2ECFA" Background="#600B1422" Appearance="Transparent" Width="38" Height="38" Padding="8" Margin="6,0,0,0" Command="{Binding NextFeaturedCommand}" ToolTip="Next spotlight" AutomationProperties.Name="Next spotlight" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <StackPanel Margin="0,0,0,26" Visibility="{Binding HasSpotlight, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="Upcoming releases" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding NewGames}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:AdaptiveGridPanel MinItemWidth="185" MaxColumns="3" Spacing="22" CoverRatio="0.50" FooterHeight="48" MaxRows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Style="{StaticResource CoverCardButton}" ToolTip="{Binding Game.Name}" CommandParameter="{Binding}"
                    Command="{Binding DataContext.OpenSpotlightCommand, RelativeSource={RelativeSource AncestorType=Page}}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="48" /></Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="12" Background="{Binding Game.CoverColor}" />
                <Border Grid.Row="0" CornerRadius="12" SizeChanged="RecommendationArtwork_SizeChanged" ClipToBounds="True" RenderOptions.BitmapScalingMode="HighQuality">
                  <Image Source="{Binding Game.HeaderImage}" Stretch="UniformToFill" StretchDirection="DownOnly" />
                </Border>
                <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="7" Padding="9,5" Margin="10" Background="#EB0B1422">
                  <TextBlock Text="{Binding Countdown}" Foreground="#D5E8FF" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <StackPanel Grid.Row="1" Margin="2,9,2,0">
                  <TextBlock Text="{Binding Game.Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding ReleaseLabel}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Page>
