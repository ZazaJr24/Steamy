<Page x:Class="Steamy.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="DashIconBadge" TargetType="Border">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>

    <Style x:Key="DashIcon" TargetType="ui:SymbolIcon">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DashCardHeader" TargetType="TextBlock" BasedOn="{StaticResource CardTitleStyle}">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DashPlainButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuickAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Appearance" Value="Secondary" />
      <Setter Property="Padding" Value="18,16" />
      <Setter Property="MinHeight" Value="80" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="QuickActionIcon" TargetType="Border">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusDot" TargetType="Ellipse">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOk}" Value="True">
          <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StatusAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Appearance" Value="Secondary" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOk}" Value="False">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StorageBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
      <Setter Property="Height" Value="4" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsStorageLow}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <LinearGradientBrush x:Key="HeroShade" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#F50E0F12" Offset="0" />
      <GradientStop Color="#C00E0F12" Offset="0.45" />
      <GradientStop Color="#200E0F12" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="InlineStat" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </Page.Resources>

  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" Padding="30,26,30,44">
    <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

      <!-- Header: greeting + inline stats + search -->
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitleStyle}" Margin="0" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Border Style="{StaticResource InlineStat}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Games24" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding InstalledCount}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text=" games" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource InlineStat}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ActiveDownloadCount}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text=" active" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource InlineStat}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="TopSpeed24" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentSpeed}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource InlineStat}" Margin="0">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Storage24" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StorageFree}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text=" free" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
          <ui:ProgressRing Width="18" Height="18" Margin="0,0,12,0" IsIndeterminate="True"
                           Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
          <ui:TextBox x:Name="DashboardSearch"
                      Width="280"
                      PlaceholderText="Search games…"
                      Icon="{ui:SymbolIcon Search24}"
                      VerticalAlignment="Center"
                      KeyDown="DashboardSearch_KeyDown" />
          <ui:Button Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0" Appearance="Secondary"
                     Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}"
                     ToolTip="Rescan library and re-check tools" />
        </StackPanel>
      </Grid>

      <!-- Hero: running download, else most recently updated game, else first-run welcome -->
      <Border CornerRadius="20" Height="220" Margin="0,0,0,22"
              Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <Grid>
          <Border CornerRadius="19" Visibility="{Binding HasHeroArt, Converter={StaticResource BoolToVis}}">
            <Border.Background>
              <ImageBrush ImageSource="{Binding HeroImage}" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
          <Border CornerRadius="19" Background="{StaticResource HeroShade}"
                  Visibility="{Binding HasHeroArt, Converter={StaticResource BoolToVis}}" />

          <!-- Download in progress -->
          <StackPanel DataContext="{Binding HeroDownload}" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                      Width="560" Margin="30,0,30,22"
                      Visibility="{Binding DataContext.ShowDownloadHero, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource StatePill}" HorizontalAlignment="Left">
              <TextBlock Text="{Binding StateLabel}" Style="{StaticResource StatePillText}" />
            </Border>
            <TextBlock Text="{Binding GameName}" FontSize="26" FontWeight="SemiBold" Foreground="White"
                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ProgressBar Style="{StaticResource JobProgressBar}" Height="6" Minimum="0" Maximum="100"
                           Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" Foreground="White" FontWeight="SemiBold"
                         Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <ui:Button Style="{StaticResource PauseButton}" Margin="0,0,8,0" Appearance="Primary" Content="Pause"
                         Icon="{ui:SymbolIcon Pause24}" CommandParameter="{Binding}"
                         Command="{Binding DataContext.DownloadActions.PauseCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
              <ui:Button Style="{StaticResource ResumeButton}" Margin="0,0,8,0" Appearance="Primary" Content="Resume"
                         Icon="{ui:SymbolIcon Play24}" CommandParameter="{Binding}"
                         Command="{Binding DataContext.DownloadActions.ResumeCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
              <ui:Button Style="{StaticResource StartButton}" Margin="0,0,8,0" Appearance="Primary" Content="Start"
                         Icon="{ui:SymbolIcon Play24}" CommandParameter="{Binding}"
                         Command="{Binding DataContext.DownloadActions.StartCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
              <ui:Button Content="Downloads" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowDownload24}"
                         Command="{Binding DataContext.NavigateDownloadsCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
            </StackPanel>
          </StackPanel>

          <!-- Most recently updated game -->
          <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="620" Margin="30,0,30,22"
                      Visibility="{Binding ShowGameHero, Converter={StaticResource BoolToVis}}">
            <Border Background="#33FFFFFF" CornerRadius="12" Padding="9,4" HorizontalAlignment="Left">
              <TextBlock Text="RECENTLY UPDATED" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
            </Border>
            <TextBlock Text="{Binding HeroGame.Name}" FontSize="28" FontWeight="SemiBold" Foreground="White"
                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding HeroGameDetail}" Foreground="#D0D4DE" FontSize="13" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <ui:Button Content="Play" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Margin="0,0,8,0"
                         Command="{Binding PlayGameCommand}" CommandParameter="{Binding HeroGame}" />
              <ui:Button Content="Open folder" Appearance="Secondary" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,0"
                         Command="{Binding OpenGameFolderCommand}" CommandParameter="{Binding HeroGame}" />
              <ui:Button Content="Library" Appearance="Secondary" Icon="{ui:SymbolIcon Library24}"
                         Command="{Binding NavigateLibraryCommand}" />
            </StackPanel>
          </StackPanel>

          <!-- First run: nothing found yet -->
          <Grid Visibility="{Binding ShowWelcomeHero, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="Games24" FontSize="190" Opacity="0.06" Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,56,0" />
            <StackPanel VerticalAlignment="Center" Margin="32,0,32,0" MaxWidth="640" HorizontalAlignment="Left">
              <Border Style="{StaticResource AccentPillStyle}" HorizontalAlignment="Left">
                <TextBlock Text="GET STARTED" Style="{StaticResource AccentPillTextStyle}" FontSize="10.5" />
              </Border>
              <TextBlock Text="Welcome to Steamy" FontSize="26" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0" />
              <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="13" Margin="0,6,0,0"
                         Text="Point the app at your Steam folder to see your games here, then set up DepotDownloader and your fixes source." />
              <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <ui:Button Content="Open Settings" Appearance="Primary" Icon="{ui:SymbolIcon Settings24}" Margin="0,0,8,0"
                           Command="{Binding NavigateSettingsCommand}" />
                <ui:Button Content="Browse games" Appearance="Secondary" Icon="{ui:SymbolIcon Apps24}"
                           Command="{Binding NavigateLibraryCommand}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- Quick Actions -->
      <TextBlock Text="Quick Actions" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
      <UniformGrid Columns="4" Margin="-4,0,-4,22">
        <ui:Button Style="{StaticResource QuickAction}" Margin="4" Command="{Binding NavigateDepotDownloaderCommand}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource QuickActionIcon}" Background="#1A3B82F6">
              <ui:SymbolIcon Symbol="CloudArrowDown24" FontSize="22" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Download" Style="{StaticResource CardTitleStyle}" FontSize="13.5" />
              <TextBlock Text="Depot downloader" Style="{StaticResource TertiaryTextStyle}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </ui:Button>

        <ui:Button Style="{StaticResource QuickAction}" Margin="4" Command="{Binding NavigateFixesCommand}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource QuickActionIcon}" Background="#1A22C55E">
              <ui:SymbolIcon Symbol="ShieldTask24" FontSize="22" Foreground="#22C55E" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Game Fixes" Style="{StaticResource CardTitleStyle}" FontSize="13.5" />
              <TextBlock Text="Apply fixes" Style="{StaticResource TertiaryTextStyle}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </ui:Button>

        <ui:Button Style="{StaticResource QuickAction}" Margin="4" Command="{Binding NavigateDlcUnlockerCommand}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource QuickActionIcon}" Background="#1AA855F7">
              <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="22" Foreground="#A855F7" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="DLC Unlocker" Style="{StaticResource CardTitleStyle}" FontSize="13.5" />
              <TextBlock Text="Unlock all DLCs" Style="{StaticResource TertiaryTextStyle}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </ui:Button>

        <ui:Button Style="{StaticResource QuickAction}" Margin="4" Command="{Binding NavigateSteamlessCommand}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource QuickActionIcon}" Background="#1AF59E0B">
              <ui:SymbolIcon Symbol="Wrench24" FontSize="22" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Steamless" Style="{StaticResource CardTitleStyle}" FontSize="13.5" />
              <TextBlock Text="Unpack EXE" Style="{StaticResource TertiaryTextStyle}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </ui:Button>
      </UniformGrid>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.75*" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- Recent games -->
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Your Games" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center" />
            <ui:Button Grid.Column="1" Content="View all" Appearance="Transparent" Command="{Binding NavigateLibraryCommand}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding RecentGames}" Margin="-6,0,-6,0"
                        Visibility="{Binding HasRecentGames, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource DashPlainButton}" Margin="6" Tag="{Binding}" Click="GameCover_Click" ToolTip="{Binding Name}">
                  <Border Style="{StaticResource CoverCardStyle}" Height="260" Background="{Binding CoverColor}">
                    <Grid>
                      <TextBlock Text="{Binding CoverGlyph}" FontSize="56" Foreground="#35FFFFFF"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="{Binding IsArtworkFallback, Converter={StaticResource BoolToVis}}" />
                      <Border CornerRadius="13">
                        <Border.Background>
                          <ImageBrush ImageSource="{Binding ArtworkImage}" Stretch="UniformToFill" />
                        </Border.Background>
                      </Border>
                      <Border CornerRadius="0,0,13,13" Height="130" VerticalAlignment="Bottom" Background="{StaticResource CoverFadeBrush}" />
                      <Border Background="#CC0E0F12" CornerRadius="8" Padding="7,3" Margin="10"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Visibility="{Binding UpdateRequired, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Update" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                      </Border>
                      <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,14">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Size}" FontSize="11" Foreground="#C7CBD8" Margin="0,4,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Style="{StaticResource SubtlePanelStyle}" Padding="28" CornerRadius="16"
                  Visibility="{Binding ShowNoGames, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" MaxWidth="420">
              <Border Style="{StaticResource DashIconBadge}" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Games24" Style="{StaticResource DashIcon}" />
              </Border>
              <TextBlock Text="No installed games found" Style="{StaticResource CardTitleStyle}" FontSize="14"
                         HorizontalAlignment="Center" Margin="0,12,0,0" />
              <TextBlock Text="{Binding NoGamesDetail}" Style="{StaticResource MutedTextStyle}" FontSize="12"
                         TextAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <ui:Button Content="Set Steam folder" Appearance="Primary" Margin="0,0,8,0" Command="{Binding NavigateSettingsCommand}" />
                <ui:Button Content="Browse games" Appearance="Secondary" Command="{Binding NavigateLibraryCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Downloads and setup status -->
        <StackPanel Grid.Column="2">
          <!-- Downloads -->
          <Border Style="{StaticResource SurfaceCardStyle}" Padding="18" Margin="0,32,0,0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Downloads" Style="{StaticResource DashCardHeader}" />
                <Border Grid.Column="1" Style="{StaticResource AccentPillStyle}" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding JobCountLabel}" Style="{StaticResource AccentPillTextStyle}" />
                </Border>
                <ui:Button Grid.Column="2" Content="Open" Appearance="Transparent" Command="{Binding NavigateDownloadsCommand}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding ActiveJobs}" Margin="0,12,0,0"
                            Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,14">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Grid Width="36" Height="54" VerticalAlignment="Top">
                        <Border CornerRadius="8" Background="{Binding CoverColor}">
                          <TextBlock Text="{Binding CoverGlyph}" FontSize="15" Foreground="#AAFFFFFF"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="8">
                          <Border.Background>
                            <ImageBrush ImageSource="{Binding PortraitArtUrl}" Stretch="UniformToFill" />
                          </Border.Background>
                        </Border>
                      </Grid>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding GameName}" Style="{StaticResource CardTitleStyle}" FontSize="12.5" VerticalAlignment="Center" />
                          <Border Grid.Column="1" Style="{StaticResource StatePill}" Padding="7,2" Margin="8,0,0,0">
                            <TextBlock Text="{Binding StateLabel}" Style="{StaticResource StatePillText}" FontSize="10.5" />
                          </Border>
                        </Grid>
                        <ProgressBar Style="{StaticResource JobProgressBar}" Height="4" Minimum="0" Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}" Margin="0,8,0,6" />
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource TertiaryTextStyle}" FontSize="11" />
                          <TextBlock Grid.Column="1" Text="{Binding Speed}" Style="{StaticResource TertiaryTextStyle}" FontSize="11" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Margin="0,12,0,2" Visibility="{Binding ShowNoJobs, Converter={StaticResource BoolToVis}}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource DashIconBadge}">
                    <ui:SymbolIcon Symbol="ArrowDownload24" Style="{StaticResource DashIcon}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Nothing downloading" Style="{StaticResource CardTitleStyle}" FontSize="12.5" />
                    <TextBlock Text="Queue a download to see it here." Style="{StaticResource TertiaryTextStyle}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <ui:Button Content="New download" Appearance="Secondary" Icon="{ui:SymbolIcon CloudArrowDown24}"
                           HorizontalAlignment="Stretch" Margin="0,14,0,0" Command="{Binding NavigateDepotDownloaderCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Storage -->
          <Border Style="{StaticResource SurfaceCardStyle}" Padding="18" Margin="0,14,0,0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Storage" Style="{StaticResource DashCardHeader}" />
                <TextBlock Grid.Column="1" Text="{Binding StorageFree}" FontWeight="Bold" FontSize="16"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{Binding StorageSummary}" Style="{StaticResource TertiaryTextStyle}" FontSize="11.5" Margin="0,4,0,0" />
              <ProgressBar Style="{StaticResource StorageBar}" Margin="0,10,0,0"
                           Value="{Binding StorageUsedPercent, Mode=OneWay}" />
            </StackPanel>
          </Border>

          <!-- Setup status -->
          <Border Style="{StaticResource SurfaceCardStyle}" Padding="18" Margin="0,14,0,0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Setup" Style="{StaticResource DashCardHeader}" />
                <TextBlock Grid.Column="1" Text="{Binding StatusSummary}" Style="{StaticResource TertiaryTextStyle}" FontSize="11"
                           VerticalAlignment="Center" />
              </Grid>
              <ItemsControl ItemsSource="{Binding StatusItems}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Top" Margin="0,5,12,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}" FontSize="12.5" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource TertiaryTextStyle}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                      </StackPanel>
                      <ui:Button Grid.Column="2" Style="{StaticResource StatusAction}" Margin="10,0,0,0"
                                 Content="{Binding ActionLabel}" Command="{Binding Action}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- More tools -->
          <Border Style="{StaticResource SurfaceCardStyle}" Padding="18" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="More Tools" Style="{StaticResource DashCardHeader}" />
              <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                         Command="{Binding NavigateDenuvoActivationCommand}">
                <Grid HorizontalAlignment="Stretch">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <ui:SymbolIcon Symbol="Key24" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Denuvo Activation" Margin="12,0,0,0" VerticalAlignment="Center" />
                  <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
              </ui:Button>
              <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                         Command="{Binding NavigateSettingsCommand}">
                <Grid HorizontalAlignment="Stretch">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <ui:SymbolIcon Symbol="Settings24" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center" />
                  <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
              </ui:Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Page>
