<Page x:Class="Steamy.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      ScrollViewer.CanContentScroll="False"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CountChip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="LinkButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Appearance" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="HeroButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Game cover: accent border + soft light overlay on hover, opacity-only animation (no scaling = no blur) -->
    <Style x:Key="GameCard" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="8,0,8,20" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <StackPanel Background="Transparent">
              <Grid Height="250">
                <Border x:Name="Frame" CornerRadius="14" Background="{Binding CoverColor}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" />
                <TextBlock Text="{Binding CoverGlyph}" FontSize="48" Foreground="#30FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsArtworkFallback, Converter={StaticResource BoolToVis}}" />
                <Border Margin="1" CornerRadius="13" CacheMode="BitmapCache"
                        RenderOptions.BitmapScalingMode="HighQuality">
                  <Border.Background>
                    <ImageBrush ImageSource="{Binding ArtworkImage}" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
                <Border x:Name="Glow" Margin="1" CornerRadius="13" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False" />
                <Border x:Name="Ring" CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                        Opacity="0" IsHitTestVisible="False" />
                <Border Background="#E60A0D14" CornerRadius="7" Padding="7,3" Margin="10"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="{Binding UpdateRequired, Converter={StaticResource BoolToVis}}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Warning24" FontSize="11" Foreground="{DynamicResource WarningBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="Update" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock x:Name="Title" Text="{Binding Name}" Margin="2,10,2,0" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Size}" Margin="2,2,2,0" FontSize="11.5"
                         Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1"
                                       Duration="{StaticResource HoverAnimationDuration}" EasingFunction="{StaticResource SmoothEaseInOut}" />
                      <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.07"
                                       Duration="{StaticResource HoverAnimationDuration}" EasingFunction="{StaticResource SmoothEaseInOut}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0"
                                       Duration="{StaticResource HoverAnimationDuration}" EasingFunction="{StaticResource SmoothEaseInOut}" />
                      <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0"
                                       Duration="{StaticResource HoverAnimationDuration}" EasingFunction="{StaticResource SmoothEaseInOut}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Compact tool tile: icon + title + subtitle in one row -->
    <Style x:Key="ToolTile" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="8,0,8,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border CornerRadius="14" Background="{DynamicResource SurfaceElevatedBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" />
              <Border x:Name="Hover" CornerRadius="14" Background="{DynamicResource SurfaceSubtleBrush}"
                      BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Opacity="0" />
              <ContentPresenter Margin="16,14" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1"
                                       Duration="{StaticResource HoverAnimationDuration}" EasingFunction="{StaticResource SmoothEaseInOut}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0"
                                       Duration="{StaticResource HoverAnimationDuration}" EasingFunction="{StaticResource SmoothEaseInOut}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolIcon" TargetType="Border">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ToolTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="ToolSubtitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Hover row for lists -->
    <Style x:Key="RowButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="10" Padding="10,9" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Stats strip -->
    <Style x:Key="StatIcon" TargetType="Border">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="StatDivider" TargetType="Border">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>

    <!-- Key/value rows in the System card -->
    <Style x:Key="InfoKey" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Width" Value="116" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>
    <Style x:Key="InfoValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="StatusDot" TargetType="Ellipse">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOk}" Value="True">
          <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StatusAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Appearance" Value="Secondary" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOk}" Value="False">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StorageBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
      <Setter Property="Height" Value="6" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsStorageLow}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <LinearGradientBrush x:Key="HeroShade" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#F50A0D14" Offset="0" />
      <GradientStop Color="#C80A0D14" Offset="0.5" />
      <GradientStop Color="#200A0D14" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBottomShade" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#000A0D14" Offset="0.35" />
      <GradientStop Color="#E60A0D14" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WelcomeGlow" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#300284C7" Offset="0" />
      <GradientStop Color="#186366F1" Offset="0.55" />
      <GradientStop Color="#000A0D14" Offset="1" />
    </LinearGradientBrush>
  </Page.Resources>

  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" Padding="36,28,36,48">
    <StackPanel x:Name="Root" MaxWidth="1320" HorizontalAlignment="Stretch" Opacity="0">
      <StackPanel.RenderTransform>
        <TranslateTransform Y="10" />
      </StackPanel.RenderTransform>
      <StackPanel.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="0" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </StackPanel.Triggers>

      <!-- Header -->
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Greeting}" FontSize="28" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{Binding HeaderSummary}" FontSize="13"
                     Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:ProgressRing Width="18" Height="18" Margin="0,0,14,0" IsIndeterminate="True"
                           Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
          <ui:TextBox x:Name="DashboardSearch"
                      Width="300"
                      PlaceholderText="Search games…"
                      Icon="{ui:SymbolIcon Search24}"
                      VerticalAlignment="Center"
                      KeyDown="DashboardSearch_KeyDown" />
          <ui:Button Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0" Appearance="Transparent"
                     Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}"
                     ToolTip="Rescan library" />
        </StackPanel>
      </Grid>

      <!-- Hero -->
      <Grid Height="300" Margin="0,0,0,18">
        <Border CornerRadius="20" Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" />
        <Border CornerRadius="20" CacheMode="BitmapCache" RenderOptions.BitmapScalingMode="HighQuality"
                Visibility="{Binding HasHeroArt, Converter={StaticResource BoolToVis}}">
          <Border.Background>
            <ImageBrush ImageSource="{Binding HeroImage}" Stretch="UniformToFill" />
          </Border.Background>
        </Border>
        <Border CornerRadius="20" Background="{StaticResource HeroShade}"
                Visibility="{Binding HasHeroArt, Converter={StaticResource BoolToVis}}" />
        <Border CornerRadius="20" Background="{StaticResource HeroBottomShade}"
                Visibility="{Binding HasHeroArt, Converter={StaticResource BoolToVis}}" />

        <!-- Running download -->
        <StackPanel DataContext="{Binding HeroDownload}" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Width="600" Margin="36,0,36,30"
                    Visibility="{Binding DataContext.ShowDownloadHero, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
          <Border Style="{StaticResource StatePill}" HorizontalAlignment="Left">
            <TextBlock Text="{Binding StateLabel}" Style="{StaticResource StatePillText}" />
          </Border>
          <TextBlock Text="{Binding GameName}" FontSize="30" FontWeight="SemiBold" Foreground="White"
                     Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding DataContext.HeroDownloadDetail, RelativeSource={RelativeSource AncestorType=Page}}"
                     Foreground="#CBD5E1" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:SmoothProgressBar Style="{StaticResource JobProgressBar}" Height="6" Minimum="0" Maximum="100"
                                        SmoothValue="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" Foreground="White" FontWeight="SemiBold" FontSize="14"
                       Typography.NumeralAlignment="Tabular" Margin="14,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <ui:Button Style="{StaticResource PauseButton}" Margin="0,0,8,0" Appearance="Primary" Content="Pause" CornerRadius="10"
                       Icon="{ui:SymbolIcon Pause24}" CommandParameter="{Binding}"
                       Command="{Binding DataContext.DownloadActions.PauseCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
            <ui:Button Style="{StaticResource ResumeButton}" Margin="0,0,8,0" Appearance="Primary" Content="Resume" CornerRadius="10"
                       Icon="{ui:SymbolIcon Play24}" CommandParameter="{Binding}"
                       Command="{Binding DataContext.DownloadActions.ResumeCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
            <ui:Button Style="{StaticResource StartButton}" Margin="0,0,8,0" Appearance="Primary" Content="Start" CornerRadius="10"
                       Icon="{ui:SymbolIcon Play24}" CommandParameter="{Binding}"
                       Command="{Binding DataContext.DownloadActions.StartCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
            <ui:Button Style="{StaticResource HeroButton}" Content="Downloads" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowDownload24}"
                       Command="{Binding DataContext.NavigateDownloadsCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
          </StackPanel>
        </StackPanel>

        <!-- Latest game -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="660" Margin="36,0,36,30"
                    Visibility="{Binding ShowGameHero, Converter={StaticResource BoolToVis}}">
          <Border Background="#3038BDF8" CornerRadius="7" Padding="9,3" HorizontalAlignment="Left">
            <TextBlock Text="RECENTLY UPDATED" FontSize="10.5" FontWeight="SemiBold" Foreground="#7DD3FC" />
          </Border>
          <TextBlock Text="{Binding HeroGame.Name}" FontSize="34" FontWeight="SemiBold" Foreground="White"
                     Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding HeroGameDetail}" Foreground="#CBD5E1" FontSize="13.5" Margin="0,4,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <ui:Button Style="{StaticResource HeroButton}" Content="Play" Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                       Command="{Binding PlayGameCommand}" CommandParameter="{Binding HeroGame}" />
            <ui:Button Style="{StaticResource HeroButton}" Content="Folder" Appearance="Secondary" Icon="{ui:SymbolIcon FolderOpen24}"
                       Command="{Binding OpenGameFolderCommand}" CommandParameter="{Binding HeroGame}" />
            <ui:Button Style="{StaticResource HeroButton}" Content="Library" Appearance="Secondary" Icon="{ui:SymbolIcon Library24}"
                       Command="{Binding NavigateLibraryCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- First run -->
        <Grid Visibility="{Binding ShowWelcomeHero, Converter={StaticResource BoolToVis}}">
          <Border CornerRadius="20" Background="{StaticResource WelcomeGlow}" />
          <ui:SymbolIcon Symbol="Games24" FontSize="190" Opacity="0.05" Foreground="{DynamicResource TextPrimaryBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,60,0" />
          <StackPanel VerticalAlignment="Center" Margin="40,0" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Welcome to Steamy" FontSize="32" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Download depots, unlock DLCs, unpack SteamStub and fix online play — all in one place." />
            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
              <ui:Button Style="{StaticResource HeroButton}" Content="Set Steam folder" Appearance="Primary" Icon="{ui:SymbolIcon Settings24}"
                         Command="{Binding NavigateSettingsCommand}" />
              <ui:Button Style="{StaticResource HeroButton}" Content="Browse games" Appearance="Secondary" Icon="{ui:SymbolIcon Apps24}"
                         Command="{Binding NavigateLibraryCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- Stats strip -->
      <Border Style="{StaticResource Card}" Padding="22,16" Margin="0,0,0,30">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" ToolTip="{Binding InstalledSummary}">
            <Border Style="{StaticResource StatIcon}" Background="#1F38BDF8">
              <ui:SymbolIcon Symbol="Games24" FontSize="18" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding InstalledCount}" Style="{StaticResource StatValue}" />
              <TextBlock Text="Installed games" Style="{StaticResource StatLabel}" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource StatDivider}" Margin="16,4" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" ToolTip="{Binding DownloadSummary}">
            <Border Style="{StaticResource StatIcon}" Background="#1F10B981">
              <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding ActiveDownloadCount}" Style="{StaticResource StatValue}" />
              <TextBlock Text="Active downloads" Style="{StaticResource StatLabel}" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="3" Style="{StaticResource StatDivider}" Margin="16,4" />

          <StackPanel Grid.Column="4" Orientation="Horizontal" ToolTip="{Binding SpeedSummary}">
            <Border Style="{StaticResource StatIcon}" Background="#1FC084FC">
              <ui:SymbolIcon Symbol="TopSpeed24" FontSize="18" Foreground="#C084FC" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding CurrentSpeed}" Style="{StaticResource StatValue}" />
              <TextBlock Text="Download speed" Style="{StaticResource StatLabel}" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="5" Style="{StaticResource StatDivider}" Margin="16,4" />

          <StackPanel Grid.Column="6" Orientation="Horizontal" ToolTip="{Binding StorageSummary}">
            <Border Style="{StaticResource StatIcon}" Background="#1FF59E0B">
              <ui:SymbolIcon Symbol="Storage24" FontSize="18" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding StorageFree}" Style="{StaticResource StatValue}" />
              <TextBlock Text="Free space" Style="{StaticResource StatLabel}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Main content -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Left: games + tools -->
        <StackPanel>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Your games" Style="{StaticResource SectionTitle}" />
              <Border Style="{StaticResource CountChip}">
                <TextBlock Text="{Binding InstalledCount}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>
            </StackPanel>
            <ui:Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="View all"
                       Command="{Binding NavigateLibraryCommand}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding RecentGames}" Margin="-8,0,-8,0"
                        Visibility="{Binding HasRecentGames, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource GameCard}" Tag="{Binding}" Click="GameCover_Click" ToolTip="{Binding Name}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Style="{StaticResource Card}" Padding="32,40" Margin="0,0,0,20"
                  Visibility="{Binding ShowNoGames, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" MaxWidth="420">
              <Border Width="60" Height="60" CornerRadius="30" Background="#1F38BDF8" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Games24" FontSize="26" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="No installed games found" FontSize="16" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
              <TextBlock Text="{Binding NoGamesDetail}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"
                         TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <ui:Button Style="{StaticResource HeroButton}" Content="Set Steam folder" Appearance="Primary" Command="{Binding NavigateSettingsCommand}" />
                <ui:Button Style="{StaticResource HeroButton}" Content="Browse games" Appearance="Secondary" Margin="0" Command="{Binding NavigateLibraryCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="Tools" Style="{StaticResource SectionTitle}" Margin="0,10,0,14" />
          <UniformGrid Columns="4" Margin="-8,0,-8,0">
            <Button Style="{StaticResource ToolTile}" Command="{Binding NavigateDepotDownloaderCommand}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource ToolIcon}" Background="#1F38BDF8">
                  <ui:SymbolIcon Symbol="CloudArrowDown24" FontSize="20" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Depot Downloader" Style="{StaticResource ToolTitle}" />
                  <TextBlock Text="Download depots" Style="{StaticResource ToolSubtitle}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Style="{StaticResource ToolTile}" Command="{Binding NavigateFixesCommand}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource ToolIcon}" Background="#1F10B981">
                  <ui:SymbolIcon Symbol="ShieldTask24" FontSize="20" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Game Fixes" Style="{StaticResource ToolTitle}" />
                  <TextBlock Text="Online fixes" Style="{StaticResource ToolSubtitle}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Style="{StaticResource ToolTile}" Command="{Binding NavigateDlcUnlockerCommand}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource ToolIcon}" Background="#1FC084FC">
                  <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="20" Foreground="#C084FC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="DLC Unlocker" Style="{StaticResource ToolTitle}" />
                  <TextBlock Text="CreamAPI" Style="{StaticResource ToolSubtitle}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Style="{StaticResource ToolTile}" Command="{Binding NavigateSteamlessCommand}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource ToolIcon}" Background="#1FF59E0B">
                  <ui:SymbolIcon Symbol="Wrench24" FontSize="20" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Steamless" Style="{StaticResource ToolTitle}" />
                  <TextBlock Text="Unpack SteamStub" Style="{StaticResource ToolSubtitle}" />
                </StackPanel>
              </Grid>
            </Button>
          </UniformGrid>
        </StackPanel>

        <!-- Right: side panels -->
        <StackPanel Grid.Column="2">

          <!-- Downloads -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Downloads" Style="{StaticResource CardTitle}" />
                <Border Grid.Column="1" Style="{StaticResource CountChip}" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding JobCountLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <ui:Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="View all" Margin="0,-6,-10,-6"
                           Command="{Binding NavigateDownloadsCommand}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding ActiveJobs}" Margin="0,14,0,-12"
                            Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,14">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid Width="36" Height="50" VerticalAlignment="Top">
                        <Border CornerRadius="8" Background="{Binding CoverColor}">
                          <TextBlock Text="{Binding CoverGlyph}" FontSize="14" Foreground="#AAFFFFFF"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="8" RenderOptions.BitmapScalingMode="HighQuality">
                          <Border.Background>
                            <ImageBrush ImageSource="{Binding PortraitArtUrl}" Stretch="UniformToFill" />
                          </Border.Background>
                        </Border>
                      </Grid>
                      <StackPanel Grid.Column="1" Margin="12,1,0,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding GameName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                     Foreground="{DynamicResource AccentBrush}" Typography.NumeralAlignment="Tabular" />
                        </Grid>
                        <controls:SmoothProgressBar Style="{StaticResource JobProgressBar}" Height="5" Minimum="0" Maximum="100"
                                                    SmoothValue="{Binding Progress, Mode=OneWay}" Margin="0,8,0,6" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5" />
                          <TextBlock Grid.Column="1" Text="{Binding Speed}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5"
                                     Typography.NumeralAlignment="Tabular" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowNoJobs, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Nothing downloading right now." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12.5" />
                <ui:Button Content="New download" Appearance="Secondary" Icon="{ui:SymbolIcon CloudArrowDown24}" CornerRadius="10"
                           HorizontalAlignment="Stretch" Margin="0,12,0,0" Command="{Binding NavigateDepotDownloaderCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- System -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="System" Style="{StaticResource CardTitle}" />
                <TextBlock Grid.Column="1" Text="{Binding LastScanLabel}" Foreground="{DynamicResource TextTertiaryBrush}"
                           FontSize="11" VerticalAlignment="Center" />
              </Grid>

              <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <TextBlock Text="Steam" Style="{StaticResource InfoKey}" />
                <TextBlock Text="{Binding SteamPath}" Style="{StaticResource InfoValue}" MaxWidth="180" ToolTip="{Binding SteamPath}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Library folders" Style="{StaticResource InfoKey}" />
                <TextBlock Text="{Binding LibraryFolderCountLabel}" Style="{StaticResource InfoValue}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Detected apps" Style="{StaticResource InfoKey}" />
                <TextBlock Text="{Binding DetectedAppCountLabel}" Style="{StaticResource InfoValue}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Games size" Style="{StaticResource InfoKey}" />
                <TextBlock Text="{Binding TotalGameSize}" Style="{StaticResource InfoValue}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="DepotDownloader" Style="{StaticResource InfoKey}" />
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDepotReady}" Value="True">
                          <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding DepotToolVersionLabel}" Style="{StaticResource InfoValue}" MaxWidth="160" />
              </StackPanel>

              <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,16" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Storage" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding StorageSummary}" FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Border CornerRadius="3" Margin="0,8,0,0" ClipToBounds="True">
                <ProgressBar Style="{StaticResource StorageBar}" Value="{Binding StorageUsedPercent, Mode=OneWay}" />
              </Border>

              <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,16,0,4" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Setup" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding StatusSummary}" FontSize="11.5" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding StatusItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Top" Margin="0,5,10,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5"
                                   TextWrapping="Wrap" Margin="0,1,0,0" />
                      </StackPanel>
                      <ui:Button Grid.Column="2" Style="{StaticResource StatusAction}" Margin="8,0,0,0"
                                 Content="{Binding ActionLabel}" Command="{Binding Action}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Share manifests -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="9" Background="#1FF472B6" Margin="0,0,10,0">
                  <ui:SymbolIcon Symbol="Share24" FontSize="16" Foreground="#F472B6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Share manifests" Style="{StaticResource CardTitle}" />
              </StackPanel>
              <TextBlock Text="Help others by sharing the manifests you downloaded."
                         Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
              <ui:Button Content="Open manifest folder" Appearance="Secondary" CornerRadius="10" HorizontalAlignment="Stretch"
                         Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,12,0,0"
                         Command="{Binding OpenManifestFolderCommand}" />
            </StackPanel>
          </Border>

          <!-- More -->
          <Border Style="{StaticResource Card}" Padding="8">
            <StackPanel>
              <Button Style="{StaticResource RowButton}" Command="{Binding NavigateDenuvoActivationCommand}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:SymbolIcon Symbol="Key24" FontSize="18" Foreground="#F59E0B" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Denuvo Activation" Margin="12,0,0,0" FontSize="13"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button Style="{StaticResource RowButton}" Command="{Binding NavigateFamilyShareCommand}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:SymbolIcon Symbol="People24" FontSize="18" Foreground="#C084FC" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Family Sharing" Margin="12,0,0,0" FontSize="13"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button Style="{StaticResource RowButton}" Command="{Binding NavigateSettingsCommand}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:SymbolIcon Symbol="Settings24" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Settings" Margin="12,0,0,0" FontSize="13"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Page>
