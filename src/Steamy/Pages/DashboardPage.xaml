<Page x:Class="Steamy.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      UseLayoutRounding="True" SnapsToDevicePixels="True"
      Background="{DynamicResource WorkspaceBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="LandscapeGameCard" TargetType="Button">
      <Setter Property="controls:CardMotion.IsEnabled" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Card" Background="Transparent">
              <Grid x:Name="MotionSurface">
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid>
                <Border CornerRadius="12" Background="{Binding CoverColor}" />
                <Border CornerRadius="12" RenderOptions.BitmapScalingMode="HighQuality">
                  <Border.Background><ImageBrush ImageSource="{Binding HeaderImage}" Stretch="UniformToFill" /></Border.Background>
                </Border>
                <Border x:Name="Ring" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="12" Opacity="0" />
              </Grid>
              <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Size}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" controls:SmoothScroll.Enabled="True" Padding="28,22,28,32">
    <StackPanel MaxWidth="1440">
      <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Overview" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
        <ui:TextBox x:Name="DashboardSearch" Grid.Column="1" Width="340" Height="38"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Find a game or App ID" Icon="{ui:SymbolIcon Search24}"
                    KeyDown="DashboardSearch_KeyDown" ToolTip="Type to search. Enter opens Games; Escape clears the search." />
        <ui:Button Grid.Column="2" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowSync24}" Margin="10,0,0,0"
                   Command="{Binding RefreshCommand}" ToolTip="Refresh library" AutomationProperties.Name="Refresh library" />
      </Grid>

      <Border CornerRadius="14" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" Padding="12" Margin="0,0,0,24"
              Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Text="{Binding SearchStatus}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="8,2,0,8" AutomationProperties.LiveSetting="Polite" />
          <ItemsControl x:Name="SearchMatches" ItemsSource="{Binding SearchResults}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7"
                         CommandParameter="{Binding}" Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding AppLabel}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0" />
                </StackPanel>
              </ui:Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Steamy's own composition: an editorial intro beside a compact artwork card. -->
      <Grid x:Name="SpotlightGrid" Margin="0,0,0,30" controls:EntranceMotion.Delay="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SpotlightGutter" Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel x:Name="HeroCopy" VerticalAlignment="Center" MaxWidth="480" HorizontalAlignment="Left" Margin="0,12,0,12">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Border CornerRadius="8" Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="8,5">
              <ui:SymbolIcon Symbol="Sparkle24" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock Text="{Binding Greeting}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="HomeHeading" FontSize="42" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="49">
            <Run Text="One place." /><LineBreak /><Run Text="More play." Foreground="{DynamicResource BrandGradientBrush}" />
          </TextBlock>
          <TextBlock Text="Your games, downloads and tools. Ready when you are." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" LineHeight="21" TextWrapping="Wrap" Margin="0,14,0,22" />
          <StackPanel Orientation="Horizontal">
            <ui:Button Content="Open library" Appearance="Primary" Foreground="White" Padding="18,9" Command="{Binding NavigateLibraryCommand}" />
            <ui:Button Content="Downloads" Appearance="Transparent" Margin="8,0,0,0" Command="{Binding NavigateDownloadsCommand}" />
          </StackPanel>
        </StackPanel>
        <Border x:Name="DashboardHero" Grid.Column="2" Height="328" CornerRadius="24" Background="{DynamicResource GlassSurfaceBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" DataContext="{Binding FeaturedGame}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border CornerRadius="23,23,0,0" Background="#24354A" />
            <Border CornerRadius="23,23,0,0" RenderOptions.BitmapScalingMode="HighQuality">
              <Border.Background><ImageBrush ImageSource="{Binding HeroArtwork}" Stretch="UniformToFill" /></Border.Background>
            </Border>
            <Border CornerRadius="23,23,0,0" Background="{DynamicResource HeroBottomShadeBrush}" IsHitTestVisible="False" />
            <Border CornerRadius="20" Background="#A6192234" BorderBrush="#40FFFFFF" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Padding="11,5">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Sparkle24" FontSize="11" Foreground="#B9D8FF" Margin="0,0,6,0" />
                <TextBlock Text="SPOTLIGHT" Foreground="White" FontSize="9" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,13">
              <TextBlock Text="{Binding ReleaseStatus}" Foreground="#B9D8FF" FontSize="9" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ReleaseLabel}" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="18,14,18,13">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding Game.Name}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Game.Name}" />
                <TextBlock Text="{Binding Publisher}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
              </StackPanel>
              <Grid Grid.Row="2" Margin="0,12,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ui:Button Content="View on Steam ↗" Appearance="Transparent" HorizontalAlignment="Left" Padding="0,5" FontSize="11" Foreground="{DynamicResource AccentBrush}" Command="{Binding OpenSpotlightCommand}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{Binding FeaturedPosition}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" Appearance="Transparent" Padding="6" Command="{Binding PreviousFeaturedCommand}" AutomationProperties.Name="Previous spotlight" />
                  <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" Appearance="Transparent" Padding="6" Command="{Binding NextFeaturedCommand}" AutomationProperties.Name="Next spotlight" />
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <StackPanel Margin="0,0,0,26" Visibility="{Binding HasSpotlight, Converter={StaticResource BoolToVis}}" controls:EntranceMotion.Delay="60">
        <Grid Margin="0,0,0,12">
          <TextBlock Text="New &amp; upcoming" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="Fresh from Steam" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <ItemsControl ItemsSource="{Binding NewGames}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:AdaptiveGridPanel MinItemWidth="200" MaxColumns="3" Spacing="16" CoverRatio="0.45" FooterHeight="62" MaxRows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Style="{StaticResource GalleryCardButton}" ToolTip="{Binding Game.Name}" CommandParameter="{Binding}"
                    Command="{Binding DataContext.OpenSpotlightCommand, RelativeSource={RelativeSource AncestorType=Page}}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="62" /></Grid.RowDefinitions>
                <Border CornerRadius="15,15,0,0" Background="{DynamicResource BrandWashBrush}" />
                <Border CornerRadius="15,15,0,0" RenderOptions.BitmapScalingMode="HighQuality">
                  <Border.Background><ImageBrush ImageSource="{Binding Game.HeaderImage}" Stretch="UniformToFill" /></Border.Background>
                </Border>
                <StackPanel Grid.Row="1" Margin="12,10,12,8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Game.Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding ReleaseLabel}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,5,0,0" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Visibility="{Binding HasRecentGames, Converter={StaticResource BoolToVis}}" Margin="0,0,0,28">
        <Grid Margin="0,0,0,14">
          <TextBlock Text="Your library" Style="{StaticResource SectionTitle}" />
          <ui:Button Content="See all →" Appearance="Transparent" HorizontalAlignment="Right" Command="{Binding NavigateLibraryCommand}" FontSize="12" />
        </Grid>
        <ItemsControl ItemsSource="{Binding RecentGames}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:AdaptiveGridPanel MinItemWidth="200" MaxColumns="4" Spacing="18" CoverRatio="0.44" FooterHeight="44" MaxRows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Tag="{Binding}" Click="GameCover_Click" Style="{StaticResource LandscapeGameCard}" ToolTip="{Binding Name}" />
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVis}}">
        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,16" />
        <Grid Margin="0,0,0,8">
          <TextBlock Text="In your queue" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
          <ui:Button Content="Open queue →" Appearance="Transparent" HorizontalAlignment="Right" Command="{Binding NavigateDownloadsCommand}" FontSize="11" />
        </Grid>
        <ItemsControl ItemsSource="{Binding ActiveJobs}"><ItemsControl.ItemTemplate><DataTemplate>
          <Grid Margin="0,6,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,7">
                <TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" />
                <TextBlock Text="{Binding ProgressLabel}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="10,0,0,0" />
              </StackPanel>
              <controls:SmoothProgressBar SmoothValue="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" Height="2" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:Button Content="Pause" Appearance="Transparent" Style="{StaticResource PauseButton}" CommandParameter="{Binding}" Command="{Binding DataContext.DownloadActions.PauseCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
              <ui:Button Content="Resume" Appearance="Transparent" Style="{StaticResource ResumeButton}" CommandParameter="{Binding}" Command="{Binding DataContext.DownloadActions.ResumeCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
              <ui:Button Content="Start" Appearance="Transparent" Style="{StaticResource StartButton}" CommandParameter="{Binding}" Command="{Binding DataContext.DownloadActions.StartCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
            </StackPanel>
          </Grid>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
