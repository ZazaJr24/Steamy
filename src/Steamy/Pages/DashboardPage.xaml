<Page x:Class="Steamy.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      ScrollViewer.CanContentScroll="False"
      UseLayoutRounding="True" SnapsToDevicePixels="True"
      Background="{DynamicResource WorkspaceBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="CoverCardButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource GalleryKeyboardFocus}" />
      <Setter Property="controls:CardMotion.IsEnabled" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Grid x:Name="MotionSurface">
                <Border x:Name="HoverGlass" Background="{DynamicResource CardHoverGlassBrush}" CornerRadius="12" Opacity="0" IsHitTestVisible="False" />
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <Border x:Name="Ring" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0" CornerRadius="12" Opacity="0" IsHitTestVisible="False" />
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverGlass" Property="Opacity" Value="1" />
                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
                <Setter TargetName="Ring" Property="Opacity" Value="0" />
              </Trigger>

            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <ScrollViewer x:Name="DashboardScroll" Style="{StaticResource DashboardScrollHostStyle}" Padding="28,22,28,30">
    <StackPanel MaxWidth="1440" RequestBringIntoView="Dashboard_RequestBringIntoView">
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Discover" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
        <ui:TextBox x:Name="DashboardSearch" Grid.Column="1" Width="340" Height="38"
                    Visibility="{Binding DashboardSearchEnabled, Converter={StaticResource BoolToVis}}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Search games or App ID" Icon="{ui:SymbolIcon Search24}"
                    KeyDown="DashboardSearch_KeyDown" GotKeyboardFocus="DashboardSearch_GotKeyboardFocus" LostKeyboardFocus="DashboardSearch_LostKeyboardFocus"
                    ToolTip="Type to search. Enter opens Games; Escape clears the search." />
        <ui:Button Grid.Column="2" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowSync24}" Margin="8,0,0,0"
                   Command="{Binding RefreshCommand}" ToolTip="Refresh spotlight" AutomationProperties.Name="Refresh spotlight" />
      </Grid>

      <Border x:Name="DashboardSearchPanel" CornerRadius="14" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" Padding="12" Margin="0,0,0,24"
              Visibility="{Binding ShowSearchPanel, Converter={StaticResource BoolToVis}}" LostKeyboardFocus="DashboardSearch_LostKeyboardFocus">
        <StackPanel>
          <TextBlock Text="{Binding SearchStatus}" Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="8,2,0,8" AutomationProperties.LiveSetting="Polite" />
          <ItemsControl x:Name="SearchMatches" ItemsSource="{Binding SearchMatches}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,7"
                         CommandParameter="{Binding Item}" Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="70" Height="35" CornerRadius="6" Background="{DynamicResource SurfaceElevatedBrush}" Margin="0,0,12,0">
                    <Border CornerRadius="6"><Border.Background><ImageBrush ImageSource="{Binding Game.HeaderImage}" Stretch="UniformToFill" /></Border.Background></Border>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
              </ui:Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Visibility="{Binding HasActivityNotice, Converter={StaticResource BoolToVis}}" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,18">
        <TextBlock Text="{Binding ActivityNotice}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
      </Border>

      <Border x:Name="DashboardHero" Height="360" CornerRadius="16" Background="#09090B"
              BorderThickness="0" Margin="0,0,0,24"
              Visibility="{Binding HasSpotlight, Converter={StaticResource BoolToVis}}" DataContext="{Binding FeaturedGame}">
        <Grid>
          <Border x:Name="SpotlightArtworkFrame" Height="360" CornerRadius="16" RenderOptions.BitmapScalingMode="HighQuality">
            <Image Source="{Binding HeroArtwork}" Stretch="UniformToFill" StretchDirection="DownOnly" RenderTransformOrigin="0.5,0.5">
              <Image.RenderTransform><ScaleTransform x:Name="ArtworkZoom" /></Image.RenderTransform>
            </Image>
          </Border>
          <Border CornerRadius="16" IsHitTestVisible="False">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#A008080B" Offset="0" /><GradientStop Color="#3008080B" Offset="0.55" /><GradientStop Color="#0008080B" Offset="1" />
            </LinearGradientBrush></Border.Background>
          </Border>
          <Border CornerRadius="16" IsHitTestVisible="False">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#0008080B" Offset="0.2" /><GradientStop Color="#5008080B" Offset="0.6" /><GradientStop Color="#DF08080B" Offset="1" />
            </LinearGradientBrush></Border.Background>
          </Border>
          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,20" CornerRadius="12" Padding="10,6" Background="#60070709">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="4" Height="4" Fill="#DEDEE4" VerticalAlignment="Center" Margin="0,0,7,0" />
              <TextBlock Text="UPCOMING" FontSize="9" FontWeight="SemiBold" Foreground="#DEDEE4" />
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="SpotlightPreviewScroll" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,20,0"
                        Width="104" MaxHeight="260" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <ItemsControl x:Name="SpotlightPreviews" ItemsSource="{Binding DataContext.SpotlightPreviews, RelativeSource={RelativeSource AncestorType=Page}}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Style="{StaticResource CoverCardButton}" Height="42" Margin="0,0,0,6" ToolTip="{Binding Game.Name}"
                        Command="{Binding DataContext.SelectFeaturedCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                  <Grid>
                    <Border CornerRadius="6" BorderThickness="0" Background="#8008080A">
                      <Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="0.55" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger></Style.Triggers>
                      </Style></Border.Style>
                      <Border CornerRadius="6"><Border.Background><ImageBrush ImageSource="{Binding Game.HeaderImage}" Stretch="UniformToFill" /></Border.Background></Border>
                    </Border>
                    <Ellipse Width="4" Height="4" Fill="White" Margin="7" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                  </Grid>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Border x:Name="SpotlightLoader" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="24" Padding="10"
                  Background="#40000000" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.Name="Next spotlight">
            <Path Width="24" Height="24" Stroke="#DDFFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 12,2 A 10,10 0 1 1 2,12" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><RotateTransform x:Name="LoaderRotation" /></Path.RenderTransform>
            </Path>
          </Border>
          <Grid x:Name="SpotlightFooter" VerticalAlignment="Bottom" Margin="24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="SpotlightDetails" Grid.ColumnSpan="2" HorizontalAlignment="Left" MaxWidth="500">
              <TextBlock x:Name="SpotlightTitle" Text="{Binding Game.Name}" FontSize="28" FontWeight="SemiBold" Foreground="#F0F0F3" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="76" ToolTip="{Binding Game.Name}" />
              <TextBlock Text="{Binding ReleaseLabel}" Foreground="#AAAAAF" FontSize="10" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="SpotlightDescription" Text="{Binding Description}" Foreground="#BEBEC5" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                         MaxWidth="360" HorizontalAlignment="Left" Height="34" LineHeight="17" LineStackingStrategy="BlockLineHeight" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel x:Name="SpotlightActions" Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Left">
              <Border x:Name="SpotlightCountdown" CornerRadius="10" Padding="12,8" BorderThickness="0" Background="#90070709"
                      ToolTip="{Binding CountdownDetail}" MinWidth="100">
                <StackPanel>
                  <Grid Width="232" Visibility="{Binding HasTimedCountdown, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding CountdownDays}" FontSize="24" FontFamily="Consolas" Foreground="#EEEEF2" /><TextBlock Text="DAYS" FontSize="8" Foreground="#92929B" Margin="0,2,0,0" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding CountdownHours}" FontSize="24" FontFamily="Consolas" Foreground="#EEEEF2" /><TextBlock Text="HOURS" FontSize="8" Foreground="#92929B" Margin="0,2,0,0" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{Binding CountdownMinutes}" FontSize="24" FontFamily="Consolas" Foreground="#EEEEF2" /><TextBlock Text="MIN" FontSize="8" Foreground="#92929B" Margin="0,2,0,0" /></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="{Binding CountdownSeconds}" FontSize="24" FontFamily="Consolas" Foreground="#EEEEF2" /><TextBlock Text="SEC" FontSize="8" Foreground="#92929B" Margin="0,2,0,0" /></StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding Countdown}" FontSize="21" Foreground="#EEEEF2">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers><DataTrigger Binding="{Binding HasTimedCountdown}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel x:Name="SpotlightPaging" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
              <ui:Button Content="{Binding SpotlightPlaybackLabel}" Command="{Binding ToggleSpotlightCommand}" Appearance="Transparent" Foreground="#CECED5" Background="Transparent" BorderThickness="0" Padding="6" FontSize="10" Margin="0,0,5,0" AutomationProperties.Name="Pause or resume spotlight" />
              <TextBlock Text="{Binding FeaturedPosition}" FontSize="10" Foreground="#92929B" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" Foreground="#CECED5" Background="Transparent" BorderThickness="0" Appearance="Transparent" Width="30" Height="30" Padding="5" Command="{Binding PreviousFeaturedCommand}" ToolTip="Previous spotlight" AutomationProperties.Name="Previous spotlight" />
              <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" Foreground="#CECED5" Background="Transparent" BorderThickness="0" Appearance="Transparent" Width="30" Height="30" Padding="5" Margin="2,0,0,0" Command="{Binding NextFeaturedCommand}" ToolTip="Next spotlight" AutomationProperties.Name="Next spotlight" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <StackPanel Margin="0,0,0,26" Visibility="{Binding HasSpotlight, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="Upcoming releases" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding NewGames}" controls:EntranceMotion.Delay="40">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:AdaptiveGridPanel MinItemWidth="210" MaxColumns="3" Spacing="20" CoverRatio="0.4674" FooterHeight="48" MaxRows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Style="{StaticResource CoverCardButton}" ToolTip="{Binding Game.Name}" CommandParameter="{Binding}"
                    Command="{Binding DataContext.OpenSpotlightCommand, RelativeSource={RelativeSource AncestorType=Page}}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="48" /></Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="12" Background="{Binding Game.CoverColor}" />
                <Border Grid.Row="0" CornerRadius="12" SizeChanged="RecommendationArtwork_SizeChanged" ClipToBounds="True" RenderOptions.BitmapScalingMode="HighQuality">
                  <Image Source="{Binding Game.HeaderImage}" Stretch="UniformToFill" StretchDirection="DownOnly" />
                </Border>
                <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="7" Padding="9,5" Margin="10" Background="#B508080A">
                  <TextBlock Text="{Binding Countdown}" Foreground="#D4D4DA" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <StackPanel Grid.Row="1" Margin="2,9,2,0">
                  <TextBlock Text="{Binding Game.Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding ReleaseLabel}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Page>
