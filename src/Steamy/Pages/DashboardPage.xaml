<Page x:Class="Steamy.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      ScrollViewer.CanContentScroll="False"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Game cover: accent ring, a faint wash and a 4 px lift on hover. The lift moves whole
         pixels only, so art and title stay sharp. The size comes from the AdaptiveGridPanel. -->
    <Style x:Key="GameCard" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Lift" Background="Transparent">
              <Grid.RenderTransform><TranslateTransform Y="0" /></Grid.RenderTransform>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid>
                <Border CornerRadius="14" Background="{Binding CoverColor}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" />
                <TextBlock Text="{Binding CoverGlyph}" FontSize="42" Foreground="#30FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsArtworkFallback, Converter={StaticResource BoolToVis}}" />
                <!-- Wide store header as a stand-in when the portrait art is missing. -->
                <Border Margin="1" CornerRadius="13" RenderOptions.BitmapScalingMode="HighQuality"
                        Visibility="{Binding IsArtworkFallback, Converter={StaticResource BoolToVis}}">
                  <Border.Background>
                    <ImageBrush ImageSource="{Binding HeaderArtworkUrl, Converter={StaticResource ArtworkImage}, ConverterParameter=480}" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
                <!-- No CacheMode: a BitmapCache renders at 1x and makes covers blurry on scaled displays. -->
                <Border Margin="1" CornerRadius="13" RenderOptions.BitmapScalingMode="HighQuality">
                  <Border.Background>
                    <ImageBrush ImageSource="{Binding ArtworkImage}" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
                <Border x:Name="Glow" Margin="1" CornerRadius="13" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False" />
                <Border x:Name="Ring" CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                        Opacity="0" IsHitTestVisible="False" />
                <Border Background="#E60B0D12" CornerRadius="7" Padding="7,3" Margin="9"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="{Binding UpdateRequired, Converter={StaticResource BoolToVis}}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="11" Foreground="#FBBF24" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="Update" FontSize="10.5" FontWeight="SemiBold" Foreground="#FBBF24" />
                  </StackPanel>
                </Border>
              </Grid>
              <StackPanel Grid.Row="1" Margin="2,9,2,0">
                <TextBlock x:Name="Title" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Size}" Margin="0,2,0,0" FontSize="11.5"
                           Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource HoverAnimationDuration}" EasingFunction="{StaticResource SmoothEaseInOut}" />
                      <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.06" Duration="{StaticResource HoverAnimationDuration}" EasingFunction="{StaticResource SmoothEaseInOut}" />
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="{StaticResource HoverAnimationDuration}" EasingFunction="{StaticResource SmoothEaseInOut}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource HoverAnimationDuration}" EasingFunction="{StaticResource SmoothEaseInOut}" />
                      <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource HoverAnimationDuration}" EasingFunction="{StaticResource SmoothEaseInOut}" />
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="{StaticResource HoverAnimationDuration}" EasingFunction="{StaticResource SmoothEaseInOut}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Key/value rows in the System card -->
    <Style x:Key="InfoKey" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="InfoValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Persistent status cues stay quiet while the dashboard is idle. -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOk}" Value="True">
          <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>

      </Style.Triggers>
    </Style>

    <Style x:Key="StatusAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Appearance" Value="Secondary" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOk}" Value="False">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StorageBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
      <Setter Property="Height" Value="5" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsStorageLow}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ToolName" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="ToolHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Page.Resources>

  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" Padding="28,24,28,48">
    <StackPanel MaxWidth="1480" HorizontalAlignment="Stretch">

      <!-- ===== Header ======================================================================== -->
      <Grid Style="{StaticResource EnterStyle1}" Margin="0,0,0,22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding DateLabel}" Style="{StaticResource OverlineStyle}" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{Binding Greeting}" Style="{StaticResource DisplayTitleStyle}" Margin="0,3,0,0" />
          <TextBlock Text="{Binding HeaderSummary}" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:ProgressRing Width="18" Height="18" Margin="0,0,14,0" IsIndeterminate="True"
                           Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
          <ui:TextBox x:Name="DashboardSearch" Width="320" PlaceholderText="Find a game…  (Enter)" AutomationProperties.Name="Find a game in your library"
                      Icon="{ui:SymbolIcon Search24}" VerticalAlignment="Center" KeyDown="DashboardSearch_KeyDown" />
          <ui:Button Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0" Appearance="Secondary"
                     Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" ToolTip="Rescan library" />
        </StackPanel>
      </Grid>

      <Border Style="{StaticResource InfoPanelStyle}" Margin="0,0,0,16" Visibility="{Binding ShowLibraryNotice, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{Binding LibraryNotice}" Style="{StaticResource BodyTextStyle}" />
      </Border>

      <!-- ===== Hero ========================================================================== -->
      <Grid Style="{StaticResource EnterStyle2}" Margin="0,0,0,18">
        <Border x:Name="DashboardHero" Height="340" CornerRadius="24" ClipToBounds="True"
                Background="#121A28"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
          <Grid>
            <!-- Game art + shades that keep the white text readable -->
            <Border CornerRadius="24" RenderOptions.BitmapScalingMode="HighQuality"
                    Visibility="{Binding HasHeroArt, Converter={StaticResource BoolToVis}}">
              <Border.Background>
                <ImageBrush ImageSource="{Binding HeroImage}" Stretch="UniformToFill" />
              </Border.Background>
            </Border>
            <Border CornerRadius="24" Background="{DynamicResource HeroShadeBrush}" Visibility="{Binding HasHeroArt, Converter={StaticResource BoolToVis}}" />
            <Border CornerRadius="24" Background="{DynamicResource HeroBottomShadeBrush}" Visibility="{Binding HasHeroArt, Converter={StaticResource BoolToVis}}" />

            <!-- Running or waiting download -->
            <StackPanel DataContext="{Binding HeroDownload}" VerticalAlignment="Bottom"
                        MaxWidth="620" Margin="32,0,32,28" HorizontalAlignment="Stretch"
                        Visibility="{Binding DataContext.ShowDownloadHero, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
              <Border Style="{StaticResource StatePill}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding StateLabel}" Style="{StaticResource StatePillText}" />
              </Border>
              <TextBlock Text="{Binding GameName}" FontSize="30" FontWeight="SemiBold" Foreground="White"
                         Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding DataContext.HeroDownloadDetail, RelativeSource={RelativeSource AncestorType=Page}}"
                         Foreground="#CBD5E1" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:SmoothProgressBar Style="{StaticResource JobProgressBar}" Height="6" Minimum="0" Maximum="100"
                                            SmoothValue="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" Foreground="White" FontWeight="SemiBold" FontSize="14"
                           Typography.NumeralAlignment="Tabular" Margin="14,0,0,0" VerticalAlignment="Center" />
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <ui:Button Style="{StaticResource PauseButton}" Margin="0,0,8,0" Appearance="Primary" Content="Pause"
                           Icon="{ui:SymbolIcon Pause24}" CommandParameter="{Binding}"
                           Command="{Binding DataContext.DownloadActions.PauseCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                <ui:Button Style="{StaticResource ResumeButton}" Margin="0,0,8,0" Appearance="Primary" Content="Resume"
                           Icon="{ui:SymbolIcon Play24}" CommandParameter="{Binding}"
                           Command="{Binding DataContext.DownloadActions.ResumeCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                <ui:Button Style="{StaticResource StartButton}" Margin="0,0,8,0" Appearance="Primary" Content="Start"
                           Icon="{ui:SymbolIcon Play24}" CommandParameter="{Binding}"
                           Command="{Binding DataContext.DownloadActions.StartCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                <ui:Button Style="{StaticResource HeroButtonStyle}" Content="Downloads" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowDownload24}"
                           Command="{Binding DataContext.NavigateDownloadsCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
              </StackPanel>
            </StackPanel>

            <!-- Most recently updated game -->
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="680" Margin="36,0,36,30"
                        Visibility="{Binding ShowGameHero, Converter={StaticResource BoolToVis}}">
              <Border Background="#33FFFFFF" CornerRadius="7" Padding="9,3" HorizontalAlignment="Left">
                <TextBlock Text="RECENTLY UPDATED" FontSize="10.5" FontWeight="Bold" Foreground="White" />
              </Border>
              <TextBlock Text="{Binding HeroGame.Name}" FontSize="34" FontWeight="SemiBold" Foreground="White"
                         Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding HeroGameDetail}" Foreground="#CBD5E1" FontSize="13.5" Margin="0,4,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <ui:Button Style="{StaticResource HeroButtonStyle}" Content="Play" Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                           Command="{Binding PlayGameCommand}" CommandParameter="{Binding HeroGame}" />
                <ui:Button Style="{StaticResource HeroButtonStyle}" Content="Open folder" Appearance="Secondary" Icon="{ui:SymbolIcon FolderOpen24}"
                           Command="{Binding OpenGameFolderCommand}" CommandParameter="{Binding HeroGame}" />
                <ui:Button Style="{StaticResource HeroButtonStyle}" Content="Library" Appearance="Secondary" Icon="{ui:SymbolIcon Library24}"
                           Command="{Binding NavigateLibraryCommand}" />
              </StackPanel>
            </StackPanel>

            <!-- First run -->
            <Grid Visibility="{Binding ShowWelcomeHero, Converter={StaticResource BoolToVis}}">
              <Border CornerRadius="24" Background="{DynamicResource SurfaceElevatedBrush}" />
              <Border Background="{DynamicResource BrandWashBrush}" />
              <Image Source="/Steamy;component/Resources/Brand/steamy-256.png" Width="210" Height="210" Opacity="0.14"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,64,0"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel VerticalAlignment="Center" Margin="40,0" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="ALL YOUR GAMES. ONE PLACE." Style="{StaticResource OverlineStyle}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" />
                <TextBlock Text="Your next session starts here." FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Your library, downloads, manifests and tools in one place. Point Steamy at your Steam folder to get started." />
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                  <ui:Button Style="{StaticResource HeroButtonStyle}" Content="Set Steam folder" Appearance="Primary" Icon="{ui:SymbolIcon Settings24}"
                             Command="{Binding NavigateSettingsCommand}" />
                  <ui:Button Style="{StaticResource HeroButtonStyle}" Content="Browse games" Appearance="Secondary" Icon="{ui:SymbolIcon Apps24}"
                             Command="{Binding NavigateLibraryCommand}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- ===== KPI tiles ===================================================================== -->
      <UniformGrid x:Name="KpiGrid" Columns="4" Margin="-7,0,-7,14" Style="{StaticResource EnterStyle3}">
        <Border Style="{StaticResource InteractiveCardStyle}" Margin="7,0,7,14" Padding="18,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconChipStyle}" Width="40" Height="40" Background="{DynamicResource AccentSoftBrush}">
              <ui:SymbolIcon Symbol="Games24" FontSize="19" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding InstalledCount}" Style="{StaticResource KpiValueStyle}" />
              <TextBlock Text="Installed games" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding InstalledSummary}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource InteractiveCardStyle}" Margin="7,0,7,14" Padding="18,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconChipStyle}" Width="40" Height="40" Background="{DynamicResource SuccessSoftBrush}">
              <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="19" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding ActiveDownloadCount}" Style="{StaticResource KpiValueStyle}" />
              <TextBlock Text="Active downloads" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding DownloadSummary}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource InteractiveCardStyle}" Margin="7,0,7,14" Padding="18,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconChipStyle}" Width="40" Height="40" Background="{DynamicResource VioletSoftBrush}">
              <ui:SymbolIcon Symbol="TopSpeed24" FontSize="19" Foreground="{DynamicResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding CurrentSpeed}" Style="{StaticResource KpiValueStyle}" />
              <TextBlock Text="Download speed" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding SpeedSummary}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource InteractiveCardStyle}" Margin="7,0,7,14" Padding="18,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconChipStyle}" Width="40" Height="40" Background="{DynamicResource WarningSoftBrush}">
              <ui:SymbolIcon Symbol="Storage24" FontSize="19" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding StorageFree}" Style="{StaticResource KpiValueStyle}" />
              <TextBlock Text="Free space" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              <Border CornerRadius="3" Margin="0,7,0,0" ClipToBounds="True" ToolTip="{Binding StorageSummary}">
                <ProgressBar Style="{StaticResource StorageBar}" Value="{Binding StorageUsedPercent, Mode=OneWay}" />
              </Border>
            </StackPanel>
          </Grid>
        </Border>
      </UniformGrid>

      <!-- ===== Main content ================================================================== -->
      <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="GutterColumn" Width="28" />
          <ColumnDefinition x:Name="SideColumnDefinition" Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Left: games + quick actions -->
        <StackPanel Grid.Column="0" Style="{StaticResource EnterStyle4}">
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Recently updated" Style="{StaticResource SectionHeaderStyle}" />
              <Border Style="{StaticResource CountBadgeStyle}">
                <TextBlock Text="{Binding InstalledCount}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
              </Border>
            </StackPanel>
            <ui:Button Grid.Column="1" Style="{StaticResource LinkButtonStyle}" Content="View library"
                       Icon="{ui:SymbolIcon ArrowRight24}" Command="{Binding NavigateLibraryCommand}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding RecentGames}" Margin="0,0,0,28"
                        Visibility="{Binding HasRecentGames, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:AdaptiveGridPanel MinItemWidth="156" Spacing="18" CoverRatio="1.5" FooterHeight="54" MaxRows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource GameCard}" Tag="{Binding}" Click="GameCover_Click" ToolTip="{Binding Name}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Style="{StaticResource CardStyle}" Padding="32,40" Margin="0,0,0,28"
                  Visibility="{Binding ShowNoGames, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" MaxWidth="440">
              <Border Width="60" Height="60" CornerRadius="30" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Games24" FontSize="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="No installed games found" FontSize="16" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
              <TextBlock Text="{Binding NoGamesDetail}" Style="{StaticResource BodyTextStyle}" TextAlignment="Center" Margin="0,6,0,0" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <ui:Button Style="{StaticResource HeroButtonStyle}" Content="Set Steam folder" Appearance="Primary" Command="{Binding NavigateSettingsCommand}" />
                <ui:Button Style="{StaticResource HeroButtonStyle}" Content="Browse games" Appearance="Secondary" Margin="0" Command="{Binding NavigateLibraryCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="Your shortcuts" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,14" />
          <ItemsControl Margin="0,0,0,12">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate>
              <controls:AdaptiveGridPanel MinItemWidth="230" Spacing="12" CoverRatio="0" FooterHeight="84" />
            </ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <Button Style="{StaticResource TileButtonStyle}" Command="{Binding NavigateLibraryCommand}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconChipStyle}" Width="42" Height="42" Background="{DynamicResource AccentSoftBrush}">
                  <ui:SymbolIcon Symbol="Apps24" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Your library" Style="{StaticResource ToolName}" />
                  <TextBlock Text="Find your next game" Style="{StaticResource ToolHint}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Style="{StaticResource TileButtonStyle}" Command="{Binding NavigateDownloadsCommand}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconChipStyle}" Width="42" Height="42" Background="{DynamicResource SuccessSoftBrush}">
                  <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Downloads" Style="{StaticResource ToolName}" />
                  <TextBlock Text="Manage your queue" Style="{StaticResource ToolHint}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Style="{StaticResource TileButtonStyle}" Command="{Binding NavigateShareCommand}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconChipStyle}" Width="42" Height="42" Background="{DynamicResource VioletSoftBrush}">
                  <ui:SymbolIcon Symbol="Share24" FontSize="20" Foreground="{DynamicResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Share manifests" Style="{StaticResource ToolName}" />
                  <TextBlock Text="Keep your collection connected" Style="{StaticResource ToolHint}" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Style="{StaticResource TileButtonStyle}" Command="{Binding NavigateSettingsCommand}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconChipStyle}" Width="42" Height="42" Background="{DynamicResource AccentSoftBrush}">
                  <ui:SymbolIcon Symbol="Settings24" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Make it yours" Style="{StaticResource ToolName}" />
                  <TextBlock Text="Appearance, storage and sources" Style="{StaticResource ToolHint}" />
                </StackPanel>
              </Grid>
            </Button>
          </ItemsControl>
        </StackPanel>

        <!-- Right: live panels -->
        <StackPanel x:Name="SideColumn" Grid.Column="2" Style="{StaticResource EnterStyle5}">

          <!-- Downloads -->
          <Border Style="{StaticResource InteractiveCardStyle}" Margin="0,0,0,14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Downloads" Style="{StaticResource CardHeaderStyle}" />
                <Border Grid.Column="1" Style="{StaticResource CountBadgeStyle}" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding JobCountLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <ui:Button Grid.Column="2" Style="{StaticResource LinkButtonStyle}" Content="View all" Margin="0,-6,-10,-6"
                           Command="{Binding NavigateDownloadsCommand}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding ActiveJobs}" Margin="0,14,0,-12"
                            Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,14">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid Width="36" Height="50" VerticalAlignment="Top">
                        <Border CornerRadius="8" Background="{Binding CoverColor}">
                          <TextBlock Text="{Binding CoverGlyph}" FontSize="14" Foreground="#AAFFFFFF"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="8" RenderOptions.BitmapScalingMode="HighQuality">
                          <Border.Background>
                            <ImageBrush ImageSource="{Binding PortraitArtUrl, Converter={StaticResource ArtworkImage}, ConverterParameter=96}" Stretch="UniformToFill" />
                          </Border.Background>
                        </Border>
                      </Grid>
                      <StackPanel Grid.Column="1" Margin="12,1,0,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding GameName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                     Foreground="{DynamicResource AccentBrush}" Typography.NumeralAlignment="Tabular" />
                        </Grid>
                        <controls:SmoothProgressBar Style="{StaticResource JobProgressBar}" Height="5" Minimum="0" Maximum="100"
                                                    SmoothValue="{Binding Progress, Mode=OneWay}" Margin="0,8,0,6" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5" />
                          <TextBlock Grid.Column="1" Text="{Binding Speed}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5"
                                     Typography.NumeralAlignment="Tabular" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowNoJobs, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Nothing downloading right now." Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                <ui:Button Content="New download" Appearance="Secondary" Icon="{ui:SymbolIcon CloudArrowDown24}"
                           HorizontalAlignment="Stretch" Margin="0,12,0,0" Command="{Binding NavigateDepotDownloaderCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Share -->
          <Border CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}"
                  Background="{DynamicResource SurfaceElevatedBrush}" Margin="0,0,0,14" ClipToBounds="True">
            <Grid>
              <Border Background="{DynamicResource BrandWashBrush}" IsHitTestVisible="False" />
              <StackPanel Margin="20">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource BrandGradientBrush}">
                    <ui:SymbolIcon Symbol="Share24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Share your manifests" Style="{StaticResource CardHeaderStyle}" />
                    <TextBlock Text="{Binding ShareLastLabel}" Style="{StaticResource CaptionStyle}" Margin="0,1,0,0" />
                  </StackPanel>
                  <ui:ProgressRing Grid.Column="2" Width="16" Height="16" IsIndeterminate="True" VerticalAlignment="Center"
                                   Visibility="{Binding IsShareScanning, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                  <TextBlock Text="{Binding ShareNewCount}" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                             Typography.NumeralAlignment="Tabular" VerticalAlignment="Bottom" />
                  <TextBlock Text="new" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,7" VerticalAlignment="Bottom" />
                </StackPanel>
                <TextBlock Text="{Binding ShareHeadline}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding ShareTotalLabel}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />

                <ui:Button Content="Share all new" Appearance="Primary" Icon="{ui:SymbolIcon Send24}" HorizontalAlignment="Stretch"
                           MinHeight="38" FontWeight="SemiBold" Margin="0,16,0,0" Command="{Binding ShareAllNewCommand}"
                           IsEnabled="{Binding HasShareNew}"
                           ToolTip="Opens Share with every game that has new manifests already selected." />
                <ui:Button Content="Open Share" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowRight24}" HorizontalAlignment="Stretch"
                           Margin="0,8,0,0" Command="{Binding NavigateShareCommand}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- System -->
          <Border Style="{StaticResource InteractiveCardStyle}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="System" Style="{StaticResource CardHeaderStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding StatusSummary}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
              </Grid>

              <ItemsControl ItemsSource="{Binding StatusItems}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Top" Margin="0,5,10,0" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5"
                                   TextWrapping="Wrap" Margin="0,1,0,0" />
                      </StackPanel>
                      <ui:Button Grid.Column="2" Style="{StaticResource StatusAction}" Margin="8,0,0,0"
                                 Content="{Binding ActionLabel}" Command="{Binding Action}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Style="{StaticResource DividerStyle}" Margin="0,16" />

              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Steam" Style="{StaticResource InfoKey}" />
                <TextBlock Grid.Column="1" Text="{Binding SteamPath}" Style="{StaticResource InfoValue}" Margin="16,0,0,0" ToolTip="{Binding SteamPath}" />
              </Grid>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Library folders" Style="{StaticResource InfoKey}" />
                <TextBlock Grid.Column="1" Text="{Binding LibraryFolderCountLabel}" Style="{StaticResource InfoValue}" />
              </Grid>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Games on disk" Style="{StaticResource InfoKey}" />
                <TextBlock Grid.Column="1" Text="{Binding TotalGameSize}" Style="{StaticResource InfoValue}" />
              </Grid>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Storage" Style="{StaticResource InfoKey}" />
                <TextBlock Grid.Column="1" Text="{Binding StorageSummary}" Style="{StaticResource InfoValue}" Margin="16,0,0,0" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Last scan" Style="{StaticResource InfoKey}" />
                <TextBlock Grid.Column="1" Text="{Binding LastScanLabel}" Style="{StaticResource InfoValue}" />
              </Grid>

              <Border Style="{StaticResource DividerStyle}" Margin="0,16,0,8" />
              <Button Style="{StaticResource RowButtonStyle}" Command="{Binding NavigateSettingsCommand}" Margin="-10,0,-10,-10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:SymbolIcon Symbol="Settings24" FontSize="17" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Open settings" Margin="12,0,0,0" FontSize="13"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight20" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Page>
