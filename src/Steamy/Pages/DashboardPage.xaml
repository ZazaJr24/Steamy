<Page x:Class="Steamy.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      ScrollViewer.CanContentScroll="False"
      UseLayoutRounding="True" SnapsToDevicePixels="True"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="CoverCardButton" TargetType="Button">
      <Setter Property="controls:CardMotion.IsEnabled" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Grid x:Name="MotionSurface">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <Border x:Name="Ring" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12" Opacity="0" IsHitTestVisible="False" />
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="QuickCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,13" />
      <Setter Property="MinHeight" Value="88" />
    </Style>
    <DataTemplate x:Key="PersonalLibraryCard">
      <Grid>
        <Button Tag="{Binding Game}" Click="GameCover_Click" Style="{StaticResource CoverCardButton}" ToolTip="{Binding Game.Name}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="12" Background="{Binding Game.CoverColor}" />
            <Border Grid.Row="0" CornerRadius="12" RenderOptions.BitmapScalingMode="HighQuality">
              <Border.Background><ImageBrush ImageSource="{Binding Game.HeaderImage}" Stretch="UniformToFill" /></Border.Background>
            </Border>
            <StackPanel Grid.Row="1" Margin="2,9,2,0">
              <TextBlock Text="{Binding Game.Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Game.Size}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Button>
        <ui:Button Content="{Binding FavoriteGlyph}" Appearance="Secondary" Width="28" Height="26" Padding="0"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7"
                   ToolTip="{Binding FavoriteActionLabel}" AutomationProperties.Name="{Binding FavoriteActionLabel}"
                   CommandParameter="{Binding Game}" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <ScrollViewer x:Name="DashboardScroll" Style="{StaticResource DashboardScrollHostStyle}" Padding="28,22,28,30">
    <StackPanel MaxWidth="1440" RequestBringIntoView="Dashboard_RequestBringIntoView">
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Discover" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
        <ui:TextBox x:Name="DashboardSearch" Grid.Column="1" Width="340" Height="38"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Search games or App ID" Icon="{ui:SymbolIcon Search24}"
                    KeyDown="DashboardSearch_KeyDown" GotKeyboardFocus="DashboardSearch_GotKeyboardFocus" LostKeyboardFocus="DashboardSearch_LostKeyboardFocus"
                    ToolTip="Type to search. Enter opens Games; Escape clears the search." />
        <ui:Button Grid.Column="2" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowSync24}" Margin="8,0,0,0"
                   Command="{Binding RefreshCommand}" ToolTip="Refresh library" AutomationProperties.Name="Refresh library" />
      </Grid>

      <Border x:Name="DashboardSearchPanel" CornerRadius="14" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" Padding="12" Margin="0,0,0,24"
              Visibility="{Binding ShowSearchPanel, Converter={StaticResource BoolToVis}}" LostKeyboardFocus="DashboardSearch_LostKeyboardFocus">
        <StackPanel>
          <StackPanel Visibility="{Binding ShowRecentSearches, Converter={StaticResource BoolToVis}}">
            <Grid Margin="8,0,4,7">
              <TextBlock Text="Recent searches" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
              <ui:Button Content="Clear" Appearance="Transparent" HorizontalAlignment="Right" FontSize="10.5" Padding="7,3" Command="{Binding ClearSearchHistoryCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding RecentSearches}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <ui:Button Content="{Binding}" Appearance="Transparent" Margin="0,0,5,5" Padding="10,6" Icon="{ui:SymbolIcon History24}"
                           CommandParameter="{Binding}" Command="{Binding DataContext.UseRecentSearchCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBlock Text="{Binding SearchStatus}" Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="8,2,0,8" AutomationProperties.LiveSetting="Polite" />
          <ItemsControl x:Name="SearchMatches" ItemsSource="{Binding SearchMatches}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,7"
                         CommandParameter="{Binding Item}" Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="70" Height="35" CornerRadius="6" Background="{DynamicResource SurfaceElevatedBrush}" Margin="0,0,12,0">
                    <Border CornerRadius="6"><Border.Background><ImageBrush ImageSource="{Binding Game.HeaderImage}" Stretch="UniformToFill" /></Border.Background></Border>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
              </ui:Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Visibility="{Binding HasActivityNotice, Converter={StaticResource BoolToVis}}" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,18">
        <TextBlock Text="{Binding ActivityNotice}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
      </Border>

      <StackPanel Margin="0,0,0,18" Visibility="{Binding HasSpotlight, Converter={StaticResource BoolToVis}}">
        <Grid Margin="0,0,0,10">
          <TextBlock Text="Spotlight" Style="{StaticResource SectionTitle}" />
          <StackPanel x:Name="SpotlightPaging" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding FeaturedPosition}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" Appearance="Transparent" Padding="6" Command="{Binding PreviousFeaturedCommand}" ToolTip="Previous spotlight" AutomationProperties.Name="Previous spotlight" />
            <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" Appearance="Transparent" Padding="6" Command="{Binding NextFeaturedCommand}" ToolTip="Next spotlight" AutomationProperties.Name="Next spotlight" />
          </StackPanel>
        </Grid>
        <Border x:Name="DashboardHero" CornerRadius="16" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" DataContext="{Binding FeaturedGame}">
          <Grid>
            <Border x:Name="SpotlightArtworkFrame" Height="282" CornerRadius="15" RenderOptions.BitmapScalingMode="HighQuality">
              <Border.Background><ImageBrush ImageSource="{Binding HeroArtwork}" Stretch="UniformToFill" /></Border.Background>
            </Border>
            <Border CornerRadius="15" IsHitTestVisible="False">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#000B1018" Offset="0.25" /><GradientStop Color="#AA0B1018" Offset="0.63" /><GradientStop Color="#F80B1018" Offset="1" />
              </LinearGradientBrush></Border.Background>
            </Border>
            <Grid x:Name="SpotlightFooter" VerticalAlignment="Bottom" Margin="22,20">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel x:Name="SpotlightDetails" VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock x:Name="SpotlightTitle" Text="{Binding Game.Name}" FontSize="26" FontWeight="SemiBold" Foreground="#F6F8FC" TextTrimming="CharacterEllipsis" ToolTip="{Binding Game.Name}" />
                <TextBlock Foreground="#C2CDDD" FontSize="11" Margin="0,8,0,0" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding ReleaseStatus, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ReleaseLabel, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
              <StackPanel x:Name="SpotlightActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                          DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                <ui:Button Content="{Binding FeaturedDownloadLabel}" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Padding="16,8" Command="{Binding DownloadFeaturedCommand}" ToolTip="Choose a source and check whether downloadable depots are available" />
                <ui:Button Content="View game" Foreground="#F6F8FC" Appearance="Transparent" Padding="10,8" Margin="8,0,0,0" Command="{Binding ViewFeaturedCommand}" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel Margin="0,0,0,26" Visibility="{Binding HasSpotlight, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="New &amp; upcoming" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding NewGames}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:AdaptiveGridPanel MinItemWidth="185" MaxColumns="3" Spacing="16" CoverRatio="0.42" FooterHeight="44" MaxRows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Style="{StaticResource CoverCardButton}" ToolTip="{Binding Game.Name}" CommandParameter="{Binding}"
                    Command="{Binding DataContext.OpenSpotlightCommand, RelativeSource={RelativeSource AncestorType=Page}}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="12" Background="{Binding Game.CoverColor}" />
                <Border Grid.Row="0" CornerRadius="12" RenderOptions.BitmapScalingMode="HighQuality">
                  <Border.Background><ImageBrush ImageSource="{Binding Game.HeaderImage}" Stretch="UniformToFill" /></Border.Background>
                </Border>
                <StackPanel Grid.Row="1" Margin="2,9,2,0">
                  <TextBlock Text="{Binding Game.Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding ReleaseLabel}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Grid x:Name="QuickActionsGrid" Margin="0,0,0,28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="QuickActionsGutter" Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border x:Name="ContinueCard" Style="{StaticResource QuickCard}">
          <Grid>
            <Grid Visibility="{Binding HasContinueGame, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="66" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Border Height="46" Width="66" CornerRadius="7" VerticalAlignment="Center" Background="{DynamicResource SurfaceElevatedBrush}">
                <Border CornerRadius="7"><Border.Background><ImageBrush ImageSource="{Binding ContinueGame.Game.HeaderImage}" Stretch="UniformToFill" /></Border.Background></Border>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="Continue" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{Binding ContinueGame.Game.Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
              </StackPanel>
              <ui:Button Grid.Column="2" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Padding="10,8" VerticalAlignment="Center"
                         Command="{Binding ContinueGameCommand}" ToolTip="{Binding ContinueGame.OpenedLabel}" AutomationProperties.Name="Continue playing" />
            </Grid>
            <Grid>
              <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                <DataTrigger Binding="{Binding HasContinueGame}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              </Style.Triggers></Style></Grid.Style>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold">
                  <Run Text="{Binding InstalledCount, Mode=OneWay}" /><Run Text=" installed games" />
                </TextBlock>
                <TextBlock Text="{Binding InstalledSummary}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <ui:Button Grid.Column="1" Content="Library" Appearance="Transparent" Padding="10,8" VerticalAlignment="Center" Command="{Binding NavigateLibraryCommand}" />
            </Grid>
          </Grid>
        </Border>
        <Border x:Name="CurrentDownloadCard" Grid.Column="2" Style="{StaticResource QuickCard}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,7">
              <TextBlock Text="Downloads" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
              <ui:Button Content="Open queue" Appearance="Transparent" HorizontalAlignment="Right" Padding="0,0,0,0" FontSize="10.5" Command="{Binding NavigateDownloadsCommand}" />
            </Grid>
            <Grid Grid.Row="1" DataContext="{Binding HeroDownload}" Visibility="{Binding DataContext.ShowDownloadHero, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10.5" Margin="0,4,0,7" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding StateLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ProgressLabel, Mode=OneWay}" />
                </TextBlock>
                <controls:SmoothProgressBar SmoothValue="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" Height="2" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Pause" Appearance="Transparent" Style="{StaticResource PauseButton}" Padding="8,6" CommandParameter="{Binding}" Command="{Binding DataContext.DownloadActions.PauseCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                <ui:Button Content="Resume" Appearance="Transparent" Style="{StaticResource ResumeButton}" Padding="8,6" CommandParameter="{Binding}" Command="{Binding DataContext.DownloadActions.ResumeCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                <ui:Button Content="Start" Appearance="Transparent" Style="{StaticResource StartButton}" Padding="8,6" CommandParameter="{Binding}" Command="{Binding DataContext.DownloadActions.StartCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
              </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Text="Queue is empty" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"
                       Visibility="{Binding ShowNoJobs, Converter={StaticResource BoolToVis}}" />
          </Grid>
        </Border>
      </Grid>

      <StackPanel Visibility="{Binding HasFavoriteGames, Converter={StaticResource BoolToVis}}" Margin="0,0,0,26">
        <Grid Margin="0,0,0,12">
          <TextBlock Text="Favorites" Style="{StaticResource SectionTitle}" />
          <ui:Button Content="All favorites" Appearance="Transparent" HorizontalAlignment="Right" Command="{Binding NavigateFavoritesCommand}" FontSize="11" Padding="0,5" />
        </Grid>
        <ItemsControl ItemsSource="{Binding FavoriteGames}" ItemTemplate="{StaticResource PersonalLibraryCard}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:AdaptiveGridPanel MinItemWidth="185" MaxColumns="4" Spacing="16" CoverRatio="0.42" FooterHeight="44" MaxRows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>

      <StackPanel Visibility="{Binding HasRecentGames, Converter={StaticResource BoolToVis}}" Margin="0,0,0,26">
        <Grid Margin="0,0,0,12">
          <TextBlock Text="Installed" Style="{StaticResource SectionTitle}" />
          <ui:Button Content="All games" Appearance="Transparent" HorizontalAlignment="Right" Command="{Binding NavigateLibraryCommand}" FontSize="11" Padding="0,5" />
        </Grid>
        <ItemsControl ItemsSource="{Binding PersonalLibrary}" ItemTemplate="{StaticResource PersonalLibraryCard}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:AdaptiveGridPanel MinItemWidth="185" MaxColumns="4" Spacing="16" CoverRatio="0.42" FooterHeight="44" MaxRows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>

      <StackPanel Visibility="{Binding HasRecentlyOpenedGames, Converter={StaticResource BoolToVis}}">
        <Grid Margin="0,0,0,10">
          <TextBlock Text="Recently opened" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="Opened through Steamy" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <ItemsControl ItemsSource="{Binding RecentlyOpenedGames}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <ui:Button Content="{Binding Game.Name}" Appearance="Transparent" Padding="12,7" Margin="0,0,8,8" ToolTip="{Binding OpenedLabel}"
                       Tag="{Binding Game}" Click="GameCover_Click" />
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
