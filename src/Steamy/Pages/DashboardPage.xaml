<Page x:Class="Steamy.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      UseLayoutRounding="True" SnapsToDevicePixels="True"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="LandscapeGameCard" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Card">
              <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
              <Border Background="{Binding CoverColor}" CornerRadius="16" />
              <Border CornerRadius="16" RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Background><ImageBrush ImageSource="{Binding HeaderImage}" Stretch="UniformToFill" /></Border.Background>
              </Border>
              <Border CornerRadius="16">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00090D14" Offset="0.1" />
                    <GradientStop Color="#40090D14" Offset="0.45" />
                    <GradientStop Color="#F0090D14" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <StackPanel Margin="15,12" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Size}" Foreground="#BFCDDA" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Border x:Name="Ring" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="16" Opacity="0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-3" Duration="{StaticResource HoverAnimationDuration}" />
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="{StaticResource HoverAnimationDuration}" />
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" controls:SmoothScroll.Enabled="True" Padding="28,18,28,36">
    <StackPanel MaxWidth="1600">
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Home" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>
        <ui:TextBox x:Name="DashboardSearch" Grid.Column="1" Width="340" Height="38"
                    PlaceholderText="Search games or App ID…" Icon="{ui:SymbolIcon Search24}"
                    KeyDown="DashboardSearch_KeyDown" ToolTip="Press Enter to search Games" />
        <ui:Button Grid.Column="2" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowSync24}" Margin="12,0,0,0"
                   Command="{Binding RefreshCommand}" ToolTip="Refresh your library" AutomationProperties.Name="Refresh library" />
      </Grid>

      <!-- Art fills the whole hero; overlays keep the text readable for every game. -->
      <Grid x:Name="DashboardHero" Height="450" Margin="0,0,0,28" DataContext="{Binding FeaturedGame}">
        <Border CornerRadius="24">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#172B42" /><GradientStop Color="#1B2638" Offset="0.5" /><GradientStop Color="#0C111B" Offset="1" />
          </LinearGradientBrush></Border.Background>
        </Border>
        <Border CornerRadius="24" RenderOptions.BitmapScalingMode="HighQuality">
          <Border.Background><ImageBrush ImageSource="{Binding HeroArtwork}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" /></Border.Background>
        </Border>
        <Border CornerRadius="24">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F5090E16" Offset="0" /><GradientStop Color="#BD090E16" Offset="0.28" />
            <GradientStop Color="#28090E16" Offset="0.72" /><GradientStop Color="#00090E16" Offset="1" />
          </LinearGradientBrush></Border.Background>
        </Border>
        <Border CornerRadius="24">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00090E16" Offset="0.35" /><GradientStop Color="#E8090E16" Offset="1" />
          </LinearGradientBrush></Border.Background>
        </Border>
        <Border CornerRadius="24" BorderBrush="#28FFFFFF" BorderThickness="1" IsHitTestVisible="False" />
        <StackPanel x:Name="HeroCopy" Margin="36,32,36,38" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="480">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <ui:SymbolIcon Symbol="Sparkle24" FontSize="15" Foreground="#90BEFF" Margin="0,0,8,0" />
            <TextBlock Text="FEATURED" Foreground="#B5D4FF" FontSize="11" FontWeight="Bold" />
          </StackPanel>
          <TextBlock x:Name="HeroTitle" Text="{Binding Game.Name}" Foreground="White" FontSize="46" FontWeight="Bold" TextWrapping="Wrap" LineHeight="51" />
          <TextBlock Text="{Binding Description}" Foreground="#CFD8E3" FontSize="14" LineHeight="23" TextWrapping="Wrap" Margin="0,16,0,0" />
          <TextBlock Text="{Binding Genres}" Foreground="#A7B9CF" FontSize="11.5" Margin="0,16,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
            <ui:Button Content="View game" Icon="{ui:SymbolIcon Games24}" Appearance="Primary" Padding="22,12" MinHeight="46"
                       Command="{Binding DataContext.ViewFeaturedCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
            <TextBlock Text="Discover in Games" Foreground="#ABBDCF" FontSize="11.5" VerticalAlignment="Center" Margin="16,0,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28"
                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
          <TextBlock Text="{Binding FeaturedPosition}" Foreground="#BAC8DA" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" />
          <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" Appearance="Secondary" Width="38" Height="38" Padding="0"
                     Command="{Binding PreviousFeaturedCommand}" ToolTip="Previous featured game" AutomationProperties.Name="Previous featured game" />
          <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" Appearance="Secondary" Width="38" Height="38" Padding="0" Margin="8,0,0,0"
                     Command="{Binding NextFeaturedCommand}" ToolTip="Next featured game" AutomationProperties.Name="Next featured game" />
        </StackPanel>
      </Grid>

      <StackPanel Visibility="{Binding HasRecentGames, Converter={StaticResource BoolToVis}}" Margin="0,0,0,28">
        <Grid Margin="0,0,0,16">
          <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="History24" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" /><TextBlock Text="Jump back in" Style="{StaticResource SectionTitle}" /></StackPanel>
          <ui:Button Content="Your library" Appearance="Transparent" HorizontalAlignment="Right" Command="{Binding NavigateLibraryCommand}" Icon="{ui:SymbolIcon ChevronRight24}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding RecentGames}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:AdaptiveGridPanel MinItemWidth="210" MaxColumns="4" Spacing="16" CoverRatio="0.5" FooterHeight="0" MaxRows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Tag="{Binding}" Click="GameCover_Click" Style="{StaticResource LandscapeGameCard}" ToolTip="{Binding Name}" />
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Margin="0,0,0,28">
        <Grid Margin="0,0,0,16">
          <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Sparkle24" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" /><TextBlock Text="Find your next adventure" Style="{StaticResource SectionTitle}" /></StackPanel>
          <ui:Button Content="Browse all" Appearance="Transparent" HorizontalAlignment="Right" Command="{Binding NavigateLibraryCommand}" Icon="{ui:SymbolIcon ChevronRight24}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding DiscoverGames}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:AdaptiveGridPanel MinItemWidth="175" MaxColumns="5" Spacing="16" CoverRatio="0.68" FooterHeight="0" MaxRows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button DataContext="{Binding Game}" Tag="{Binding}" Click="GameCover_Click" Style="{StaticResource LandscapeGameCard}" ToolTip="{Binding Name}" />
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Discover games in the catalog. Source availability is checked when you select a game."
                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
      </StackPanel>

      <Border CornerRadius="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="20,16" Margin="0,0,0,24"
              Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <Grid Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowDownload24" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" /><TextBlock Text="Downloads" Style="{StaticResource SectionTitle}" /></StackPanel>
            <ui:Button Content="Open queue" Appearance="Transparent" HorizontalAlignment="Right" Command="{Binding NavigateDownloadsCommand}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding ActiveJobs}"><ItemsControl.ItemTemplate><DataTemplate>
            <Grid Margin="0,8,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,18,0">
                <TextBlock Text="{Binding GameName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,4,0,6" TextTrimming="CharacterEllipsis" />
                <controls:SmoothProgressBar SmoothValue="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" Height="3" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding ProgressLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Pause" Appearance="Transparent" Style="{StaticResource PauseButton}" CommandParameter="{Binding}" Command="{Binding DataContext.DownloadActions.PauseCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                <ui:Button Content="Resume" Appearance="Transparent" Style="{StaticResource ResumeButton}" CommandParameter="{Binding}" Command="{Binding DataContext.DownloadActions.ResumeCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                <ui:Button Content="Start" Appearance="Transparent" Style="{StaticResource StartButton}" CommandParameter="{Binding}" Command="{Binding DataContext.DownloadActions.StartCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
              </StackPanel>
            </Grid>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Explore free manifest sources" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="Sushi · Zaza · No API key needed" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button Content="SushiTools" Appearance="Secondary" Command="{Binding ExploreSourceCommand}" CommandParameter="Sushi" Margin="12,0,8,0" />
          <ui:Button Content="Zaza" Appearance="Transparent" Command="{Binding ExploreSourceCommand}" CommandParameter="Zaza" />
        </StackPanel>
      </Grid>
      <TextBlock Text="{Binding LibraryNotice}" Visibility="{Binding ShowLibraryNotice, Converter={StaticResource BoolToVis}}"
                 Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,22,0,0" />
    </StackPanel>
  </ScrollViewer>
</Page>
