<Page x:Class="Steamy.Pages.CommunityPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:Steamy.Controls" Background="Transparent" ScrollViewer.CanContentScroll="False">
 <ScrollViewer Style="{StaticResource PageScrollHostStyle}"><StackPanel Margin="28,24,28,28" MaxWidth="1080" HorizontalAlignment="Stretch">
  <TextBlock Text="Good company starts here." Style="{StaticResource PageTitleStyle}" />
  <TextBlock Text="Meet the community, find someone to play with and bring your party together." Style="{StaticResource PageSubtitleStyle}" />
  <Border Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="32" Margin="0,10,0,24">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Width="80" Height="80" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}" controls:RoundedClip.Radius="22" Margin="0,0,26,0" VerticalAlignment="Top"><Grid><ui:SymbolIcon Symbol="People24" FontSize="36" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image controls:AsyncArtwork.Private="True" controls:AsyncArtwork.Width="160" controls:AsyncArtwork.Url="{Binding Server.IconUrl}" Stretch="UniformToFill" /></Grid></Border>
    <StackPanel Grid.Column="1"><TextBlock Text="THE STEAMY COMMUNITY" Style="{StaticResource FieldLabelStyle}" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding Server.Name}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,8" /><TextBlock Text="{Binding Server.Activity}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" /><TextBlock Text="Talk games, find teammates, share your setup and catch the latest Steamy updates." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" LineHeight="23" TextWrapping="Wrap" Margin="0,18,0,22" MaxWidth="620" HorizontalAlignment="Left" /><ui:Button Content="Join the Discord" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenCommand}" Appearance="Primary" CornerRadius="10" Padding="18,11" HorizontalAlignment="Left" /><TextBlock Text="Opens the invite in Discord or your browser." FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,0" /></StackPanel>
   </Grid>
  </Border>
  <TextBlock Text="Your next session" Style="{StaticResource SectionTitleStyle}" />
  <TextBlock Text="Add your teammates in Friends, create a party around an installed game and send them an invitation." FontSize="14" LineHeight="23" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" />
  <ui:Button Content="Open Friends" Icon="{ui:SymbolIcon Chat24}" Click="Friends_Click" Appearance="Secondary" CornerRadius="10" Padding="16,10" Margin="0,18,0,0" HorizontalAlignment="Left" />
  <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,32,0,0" Padding="0,20,0,0"><StackPanel><TextBlock Text="Enjoying Steamy? Don't forget to star the repo. Thanks for your support!" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /><ui:Button Content="Star on GitHub ↗" Command="{Binding StarRepoCommand}" Appearance="Secondary" CornerRadius="10" Padding="14,8" Margin="0,12,0,0" HorizontalAlignment="Left" /></StackPanel></Border>
  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,24,0,0" />
 </StackPanel></ScrollViewer>
</Page>
