<Page x:Class="Steamy.Pages.SharePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:pages="clr-namespace:Steamy.Pages"
      xmlns:vm="clr-namespace:Steamy.ViewModels"
      xmlns:services="clr-namespace:Steamy.Services"
      ScrollViewer.CanContentScroll="False"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <pages:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

    <!-- Rows select by click or Space; the ListBox runs in Multiple mode and every container is
         bound to the item's IsSelected, so the view model stays the single source of truth. -->
    <Style x:Key="ShareRowStyle" TargetType="ListBoxItem">
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" CornerRadius="12" Padding="12,9" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StatusPill" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsNew}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ShareItemState.Sending}">
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ShareItemState.Sent}">
          <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ShareItemState.Failed}">
          <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StatusPillText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsNew}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ShareItemState.Sending}">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ShareItemState.Sent}">
          <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ShareItemState.Failed}">
          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SourceTag" TargetType="Border" BasedOn="{StaticResource TagStyle}">
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding SourceKind}" Value="{x:Static services:ShareSourceKind.SteamLibrary}">
          <Setter Property="Background" Value="{DynamicResource VioletSoftBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding SourceKind}" Value="{x:Static services:ShareSourceKind.Lua}">
          <Setter Property="Background" Value="{DynamicResource PinkSoftBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SourceTagText" TargetType="TextBlock" BasedOn="{StaticResource TagTextStyle}">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding SourceKind}" Value="{x:Static services:ShareSourceKind.SteamLibrary}">
          <Setter Property="Foreground" Value="{DynamicResource VioletBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding SourceKind}" Value="{x:Static services:ShareSourceKind.Lua}">
          <Setter Property="Foreground" Value="{DynamicResource PinkBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ResultBanner" TargetType="Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ResultSuccess}" Value="True">
          <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>

  <Grid Margin="40,28,40,24" MaxWidth="1320">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Style="{StaticResource EnterStyle1}" Margin="0,0,0,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource BrandGradientBrush}" VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="Share24" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="Share manifests" Style="{StaticResource PageTitleStyle}" Margin="0" />
        <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"
                   Text="Every manifest you have — installed games, Lua scripts and all cached manifests, installed or not. Pick what you want, then send it in one go." />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <ui:ProgressRing Width="18" Height="18" Margin="0,0,14,0" IsIndeterminate="True"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
        <ui:Button Content="Rescan" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}"
                   Command="{Binding RescanCommand}" />
      </StackPanel>
    </Grid>

    <!-- Numbers -->
    <UniformGrid Grid.Row="1" Columns="4" Margin="-7,0,-7,16" Style="{StaticResource EnterStyle2}">
      <Border Style="{StaticResource CardStyle}" Margin="7,0" Padding="18,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconChipStyle}" Background="{DynamicResource AccentSoftBrush}">
            <ui:SymbolIcon Symbol="Games24" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding TotalCountLabel}" Style="{StaticResource KpiValueStyle}" />
            <TextBlock Text="{Binding SourcesLabel}" Style="{StaticResource CaptionStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource CardStyle}" Margin="7,0" Padding="18,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconChipStyle}" Background="{DynamicResource SuccessSoftBrush}">
            <ui:SymbolIcon Symbol="Sparkle24" FontSize="18" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding NewCountLabel}" Style="{StaticResource KpiValueStyle}" />
            <TextBlock Text="{Binding LastShareLabel}" Style="{StaticResource CaptionStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource CardStyle}" Margin="7,0" Padding="18,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconChipStyle}" Background="{DynamicResource VioletSoftBrush}">
            <ui:SymbolIcon Symbol="DocumentMultiple24" FontSize="18" Foreground="{DynamicResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding TotalSizeLabel}" Style="{StaticResource KpiValueStyle}" />
            <TextBlock Text="{Binding TotalFilesLabel}" Style="{StaticResource CaptionStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource CardStyle}" Margin="7,0" Padding="18,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconChipStyle}" Background="{DynamicResource PinkSoftBrush}">
            <ui:SymbolIcon Symbol="CloudArrowUp24" FontSize="18" Foreground="{DynamicResource PinkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding TargetLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding BranchLabel}" />
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasToken}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding TokenStatus}" Style="{StaticResource CaptionStyle}" />
            </StackPanel>
          </StackPanel>
          <ui:Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Appearance="Transparent"
                     Icon="{ui:SymbolIcon Settings24}" ToolTip="Repository and token (Settings)"
                     Command="{Binding OpenSettingsCommand}" />
        </Grid>
      </Border>
    </UniformGrid>

    <!-- Toolbar -->
    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,12" CornerRadius="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="360" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Search by name or App ID…" Icon="{ui:SymbolIcon Search24}" />
        <Border Grid.Column="1" Style="{StaticResource SegmentHostStyle}" Margin="10,0,0,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource SegmentButtonStyle}" GroupName="ShareFilter" Content="All" IsChecked="{Binding ShowAll}" />
            <RadioButton Style="{StaticResource SegmentButtonStyle}" GroupName="ShareFilter" Content="New" IsChecked="{Binding ShowNew}" />
            <RadioButton Style="{StaticResource SegmentButtonStyle}" GroupName="ShareFilter" Content="Installed" IsChecked="{Binding ShowInstalled}" />
            <RadioButton Style="{StaticResource SegmentButtonStyle}" GroupName="ShareFilter" Content="Lua" IsChecked="{Binding ShowLua}" />
            <RadioButton Style="{StaticResource SegmentButtonStyle}" GroupName="ShareFilter" Content="Other" IsChecked="{Binding ShowManifests}"
                         ToolTip="Manifests of games that are not installed and have no Lua" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button Style="{StaticResource LinkButtonStyle}" Content="Select new" Icon="{ui:SymbolIcon Sparkle24}"
                     Command="{Binding SelectNewCommand}" />
          <ui:Button Style="{StaticResource LinkButtonStyle}" Content="Select all" Icon="{ui:SymbolIcon CheckmarkCircle24}"
                     Command="{Binding SelectAllCommand}" />
          <ui:Button Style="{StaticResource LinkButtonStyle}" Content="Clear" Foreground="{DynamicResource TextSecondaryBrush}"
                     Command="{Binding ClearSelectionCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- List -->
    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,12">
      <Grid>
        <ListBox ItemsSource="{Binding Items}"
                 SelectionMode="Multiple"
                 ItemContainerStyle="{StaticResource ShareRowStyle}"
                 Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" IsHitTestVisible="False" Focusable="False"
                          VerticalAlignment="Center" MinWidth="0" Margin="0,0,6,0" />
                <Grid Grid.Column="1" Width="112" Height="42" VerticalAlignment="Center">
                  <Border CornerRadius="7" Background="{DynamicResource SurfaceSubtleBrush}">
                    <ui:SymbolIcon Symbol="Games24" FontSize="16" Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Border CornerRadius="7" RenderOptions.BitmapScalingMode="HighQuality">
                    <Border.Background>
                      <ImageBrush ImageSource="{Binding CapsuleUrl}" Stretch="UniformToFill" />
                    </Border.Background>
                  </Border>
                </Grid>
                <StackPanel Grid.Column="2" Margin="14,0,12,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Border Style="{StaticResource SourceTag}">
                      <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource SourceTagText}" />
                    </Border>
                    <Border Style="{StaticResource TagStyle}" Margin="6,0,0,0">
                      <TextBlock Text="{Binding AppIdLabel}" Style="{StaticResource TagTextStyle}" Typography.NumeralAlignment="Tabular" />
                    </Border>
                    <TextBlock Text="{Binding ContentSummary}" Style="{StaticResource CaptionStyle}" Margin="10,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" FontSize="12" Margin="0,0,16,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular" />
                <Border Grid.Column="4" Style="{StaticResource StatusPill}" MinWidth="86">
                  <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusPillText}" HorizontalAlignment="Center" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Filter matches nothing -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVis}}">
          <ui:SymbolIcon Symbol="SearchInfo24" FontSize="30" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="Nothing matches this filter." Style="{StaticResource BodyTextStyle}" Margin="0,10,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Nothing at all -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24"
                    Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
          <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource PinkSoftBrush}" HorizontalAlignment="Center">
            <ui:SymbolIcon Symbol="Share24" FontSize="28" Foreground="{DynamicResource PinkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Nothing to share yet" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                     HorizontalAlignment="Center" Margin="0,14,0,0" />
          <TextBlock Text="Install or download games through Steam or Steamy, or put Lua scripts into SteamTools — their manifests show up here automatically."
                     Style="{StaticResource BodyTextStyle}" TextAlignment="Center" Margin="0,6,0,0" />
          <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <ui:Button Style="{StaticResource HeroButtonStyle}" Content="Rescan" Appearance="Primary"
                       Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RescanCommand}" />
            <ui:Button Style="{StaticResource HeroButtonStyle}" Content="Games" Appearance="Secondary"
                       Icon="{ui:SymbolIcon Apps24}" Command="{Binding OpenLibraryCommand}" />
            <ui:Button Style="{StaticResource HeroButtonStyle}" Content="Settings" Appearance="Secondary" Margin="0"
                       Icon="{ui:SymbolIcon Settings24}" Command="{Binding OpenSettingsCommand}" />
          </StackPanel>
        </StackPanel>

        <ui:ProgressRing Width="28" Height="28" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ui:ProgressRing.Style>
            <Style TargetType="ui:ProgressRing" BasedOn="{StaticResource {x:Type ui:ProgressRing}}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsScanning}" Value="True" />
                    <Condition Binding="{Binding HasItems}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </ui:ProgressRing.Style>
        </ui:ProgressRing>
      </Grid>
    </Border>

    <!-- Result -->
    <Border Grid.Row="4" Style="{StaticResource ResultBanner}" Margin="0,0,0,12"
            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0">
          <ui:SymbolIcon.Style>
            <Style TargetType="ui:SymbolIcon">
              <Setter Property="Symbol" Value="ErrorCircle24" />
              <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ResultSuccess}" Value="True">
                  <Setter Property="Symbol" Value="CheckmarkCircle24" />
                  <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:SymbolIcon.Style>
        </ui:SymbolIcon>
        <TextBlock Grid.Column="1" Text="{Binding ResultMessage}" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <ui:Button Grid.Column="2" Style="{StaticResource LinkButtonStyle}" Content="Open" Icon="{ui:SymbolIcon Open24}"
                   Command="{Binding OpenResultCommand}" Margin="8,0,0,0"
                   Visibility="{Binding HasResultLink, Converter={StaticResource BoolToVis}}" />
        <ui:Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Appearance="Transparent" Width="30" Height="30" MinHeight="30"
                   Icon="{ui:SymbolIcon Dismiss24}" FontSize="12" ToolTip="Dismiss" Command="{Binding DismissResultCommand}" />
      </Grid>
    </Border>

    <!-- Action bar -->
    <Border Grid.Row="5" Style="{StaticResource CardStyle}" Padding="18,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{Binding SelectionSummary}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="13" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                       Text="Only manifests, Lua and keys are packed. Your Steam account, SteamID and local paths are never included." />
          </StackPanel>
        </StackPanel>

        <StackPanel VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ProgressText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:0}%}" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Typography.NumeralAlignment="Tabular" Margin="12,0,0,0" />
          </Grid>
          <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,8,24,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <ui:Button Content="Cancel" Appearance="Secondary" Icon="{ui:SymbolIcon Dismiss24}" Margin="0,0,8,0"
                     Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
          <ui:Button Content="Save as ZIP" Appearance="Secondary" Icon="{ui:SymbolIcon FolderZip24}" Margin="0,0,8,0"
                     IsEnabled="{Binding CanExport}" Click="ExportZip_Click"
                     ToolTip="One ZIP with every selected game in its own folder — send it anywhere, no token needed." />
          <ui:Button Content="{Binding ShareButtonLabel}" Appearance="Primary" Icon="{ui:SymbolIcon Send24}" Padding="20,9" MinHeight="38"
                     FontWeight="SemiBold" Command="{Binding ShareSelectedCommand}"
                     ToolTip="Sends every selected game to the dump repository in one commit." />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
