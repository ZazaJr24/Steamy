<Page x:Class="Steamy.Pages.DownloadsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      ScrollViewer.CanContentScroll="False"
      UseLayoutRounding="True" SnapsToDevicePixels="True"
      Background="{DynamicResource WorkspaceBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis" />
    <LinearGradientBrush x:Key="DownloadSideShade" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#DA171A20" Offset="0" />
      <GradientStop Color="#70171A20" Offset="0.55" />
      <GradientStop Color="#30171A20" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DownloadBottomShade" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#00171A20" Offset="0" />
      <GradientStop Color="#40171A20" Offset="0.42" />
      <GradientStop Color="#F4171A20" Offset="1" />
    </LinearGradientBrush>

    <!-- Queue row: a solid card with a quiet hover outline. -->
    <Style x:Key="QueueRow" TargetType="Border" BasedOn="{StaticResource JobCardEntrance}">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource ControlHoverBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="QueueOnlyButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers><DataTrigger Binding="{Binding StateLabel}" Value="Queued"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
    </Style>

    <Style x:Key="HideWhenEmpty" TargetType="TextBlock" BasedOn="{StaticResource JobNumberText}">
      <Style.Triggers>
        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
      </Style.Triggers>
    </Style>

    <!-- One row, used for the queue and for finished downloads -->
    <DataTemplate x:Key="JobRowTemplate">
      <Border Style="{StaticResource QueueRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Game art -->
          <Grid Width="64" Height="48">
            <Border CornerRadius="12" Background="{Binding CoverColor}">
              <TextBlock Text="{Binding CoverGlyph}" FontSize="20" Foreground="#44FFFFFF"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border CornerRadius="12">
              <Border.Background>
                <ImageBrush ImageSource="{Binding HeaderArtUrl, Converter={StaticResource ArtworkImage}, ConverterParameter=256}" Stretch="UniformToFill" />
              </Border.Background>
            </Border>
          </Grid>

          <!-- Title, progress, details -->
          <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding GameName}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding GameName}" />
            <WrapPanel Margin="0,5,0,0">
              <Border Style="{StaticResource StatePill}" Padding="7,2">
                <TextBlock Text="{Binding StateLabel}" Style="{StaticResource StatePillText}" />
              </Border>
              <TextBlock Text="{Binding AppLabel}" Style="{StaticResource CaptionStyle}" Margin="10,0,0,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource CaptionStyle}" Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="{Binding DownloadMode}" />
              <TextBlock Text="{Binding Priority, StringFormat='Priority: {0}'}" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding StateLabel}" Value="Queued"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </WrapPanel>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <controls:SmoothProgressBar SmoothValue="{Binding Progress}" IsIndeterminate="{Binding IsProgressIndeterminate}" Maximum="100" Height="5"
                                          Style="{StaticResource JobProgressBar}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding ProgressCaption}" Style="{StaticResource JobNumberText}"
                         Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                         Margin="12,0,0,0" MinWidth="46" TextAlignment="Right" />
            </Grid>
            <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" ToolTip="{Binding Status}" />
            <WrapPanel Margin="0,6,0,0">
              <TextBlock Text="{Binding SizeSummary}" Style="{StaticResource HideWhenEmpty}" FontSize="11.5" Margin="0,0,14,0" />
              <TextBlock Text="{Binding SpeedDisplay}" Style="{StaticResource HideWhenEmpty}" FontSize="11.5" Margin="0,0,14,0"
                         Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding EtaDisplay}" Style="{StaticResource HideWhenEmpty}" FontSize="11.5" />
            </WrapPanel>
          </StackPanel>

          <!-- Actions -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button Icon="{ui:SymbolIcon ArrowUp24}" ToolTip="Move up within this priority" AutomationProperties.Name="Move download up"
                       Style="{StaticResource QueueOnlyButton}" Width="30" Height="30" Padding="0" CornerRadius="15"
                       Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
            <ui:Button Icon="{ui:SymbolIcon ArrowDown24}" ToolTip="Move down within this priority" AutomationProperties.Name="Move download down"
                       Style="{StaticResource QueueOnlyButton}" Width="30" Height="30" Padding="0" CornerRadius="15"
                       Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
            <ui:Button Icon="{ui:SymbolIcon Star24}" ToolTip="Change priority: Normal → High → Low" AutomationProperties.Name="Change download priority"
                       Style="{StaticResource QueueOnlyButton}" Width="30" Height="30" Padding="0" CornerRadius="15"
                       Command="{Binding DataContext.CyclePriorityCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
            <ui:Button Icon="{ui:SymbolIcon Play24}" ToolTip="Start" AutomationProperties.Name="Start" Appearance="Primary"
                       Style="{StaticResource StartButton}" Width="34" Height="34" Padding="0" CornerRadius="17"
                       Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       CommandParameter="{Binding}" />
            <ui:Button Icon="{ui:SymbolIcon Pause24}" ToolTip="Pause" AutomationProperties.Name="Pause" Appearance="Secondary"
                       Style="{StaticResource PauseButton}" Width="34" Height="34" Padding="0" CornerRadius="17"
                       Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       CommandParameter="{Binding}" />
            <ui:Button Icon="{ui:SymbolIcon Play24}" ToolTip="Resume" AutomationProperties.Name="Resume" Appearance="Primary"
                       Style="{StaticResource ResumeButton}" Width="34" Height="34" Padding="0" CornerRadius="17"
                       Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       CommandParameter="{Binding}" />
            <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Retry" AutomationProperties.Name="Retry" Appearance="Secondary"
                       Style="{StaticResource RetryButton}" Width="34" Height="34" Padding="0" CornerRadius="17"
                       Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       CommandParameter="{Binding}" />
            <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="Verify &amp; repair using the downloader manifests" AutomationProperties.Name="Verify and repair" Appearance="Secondary"
                       Style="{StaticResource RepairButton}" Width="34" Height="34" Padding="0" CornerRadius="17"
                       Command="{Binding DataContext.RepairCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
            <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Open folder" AutomationProperties.Name="Open folder" Appearance="Secondary"
                       Style="{StaticResource CompletedOnlyButton}" Width="34" Height="34" Padding="0" CornerRadius="17"
                       Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       CommandParameter="{Binding}" />
            <ui:Button Icon="{ui:SymbolIcon ShieldCheckmark24}" ToolTip="Check local files: inspect the target folder without claiming a manifest verification" AutomationProperties.Name="Check local files" Appearance="Secondary"
                       Style="{StaticResource CompletedOnlyButton}" Width="34" Height="34" Padding="0" CornerRadius="17"
                       Command="{Binding DataContext.VerifyCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       CommandParameter="{Binding}" />
            <ui:Button Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Cancel" AutomationProperties.Name="Cancel" Appearance="Secondary"
                       Style="{StaticResource CancelButton}" Width="34" Height="34" Padding="0" CornerRadius="17"
                       Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       CommandParameter="{Binding}" />
            <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="Remove from list" AutomationProperties.Name="Remove from list" Appearance="Secondary"
                       Style="{StaticResource RemoveButton}" Width="34" Height="34" Padding="0" CornerRadius="17"
                       Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       CommandParameter="{Binding}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid Margin="28,22,28,20" MaxWidth="1480">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,14" controls:EntranceMotion.Delay="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Downloads" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0" />
        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0">
          <Run Text="{Binding ActiveCount, Mode=OneWay}" /><Run Text=" active   ·   " />
          <Run Text="{Binding QueuedJobCount, Mode=OneWay}" /><Run Text=" queued   ·   " />
          <Run Text="{Binding CompletedCount, Mode=OneWay}" /><Run Text=" completed" />
        </TextBlock>
      </StackPanel>
      <WrapPanel Grid.Column="1" x:Name="DownloadHeaderActions" VerticalAlignment="Center">
        <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}" ToolTip="Set up a depot download" AutomationProperties.Name="Open DepotDownloader" Command="{Binding NavigateDepotDownloaderCommand}" Margin="0,0,8,0" />
        <ui:Button Icon="{ui:SymbolIcon Play24}" ToolTip="Start queue" AutomationProperties.Name="Start queue" Appearance="Primary" Command="{Binding StartQueuedCommand}" Margin="0,0,8,0" />
        <ui:Button Content="Stop queue" Command="{Binding StopQueueCommand}" Margin="0,0,8,0" Visibility="{Binding IsQueueRunning, Converter={StaticResource BoolVis}}"
                   ToolTip="Stop starting waiting jobs. Running downloads keep their own Pause and Cancel controls." />
        <ui:Button Icon="{ui:SymbolIcon Apps24}" ToolTip="Browse games" AutomationProperties.Name="Browse games" Command="{Binding NavigateLibraryCommand}" />
      </WrapPanel>
    </Grid>

    <Grid Grid.Row="1" x:Name="FeaturedPanel" Margin="0,0,0,16" controls:EntranceMotion.Delay="20">
      <Border x:Name="DownloadHero" DataContext="{Binding HeroJob}" CornerRadius="22" MinHeight="330" Background="#171A20"
              Visibility="{Binding DataContext.HasHeroJob, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolVis}}">
        <Grid>
          <Border CornerRadius="22" Background="{Binding CoverColor}" />
          <Border CornerRadius="22"><Border.Background><ImageBrush ImageSource="{Binding HeaderArtUrl, Converter={StaticResource ArtworkImage}, ConverterParameter=1280}" Stretch="UniformToFill" /></Border.Background></Border>
          <Border x:Name="DownloadHeroArtwork" CornerRadius="22"><Border.Background><ImageBrush ImageSource="{Binding HeroArtUrl, Converter={StaticResource ArtworkImage}, ConverterParameter=1600}" Stretch="UniformToFill" AlignmentY="Center" /></Border.Background></Border>
          <Border CornerRadius="22" Background="{StaticResource DownloadSideShade}" />
          <Border CornerRadius="22" Background="{StaticResource DownloadBottomShade}" />
          <Grid x:Name="DownloadHeroContent" Margin="24,20,24,22">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                <ui:Button Icon="{ui:SymbolIcon Pause24}" ToolTip="Pause download" AutomationProperties.Name="Pause download" Appearance="Secondary" Style="{StaticResource PauseButton}" Width="40" Height="40" Padding="0" CornerRadius="20" Margin="0,0,6,0" Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                <ui:Button Icon="{ui:SymbolIcon Play24}" ToolTip="Resume download" AutomationProperties.Name="Resume download" Appearance="Primary" Style="{StaticResource ResumeButton}" Width="40" Height="40" Padding="0" CornerRadius="20" Margin="0,0,6,0" Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Open target folder" AutomationProperties.Name="Open target folder" Width="36" Height="36" Padding="0" CornerRadius="18" Margin="0,2,6,0" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                <ui:Button Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Cancel download" AutomationProperties.Name="Cancel download" Style="{StaticResource CancelButton}" Width="36" Height="36" Padding="0" CornerRadius="18" Margin="0,2,0,0" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
              </WrapPanel>
              <StackPanel x:Name="DownloadHeroHeading" VerticalAlignment="Bottom" Margin="0,48,0,0">
                <WrapPanel Margin="0,0,0,9">
                  <Border CornerRadius="9" Background="#604A4E58" Padding="9,3"><TextBlock Foreground="#E5E9F1" FontSize="10.5" FontWeight="SemiBold"><Run Text="{Binding PhaseLabel, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding AppLabel, Mode=OneWay}"/></TextBlock></Border>
                  <TextBlock Text="{Binding SourceLabel}" Foreground="#C4CCD8" FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center" />
                </WrapPanel>
                <TextBlock x:Name="DownloadHeroTitle" Text="{Binding GameName}" FontSize="32" FontWeight="SemiBold" Foreground="#F8FAFF" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameName}" />
                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#D4DAE4" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
            <Grid x:Name="DownloadHeroProgressRow" Grid.Row="1" Margin="0,22,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <controls:SmoothProgressBar x:Name="FocusedProgress" SmoothValue="{Binding Progress}" IsIndeterminate="{Binding IsProgressIndeterminate}" Maximum="100" Height="5" Style="{StaticResource JobProgressBar}" Foreground="#F4F7FC" Background="#405C626B" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding ProgressCaption}" Style="{StaticResource JobNumberText}" Foreground="#F8FAFF" FontSize="24" FontWeight="SemiBold" Margin="18,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <UniformGrid Grid.Row="2" x:Name="FocusedMetrics" Columns="4">
              <StackPanel Margin="0,0,8,6"><TextBlock Text="DOWNLOAD SPEED" FontSize="9.5" Foreground="#AAB5C5"/><TextBlock Text="{Binding TransferSpeedDisplay}" FontSize="18" Style="{StaticResource JobNumberText}" Foreground="#F0F4FA" Margin="0,5,0,0"/></StackPanel>
              <StackPanel Margin="0,0,8,6"><TextBlock Text="TIME LEFT" FontSize="9.5" Foreground="#AAB5C5"/><TextBlock Text="{Binding RemainingDisplay}" FontSize="17" Style="{StaticResource JobNumberText}" Foreground="#F0F4FA" TextTrimming="CharacterEllipsis" ToolTip="{Binding RemainingDisplay}" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Margin="0,0,8,6"><TextBlock Text="TRANSFERRED" FontSize="9.5" Foreground="#AAB5C5"/><TextBlock Text="{Binding DownloadedDisplay}" FontSize="18" Style="{StaticResource JobNumberText}" Foreground="#F0F4FA" Margin="0,5,0,0"/></StackPanel>
              <StackPanel Margin="0,0,0,6"><TextBlock Text="DEPOT CONTENT SIZE" FontSize="9.5" Foreground="#AAB5C5" ToolTip="Manifest content size for the active depot. The whole game total is shown only when it is known."/><TextBlock Text="{Binding TotalDisplay}" FontSize="18" Style="{StaticResource JobNumberText}" Foreground="#F0F4FA" Margin="0,5,0,0" ToolTip="Manifest content size for the active depot; compressed transfer size can differ."/></StackPanel>
            </UniformGrid>
            <Grid x:Name="DownloadHeroDetailRow" Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding CurrentDepotDetail}" Foreground="#BAC5D5" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentDepotDetail}" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <ui:Button Grid.Column="1" Content="Details" Icon="{ui:SymbolIcon Info24}" Click="DownloadDetails_Click" Padding="10,4" FontSize="11" />
            </Grid>
          </Grid>
        </Grid>
      </Border>
      <Border CornerRadius="16" Background="{DynamicResource SurfaceElevatedBrush}" Padding="20,18" Visibility="{Binding ShowIdleHero, Converter={StaticResource BoolVis}}">
        <StackPanel>
          <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding IdleHeadline}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0" />
          <TextBlock Text="{Binding IdleDetail}" Style="{StaticResource BodyTextStyle}" Margin="0,6,0,12" TextWrapping="Wrap" />
          <ui:Button Content="Start next download" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" HorizontalAlignment="Left" Visibility="{Binding HasNextQueuedJob, Converter={StaticResource BoolVis}}" Command="{Binding StartCommand}" CommandParameter="{Binding NextQueuedJob}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2" x:Name="DownloadFilters" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <ui:TextBox PlaceholderText="Search downloads or App ID…" Icon="{ui:SymbolIcon Search24}"
                  AutomationProperties.Name="Search downloads" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,0,12,0" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" MinWidth="120" AutomationProperties.Name="Filter download status" />
      <ComboBox Grid.Column="2" ItemsSource="{Binding SourceFilters}" SelectedItem="{Binding SelectedSourceFilter}" MinWidth="102" Margin="8,0,0,0" AutomationProperties.Name="Filter downloads by source" />
      <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" ToolTip="Refresh downloads" AutomationProperties.Name="Refresh downloads" Margin="8,0,0,0" />
    </Grid>

    <!-- A finite viewport and recycling keep large histories from creating every card at once. -->
    <Grid Grid.Row="3">
      <ListBox ItemsSource="{Binding FilteredJobs}" SelectedItem="{Binding SelectedJob}" ItemTemplate="{StaticResource JobRowTemplate}"
               ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
               RequestBringIntoView="JobList_RequestBringIntoView" AutomationProperties.Name="Downloads">
        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Template">
              <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Selection" BorderBrush="Transparent" BorderThickness="2" CornerRadius="19" Margin="0,0,0,6">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                  <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" Visibility="{Binding ShowEmptyResults, Converter={StaticResource BoolVis}}">
        <TextBlock Text="Nothing to show here yet" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding EmptyStateMessage}" Style="{StaticResource BodyTextStyle}" Margin="0,8,0,12" TextAlignment="Center" />
        <ui:Button Content="Clear filters" HorizontalAlignment="Center" Command="{Binding ClearFiltersCommand}"
                   Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolVis}}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="4" Margin="0,8,0,0">
      <TextBlock Text="{Binding ResultLabel}" Style="{StaticResource CaptionStyle}" />
      <TextBlock Text="{Binding QueueStatus}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
      <Expander x:Name="DownloadDetails" Header="Details &amp; recovery" Margin="0,6,0,0" DataContext="{Binding SelectedJob}">
        <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
          <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style></Expander.Style>
        <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14,10">
            <TextBlock Text="{Binding GameName}" Style="{StaticResource CardHeaderStyle}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,10" />
            <WrapPanel Margin="0,0,0,8">
              <Border Style="{StaticResource AccentPillStyle}" Margin="0,0,8,4"><TextBlock Text="{Binding DownloadMode}" Style="{StaticResource AccentPillTextStyle}" /></Border>
              <Border Style="{StaticResource StatusPillStyle}" Margin="0,0,8,4"><TextBlock Text="{Binding DepotLabel}" Style="{StaticResource CaptionStyle}" /></Border>
              <Border Style="{StaticResource StatusPillStyle}" Margin="0,0,8,4"><TextBlock Text="{Binding Branch, StringFormat='Branch: {0}'}" Style="{StaticResource CaptionStyle}" /></Border>
            </WrapPanel>
            <TextBlock Text="{Binding ElapsedDisplay, StringFormat='Active time: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
            <TextBlock Text="{Binding ManifestId, StringFormat='Manifest: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
            <TextBlock Text="{Binding InstallationDisplay, StringFormat='Content size (current depot): {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
            <TextBlock Text="{Binding ReusedDisplay, StringFormat='Verified existing content: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
            <TextBlock Text="{Binding CurrentFile, StringFormat='Current file: {0}'}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentFile}" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding TargetFolder, StringFormat='Folder: {0}'}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetFolder}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
            <WrapPanel Margin="-6,12,0,0">
              <ui:Button Content="Verify &amp; repair" Icon="{ui:SymbolIcon ShieldCheckmark24}" Style="{StaticResource RepairButton}" Appearance="Primary"
                         ToolTip="Run the downloader against its saved manifests; check existing files and download missing or changed data."
                         Command="{Binding DataContext.RepairCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
              <ui:Button Content="Check local files" Icon="{ui:SymbolIcon FolderOpen24}" Style="{StaticResource CheckFilesButton}" Appearance="Secondary"
                         ToolTip="Inspect local files without changing them. This is not a manifest or checksum verification."
                         Command="{Binding DataContext.VerifyCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
            </WrapPanel>
            <Expander Header="Tool output" Margin="0,8,0,0"><TextBox Text="{Binding ProcessLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" /></Expander>
          </StackPanel>
        </ScrollViewer>
      </Expander>
    </StackPanel>
  </Grid>
</Page>
