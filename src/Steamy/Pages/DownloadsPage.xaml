<Page x:Class="Steamy.Pages.DownloadsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      xmlns:models="clr-namespace:Steamy.Models"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis" />
    <Style x:Key="DownloadJobCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>

  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" Padding="32,28,32,40">
    <StackPanel HorizontalAlignment="Stretch">

      <!-- Header row -->
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Downloads" Style="{StaticResource PageTitleStyle}"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button Content="Games" Icon="{ui:SymbolIcon Apps24}"
                     Command="{Binding NavigateLibraryCommand}" Appearance="Secondary"
                     Margin="0,0,6,0"/>
          <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}"
                     Command="{Binding RefreshCommand}" Appearance="Secondary"
                     ToolTip="Refresh"/>
        </StackPanel>
      </Grid>

      <!-- Summary stats -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasJobs}" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}">
          <Run Text="{Binding ActiveCount, Mode=OneWay, StringFormat='{}{0} active'}"/>
          <Run Text="  ·  "/>
          <Run Text="{Binding QueuedJobCount, Mode=OneWay, StringFormat='{}{0} queued'}"/>
          <Run Text="  ·  "/>
          <Run Text="{Binding CompletedCount, Mode=OneWay, StringFormat='{}{0} completed'}"/>
          <Run Text="  ·  "/>
          <Run Text="{Binding FailedCount, Mode=OneWay, StringFormat='{}{0} failed'}"/>
        </TextBlock>
      </StackPanel>

      <!-- ═══ JOB LIST ═══ -->
      <ItemsControl ItemsSource="{Binding FilteredJobs}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource DownloadJobCardStyle}">
              <StackPanel>

                <!-- Main row: icon + info + buttons -->
                <Grid Margin="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- Game icon -->
                  <Border Width="48" Height="48" CornerRadius="6"
                          Background="{Binding CoverColor}"
                          ClipToBounds="True" VerticalAlignment="Top">
                    <Grid>
                      <TextBlock Text="{Binding CoverGlyph}" FontSize="18"
                                 Foreground="#44FFFFFF"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                      <Image Source="{Binding CoverImageUrl, TargetNullValue={x:Null}}"
                             Stretch="UniformToFill"
                             RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                  </Border>

                  <!-- Title + meta -->
                  <StackPanel Grid.Column="1" Margin="12,0,12,0"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding GameName}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding GameName}"/>
                    <TextBlock Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="11.5" Margin="0,2,0,0">
                      <Run Text="{Binding AppLabel, Mode=OneWay}"/>
                      <Run Text="  ·  "/>
                      <Run Text="{Binding DownloadMode, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>

                  <!-- State + action buttons -->
                  <StackPanel Grid.Column="2" Orientation="Horizontal"
                              VerticalAlignment="Center">
                    <Border Style="{StaticResource StatePill}" Margin="0,0,10,0">
                      <TextBlock Text="{Binding StateLabel}"
                                 Style="{StaticResource StatePillText}"/>
                    </Border>
                    <ui:Button Icon="{ui:SymbolIcon Play24}" ToolTip="Start"
                               Style="{StaticResource StartButton}"
                               Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               CommandParameter="{Binding}" Appearance="Primary"/>
                    <ui:Button Icon="{ui:SymbolIcon Pause24}" ToolTip="Pause"
                               Style="{StaticResource PauseButton}"
                               Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               CommandParameter="{Binding}" Appearance="Secondary"/>
                    <ui:Button Icon="{ui:SymbolIcon Play24}" ToolTip="Resume"
                               Style="{StaticResource ResumeButton}"
                               Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               CommandParameter="{Binding}" Appearance="Primary"/>
                    <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Retry"
                               Style="{StaticResource RetryButton}"
                               Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               CommandParameter="{Binding}" Appearance="Secondary"/>
                    <ui:Button Icon="{ui:SymbolIcon ShieldCheckmark24}" ToolTip="Verify"
                               Style="{StaticResource CompletedOnlyButton}"
                               Command="{Binding DataContext.VerifyCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               CommandParameter="{Binding}" Appearance="Secondary"/>
                    <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Open Folder"
                               Style="{StaticResource CompletedOnlyButton}"
                               Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               CommandParameter="{Binding}" Appearance="Secondary"/>
                    <ui:Button Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Cancel"
                               Style="{StaticResource CancelButton}"
                               Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               CommandParameter="{Binding}" Appearance="Danger"/>
                    <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="Remove"
                               Style="{StaticResource RemoveButton}"
                               Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               CommandParameter="{Binding}" Appearance="Secondary"/>
                  </StackPanel>
                </Grid>

                <!-- Progress bar — full width -->
                <Grid Margin="60,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <controls:SmoothProgressBar SmoothValue="{Binding Progress}"
                                              Maximum="100" Height="4"
                                              Style="{StaticResource JobProgressBar}"
                                              VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12" FontWeight="SemiBold"
                             Margin="12,0,0,0" MinWidth="40"
                             TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Stats: size left, speed + ETA right -->
                <Grid Margin="60,5,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding SizeSummary}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SizeSummary}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource AccentBrush}"
                               FontSize="12" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="{Binding Speed}"/>
                          <Setter Property="Visibility" Value="Visible"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Speed}" Value="">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="  ·  " Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="12">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Visible"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Eta}" Value="">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="{Binding Eta}"/>
                          <Setter Property="Visibility" Value="Visible"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Eta}" Value="">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Grid>

                <!-- Status text (depot info) -->
                <TextBlock Text="{Binding Status}" Margin="60,2,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           FontSize="11" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Status}" Opacity="0.7">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <!-- Target folder -->
                <TextBlock Text="{Binding TargetFolder}" Margin="60,1,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           FontSize="10.5" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding TargetFolder}" Opacity="0.5"/>

                <!-- Separator -->
                <Border Height="1" Margin="0,14,0,0"
                        Background="{DynamicResource BorderSubtleBrush}"
                        Opacity="0.3"/>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Empty state -->
      <StackPanel HorizontalAlignment="Center" Margin="0,60,0,0">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasJobs}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="No downloads" FontSize="15"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Browse games to start downloading."
                   FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                   HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.6"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Page>
