<Page x:Class="Steamy.Pages.BetterSteamToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="{DynamicResource WorkspaceBackgroundBrush}" UseLayoutRounding="True">
  <Page.Resources><BooleanToVisibilityConverter x:Key="BoolToVis" /></Page.Resources>
  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" Padding="26,20,26,28" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="BetterSteamTools" Style="{StaticResource PageTitleStyle}" />
          <TextBlock Text="Add game metadata to Steam from files or your configured sources." Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>
        <ui:Button Grid.Column="1" Content="Project" Command="{Binding OpenProjectCommand}" Appearance="Transparent" VerticalAlignment="Top" />
      </Grid>
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Steam connection" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          <Grid Margin="0,12,0,10" IsEnabled="{Binding IsIdle}">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding SteamRoot, UpdateSourceTrigger=LostFocus}" PlaceholderText="Steam folder containing steam.exe" LostKeyboardFocus="SteamRoot_LostFocus" AutomationProperties.Name="Steam installation folder" />
            <ui:Button Grid.Column="1" Content="Browse" Command="{Binding BrowseSteamCommand}" Margin="8,0,0,0" Appearance="Secondary" />
            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding DetectCommand}" Margin="8,0,0,0" Appearance="Transparent" ToolTip="Detect Steam and installed metadata" AutomationProperties.Name="Detect Steam" />
          </Grid>
          <TextBlock Text="{Binding BackendLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
          <TextBlock Text="Close Steam for backend installation. Game metadata can reload while Steam is running." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,12" />
          <WrapPanel>
            <ui:Button x:Name="InstallBackendButton" Content="Install / update BetterSteamTools" Command="{Binding InstallBackendCommand}" Appearance="Primary" Padding="14,9" Margin="0,0,10,0" />
            <ui:Button Content="Start Steam" Command="{Binding OpenSteamCommand}" Appearance="Secondary" Padding="14,9" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Add a game" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="Enter a Steam App ID or store link, then Add to Steam. Automatic tries available sources." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,12" />
          <ui:TextBox Text="{Binding GameInput, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="App ID or https://store.steampowered.com/app/…" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Game App ID or Steam store link" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="SourcePicker" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Label" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Game metadata source" />
            <ui:Button x:Name="AddGameButton" Grid.Column="1" Content="Add to Steam" Command="{Binding AddGameCommand}" Appearance="Primary" Padding="16,9" Margin="10,0,0,0" />
          </Grid>
          <WrapPanel Margin="0,10,0,0">
            <TextBlock Text="Sushi and Zaza are free. API providers use your configured credentials." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
            <ui:Button Content="Source settings" Command="{Binding OpenSettingsCommand}" Appearance="Transparent" FontSize="11" />
            <ui:Button Content="Browse Games" Command="{Binding OpenGamesCommand}" Appearance="Transparent" FontSize="11" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border x:Name="MetadataDropZone" Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,16"
              AllowDrop="True" DragOver="Metadata_DragOver" Drop="Metadata_Drop" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Drop ZIP Lua or manifest files to install">
        <StackPanel>
          <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="24" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding FilesLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,7" />
          <TextBlock Text="Drop to install immediately, or choose files. Leave the game field empty to detect App IDs. Manifest-only files are cached without inventing a game ID." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" TextWrapping="Wrap" />
          <ui:Button Content="Choose files and install" Command="{Binding BrowseFilesCommand}" Appearance="Secondary" HorizontalAlignment="Left" Padding="14,9" Margin="0,14,0,0" />
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,18">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
          <ui:Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Appearance="Transparent" Margin="10,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </Grid>
      </Border>
      <TextBlock Text="{Binding AddedCount}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
      <ItemsControl ItemsSource="{Binding AddedGames}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="11,7" Margin="0,0,8,8"><TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" /></Border></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
