<Page x:Class="Steamy.Pages.BetterSteamToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Steamy.ViewModels"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis" />
  </Page.Resources>

  <Grid Margin="36,28,36,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="BetterSteamTools" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="Open Source Steam DLC Unlocker — select games and launch"
                   Style="{StaticResource PageSubtitleStyle}" />
      </StackPanel>
      <ui:Button Grid.Column="1" Content="Browse…" Click="BrowseTool_Click"
                 Appearance="Secondary" Height="34" FontSize="12" Padding="14,0" Margin="0,0,6,0" />
      <ui:Button Grid.Column="2" Content="{Binding ToolStatusText}"
                 Command="{Binding DownloadCommand}"
                 Appearance="Primary" Height="34" FontSize="13" FontWeight="SemiBold" Padding="18,0" />
    </Grid>

    <!-- Tool status bar -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}">
          <ui:SymbolIcon Symbol="KeyMultiple24" Foreground="{DynamicResource AccentBrush}"
                         FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Status}" Style="{StaticResource CardTitleStyle}" FontSize="12.5" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0"
                           Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}" />
          <ui:Button Content="Launch" Command="{Binding LaunchCommand}"
                     Appearance="Primary" Height="30" FontSize="11" Padding="16,0" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Two columns: Games + Details -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="1.2*" />
      </Grid.ColumnDefinitions>

      <!-- Games panel -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search + Add -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                      PlaceholderText="Search games…"
                      FontSize="12" Padding="10,7" />
          <ui:Button Grid.Column="1" Content="Add…" Click="AddGameFolder_Click"
                     Appearance="Secondary" Height="34" FontSize="11" Padding="12,0" Margin="6,0,0,0"
                     ToolTip="Add a game folder manually" />
          <ui:Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshGamesCommand}"
                     Appearance="Transparent" Height="34" FontSize="11" Padding="8,0" Margin="4,0,0,0" />
        </Grid>

        <!-- Game count -->
        <TextBlock Grid.Row="1" Text="{Binding GameCountLabel}"
                   FontSize="10.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="2,0,0,6" />

        <!-- Game list -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceSubtleBrush}"
                CornerRadius="10" Padding="2">
          <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoadingGames, Converter={StaticResource BoolVis}}">
              <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" />
              <TextBlock Text="Scanning…" FontSize="11"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding FilteredGames}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="Row" Padding="10,7" Margin="1" CornerRadius="6"
                            Background="Transparent" Cursor="Hand"
                            MouseLeftButtonDown="GameRow_Click">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontSize="12"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"
                                     TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                            <TextBlock.Text>
                              <MultiBinding StringFormat="App {0} — {1}">
                                <Binding Path="AppId" />
                                <Binding Path="InstallPath" />
                              </MultiBinding>
                            </TextBlock.Text>
                          </TextBlock>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Appearance="Transparent"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Height="24" Width="24" Padding="0"
                                   Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   CommandParameter="{Binding}"
                                   ToolTip="Remove from list" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background"
                                Value="{DynamicResource ControlHoverBrush}" />
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- Right panel: Selected game details -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Selected Game" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />

        <Border Grid.Row="1" Background="{DynamicResource SurfaceSubtleBrush}"
                CornerRadius="10" Padding="18">
          <Grid>
            <!-- No game selected placeholder -->
            <StackPanel x:Name="NoGamePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="Games24" FontSize="32"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             HorizontalAlignment="Center" Margin="0,0,0,8" />
              <TextBlock Text="Select a game from the list"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         FontSize="12" HorizontalAlignment="Center" />
              <TextBlock Text="or add a game folder manually"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Game details when selected -->
            <StackPanel x:Name="GameDetailsPanel" Visibility="Collapsed">
              <TextBlock x:Name="GameNameText" FontSize="18" FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
              <TextBlock x:Name="GameAppIdText" FontSize="11"
                         Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4" />
              <TextBlock x:Name="GamePathText" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

              <ui:Button Content="Launch BetterSteamTools for this game"
                         Command="{Binding LaunchForGameCommand}"
                         Appearance="Primary"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Center"
                         Height="40" FontSize="13" FontWeight="SemiBold"
                         Margin="0,0,0,12" />

              <Border Background="{DynamicResource SurfaceElevatedBrush}"
                      CornerRadius="10" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="How it works" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                  <TextBlock TextWrapping="Wrap" FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="BetterSteamTools is an open-source Steam DLC unlocker. It patches the game's Steam API DLL to unlock all available DLC content. The tool launches with its own interface where you can configure and apply the unlock." />
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource SurfaceElevatedBrush}"
                      CornerRadius="10" Padding="14">
                <StackPanel>
                  <TextBlock Text="Requirements" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock Text="•" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="Steam must be running" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock Text="•" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="Game must be installed via Steam" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="•" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="Run as Administrator recommended" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Bottom status -->
    <Border Grid.Row="3" Margin="0,10,0,0" Padding="8,6" CornerRadius="8"
            Background="{DynamicResource SurfaceElevatedBrush}">
      <TextBlock Text="{Binding Status}" FontSize="11"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </Border>
  </Grid>
</Page>
