<Page x:Class="Steamy.Pages.HypervisorFixesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      Background="{DynamicResource PageBackgroundBrush}">
  <Grid Margin="32,26,32,32">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel controls:EntranceMotion.Delay="0">
      <TextBlock Text="Hypervisor Fixes" Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="A new home for virtualization compatibility tools." Style="{StaticResource PageSubtitleStyle}" />
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" MaxWidth="620" Padding="40"
            HorizontalAlignment="Center" VerticalAlignment="Center" controls:EntranceMotion.Delay="30">
      <StackPanel>
        <Border Width="68" Height="68" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,24">
          <ui:SymbolIcon Symbol="Shield24" FontSize="30" Foreground="{DynamicResource AccentBrush}" />
        </Border>
        <TextBlock Text="Coming in version 0.8.0." FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" />
        <TextBlock Text="Hypervisor compatibility fixes are being prepared."
                   Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center" Margin="0,12,0,0" MaxWidth="390" />
        <TextBlock Text="No changes are applied to your system from this page."
                   Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,24,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Page>
