              <TextBlock Text="Keep it private so only people with access can see the shares." Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <ui:TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Settings.ManifestShareRepo, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Steamy-Dumps" />
          </Grid>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
              <TextBlock Text="Branch" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="Branch the shares are committed to." Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <ui:TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Settings.ManifestShareBranch, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="main" />
          </Grid>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
              <TextBlock Text="Sharing token" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="{Binding ShareCredentialStatus}" FontSize="12" Margin="0,3,0,0"
                         Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="Fine-grained PAT with Contents: Read and write on that repository only. Encrypted with DPAPI, never written to logs or exports."
                         Style="{StaticResource MutedTextStyle}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <PasswordBox x:Name="ShareTokenBox" Style="{StaticResource CredentialBoxStyle}" Grid.Column="1" VerticalAlignment="Center"
                         PasswordChanged="ShareTokenBox_PasswordChanged" />
          </Grid>
          <TextBlock Text="Nothing is uploaded until you press Share on the Share page. Your SteamID and local paths are removed from every pack."
                     Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

          </StackPanel>
          <StackPanel Tag="general" controls:EntranceMotion.Delay="0">
      <!-- ===== Quality of life and security ============================================= -->
      <WrapPanel Margin="0,8,0,12">
        <Border Style="{StaticResource SectionChip}">
          <ui:SymbolIcon Symbol="ShieldTask24" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Quality of life and security" Style="{StaticResource SectionHeading}" Margin="10,0,0,0" />
        <TextBlock Text="Updates, notifications and logs" Style="{StaticResource SectionHint}" />
      </WrapPanel>
      <Border Style="{StaticResource SettingsCard}" CornerRadius="12" Padding="18" Margin="0,0,0,10">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource RowIcon}">
                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border><StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Automatic updates" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Text="At startup Steamy looks for a new version on GitHub and installs it with one click." Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AppVersionLabel, Mode=OneWay}" Style="{StaticResource TertiaryTextStyle}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" />
              </StackPanel></Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:Button Content="Check now" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Secondary" CornerRadius="9"
                         Command="{Binding CheckForUpdatesCommand}" Margin="0,0,12,0" />
              <ui:ToggleSwitch IsChecked="{Binding Settings.AutoUpdate}" />
            </StackPanel>
          </Grid>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
              <TextBlock Text="Notifications" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="Show local download and provider status notifications." Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.Notifications}" />
          </Grid>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
              <TextBlock Text="Debug logging" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="Additional diagnostics with automatic secret redaction." Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.DebugLogging}" />
          </Grid>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
              <TextBlock Text="Show DepotDownloader logs in Downloads" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="Keep the log panel hidden by default; enable it here when you need technical output." Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowDownloadLogs}" />
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
              <TextBlock Text="Confirm before deleting" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="Ask once more before a queue entry or local file is removed." Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ConfirmBeforeDelete}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SettingsCard}" CornerRadius="18" Padding="16,14" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
            <Border Style="{StaticResource RowIcon}">
              <ui:SymbolIcon Symbol="Key24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Stored credentials" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="Deletes the encrypted Steam API key, Ryuu auth key, Hubcap API key, DepotBox API key and fixes source token from this machine."
                         Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
          <ui:Button Grid.Column="1" Content="Clear credentials" Command="{Binding ClearCredentialsCommand}"
                     Appearance="Danger" CornerRadius="9" VerticalAlignment="Center" />
        </Grid>
      </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <StackPanel x:Name="NoSettingsResults" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
        <Border Style="{StaticResource SectionChip}" Width="56" Height="56" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,16">
          <ui:SymbolIcon Symbol="Search24" FontSize="25" Foreground="{DynamicResource AccentBrush}" />
        </Border>
        <TextBlock Text="No matching settings" Style="{StaticResource SectionHeading}" HorizontalAlignment="Center" />
        <TextBlock Text="Try a different word, such as downloads or appearance." Style="{StaticResource BodyTextStyle}"
                   TextAlignment="Center" Margin="0,6,0,16" />
        <ui:Button Content="Clear search" HorizontalAlignment="Center" Click="ClearSearch_Click" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="3" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1" CornerRadius="16" Padding="16,12" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="{Binding SaveStatus}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"
                     TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="Changes save automatically · credentials stay encrypted" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:ProgressRing Width="18" Height="18" Margin="0,0,12,0" IsIndeterminate="{Binding IsBusy}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <ui:Button Content="Reset defaults" Click="ResetDefaults_Click" Appearance="Secondary" Margin="0,0,8,0"
                     ToolTip="Restore default settings" />
          <ui:Button Content="Save now" Command="{Binding SaveCommand}" Appearance="Primary" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
