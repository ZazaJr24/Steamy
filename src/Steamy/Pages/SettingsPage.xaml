<Page x:Class="Steamy.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      PreviewKeyDown="Settings_PreviewKeyDown"
      ScrollViewer.CanContentScroll="False"
      UseLayoutRounding="True" SnapsToDevicePixels="True"
      Background="{DynamicResource WorkspaceBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style x:Key="CredentialBoxStyle" TargetType="PasswordBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource SurfaceCardStyle}">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SectionChip" TargetType="Border">
      <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SectionHint" TargetType="TextBlock" BasedOn="{StaticResource TertiaryTextStyle}">
      <Setter Property="FontSize" Value="12" /><Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,4,0,0" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SettingsGroupLabel" TargetType="TextBlock" BasedOn="{StaticResource OverlineStyle}">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Margin" Value="0,0,0,18" />
    </Style>
    <Style x:Key="RowIcon" TargetType="Border">
      <Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="11" /><Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TestButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Appearance" Value="Secondary" /><Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style x:Key="SettingsCategory" TargetType="RadioButton">
      <Setter Property="controls:CardMotion.IsEnabled" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,10" /><Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent"><Grid x:Name="MotionSurface">
            <Border x:Name="CategorySurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            </Grid></Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="CategorySurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid Margin="28,22,28,16" MaxWidth="1280">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="Appearance, downloads and connections." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" />
    </StackPanel>

    <StackPanel Grid.Row="1">
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <ui:TextBox x:Name="SettingsSearch" PlaceholderText="Find a setting — theme, resume, DNS…"
                    Icon="{ui:SymbolIcon Search24}" TextChanged="SettingsSearch_TextChanged"
                    AutomationProperties.Name="Search all settings" Margin="0,0,10,0" />
        <ui:Button Grid.Column="1" Content="Export" Icon="{ui:SymbolIcon Document24}" Click="ExportButton_Click"
                   Appearance="Secondary" ToolTip="Export settings as JSON. Credentials are excluded." />
      </Grid>
      <WrapPanel x:Name="CategoryNavigation" KeyboardNavigation.TabNavigation="Once" Margin="0,0,0,2">
        <RadioButton Content="General" Tag="general" GroupName="SettingsCategories" IsChecked="True" Style="{StaticResource SettingsCategory}" Checked="Category_Checked" />
        <RadioButton Content="Downloads" Tag="downloads" GroupName="SettingsCategories" Style="{StaticResource SettingsCategory}" Checked="Category_Checked" />
        <RadioButton Content="Connections" Tag="services" GroupName="SettingsCategories" Style="{StaticResource SettingsCategory}" Checked="Category_Checked" />
        <RadioButton Content="Network" Tag="network" GroupName="SettingsCategories" Style="{StaticResource SettingsCategory}" Checked="Category_Checked" />
        <RadioButton Content="Sharing" Tag="sharing" GroupName="SettingsCategories" Style="{StaticResource SettingsCategory}" Checked="Category_Checked" />
        <RadioButton Content="All settings" Tag="all" GroupName="SettingsCategories" Style="{StaticResource SettingsCategory}" Checked="Category_Checked" />
      </WrapPanel>
      <TextBlock x:Name="SectionSummary" Style="{StaticResource CaptionStyle}" Margin="2,0,0,8" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>

    <Grid Grid.Row="2">
      <ScrollViewer x:Name="SettingsScrollViewer" Style="{StaticResource PageScrollHostStyle}"
                    controls:SmoothScroll.Enabled="True"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,4,20">
        <StackPanel x:Name="SectionsPanel">
          <Border Tag="services" Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Free manifest sources" Style="{StaticResource SectionHeading}" />
              <TextBlock Text="Sushi and Zaza work without an API key. Select the source when opening a game, or filter your library by source." Style="{StaticResource BodyTextStyle}" Margin="0,8,0,12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Tag="general" controls:EntranceMotion.Delay="0">
      <!-- ===== Appearance ============================================================== -->
      <WrapPanel Margin="0,8,0,12">
        <Border Style="{StaticResource SectionChip}">
          <ui:SymbolIcon Symbol="Settings24" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Appearance" Style="{StaticResource SectionHeading}" Margin="10,0,0,0" />
        <TextBlock Text="Theme, backdrop and language" Style="{StaticResource SectionHint}" />
      </WrapPanel>
      <Border Style="{StaticResource SettingsCard}" CornerRadius="12" Padding="18" Margin="0,0,0,10">
        <StackPanel>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource RowIcon}">
                <ui:SymbolIcon Symbol="Settings24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border><StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Theme" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Text="System, light or dark." Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" />
              </StackPanel></Grid>
            <ComboBox Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding Appearances}" SelectedItem="{Binding Settings.Appearance}" SelectionChanged="AppearanceComboBox_SelectionChanged" />
          </Grid>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource RowIcon}">
                <ui:SymbolIcon Symbol="TopSpeed24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border><StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Window Backdrop" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Text="Windows 11 background style." Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" />
              </StackPanel></Grid>
            <ComboBox Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding BackdropStyles}" SelectedItem="{Binding Settings.BackdropStyle}" SelectionChanged="BackdropComboBox_SelectionChanged" />
          </Grid>
          <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,14" Margin="0,0,0,8">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Margin="41,0,24,0"><TextBlock Text="Dashboard search" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Text="Show search on Discover." Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" /></StackPanel>
              <ui:ToggleSwitch x:Name="DashboardSearchToggle" Grid.Column="1" IsChecked="{Binding Settings.DashboardSearch, Mode=TwoWay}" AutomationProperties.Name="Dashboard search" />
            </Grid>
          </Border>
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="41,0,24,0">
              <TextBlock Text="Reduce effects" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="Instant transitions. Respects Windows animation preferences."
                         Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <ui:ToggleSwitch x:Name="ReduceEffectsToggle" Grid.Column="1" IsChecked="{Binding Settings.ReduceEffects, Mode=TwoWay}"
                             AutomationProperties.Name="Reduce effects" />
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource RowIcon}">
                <ui:SymbolIcon Symbol="Document24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border><StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Language" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Text="Applied on next start." Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" />
              </StackPanel></Grid>
            <ComboBox Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding Languages}" SelectedItem="{Binding Settings.Language}" />
          </Grid>
        </StackPanel>
      </Border>

          </StackPanel>
          <StackPanel Tag="services" controls:EntranceMotion.Delay="0">
      <!-- ===== Steam connection ======================================================== -->
      <WrapPanel Margin="0,8,0,12">
        <Border Style="{StaticResource SectionChip}">
          <ui:SymbolIcon Symbol="Games24" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Steam connection" Style="{StaticResource SectionHeading}" Margin="10,0,0,0" />
        <TextBlock Text="API key, SteamID64 and endpoint" Style="{StaticResource SectionHint}" />
      </WrapPanel>
      <Border Style="{StaticResource SettingsCard}" CornerRadius="12" Padding="18" Margin="0,0,0,10">
        <StackPanel>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource RowIcon}">
                <ui:SymbolIcon Symbol="Key24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border><StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Steam API key" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Text="{Binding SteamCredentialStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,3,0,0" />
              </StackPanel></Grid>
            <PasswordBox x:Name="SteamApiKeyBox" Style="{StaticResource CredentialBoxStyle}" Grid.Column="1" VerticalAlignment="Center" PasswordChanged="SteamApiKeyBox_PasswordChanged"
                         ToolTip="Type a key and save; it is encrypted with DPAPI and never leaves this machine in plain text." />
          </Grid>
          <TextBlock Text="Leave the box empty to keep the stored key unchanged."
                     Style="{StaticResource TertiaryTextStyle}" FontSize="11" Margin="41,0,0,14" />
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
              <TextBlock Text="SteamID64" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="{Binding SteamIdHint}" Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <ui:TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Settings.SteamId64, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="7656119…" />
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
              <TextBlock Text="API endpoint" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="Only use an official or explicitly authorized endpoint." Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <ui:TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Settings.SteamApiUrl, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ui:Button Content="Test endpoint" Style="{StaticResource TestButton}" Command="{Binding TestSteamCommand}"
                       Icon="{ui:SymbolIcon Play24}" />
            <TextBlock Grid.Column="1" Text="{Binding SteamTestStatus}" Style="{StaticResource MutedTextStyle}"
                       FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Border>

          </StackPanel>
          <StackPanel Tag="services" controls:EntranceMotion.Delay="0">
      <!-- ===== Ryuu Generator =========================================================== -->
      <WrapPanel Margin="0,8,0,12">
        <Border Style="{StaticResource SectionChip}">
          <ui:SymbolIcon Symbol="CloudArrowDown24" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Ryuu Generator" Style="{StaticResource SectionHeading}" Margin="10,0,0,0" />
        <TextBlock Text="Base URL and auth key" Style="{StaticResource SectionHint}" />
      </WrapPanel>
      <Border Style="{StaticResource SettingsCard}" CornerRadius="12" Padding="18" Margin="0,0,0,10">
        <StackPanel>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
              <TextBlock Text="Base URL" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="The address the app calls for generated manifests." Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <ui:TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Settings.RyuuBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource RowIcon}">
                <ui:SymbolIcon Symbol="Key24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border><StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Auth key" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Text="{Binding RyuuCredentialStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,3,0,0" />
              </StackPanel></Grid>
            <PasswordBox x:Name="RyuuAuthKeyBox" Style="{StaticResource CredentialBoxStyle}" Grid.Column="1" VerticalAlignment="Center" PasswordChanged="RyuuAuthKeyBox_PasswordChanged" />
          </Grid>
          <TextBlock Text="Stored separately, never written into logs or exports. Empty means: keep the current key."
                     Style="{StaticResource TertiaryTextStyle}" FontSize="11" Margin="41,0,0,14" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ui:Button Content="Test endpoint" Style="{StaticResource TestButton}" Command="{Binding TestRyuuCommand}"
                       Icon="{ui:SymbolIcon Play24}" />
            <TextBlock Grid.Column="1" Text="{Binding RyuuTestStatus}" Style="{StaticResource MutedTextStyle}"
                       FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Border>

          </StackPanel>
          <StackPanel Tag="services" controls:EntranceMotion.Delay="0">
      <!-- ===== Fixes source ============================================================= -->
      <WrapPanel Margin="0,8,0,12">
        <Border Style="{StaticResource SectionChip}">
          <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Fixes source" Style="{StaticResource SectionHeading}" Margin="10,0,0,0" />
        <TextBlock Text="fixes.json catalog and archives" Style="{StaticResource SectionHint}" />
      </WrapPanel>
      <Border Style="{StaticResource SettingsCard}" CornerRadius="12" Padding="18" Margin="0,0,0,10">
        <StackPanel>
          <Border Style="{StaticResource InfoPanelStyle}" CornerRadius="14" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                             VerticalAlignment="Top" Margin="0,1,9,0" />
              <TextBlock Text="Where the Game Fixes page loads its catalog (fixes.json) and archives from. Leave the URL empty to use the built-in source; private repositories need an access token." Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
              <TextBlock Text="Source URL" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="Empty uses the built-in source. Or paste another GitHub repository / web folder." Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <ui:TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Settings.FixMirrorUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://github.com/ZazaJr24/Fix (built-in)" />
          </Grid>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource RowIcon}">
                <ui:SymbolIcon Symbol="Key24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border><StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Access token" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Text="{Binding MirrorCredentialStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,3,0,0" />
              </StackPanel></Grid>
            <PasswordBox x:Name="MirrorTokenBox" Style="{StaticResource CredentialBoxStyle}" Grid.Column="1" VerticalAlignment="Center" PasswordChanged="MirrorTokenBox_PasswordChanged"
                         ToolTip="GitHub personal access token with read access to the repository. Encrypted with DPAPI." />
          </Grid>
          <TextBlock Text="Required for private repositories. Encrypted with DPAPI, never exported. Empty means: keep the current token."
                     Style="{StaticResource TertiaryTextStyle}" FontSize="11" Margin="41,0,0,14" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ui:Button Content="Test source" Style="{StaticResource TestButton}" Command="{Binding TestMirrorCommand}"
                       Icon="{ui:SymbolIcon Play24}" />
            <TextBlock Grid.Column="1" Text="{Binding MirrorTestStatus}" Style="{StaticResource MutedTextStyle}"
                       FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Border>

          </StackPanel>
          <StackPanel Tag="services" controls:EntranceMotion.Delay="0">
      <!-- ===== Hubcap Manifest ========================================================== -->
      <WrapPanel Margin="0,8,0,12">
        <Border Style="{StaticResource SectionChip}">
          <ui:SymbolIcon Symbol="Rocket24" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Hubcap Manifest" Style="{StaticResource SectionHeading}" Margin="10,0,0,0" />
        <TextBlock Text="Games, Lua and depot manifests" Style="{StaticResource SectionHint}" />
      </WrapPanel>
      <Border Style="{StaticResource SettingsCard}" CornerRadius="12" Padding="18" Margin="0,0,0,10">
        <StackPanel>
          <Border Style="{StaticResource InfoPanelStyle}" CornerRadius="14" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                             VerticalAlignment="Top" Margin="0,1,9,0" />
              <TextBlock Text="Hubcap provides fast game search and manifest downloads for Denuvo Activation. An API key from hubcapmanifest.com is required." Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
              <TextBlock Text="Base URL" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="The Hubcap manifest API endpoint." Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <ui:TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Settings.HubcapBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource RowIcon}">
                <ui:SymbolIcon Symbol="Key24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border><StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="API key" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Text="{Binding HubcapCredentialStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,3,0,0" />
              </StackPanel></Grid>
            <PasswordBox x:Name="HubcapApiKeyBox" Style="{StaticResource CredentialBoxStyle}" Grid.Column="1" VerticalAlignment="Center" PasswordChanged="HubcapApiKeyBox_PasswordChanged"
                         ToolTip="Type your Hubcap API key and save; encrypted with DPAPI, never exported." />
          </Grid>
          <TextBlock Text="Encrypted with DPAPI, never written into logs or exports. Empty means: keep the current key."
                     Style="{StaticResource TertiaryTextStyle}" FontSize="11" Margin="41,0,0,14" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ui:Button Content="Test connection" Style="{StaticResource TestButton}" Command="{Binding TestHubcapCommand}"
                       Icon="{ui:SymbolIcon Play24}" />
            <TextBlock Grid.Column="1" Text="{Binding HubcapTestStatus}" Style="{StaticResource MutedTextStyle}"
                       FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
          <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="10"
                  Background="{DynamicResource SurfaceSubtleBrush}"
                  Visibility="{Binding HubcapUsageInfo, Converter={StaticResource StringVis}}">
            <StackPanel>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Daily API Usage" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding HubcapUsageInfo}" FontSize="12"
