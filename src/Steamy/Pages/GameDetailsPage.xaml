<Page x:Class="Steamy.Pages.GameDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      Background="{DynamicResource GameDetailsBackgroundBrush}" FontFamily="{DynamicResource SteamyFontFamily}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed" RenderOptions.ClearTypeHint="Auto" ScrollViewer.CanContentScroll="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhen" /><system:Double xmlns:system="clr-namespace:System;assembly=System.Runtime" x:Key="DetailPreviewHeight">150</system:Double>

    <LinearGradientBrush x:Key="DetailGlassTintBrush" StartPoint="0,0" EndPoint="0.35,1"><GradientStop Color="#0EFFFFFF"/><GradientStop Color="#04FFFFFF" Offset="0.48"/><GradientStop Color="#08FFFFFF" Offset="1"/></LinearGradientBrush>
    <Style x:Key="DetailGlass" TargetType="Border">
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Background" Value="{DynamicResource DetailSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DetailEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="DetailButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="#0FFFFFFF" />
      <Setter Property="Padding" Value="16,11" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource GalleryKeyboardFocus}" />
      <Setter Property="controls:CardMotion.IsEnabled" Value="True" /><Setter Property="controls:CardMotion.HoverScale" Value="1" /><Setter Property="controls:CardMotion.HoverLift" Value="-1" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Face" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource DetailEdgeBrush}" BorderThickness="1">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#60FFFFFF" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.5" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DetailMainAction" TargetType="Button" BasedOn="{StaticResource DetailButton}"><Setter Property="Height" Value="42"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border CornerRadius="21" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="DetailTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="12,11" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource GalleryKeyboardFocus}" />
      <Setter Property="controls:CardMotion.IsEnabled" Value="True" /><Setter Property="controls:CardMotion.HoverScale" Value="1.025" /><Setter Property="controls:CardMotion.HoverLift" Value="-1" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Face" CornerRadius="18" Background="Transparent" Padding="{TemplateBinding Padding}">
          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#14FFFFFF" /></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DetailHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
    <Style x:Key="DetailCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
    <DataTemplate x:Key="RelatedGameCard"><Button Command="{Binding DataContext.OpenRelatedGameCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Style="{StaticResource DetailButton}" Padding="14" HorizontalContentAlignment="Stretch" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="48" CornerRadius="10" Background="{Binding CoverColor}" controls:RoundedClip.Radius="10"><Image Source="{Binding ArtworkImage}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding GenresDisplay}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="View ›" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/></Grid></Button></DataTemplate>
  </Page.Resources>
  <Grid>
  <ScrollViewer x:Name="DetailsScroll" Style="{StaticResource DashboardScrollHostStyle}" HorizontalScrollBarVisibility="Disabled" ScrollChanged="DetailsScroll_Changed">
    <Grid x:Name="DetailsScene" Background="{DynamicResource GameDetailsBackgroundBrush}">
      <Border x:Name="GameDetailsWarmGradient" IsHitTestVisible="False" Background="{DynamicResource GameDetailsGradientBrush}" />
        <Grid x:Name="HeroArtworkFade" IsHitTestVisible="False" VerticalAlignment="Top" ClipToBounds="True">
          <Grid x:Name="HeroScene" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="HeroZoom"/><TranslateTransform x:Name="HeroParallax"/></TransformGroup></Grid.RenderTransform><Image x:Name="HeroImage" Stretch="Fill"/></Grid></Grid>
    <StackPanel>
      <Grid x:Name="GameHero" Height="360" ClipToBounds="True">
        <Border x:Name="HeroTopShade" IsHitTestVisible="False" Height="84" VerticalAlignment="Top"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#60000000"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      </Grid>
      <Grid x:Name="GameIdentityLayout" MaxWidth="880" HorizontalAlignment="Center" Margin="0,0,0,32"><Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="GameIdentityArtwork" Width="132" Height="132" CornerRadius="22" controls:RoundedClip.Radius="22" Background="{Binding Game.CoverColor}" BorderBrush="#28FFFFFF" BorderThickness="1" Margin="0,0,22,0" VerticalAlignment="Center"><Image Source="{Binding Game.ArtworkImage}" Stretch="UniformToFill"/></Border>
          <StackPanel x:Name="HeroIdentity" Grid.Column="1" VerticalAlignment="Center">
            <Image x:Name="GameLogo" Source="{Binding LogoArtwork}" Stretch="Uniform" Width="170" MaxHeight="40" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="Collapsed"/>
            <TextBlock x:Name="GameTitle" Text="{Binding Name}" FontFamily="{DynamicResource SteamyDisplayFontFamily}" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding Genres}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="17" TextWrapping="NoWrap" LineHeight="24" MaxHeight="26" TextTrimming="CharacterEllipsis"/>
            <WrapPanel Margin="0,13,0,0"><StackPanel Orientation="Horizontal" Margin="0,0,18,6" Visibility="{Binding HasReviews, Converter={StaticResource VisibleWhen}}"><ui:SymbolIcon Symbol="ThumbLike24" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0"/><TextBlock Text="{Binding ReviewPercentLabel}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text=" positive" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><TextBlock Text="{Binding ReleaseDate}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12"/></WrapPanel>
            <WrapPanel x:Name="GameIdentityActions" Margin="0,12,0,0"><Button x:Name="PlayButton" Background="{DynamicResource DetailPrimaryActionBackground}" Style="{StaticResource DetailMainAction}" Command="{Binding PlayCommand}" Foreground="{DynamicResource DetailPrimaryActionForeground}" Height="42" MinWidth="112" Padding="18,9" Margin="0,0,12,0" AutomationProperties.Name="Start game" Visibility="{Binding IsInstalled, Converter={StaticResource VisibleWhen}}">

              <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Play24" FontSize="18" Margin="0,0,8,0" /><TextBlock Text="{Binding PlayLabel}" FontSize="15" FontWeight="SemiBold" /></StackPanel>
            </Button><Button x:Name="AddToSteamButton" Style="{StaticResource DetailMainAction}" Command="{Binding AddToSteamCommand}" Width="42" MinWidth="42" Height="42" Padding="0" Margin="-4,0,12,0" Background="#0FFFFFFF" BorderBrush="{DynamicResource DetailEdgeBrush}" BorderThickness="1" ToolTip="Add to Steam" AutomationProperties.Name="Add game to Steam" Visibility="{Binding CanAddToSteam, Converter={StaticResource VisibleWhen}}"><ui:SymbolIcon Symbol="Add24" FontSize="18"/></Button><Button x:Name="InstallButton" Click="Install_Click" Foreground="{DynamicResource DetailPrimaryActionForeground}" Height="42" MinWidth="172" Margin="0,0,14,0" Visibility="{Binding CanInstall, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{Binding InstallLabel}">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource DetailMainAction}"><Setter Property="Background" Value="{DynamicResource DetailPrimaryActionBackground}"/><Style.Triggers><DataTrigger Binding="{Binding HasDownload}" Value="True"><Setter Property="Background" Value="#38404B"/></DataTrigger></Style.Triggers></Style></Button.Style>
              <Grid MinWidth="120">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2"><ui:SymbolIcon Symbol="ArrowDownload24" FontSize="17" Margin="0,0,8,0"/><TextBlock Text="{Binding InstallLabel}" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                <controls:SmoothProgressBar SmoothValue="{Binding Download.Progress}" IsIndeterminate="{Binding Download.IsProgressIndeterminate}" Maximum="100" Height="3" Margin="-8,0,-8,-8" VerticalAlignment="Bottom" Foreground="#66C0F4" Background="#35FFFFFF" Style="{StaticResource JobProgressBar}" Visibility="{Binding HasDownload, Converter={StaticResource VisibleWhen}}"/>
              </Grid>
            </Button><Button x:Name="SteamStoreButton" Content="View in Steam ↗" Style="{StaticResource DetailMainAction}" Command="{Binding OpenSteamCommand}" Background="#0FFFFFFF" BorderBrush="{DynamicResource DetailEdgeBrush}" BorderThickness="1" Padding="16,9" Height="42" AutomationProperties.Name="View in Steam" Visibility="{Binding IsSteamGame, Converter={StaticResource VisibleWhen}}"/><StackPanel x:Name="HeroPlayTime" VerticalAlignment="Center" Margin="14,0,22,0"><TextBlock Text="Time played" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,5"/><TextBlock x:Name="HeroPlayTimeText" Text="{Binding PlayTimeLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/></StackPanel><StackPanel x:Name="HeroLastPlayed" VerticalAlignment="Center"><TextBlock Text="{Binding LastPlayedCaption}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,5"/><TextBlock x:Name="HeroLastPlayedText" Text="{Binding LastPlayedLabel}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/></StackPanel></WrapPanel>
          </StackPanel>
      </Grid>
      <Grid>
      <StackPanel x:Name="DetailsBody" Margin="0,0,0,40" MaxWidth="1280" HorizontalAlignment="Center">

        <TextBlock Text="{Binding LaunchStatus}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,4,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding LaunchStatus}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>

        <StackPanel x:Name="OverviewPanel" Visibility="{Binding IsOverview, Converter={StaticResource VisibleWhen}}">
          <StackPanel Margin="4,0,4,26">
          <TextBlock Text="Game details" Style="{StaticResource DetailHeading}" FontSize="23"/>
          <Border x:Name="GameInformationCard" Style="{StaticResource DetailGlass}" Margin="0,16,0,0">
            <StackPanel>
              <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0"><TextBlock Text="{Binding ReviewPercentLabel}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding ReviewDescription}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding ReviewCountLabel}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="20,4,20,0"><TextBlock Text="Genre" Style="{StaticResource DetailCaption}"/><TextBlock Text="{Binding Genres}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="20,4,0,0"><TextBlock Text="Released" Style="{StaticResource DetailCaption}"/><TextBlock Text="{Binding ReleaseDate}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/></StackPanel>
              </Grid>
              <Border Height="1" Background="{DynamicResource DetailEdgeBrush}"/>
              <Grid Margin="0,20,0,20" Visibility="{Binding IsSteamGame, Converter={StaticResource VisibleWhen}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0"><TextBlock Text="Languages" Style="{StaticResource DetailCaption}"/><TextBlock Text="{Binding Languages}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="21"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,0"><TextBlock Text="Features" Style="{StaticResource DetailCaption}"/><TextBlock Text="{Binding Features}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="21"/></StackPanel>
              </Grid>
              <Border Height="1" Background="{DynamicResource DetailEdgeBrush}"/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding IsSteamGame, Converter={StaticResource VisibleWhen}}"><Button Content="View in Steam ↗" Command="{Binding OpenSteamCommand}" Style="{StaticResource DetailButton}" Background="Transparent" Padding="4,8" Margin="0,0,24,0"/><Button Content="Community ↗" Command="{Binding OpenCommunityCommand}" Style="{StaticResource DetailButton}" Background="Transparent" Padding="4,8"/></StackPanel>
            </StackPanel>
          </Border>
          </StackPanel>
          <StackPanel Margin="0,8,0,30" Visibility="{Binding HasScreenshots, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="Preview" Style="{StaticResource DetailHeading}" Margin="0,0,0,16" />
            <ItemsControl x:Name="ScreenshotGallery" ItemsSource="{Binding Screenshots}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Tag="{Binding}" Click="Screenshot_Click" Style="{StaticResource DetailButton}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="0" Margin="0,0,14,10" Background="Transparent" AutomationProperties.Name="Open game screenshot">
                  <Border CornerRadius="14" controls:RoundedClip.Radius="14" ClipToBounds="True"><Image controls:AsyncArtwork.Width="600" controls:AsyncArtwork.Url="{Binding Thumbnail}" Stretch="UniformToFill" Height="{DynamicResource DetailPreviewHeight}" RenderOptions.BitmapScalingMode="HighQuality" /></Border>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Border Style="{StaticResource DetailGlass}" Padding="20" Margin="4,0,4,0">
            <StackPanel>

              <TextBlock Text="{Binding Description}" FontSize="14" LineHeight="24" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,22" />
              <UniformGrid Columns="2" Margin="0,0,0,0">
                <StackPanel Margin="0,0,16,0"><TextBlock Text="DEVELOPER" Style="{StaticResource DetailCaption}" /><TextBlock Text="{Binding Developer}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" /></StackPanel>
                <StackPanel><TextBlock Text="PUBLISHER" Style="{StaticResource DetailCaption}" /><TextBlock Text="{Binding Publisher}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" /></StackPanel>
              </UniformGrid>

            </StackPanel>
          </Border>
        <StackPanel Margin="4,30,4,0">
          <StackPanel Visibility="{Binding AchievementsAvailable, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,30"><Grid Margin="0,0,0,14"><TextBlock Text="Achievements" Style="{StaticResource DetailHeading}"/><Button Content="{Binding AchievementSummary}" Style="{StaticResource DetailButton}" HorizontalAlignment="Right" Padding="12,6" Command="{Binding SelectTabCommand}" CommandParameter="1"/></Grid><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" controls:SmoothScroll.Enabled="True" controls:SmoothScroll.Horizontal="True"><ItemsControl ItemsSource="{Binding AchievementPreview}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="150" MinHeight="190" Style="{StaticResource DetailGlass}" Padding="16" Margin="0,0,12,10"><StackPanel><Border Width="62" Height="62" CornerRadius="31" Background="#18000000" HorizontalAlignment="Center" Margin="0,0,0,16"><Grid><ui:SymbolIcon Symbol="LockClosed24" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="23"/><Image Source="{Binding IconUri}" Stretch="Uniform"/></Grid></Border><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel>
          <Border Style="{StaticResource DetailGlass}" Margin="0,0,0,24" Visibility="{Binding HasDeveloper, Converter={StaticResource VisibleWhen}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding MoreDeveloperHeading}" Style="{StaticResource DetailHeading}"/><TextBlock Text="Explore the developer's games on Steam." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,12,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="View games ↗" Tag="{Binding DeveloperStoreUri}" Click="OpenLink_Click" Style="{StaticResource DetailButton}" VerticalAlignment="Center"/></Grid></Border>
<StackPanel Visibility="{Binding HasDeveloperGames, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,28"><TextBlock Text="{Binding MoreDeveloperHeading}" Style="{StaticResource DetailHeading}" Margin="0,0,0,16"/><ItemsControl ItemsSource="{Binding DeveloperGames}" ItemTemplate="{StaticResource RelatedGameCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:AdaptiveGridPanel MinItemWidth="280" MaxColumns="3" Spacing="14" CoverRatio="0.25"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
<StackPanel Visibility="{Binding HasSimilarGames, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,28"><TextBlock Text="You might also like" Style="{StaticResource DetailHeading}" Margin="0,0,0,16"/><ItemsControl ItemsSource="{Binding SimilarGames}" ItemTemplate="{StaticResource RelatedGameCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:AdaptiveGridPanel MinItemWidth="280" MaxColumns="3" Spacing="14" CoverRatio="0.25"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><TextBlock Text="Based on the game's Steam genres." FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0"/></StackPanel>
<StackPanel Margin="0,0,0,30" Visibility="{Binding HasNews, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="Latest updates" Style="{StaticResource DetailHeading}" Margin="0,0,0,16" />
            <ItemsControl x:Name="NewsList" ItemsSource="{Binding News}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Style="{StaticResource DetailGlass}" Margin="0,0,0,12" Padding="22,18">
                  <StackPanel>
                    <TextBlock Text="{Binding DateLabel}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Summary}" FontSize="13" LineHeight="22" MaxHeight="88" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,14" />
                    <Button Content="Read update ↗" Tag="{Binding Link}" Click="OpenLink_Click" Style="{StaticResource DetailButton}" Padding="12,7" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Margin="0,0,0,30" Visibility="{Binding HasFullDescription, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="Discover the game" Style="{StaticResource DetailHeading}" Margin="0,0,0,16" />
            <TextBlock Text="{Binding FullDescription}" FontSize="14" LineHeight="25" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
          <Border Style="{StaticResource DetailGlass}" Margin="0,0,0,28" Visibility="{Binding HasRequirements, Converter={StaticResource VisibleWhen}}">
            <StackPanel><TextBlock Text="System requirements" Style="{StaticResource DetailHeading}" Margin="0,0,0,16" /><TextBlock Text="{Binding SystemRequirements}" FontSize="13" LineHeight="23" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
          </Border>



          <TextBlock Text="ON THIS PC" Style="{StaticResource DetailCaption}" />
          <TextBlock Text="{Binding InstallationLabel}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
          <TextBlock Text="{Binding LaunchTarget}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
        </StackPanel>
        <Border x:Name="AchievementsPanel" Style="{StaticResource DetailGlass}" Visibility="{Binding IsAchievements, Converter={StaticResource VisibleWhen}}">
          <StackPanel>
            <Grid><TextBlock Text="Achievements" Style="{StaticResource DetailHeading}" /><Button Content="Refresh" HorizontalAlignment="Right" Command="{Binding RefreshAchievementsCommand}" Style="{StaticResource DetailButton}" /></Grid>
            <TextBlock Text="{Binding AchievementSummary}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,14,0,8" />
            <ProgressBar Value="{Binding AchievementPercent, Mode=OneWay}" Maximum="100" Height="5" Foreground="#82B9F2" Background="#16FFFFFF" Visibility="{Binding AchievementsAvailable, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding AchievementStatus}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,14,0,18" />
            <ListBox x:Name="AchievementList" ItemsSource="{Binding Achievements}" MaxHeight="440" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,10" /></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><Border CornerRadius="18" Background="#10FFFFFF" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="12" Background="#18FFFFFF" controls:RoundedClip.Radius="12"><Grid><ui:SymbolIcon Symbol="Trophy24" FontSize="24" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding IconUri}" Stretch="UniformToFill" /></Grid></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,16,0"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding StateLabel}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Visibility="{Binding IsSteamGame, Converter={StaticResource VisibleWhen}}" Margin="0,14,0,0">
              <TextBlock Text="Connect Steam achievements" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Uses your Steam ID from Settings. Your API key is saved securely on this PC." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,14" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><PasswordBox x:Name="SteamApiKey" MaxLength="32" Height="38" VerticalContentAlignment="Center" AutomationProperties.Name="Steam Web API key" /><Button Grid.Column="1" Content="Connect" Click="ConnectSteam_Click" Style="{StaticResource DetailButton}" Margin="10,0,0,0" /><Button Grid.Column="2" Content="Profile settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource DetailButton}" Margin="10,0,0,0" /></Grid>
              <Button Content="Get a Steam Web API key ↗" Click="GetSteamKey_Click" Style="{StaticResource DetailButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="0,8" Background="Transparent" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border x:Name="NotesPanel" Style="{StaticResource DetailGlass}" Visibility="{Binding IsNotes, Converter={StaticResource VisibleWhen}}">
          <StackPanel><TextBlock Text="Your notes" Style="{StaticResource DetailHeading}" /><TextBlock Text="Just for this game. Saved automatically on this PC." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,18" />
            <TextBox x:Name="GameNotes" IsEnabled="{Binding CanEditPreferences}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="270" MaxLength="32000" Padding="18" FontSize="14" AutomationProperties.Name="Game notes" />
            <Grid Margin="0,16,0,0"><TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" /><Button Content="Save notes" Command="{Binding SaveCommand}" Style="{StaticResource DetailButton}" HorizontalAlignment="Right" /></Grid>
          </StackPanel>
        </Border>
        <Border x:Name="LaunchOptionsPanel" Style="{StaticResource DetailGlass}" Visibility="{Binding IsLaunchOptions, Converter={StaticResource VisibleWhen}}">
          <StackPanel><TextBlock Text="Launch options" Style="{StaticResource DetailHeading}" /><TextBlock Text="Additional arguments for this game" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,10" />
            <TextBox x:Name="LaunchArgumentsBox" IsEnabled="{Binding CanEditPreferences}" Text="{Binding LaunchArguments, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" Padding="14" AutomationProperties.Name="Game launch arguments" />
            <TextBlock Text="Only use options supported by the game, for example -windowed." FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,24" />
            <TextBlock Text="STARTUP" Style="{StaticResource DetailCaption}" /><TextBlock Text="{Binding LaunchTarget}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsLocalGame, Converter={StaticResource VisibleWhen}}" IsEnabled="{Binding CanEditPreferences}" Margin="0,0,0,20"><Button Content="Choose executable" Click="ChooseExecutable_Click" Style="{StaticResource DetailButton}" Margin="0,0,10,0" /><Button Content="Use detected executable" Click="ResetExecutable_Click" Style="{StaticResource DetailButton}" /></StackPanel>
            <TextBlock Text="INSTALLATION" Style="{StaticResource DetailCaption}" /><TextBlock Text="{Binding InstallationLabel}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,24" />
            <Grid><TextBlock Text="{Binding SaveStatus}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" /><Button Content="Save options" Command="{Binding SaveCommand}" Style="{StaticResource DetailButton}" HorizontalAlignment="Right" /></Grid>
          </StackPanel>
        </Border>
        <Expander x:Name="GameToolsDisclosure" Header="Your game tools" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" Margin="0,20,0,0">
          <StackPanel><Border Padding="3" CornerRadius="12" Background="#08FFFFFF" HorizontalAlignment="Left" Margin="0,12,0,30" Width="500">
          <Grid x:Name="TabRail" SizeChanged="TabRail_SizeChanged">
            <Border x:Name="TabIndicator" CornerRadius="9" Background="#15FFFFFF" BorderThickness="0" HorizontalAlignment="Left" IsHitTestVisible="False"><Border.RenderTransform><TranslateTransform x:Name="TabSlide" /></Border.RenderTransform></Border>
          <UniformGrid Columns="4">
            <RadioButton Content="Overview" GroupName="GameTabs" Style="{StaticResource DetailTab}" IsChecked="{Binding IsOverview, Mode=OneWay}" Command="{Binding SelectTabCommand}" CommandParameter="0" />
            <RadioButton Content="Achievements" GroupName="GameTabs" Style="{StaticResource DetailTab}" IsChecked="{Binding IsAchievements, Mode=OneWay}" Command="{Binding SelectTabCommand}" CommandParameter="1" />
            <RadioButton Content="Notes" GroupName="GameTabs" Style="{StaticResource DetailTab}" IsChecked="{Binding IsNotes, Mode=OneWay}" Command="{Binding SelectTabCommand}" CommandParameter="2" />
            <RadioButton Content="Launch options" GroupName="GameTabs" Style="{StaticResource DetailTab}" IsChecked="{Binding IsLaunchOptions, Mode=OneWay}" Command="{Binding SelectTabCommand}" CommandParameter="3" />
          </UniformGrid>
          </Grid>
        </Border><Border x:Name="GameActionBar" Background="Transparent" Padding="0,16" controls:SurfaceMotion.RevealOnShow="True">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="0" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>


            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0"><TextBlock Text="PLAY TIME" Style="{StaticResource DetailCaption}" /><TextBlock x:Name="PlayTimeText" Text="{Binding PlayTimeLabel}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /></StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="{Binding LastPlayedCaption}" Style="{StaticResource DetailCaption}" /><TextBlock Text="{Binding LastPlayedLabel}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding SourceCaption}" Style="{StaticResource DetailCaption}" /><TextBlock Text="{Binding SourceLabel}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
            <Button Grid.Column="4" Style="{StaticResource DetailButton}" Command="{Binding OpenFolderCommand}" Padding="11" Width="40" Height="40" AutomationProperties.Name="Open installation folder"><ui:SymbolIcon Symbol="Folder24" FontSize="18" /></Button>
            <Button Grid.Column="5" Style="{StaticResource DetailButton}" Command="{Binding SelectTabCommand}" CommandParameter="3" Padding="11" Width="40" Height="40" AutomationProperties.Name="Launch options"><ui:SymbolIcon Symbol="Settings24" FontSize="18" /></Button>
          </Grid>
        </Border></StackPanel>
        </Expander>
      </StackPanel>
      </Grid>
    </StackPanel>
    </Grid>
  </ScrollViewer>
  <Border x:Name="DetailsChromeScrim" Height="64" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0">
    <Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="White"/><GradientStop Color="White" Offset="0.72"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Border.OpacityMask>
  </Border>
  <Button x:Name="BackButton" Style="{StaticResource DetailMainAction}" Command="{Binding BackCommand}"
          Panel.ZIndex="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,76,0,0"
          Width="42" Height="42" Padding="0" Background="{DynamicResource DialogSurfaceBrush}"
          BorderBrush="{DynamicResource DetailEdgeBrush}" BorderThickness="1" ToolTip="Back to your games"
          AutomationProperties.Name="Back to your games"><ui:SymbolIcon Symbol="ChevronLeft24" FontSize="18"/></Button>
  <controls:GameScreenshotViewer x:Name="ScreenshotViewer" Margin="0,54,0,0" Panel.ZIndex="11" Visibility="Collapsed" />
  <Grid x:Name="InstallationHost" Visibility="Collapsed" Panel.ZIndex="10" />
  </Grid>
</Page>
