<Page x:Class="Steamy.Pages.GameFixesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style x:Key="FixBadge" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="FixRow" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="DialogSectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <LinearGradientBrush x:Key="HeroBannerFade" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#00000000" Offset="0.0" />
      <GradientStop Color="#90000000" Offset="0.55" />
      <GradientStop Color="#E8000000" Offset="1.0" />
    </LinearGradientBrush>
    <Style x:Key="FixIconBadge" TargetType="Border">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,14,0" />
    </Style>
  </Page.Resources>

  <Grid>
    <Grid x:Name="MainContentGrid" Margin="26,26,20,0" HorizontalAlignment="Stretch">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Grid.Row="0" Margin="0,0,8,16"
            Background="{DynamicResource SurfaceElevatedBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="8,7">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBox Grid.Column="0"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Search game fixes…"
                    Icon="{ui:SymbolIcon Search24}"
                    FontSize="13"
                    Background="{DynamicResource SurfaceBrush}"
                    HorizontalAlignment="Stretch"
                    MinHeight="38"
                    VerticalAlignment="Center" />
        <Border Grid.Column="1" Style="{StaticResource AccentPillStyle}" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding CatalogCountLabel}" Style="{StaticResource AccentPillTextStyle}" />
        </Border>
        <ui:ProgressRing Grid.Column="2"
                         Width="22" Height="22"
                         IsIndeterminate="{Binding IsLoading}"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Margin="10,0,0,0"
                         VerticalAlignment="Center" />
        <ui:Button Grid.Column="3"
                   Style="{StaticResource IconButtonStyle}"
                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                   Command="{Binding FetchCommand}"
                   Appearance="Secondary"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   ToolTip="Refresh fixes" />
      </Grid>
    </Border>

    <!-- Scrollable grid + pager -->
    <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollHostStyle}" Padding="0,0,8,0">
      <StackPanel>
        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Empty state -->
        <TextBlock Margin="2,12,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasGames}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
          <Run Text="{Binding EmptyStateMessage, Mode=OneWay}" />
        </TextBlock>

        <!-- Game cards grid -->
        <ItemsControl ItemsSource="{Binding PagedGames}" HorizontalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemWidth="186" ItemHeight="326" HorizontalAlignment="Left" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="7,4,7,10"
                      Width="172"
                      Height="312"
                      Style="{StaticResource CoverCardStyle}"
                      MouseLeftButtonUp="GameCard_MouseLeftButtonUp"
                      Tag="{Binding}"
                      ToolTip="{Binding Name}">
                <Border.Clip>
                  <RectangleGeometry Rect="0,0,172,312" RadiusX="12" RadiusY="12" />
                </Border.Clip>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="252" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>

                  <!-- Cover -->
                  <Grid ClipToBounds="True" Background="#0B0C0F">
                    <Image Source="{Binding ArtworkImage}" Stretch="UniformToFill" />
                    <Border Background="{DynamicResource SurfaceSubtleBrush}"
                            Visibility="{Binding IsArtworkLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <StackPanel VerticalAlignment="Center">
                        <Rectangle Height="10" Margin="34,0,34,12" RadiusX="5" RadiusY="5" Fill="{DynamicResource ControlHoverBrush}" />
                        <Rectangle Height="10" Margin="24,0,24,0" RadiusX="5" RadiusY="5" Fill="{DynamicResource ControlHoverBrush}" />
                      </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding CoverGlyph}"
                               Foreground="#3A3E47"
                               FontSize="32"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsArtworkFallback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Rectangle VerticalAlignment="Bottom" Height="70" Fill="{StaticResource CoverFadeBrush}" />
                    <Border Style="{StaticResource CoverBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                      <TextBlock Text="{Binding Summary}" Style="{StaticResource CoverBadgeTextStyle}" />
                    </Border>
                  </Grid>

                  <!-- Footer -->
                  <StackPanel Grid.Row="1" Margin="11,8,11,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AppLabel}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="10.5"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Pager -->
        <Border Style="{StaticResource FilterBarStyle}" Margin="0,12,0,16" Padding="10,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding VisibleCountLabel}"
                       Style="{StaticResource TertiaryTextStyle}"
                       FontSize="11.5"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
              <ui:Button Content="Previous"
                         Command="{Binding PreviousPageCommand}"
                         Appearance="Secondary"
                         IsEnabled="{Binding CanGoPrevious}" />
              <Border Style="{StaticResource AccentPillStyle}" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="{Binding PageLabel}" Style="{StaticResource AccentPillTextStyle}" />
              </Border>
              <ui:Button Content="Next"
                         Command="{Binding NextPageCommand}"
                         Appearance="Secondary"
                         IsEnabled="{Binding CanGoNext}" />
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Text="{Binding LastFetchLabel}"
                       Style="{StaticResource TertiaryTextStyle}"
                       FontSize="11"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    </Grid>

    <!-- Fix dialog overlay -->
    <Grid x:Name="OverlayGrid" Visibility="Collapsed">
      <Border Background="#B3000000" MouseLeftButtonUp="Overlay_Close" />
      <Border x:Name="DialogPanel"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="20"
              Width="560"
              MaxHeight="720"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True"
              RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
          <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.5" />
        </Border.Effect>
        <Border.RenderTransform><ScaleTransform x:Name="DialogScale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
        <Border.Clip>
          <RectangleGeometry Rect="0,0,560,720" RadiusX="20" RadiusY="20" />
        </Border.Clip>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Hero banner with game artwork -->
          <Grid Grid.Row="0" Height="140" ClipToBounds="True">
            <Grid Background="#0B0C0F">
              <Image x:Name="OverlayHeroImage" Stretch="UniformToFill" VerticalAlignment="Center" Opacity="0.85" />
            </Grid>
            <Border Background="{StaticResource HeroBannerFade}" />
            <!-- Close button over the hero -->
            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                       Style="{StaticResource IconButtonStyle}"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Width="32" Height="32" MinHeight="32"
                       ToolTip="Close"
                       Click="OverlayCloseButton_Click">
              <ui:Button.Foreground>
                <SolidColorBrush Color="White" />
              </ui:Button.Foreground>
            </ui:Button>
            <!-- Title over the hero -->
            <StackPanel VerticalAlignment="Bottom" Margin="24,0,56,16">
              <TextBlock x:Name="OverlayTitle" Text="Game Fixes"
                         Foreground="White" FontSize="18" FontWeight="Bold"
                         TextTrimming="CharacterEllipsis">
                <TextBlock.Effect>
                  <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.6" />
                </TextBlock.Effect>
              </TextBlock>
              <TextBlock x:Name="OverlayAppId" Text="App 0"
                         Foreground="#B0FFFFFF" FontSize="11.5" Margin="0,3,0,0">
                <TextBlock.Effect>
                  <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.5" />
                </TextBlock.Effect>
              </TextBlock>
            </StackPanel>
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18,24,6">
            <StackPanel>
              <!-- Game folder -->
              <TextBlock Text="GAME FOLDER" Style="{StaticResource DialogSectionLabel}" />
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,18">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource SurfaceSubtleBrush}" Margin="4,0,12,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Folder24" FontSize="16" Foreground="{DynamicResource TextTertiaryBrush}" />
                  </Border>
                  <TextBlock Grid.Column="1" x:Name="FolderPathText" Text="Select the game folder…"
                             Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <ui:Button Grid.Column="2" Content="Browse" Appearance="Secondary"
                             Margin="8,0,2,0" Click="BrowseFolderButton_Click" />
                </Grid>
              </Border>

              <!-- Fixes list -->
              <TextBlock Text="AVAILABLE FIXES" Style="{StaticResource DialogSectionLabel}" />
              <StackPanel x:Name="FixesList" />

              <!-- Status -->
              <Border x:Name="StatusBorder" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,6,0,0" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ui:SymbolIcon x:Name="StatusIcon" Symbol="Info24" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                  <TextBlock Grid.Column="1" x:Name="OverlayStatus" Text="" Foreground="{DynamicResource AccentBrush}" FontSize="12" TextWrapping="Wrap" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Footer -->
          <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,14,24,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:Button Content="Close" Appearance="Secondary" Click="OverlayCloseButton_Click" />
              <ui:Button Grid.Column="2"
                       Content="Apply ZIP"
                       Icon="{ui:SymbolIcon FolderOpen24}"
                       Appearance="Secondary"
                       Margin="0,0,8,0"
                       ToolTip="Select a ZIP you already downloaded"
                       Click="ApplyZipButton_Click" />
              <ui:Button Grid.Column="3"
                       x:Name="ApplyAllButton"
                       Content="Download &amp; Apply All"
                       Icon="{ui:SymbolIcon ArrowDownload24}"
                       Appearance="Primary"
                       Click="ApplyAllButton_Click" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
