<Page x:Class="Steamy.Pages.AchievementsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Page.Resources>
  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" Padding="30,26,30,44">
    <StackPanel MaxWidth="1240" HorizontalAlignment="Stretch">
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Achievements" Style="{StaticResource PageTitleStyle}" />
          <TextBlock Text="Achievement metadata is only shown when a source is configured; nothing is generated locally."
                     Style="{StaticResource PageSubtitleStyle}" Margin="0" />
        </StackPanel>
        <ui:Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Appearance="Secondary" VerticalAlignment="Center" />
      </Grid>

      <Border Style="{StaticResource FilterBarStyle}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding StatusMessage}"
                     Style="{StaticResource MutedTextStyle}"
                     FontSize="12"
                     VerticalAlignment="Center"
                     MaxWidth="620"
                     TextTrimming="CharacterEllipsis" />
          <ui:TextBox Grid.Column="1"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                      PlaceholderText="Search achievements"
                      Width="250"
                      Margin="12,0,8,0" />
          <controls:FilterFlyout Grid.Column="2"
                                 FilterSummary="{Binding FilterSummary}"
                                 HasActiveFilters="{Binding HasActiveFilters}">
            <controls:FilterFlyout.FilterContent>
              <StackPanel>
                <TextBlock Text="Achievement status" Style="{StaticResource PillTextStyle}" />
                <ComboBox ItemsSource="{Binding Filters}"
                          SelectedItem="{Binding SelectedFilter}"
                          Margin="0,5,0,0" />
              </StackPanel>
            </controls:FilterFlyout.FilterContent>
          </controls:FilterFlyout>
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding FilteredAchievements}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,10" Padding="16">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" Background="{DynamicResource AccentSoftBrush}" CornerRadius="14">
                  <TextBlock Text="{Binding IconGlyph}" Foreground="{DynamicResource AccentBrush}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,20,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="  ·  " Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding GameName}" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,5,0,0" />
                  <ProgressBar Value="{Binding Progress}" Maximum="100" Margin="0,10,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ProgressLabel}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding UnlockedAt}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" Margin="0,5,0,0" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="No achievements match the current view."
                 Style="{StaticResource MutedTextStyle}"
                 Margin="0,10,0,0"
                 Visibility="{Binding HasAchievements, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
  </ScrollViewer>
</Page>
