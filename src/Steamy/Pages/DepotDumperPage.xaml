<Page x:Class="Steamy.Pages.DepotDumperPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="RiseIn" TargetType="FrameworkElement">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="12" /></Setter.Value></Setter>
      <Style.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.44">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RiseInLate" TargetType="FrameworkElement" BasedOn="{StaticResource RiseIn}">
      <Setter Property="Opacity" Value="0" />
      <Style.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4" BeginTime="0:0:0.14">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.44" BeginTime="0:0:0.14">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="FieldHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Game row: soft wash on hover, accent bar when it is the picked one -->
    <Style x:Key="GameRow" TargetType="Border">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>

  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" Padding="36,28,36,56">
    <StackPanel MaxWidth="1320" HorizontalAlignment="Stretch">

      <!-- Header -->
      <Grid Style="{StaticResource RiseIn}" Margin="0,0,0,22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center" Margin="0,0,12,0">
              <ui:SymbolIcon Symbol="CloudArrowDown24" FontSize="18" Foreground="{DynamicResource AccentBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Depot Dumper" Style="{StaticResource PageTitleStyle}" Margin="0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Border Width="22" Height="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Grab the Lua and every depot manifest, then send them straight to the project's private dump repository."
                       Style="{StaticResource PageSubtitleStyle}" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:ProgressRing Width="18" Height="18" Margin="0,0,14,0" IsIndeterminate="True"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
          <ui:Button Content="Open folder" Appearance="Secondary" CornerRadius="10" Icon="{ui:SymbolIcon FolderOpen24}"
                     Command="{Binding RevealFolderCommand}" Margin="0,0,8,0" />
          <ui:Button Content="Cancel" Appearance="Danger" CornerRadius="10" Icon="{ui:SymbolIcon Dismiss24}"
                     Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </Grid>

      <!-- Control card -->
      <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="1.25*" />
          </Grid.ColumnDefinitions>

          <!-- Left: what to dump -->
          <StackPanel Grid.Column="0">
            <TextBlock Text="What to dump" Style="{StaticResource FieldLabel}" />
            <TextBlock Text="Steam App ID or a game from your library." Style="{StaticResource FieldHint}" />

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Text="{Binding AppIdText, UpdateSourceTrigger=PropertyChanged}"
                          PlaceholderText="App ID, e.g. 730"
                          Icon="{ui:SymbolIcon Search24}" />
              <ui:Button Grid.Column="1" Content="Refresh library" Appearance="Secondary" CornerRadius="10"
                         Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowClockwise24}"
                         Command="{Binding RefreshGamesCommand}" />
            </Grid>

            <TextBlock Text="Manifest source" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
            <ComboBox ItemsSource="{Binding AvailableSources}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedSource}" Height="34" Margin="0,8,0,0" />
            <TextBlock Text="{Binding SourceHint}" Style="{StaticResource FieldHint}" />

            <!-- Own-account dump -->
            <Border Style="{StaticResource InfoPanelStyle}" CornerRadius="12" Margin="0,16,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Dump from your own account" Style="{StaticResource FieldLabel}" FontSize="12.5" />
                    <TextBlock Text="Also grabs depots only your licensed account can see. Steamy never touches your password — the tool's own console asks for it and the 2FA / Steam Guard code."
                               Style="{StaticResource FieldHint}" FontSize="11.5" />
                  </StackPanel>
                  <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding UseSteamLogin}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>
                <ui:TextBox Text="{Binding SteamUsername, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Steam account name (no password)"
                            Height="32" Margin="0,10,0,0"
                            Visibility="{Binding UseSteamLogin, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </Border>

            <TextBlock Text="Dump folder" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}"
                          PlaceholderText="Leave empty for the download folder" />
              <ui:Button Grid.Column="1" Content="Browse…" Appearance="Secondary" CornerRadius="10"
                         Margin="8,0,0,0" Click="BrowseFolder_Click" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <ui:SymbolIcon Symbol="Info24" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center" Margin="0,0,7,0" />
              <TextBlock Text="{Binding DumpFolderPreview}" Style="{StaticResource TertiaryTextStyle}"
                         FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>

          <!-- Right: what happens -->
          <StackPanel Grid.Column="2">
            <TextBlock Text="Dump &amp; share" Style="{StaticResource FieldLabel}" />
            <TextBlock Text="Dumping only reads the source. Sending commits the packed ZIP to the repository below; your Steam account and local paths are never included."
                       Style="{StaticResource FieldHint}" />

            <Border Style="{StaticResource InfoPanelStyle}" CornerRadius="12" Margin="0,14,0,0">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Share24" FontSize="14" Foreground="{DynamicResource PinkBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                <StackPanel>
                  <TextBlock Text="{Binding ShareTarget}" FontSize="12.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="Private dump repository" Style="{StaticResource MutedTextStyle}" FontSize="11.5" />
                </StackPanel>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <ui:Button Content="Dump manifest + Lua" Appearance="Primary" CornerRadius="10" Padding="18,9"
                         Icon="{ui:SymbolIcon CloudArrowDown24}" Command="{Binding DumpCommand}" Margin="0,0,8,0"
                         ToolTip="Fetches the Lua and every depot manifest of this app. With your own account on, licensed depots are included." />
              <ui:Button Content="Send to repository" Appearance="Secondary" CornerRadius="10" Padding="18,9"
                         Icon="{ui:SymbolIcon Share24}" Command="{Binding ShareCommand}" />
            </StackPanel>
            <ui:Button Style="{StaticResource LinkButtonStyle}" Margin="-10,8,0,0" HorizontalAlignment="Left"
                       Content="Share all your dumps and installed games at once" Icon="{ui:SymbolIcon ArrowRight24}"
                       Command="{Binding OpenShareCommand}" />

            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedTextStyle}" FontSize="12"
                       Margin="0,14,0,0" TextWrapping="Wrap" />

            <!-- Result -->
            <Border CornerRadius="12" Padding="14,11" Margin="0,14,0,0"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ResultSuccess}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Info24" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ui:SymbolIcon.Style>
                      <Style TargetType="ui:SymbolIcon">
                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ResultSuccess}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ui:SymbolIcon.Style>
                  </ui:SymbolIcon>
                  <TextBlock Text="{Binding ResultMessage}" FontSize="12.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="{Binding ResultDetail}" Style="{StaticResource TertiaryTextStyle}" FontSize="11.5"
                           Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Library + log -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="340" />
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,18">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Your library" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Grid.Column="1" Text="{Binding GameCountLabel}" Style="{StaticResource TertiaryTextStyle}"
                         FontSize="11.5" VerticalAlignment="Center" />
            </Grid>
            <ui:TextBox Text="{Binding GameSearchText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Search games…" Margin="0,12,0,8" Icon="{ui:SymbolIcon Search24}" />
            <ScrollViewer Height="380" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding FilteredGames}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource GameRow}" MouseLeftButtonDown="GameRow_MouseDown">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding AppId}" FontSize="11" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Typography.NumeralAlignment="Tabular" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,18">
          <StackPanel>
            <TextBlock Text="Activity" Style="{StaticResource CardTitleStyle}" />
            <TextBlock Text="Every request the dumper makes, with a timestamp."
                       Style="{StaticResource FieldHint}" />
            <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="12" Padding="14,12" Margin="0,14,0,0">
              <ScrollViewer Height="340" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Log}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Page>
