<Page x:Class="Steamy.Pages.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      xmlns:local="clr-namespace:Steamy.Pages"
      FontFamily="{DynamicResource SteamyFontFamily}" UseLayoutRounding="True" SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed" RenderOptions.ClearTypeHint="Auto"
      PreviewKeyDown="Page_PreviewKeyDown"
      ScrollViewer.CanContentScroll="False"
      Background="Transparent">
  <Page.Resources>
    <!-- Official Steam header mark: source recorded in THIRD-PARTY-NOTICES. Vector paths retain the supplied shape. -->
