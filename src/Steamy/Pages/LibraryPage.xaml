<Page x:Class="Steamy.Pages.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Steamy.Controls"
      xmlns:local="clr-namespace:Steamy.Pages"
      UseLayoutRounding="True" SnapsToDevicePixels="True"
      PreviewKeyDown="Page_PreviewKeyDown"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource WorkspaceBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <local:EnumToShowBoolConverter x:Key="EnumTo_ShowBoolConverter" />
    <!-- keep local xmlns for correctness -->
    <Style x:Key="GalleryEmptyStateStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Margin" Value="2,12,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasCatalogItems}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Option rows and host chips inside the download dialog. The code-behind swaps
         Background/BorderBrush for the selected state using the same theme brushes. -->
    <Style x:Key="OptionRow" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="HostPill" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="DialogSectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <LinearGradientBrush x:Key="HeroBannerFade" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#00000000" Offset="0" />
      <GradientStop Color="#CC0A0D14" Offset="0.6" />
      <GradientStop Color="#F80A0D14" Offset="1" />
    </LinearGradientBrush>

    <!-- Dashboard stat tile -->
    <Style x:Key="StatTileStyle" TargetType="Border" BasedOn="{StaticResource SurfaceCardStyle}">
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Margin" Value="6,0" />
    </Style>

    <!-- Dashboard shortcut tile: icon badge + title + subtitle, click to navigate -->
    <Style x:Key="ShortcutTileStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="15,14" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ShortcutIconBadge" TargetType="Border">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <Grid>
    <Grid x:Name="MainContentGrid" Margin="32,26,24,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Header: title left, search + filter + refresh right -->
      <Grid Grid.Row="0" Margin="0,0,8,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Games" Style="{StaticResource PageTitleStyle}" Margin="0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CatalogCountLabel}" Margin="12,6,0,0" FontSize="12.5"
                     Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <ui:TextBox Grid.Column="2"
                    Width="300"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Search games…"
                    Icon="{ui:SymbolIcon Search24}"
                    FontSize="13"
                    MinHeight="38"
                    VerticalAlignment="Center">
          <ui:TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SubmitSearchCommand}" /></ui:TextBox.InputBindings>
        </ui:TextBox>
        <controls:FilterFlyout Grid.Column="3"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FilterSummary="{Binding FilterSummary}"
                               HasActiveFilters="{Binding HasActiveFilters}">
          <controls:FilterFlyout.FilterContent>
            <StackPanel>
              <TextBlock Text="Show" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedTypeFilter}" Margin="0,0,0,12" />
              <TextBlock Text="Manifest source" Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" />
              <ComboBox ItemsSource="{Binding SourceFilters}" SelectedItem="{Binding SelectedSourceFilter}" Margin="0,0,0,12" AutomationProperties.Name="Filter games by manifest source" />
              <TextBlock Text="{Binding SourceFilterHint}" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" Margin="0,0,0,12" />
              <TextBlock Text="Sort" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Margin="0,0,0,12" />
              <TextBlock Text="Cards per page" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" />
              <CheckBox Content="Include adult games (NSFW)" IsChecked="{Binding NsfwScope, Converter={StaticResource EnumTo_ShowBoolConverter}, ConverterParameter=Show}" Margin="0,12,0,0" />
              <TextBlock Text="NSFW games are hidden by default and show with the adult label." Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
          </controls:FilterFlyout.FilterContent>
        </controls:FilterFlyout>
        <ui:Button Grid.Column="4"
                   Style="{StaticResource IconButtonStyle}"
                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                   Command="{Binding RefreshCatalogCommand}"
                   Appearance="Secondary"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   ToolTip="Refresh list" />
      </Grid>

      <StackPanel Grid.Row="1" Margin="0,0,8,8">
        <ProgressBar IsIndeterminate="True" Height="2" Margin="0,0,0,6" Visibility="{Binding IsCatalogLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Grid Visibility="{Binding ShowRecentSearches, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <ItemsControl ItemsSource="{Binding RecentSearches}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <ui:Button Content="{Binding}" CommandParameter="{Binding}" Command="{Binding DataContext.UseRecentSearchCommand, RelativeSource={RelativeSource AncestorType=Page}}" Appearance="Transparent" FontSize="11" Padding="8,4" Margin="0,0,6,3" />
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <ui:Button Grid.Column="1" Content="Clear history" Appearance="Transparent" FontSize="10.5" Command="{Binding ClearSearchHistoryCommand}" />
        </Grid>
        <TextBlock Text="{Binding SearchHint}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding SearchSuggestions}" Visibility="{Binding HasSearchSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <ui:Button Command="{Binding DataContext.SelectSearchSuggestionCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Appearance="Transparent" Padding="6" Margin="0,0,8,6" ToolTip="{Binding Name}">
              <StackPanel Orientation="Horizontal">
                <Image Source="{Binding HeaderImage}" Width="46" Height="28" Stretch="UniformToFill" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Name}" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11" />
              </StackPanel>
            </ui:Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <ScrollViewer Grid.Row="2" controls:SmoothScroll.Enabled="True" Style="{StaticResource PageScrollHostStyle}" Padding="0,0,8,0">
        <StackPanel>
          <TextBlock Text="{Binding EmptyStateMessage}" Style="{StaticResource GalleryEmptyStateStyle}" />

          <ItemsControl ItemsSource="{Binding PagedCatalogItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:AdaptiveGridPanel MinItemWidth="174" Spacing="20" CoverRatio="1.38" FooterHeight="64" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button x:Name="Card" Style="{StaticResource GalleryCardButton}"
                        Click="GameCard_Click" Tag="{Binding}" ToolTip="{Binding Name}"
                        AutomationProperties.Name="{Binding Name}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="64" />
                    </Grid.RowDefinitions>

                    <Border CornerRadius="15,15,0,0" Background="#0B0C0F">
                      <Grid>
                        <Border CornerRadius="15,15,0,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True">
                          <Border.Background>
                            <ImageBrush ImageSource="{Binding ArtworkImage}" Stretch="UniformToFill" />
                          </Border.Background>
                        </Border>
                        <Border CornerRadius="15,15,0,0" Background="{DynamicResource SurfaceSubtleBrush}"
                                Visibility="{Binding IsArtworkLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="STEAM" Foreground="#3A3E47" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsArtworkFallback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <!-- Bottom fade for text readability -->
                        <Border CornerRadius="0,0,0,0" Height="60" VerticalAlignment="Bottom">
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                              <GradientStop Color="#00000000" Offset="0" />
                              <GradientStop Color="#40000000" Offset="1" />
                            </LinearGradientBrush>
                          </Border.Background>
                        </Border>
                        <Border x:Name="Shine" CornerRadius="15,15,0,0" Background="#FFFFFF" Opacity="0" />
                        <Border Style="{StaticResource CoverBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                          <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource CoverBadgeTextStyle}" />
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                Style="{StaticResource CoverBadgeStyle}" ToolTip="Installed"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                          <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Installed" Style="{StaticResource CoverBadgeTextStyle}" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Border>

                    <!-- Footer -->
                    <StackPanel Grid.Row="1" Margin="14,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="13" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding AppLabel}" Margin="0,4,0,0"
                                 Foreground="{DynamicResource TextTertiaryBrush}"
                                 FontSize="10.5" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
                <DataTemplate.Triggers>
                  <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Shine" Property="Opacity" Value="0.035" />
                  </Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Pager: flat, centered -->
          <Grid Margin="0,22,0,26">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding VisibleCountLabel}" FontSize="11.5"
                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ui:Button Style="{StaticResource IconButtonStyle}" Icon="{ui:SymbolIcon ChevronLeft24}"
                         Appearance="Transparent" Command="{Binding PreviousPageCommand}"
                         IsEnabled="{Binding CanGoPrevious}" ToolTip="Previous page" />
              <TextBlock Text="{Binding PageLabel}" Margin="14,0" FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
              <ui:Button Style="{StaticResource IconButtonStyle}" Icon="{ui:SymbolIcon ChevronRight24}"
                         Appearance="Transparent" Command="{Binding NextPageCommand}"
                         IsEnabled="{Binding CanGoNext}" ToolTip="Next page" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding UpdatedLabel}" FontSize="11"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <!-- A half-resolution frozen backdrop keeps modal blur independent of live progress updates. -->
    <Image x:Name="BackdropImage" Margin="32,26,24,0" Visibility="Collapsed" Stretch="Fill"
           IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
      <Image.Effect><BlurEffect Radius="14" RenderingBias="Performance" /></Image.Effect>
    </Image>
    <!-- Download dialog overlay -->
    <Grid x:Name="OverlayGrid" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
      <Border Background="#65070B12" MouseLeftButtonUp="Overlay_Close" />
      <Border x:Name="DialogPanel"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource SolidSurfaceBrush}"
              BorderThickness="1" CornerRadius="16"
              Width="640" MaxWidth="{Binding ActualWidth, ElementName=OverlayGrid}"
              MaxHeight="{Binding ActualHeight, ElementName=OverlayGrid}"
              Margin="16" RenderTransformOrigin="0.5,0.5">
        <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#70FFFFFF" Offset="0" /><GradientStop Color="#16FFFFFF" Offset="0.6" /><GradientStop Color="#28FFFFFF" Offset="1" />
        </LinearGradientBrush></Border.BorderBrush>
        <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="DialogScale" /><TranslateTransform x:Name="DialogOffset" /></TransformGroup></Border.RenderTransform>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Hero banner -->
          <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="{DynamicResource AccentSoftBrush}">
          <Grid Height="128">
            <Image x:Name="OverlayCover" Stretch="UniformToFill" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Border Background="{StaticResource HeroBannerFade}" />
            <ui:Button x:Name="DialogCloseButton" Style="{StaticResource IconButtonStyle}"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Width="30" Height="30" MinHeight="30"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,12,14,0"
                       ToolTip="Close"
                       Click="OverlayCloseButton_Click">
            </ui:Button>
            <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,14">
              <TextBlock x:Name="OverlayTitle" Text="Download Game"
                         Foreground="White"
                         FontSize="20" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="OverlayAppId" Text="App 0"
                         Foreground="#C7CBD8"
                         FontSize="11.5" Margin="0,3,0,0" />
            </StackPanel>
          </Grid>
          </Border>

          <ScrollViewer Grid.Row="1" controls:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto" Padding="24,16,24,6">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <ui:Button x:Name="FavoriteButton" Content="Favorite" Icon="{ui:SymbolIcon Heart24}" Appearance="Secondary" Click="FavoriteButton_Click" />
                <ui:Button x:Name="PlayButton" Content="Play in Steam" Icon="{ui:SymbolIcon Play24}" Appearance="Secondary" Margin="8,0,0,0" Visibility="Collapsed" Click="PlayButton_Click" />
              </StackPanel>
              <TextBlock x:Name="WizardStepText" Text="1 · Choose a source" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
              <TextBlock x:Name="WizardTrailText" Text="Source  →  Depots &amp; version  →  Location" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,16" />
              <ProgressBar x:Name="WizardBusyBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,12" />
              <StackPanel x:Name="SourceStepPanel">
                <TextBlock Text="Choose where to load this game's available depot versions." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />
                <UniformGrid Columns="2">
                  <ui:Button x:Name="SourceSushi" Tag="Sushi" Content="Sushi · free" Click="SourceButton_Click" Appearance="Secondary" Padding="14,11" HorizontalAlignment="Stretch" Margin="0,0,8,8" ToolTip="No API key needed" />
                  <ui:Button x:Name="SourceZaza" Tag="Zaza" Content="Zaza · free" Click="SourceButton_Click" Appearance="Secondary" Padding="14,11" HorizontalAlignment="Stretch" Margin="0,0,0,8" ToolTip="No API key needed" />
                  <ui:Button x:Name="SourceRyuu" Tag="Ryuu" Content="Ryuu" Click="SourceButton_Click" Appearance="Secondary" Padding="14,11" HorizontalAlignment="Stretch" Margin="0,0,8,8" ToolTip="Requires an auth code" />
                  <ui:Button x:Name="SourceHubcap" Tag="Hubcap" Content="Hubcap" Click="SourceButton_Click" Appearance="Secondary" Padding="14,11" HorizontalAlignment="Stretch" Margin="0,0,0,8" ToolTip="Requires an API key" />
                  <ui:Button x:Name="SourceDepotBox" Tag="DepotBox" Content="DepotBox" Click="SourceButton_Click" Appearance="Secondary" Padding="14,11" HorizontalAlignment="Stretch" Margin="0,0,8,8" ToolTip="Requires an API key" />
                </UniformGrid>
                <TextBlock x:Name="SourceAvailabilityText" Text="" FontSize="11" Margin="0,4,0,6" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel x:Name="DepotStepPanel" Visibility="Collapsed">
                <TextBlock x:Name="DepotSourceText" Text="Depots from the selected source" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBlock Text="Choose the depots you need. Only versions supplied by this source appear here." FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <ui:Button Content="Select all" Appearance="Transparent" Padding="0,4,12,4" Click="SelectAllDepots_Click" FontSize="11" />
                  <ui:Button Content="Clear selection" Appearance="Transparent" Padding="0,4" Click="ClearDepotSelection_Click" FontSize="11" />
                </StackPanel>
                <ItemsControl x:Name="DepotChoices">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,12,0" AutomationProperties.Name="{Binding Name}" />
                        <StackPanel Grid.Column="1">
                          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10.5" Margin="8,0,0,0" />
                          </Grid>
                          <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" DisplayMemberPath="Label" IsEnabled="{Binding IsSelected}" Margin="0,8,0,0" FontSize="11" MinHeight="34" AutomationProperties.Name="Choose depot version" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="DepotSelectionSummary" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel x:Name="LocationStepPanel" Visibility="Collapsed">
                <TextBlock x:Name="LocationSelectionText" Text="Your selection" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                <TextBlock Text="Download location" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" MinHeight="38">
                    <TextBlock x:Name="DownloadPathText" Text="Select a folder…" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </Border>
                  <ui:Button x:Name="LocationBrowseButton" Grid.Column="1" Content="Browse" Appearance="Secondary" Margin="8,0,0,0" Click="BrowseFolderButton_Click" />
                </Grid>
                <TextBlock Text="Final game folder" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,3" />
                <TextBlock x:Name="DownloadTargetText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="LocationSpaceText" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,8,0,14" />
                <Expander Header="Optional archive" IsExpanded="False" FontSize="11">
                  <Grid Margin="0,10,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="CustomArchiveText" Text="No archive selected" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Content="Add" Appearance="Secondary" Margin="8,0,0,0" Click="BrowseArchiveButton_Click" ToolTip="Extract .zip / .7z / .rar after download" />
                  </Grid>
                </Expander>
              </StackPanel>

              <!-- Status -->
              <TextBlock x:Name="OverlayStatus" Text=""
                         Foreground="{DynamicResource AccentBrush}"
                         FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>

          <!-- Footer -->
          <Border Grid.Row="2" Padding="0"
                  CornerRadius="0,0,16,16">
            <StackPanel>
              <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />
              <Grid Margin="24,14,24,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <ui:Button x:Name="BackButton" Content="Back" Appearance="Secondary" Visibility="Collapsed" Click="WizardBackButton_Click" />
                  <ui:Button x:Name="NewSelectionButton" Content="New selection" Appearance="Secondary" Visibility="Collapsed" Click="NewSelectionButton_Click" ToolTip="Select source and versions again; existing files are kept" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <ui:Button x:Name="PauseButton" Content="Pause" Icon="{ui:SymbolIcon Pause24}"
                             Appearance="Secondary" Margin="0,0,8,0"
                             Visibility="Collapsed" Click="PauseButton_Click" />
                  <ui:Button x:Name="StartButton"
                             Content="Next"
                             Icon="{ui:SymbolIcon ChevronRight24}"
                             Appearance="Primary"
                             Click="StartDownloadButton_Click" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
