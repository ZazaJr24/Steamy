51.909,61.5 151.909,34.161 141.779,34.161 141.779,28.175    168.988,28.175 168.988,34.161   Z"/><GeometryDrawing Brush="#E8FFFFFF" Geometry="M 183.7,34.143 183.7,41.652 197.056,41.652 197.056,47.638 183.7,47.638 183.7,55.459    199.196,55.459 199.196,61.5 176.723,61.5 176.723,28.175 199.196,28.175 199.196,34.143   Z"/><GeometryDrawing Brush="#E8FFFFFF" Geometry="M214.773,55.03l-2.206,6.471h-7.316l12.495-33.325h7.025L237.619,61.5h-7.563l-2.254-6.471H214.773z    M221.219,36.125l-4.551,13.343h9.196L221.219,36.125z"/><GeometryDrawing Brush="#E8FFFFFF" Geometry="M 273.436,41.056 264.316,60.529 260.378,60.529 251.406,41.23 251.406,61.5 244.723,61.5    244.723,28.175 251.391,28.175 262.591,52.231 273.393,28.175 280.119,28.175 280.119,61.5 273.437,61.5   Z"/><GeometryDrawing Brush="#E8FFFFFF" Geometry="M293.611,32.379c0,2.864-2.146,4.649-4.609,4.649c-2.472,0-4.623-1.785-4.623-4.649   c0-2.863,2.151-4.636,4.623-4.636C291.466,27.743,293.611,29.516,293.611,32.379 M285.154,32.379c0,2.396,1.726,3.901,3.848,3.901   c2.114,0,3.833-1.505,3.833-3.901c0-2.403-1.719-3.885-3.833-3.885C286.886,28.494,285.154,29.994,285.154,32.379 M289.066,30.01   c1.195,0,1.597,0.632,1.597,1.315c0,0.626-0.371,1.046-0.823,1.26l1.071,2.007h-0.877l-0.903-1.779H288.2v1.779h-0.73V30.01   H289.066z M288.207,32.142h0.814c0.527,0,0.838-0.331,0.838-0.747c0-0.42-0.223-0.69-0.84-0.69h-0.813V32.142z"/></DrawingGroup></DrawingImage.Drawing></DrawingImage>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <local:EnumToShowBoolConverter x:Key="EnumTo_ShowBoolConverter" />
    <local:GenreNameConverter x:Key="GenreNameConverter" />
    <local:GenreCountConverter x:Key="GenreCountConverter" />
    <Style x:Key="InstallDriveButton" TargetType="Button" BasedOn="{StaticResource GalleryCardButton}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="DriveSurface" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DriveSurface" Property="Background" Value="{DynamicResource CardHoverGlassBrush}" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- keep local xmlns for correctness -->
    <Style x:Key="GalleryEmptyStateStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Margin" Value="2,12,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasCatalogItems}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Option rows and host chips inside the download dialog. The code-behind swaps
         Background/BorderBrush for the selected state using the same theme brushes. -->
    <Style x:Key="OptionRow" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="HostPill" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="DialogSectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <LinearGradientBrush x:Key="HeroBannerFade" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#00000000" Offset="0" />
      <GradientStop Color="#B3162C47" Offset="0.6" />
      <GradientStop Color="#EC213B5B" Offset="1" />
    </LinearGradientBrush>

    <!-- Dashboard stat tile -->
    <Style x:Key="StatTileStyle" TargetType="Border" BasedOn="{StaticResource SurfaceCardStyle}">
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Margin" Value="6,0" />
    </Style>

    <!-- Dashboard shortcut tile: icon badge + title + subtitle, click to navigate -->
    <Style x:Key="ShortcutTileStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="15,14" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ShortcutIconBadge" TargetType="Border">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="LibraryTabs" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ItemsPresenter /></Border></ControlTemplate></Setter.Value></Setter>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="16,11" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Grid><Border x:Name="TabSurface" CornerRadius="6,6,0,0" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><Border x:Name="TabUnderline" Height="3" Background="{DynamicResource DownloadAccentBrush}" CornerRadius="1.5" VerticalAlignment="Bottom" Opacity="0" /></Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource GlassSurfaceBrush}" /><Setter TargetName="TabUnderline" Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource GlassSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="TabSurface" Property="BorderThickness" Value="1" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></Setter.Value></Setter>
    </Style>
    <Style x:Key="LibraryCoverButton" TargetType="Button" BasedOn="{StaticResource GalleryCardButton}">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="controls:CardMotion.HoverScale" Value="1" />
      <Setter Property="controls:CardMotion.HoverLift" Value="-3" />
      <Setter Property="controls:CardMotion.HoverDuration" Value="180" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid Background="Transparent"><Grid x:Name="MotionSurface">
          <Border x:Name="Chrome" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
          </Border>
        </Grid></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="LibrarySelectedChipForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LibrarySelectedChipBrush" Color="#343437" />
    <SolidColorBrush x:Key="LibrarySelectedChipBorderBrush" Color="#68686D" />
    <Style x:Key="LibraryFilterToggle" TargetType="ToggleButton" BasedOn="{StaticResource FilterToggleButtonStyle}">
      <Setter Property="Width" Value="108" /><Setter Property="Height" Value="44" /><Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="22"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LibrarySelectedChipBorderBrush}" /></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LibrarySelectedChipBrush}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LibrarySelectedChipBorderBrush}" /><Setter Property="Foreground" Value="{DynamicResource LibrarySelectedChipForegroundBrush}" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LibraryPills" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate></Setter.Value></Setter>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="14,0" /><Setter Property="Height" Value="34" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Pill" CornerRadius="17" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource LibrarySelectedChipForegroundBrush}" /><Setter TargetName="Pill" Property="Background" Value="{DynamicResource LibrarySelectedChipBrush}" /><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource LibrarySelectedChipBorderBrush}" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></Setter.Value></Setter>
    </Style>
    <Style x:Key="LibraryGenrePills" TargetType="ListBox" BasedOn="{StaticResource LibraryPills}">
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="14,0" /><Setter Property="Height" Value="40" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Pill" CornerRadius="20" Background="#161822" BorderBrush="#262A38" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FFFFFF" /><Setter TargetName="Pill" Property="Background" Value="#2D3244" /><Setter TargetName="Pill" Property="BorderBrush" Value="#545D78" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="#4A526B" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></Setter.Value></Setter>
      <Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding Converter={StaticResource GenreNameConverter}}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Converter={StaticResource GenreCountConverter}}" Foreground="#8A92A6" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </DataTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LibraryMoreButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FontSize" Value="14" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Padding" Value="24,10" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="22" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LibraryOptionalText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="InstallStepContent" TargetType="Expander">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <ContentPresenter x:Name="StepContent" ContentSource="Content" />
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="False"><Setter TargetName="StepContent" Property="Visibility" Value="Collapsed" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Page.Resources>

  <Grid x:Name="LibraryScene" Background="Transparent">
    <controls:ShellBackdropView x:Name="LibraryAmbientBackdrop" IsPageBackdrop="True" BaseBrush="{DynamicResource PageBackgroundBrush}" IsHitTestVisible="False"/>
    <Grid x:Name="MainContentGrid" MaxWidth="1408" Margin="32,12,32,0" ClipToBounds="True">
      <ItemsControl x:Name="LibraryGallery" Margin="0,68,0,0" ItemsSource="{Binding PagedCatalogItems}" KeyboardNavigation.DirectionalNavigation="Contained" VirtualizingPanel.VirtualizationMode="Recycling">
        <ItemsControl.Template><ControlTemplate TargetType="ItemsControl">
          <ScrollViewer x:Name="GalleryScroll" CanContentScroll="True" ClipToBounds="True" controls:SmoothScroll.Enabled="True" Style="{StaticResource DashboardScrollHostStyle}" ScrollChanged="LibraryScroll_Changed" SizeChanged="GalleryScroll_SizeChanged">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate></ItemsControl.Template>
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingGamePanel MinItemWidth="184" MaxColumns="6" Spacing="24" RowSpacing="30" CoverRatio="1.42" FooterHeight="84" LeadingHeight="64" TrailingHeight="100" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
          <Button x:Name="Card" Style="{StaticResource LibraryCoverButton}" Click="GameCard_Click" Tag="{Binding}" controls:ArtworkLease.Item="{Binding}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
            <Button.ContextMenu><ContextMenu><MenuItem Header="Game details" Click="GameDetailsMenu_Click" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /><MenuItem Header="Install…" Click="InstallGameMenu_Click" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /><MenuItem Header="{Binding PlacementTarget.Tag.AppId, RelativeSource={RelativeSource AncestorType=ContextMenu}, StringFormat='App {0}'}" IsEnabled="False" /></ContextMenu></Button.ContextMenu>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="84" /></Grid.RowDefinitions>
              <Border x:Name="Cover" CornerRadius="14" Background="#141418" BorderBrush="#222634" BorderThickness="1" controls:RoundedClip.Radius="14">
                <Grid ClipToBounds="True">
                  <Image Source="{Binding ArtworkImage}" RenderOptions.BitmapScalingMode="HighQuality"><Image.Style><Style TargetType="Image"><Setter Property="Stretch" Value="UniformToFill"/><Style.Triggers><DataTrigger Binding="{Binding IsArtworkLandscape}" Value="True"><Setter Property="Stretch" Value="Uniform"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
                  <Border Background="#171920" Visibility="{Binding IsArtworkFallback, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ArtworkMonogram}" FontSize="44" FontWeight="SemiBold" Foreground="#70FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Border Height="64" VerticalAlignment="Bottom" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="Transparent"/><GradientStop Color="#95080B10" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                  <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10" CornerRadius="6" Background="#B80D1016" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="7,3" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Image Source="{StaticResource LibrarySteamMark}" Width="48" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0" AutomationProperties.Name="Steam" />
                      <TextBlock Text="PC" FontSize="10" FontWeight="SemiBold" Foreground="#CCD2E0" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" CornerRadius="6" Background="#D00B1B14" BorderBrush="#5034D399" BorderThickness="1" Padding="6,3" ToolTip="Installed on this PC" Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <ui:SymbolIcon Symbol="Checkmark24" FontSize="11" Foreground="#34D399" Margin="0,0,3,0" VerticalAlignment="Center" />
                      <TextBlock Text="Installed" FontSize="10" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
