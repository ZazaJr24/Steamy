<Page x:Class="Steamy.Pages.CreamInstallerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Steamy.Pages"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
  </Page.Resources>

  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" Padding="24,20,24,32">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">

      <!-- Header -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>
        <ui:Button Grid.Column="1"
                   Icon="{ui:SymbolIcon Info24}"
                   Command="{Binding ToggleInfoCommand}"
                   Appearance="Secondary"
                   Style="{StaticResource IconButtonStyle}"
                   ToolTip="Show tool information"
                   VerticalAlignment="Center" />
      </Grid>

      <!-- Status strip -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="14"
              Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}">
            <TextBlock Text="⚙"
                       FontSize="17"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Status}" Style="{StaticResource CardTitleStyle}" />
            <TextBlock Text="{Binding DisplayPath}"
                       Style="{StaticResource TertiaryTextStyle}"
                       FontSize="11"
                       Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding DisplaySteamApiPath}"
                       Style="{StaticResource TertiaryTextStyle}"
                       FontSize="10.5"
                       Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasSteamApiPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button Content="Refresh"
                       Command="{Binding RefreshStatusCommand}"
                       Appearance="Secondary" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Tool selection -->
      <Border Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Tool selection" Style="{StaticResource CardTitleStyle}" FontSize="14" Margin="0,0,0,4" />
          <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11.5" Margin="0,0,0,12"
                     Text="Select the CreamInstaller executable you want to run. The app only launches that file; it does not download or repackage it." />

          <TextBlock Text="CreamInstaller.exe" Style="{StaticResource PillTextStyle}" Margin="0,0,0,6" />
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Paste the path to CreamInstaller.exe or use Browse…"
                        LostFocus="ExecutablePathBox_LostFocus"
                        VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ui:Button Content="Browse…"
                         Click="BrowseExecutableButton_Click"
                         Appearance="Secondary"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center" />
              <ui:Button Content="{Binding DownloadButtonText}"
                         Command="{Binding DownloadCommand}"
                         Appearance="Secondary"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsDownloading, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="SteamAPI64.dll folder (optional)" Style="{StaticResource PillTextStyle}" Margin="0,0,0,6" />
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding SteamApiPath, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Optional: folder containing SteamAPI64.dll or the DLL path itself"
                        LostFocus="SteamApiPathBox_LostFocus"
                        VerticalAlignment="Center" />
            <ui:Button Grid.Column="1"
                       Content="Choose folder…"
                       Click="BrowseSteamApiButton_Click"
                       Appearance="Secondary"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
          <TextBlock Style="{StaticResource TertiaryTextStyle}" FontSize="10.5" Margin="2,4,0,0">
            <Run Text="Optional. When left empty, the app automatically looks for steam_api64.dll in the same folder as the selected game .exe." />
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- Game executable -->
      <Border Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Game" Style="{StaticResource CardTitleStyle}" FontSize="14" Margin="0,0,0,4" />
          <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11.5" Margin="0,0,0,12"
                     Text="Select the game executable the tool should run against." />

          <TextBlock Text="Game .exe" Style="{StaticResource PillTextStyle}" Margin="0,0,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding TargetExePath, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Paste the path to the game .exe or use Browse…"
                        LostFocus="TargetExePathBox_LostFocus"
                        VerticalAlignment="Center" />
            <ui:Button Grid.Column="1"
                       Content="Browse…"
                       Click="BrowseTargetButton_Click"
                       Appearance="Secondary"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{Binding TargetHint}"
                     Style="{StaticResource MutedTextStyle}"
                     FontSize="10.5"
                     Margin="0,4,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Actions -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="14"
              Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding LastMessage}"
                       Style="{StaticResource MutedTextStyle}"
                       FontSize="11.5"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding RunningLabel}"
                       Style="{StaticResource MutedTextStyle}"
                       FontSize="10.5"
                       Margin="0,4,0,0"
                       Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </StackPanel>
          <ui:Button Grid.Column="1"
                     Content="Cancel"
                     Command="{Binding CancelRunCommand}"
                     IsEnabled="{Binding IsBusy}"
                     Appearance="Secondary"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center" />
          <ui:Button Grid.Column="2"
                     Content="Run"
                     Command="{Binding RunCommand}"
                     IsEnabled="{Binding CanRun}"
                     Appearance="Primary"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- Done popup -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="16"
              Margin="0,0,0,14"
              Visibility="{Binding ShowDone, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DoneSuccess}" Value="True">
                      <Setter Property="Background" Value="#1F42D39A" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="!" />
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DoneSuccess}" Value="True">
                        <Setter Property="Text" Value="✓" />
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>
            <TextBlock Grid.Column="1"
                       Text="{Binding DoneTitle}"
                       Style="{StaticResource CardTitleStyle}"
                       FontSize="14"
                       Margin="10,0,10,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <ui:Button Grid.Column="2"
                       Content="Dismiss"
                       Command="{Binding DismissDoneCommand}"
                       Appearance="Secondary"
                       VerticalAlignment="Center" />
          </Grid>

          <TextBlock Text="{Binding DoneMessage}"
                     Style="{StaticResource MutedTextStyle}"
                     FontSize="11.5"
                     Margin="0,8,0,0"
                     TextWrapping="Wrap" />

          <Border Background="{DynamicResource SurfaceSubtleBrush}"
                  CornerRadius="10"
                  Padding="10,8"
                  Margin="0,10,0,0"
                  Visibility="{Binding HasOutput, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding Output}"
                         TextWrapping="Wrap"
                         FontSize="10.5"
                         FontFamily="Consolas"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </ScrollViewer>
          </Border>

          <ui:Button Content="Close"
                     Command="{Binding CloseDoneCommand}"
                     Appearance="Primary"
                     HorizontalAlignment="Right"
                     Margin="0,10,0,0" />
        </StackPanel>
      </Border>

      <!-- Info card -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="14"
              Margin="0,0,0,14"
              Visibility="{Binding IsInfoVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <TextBlock Text="Tool information" Style="{StaticResource CardTitleStyle}" FontSize="13" />
          <TextBlock Text="{Binding InfoText}"
                     Style="{StaticResource MutedTextStyle}"
                     FontSize="11.5"
                     Margin="0,5,0,0"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding DownloadUrl}"
                     Style="{StaticResource TertiaryTextStyle}"
                     FontSize="10.5"
                     Margin="0,6,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
