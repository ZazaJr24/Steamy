<Page x:Class="Steamy.Pages.CreamApiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Steamy.ViewModels"
      xmlns:svc="clr-namespace:Steamy.Services"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis" />
  </Page.Resources>

  <Grid Margin="28,20,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ═══ HEADER ═══ -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="DLC Unlocker" Style="{StaticResource PageTitleStyle}" Margin="0" />
        <TextBlock Text="Select a game, pick a method, fetch DLCs, apply."
                   Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock Text="Method" FontSize="11"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding AvailableModes}"
                  SelectedItem="{Binding SelectedMode}"
                  Width="160" Height="32" FontSize="12" />
      </StackPanel>

      <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11"
                 Foreground="{DynamicResource TextTertiaryBrush}"
                 VerticalAlignment="Center" MaxWidth="250"
                 TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding Status}" />
    </Grid>

    <!-- ═══ TWO-COLUMN BODY ═══ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1.3*" />
      </Grid.ColumnDefinitions>

      <!-- LEFT: Game Picker -->
      <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" CornerRadius="14" Padding="14,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Title + Browse -->
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding GameCountLabel}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <ui:Button Grid.Column="1" Content="Browse…" Click="BrowseGameFolder_Click"
                       Appearance="Secondary" Height="28" FontSize="11" />
          </Grid>

          <!-- Search -->
          <ui:TextBox Grid.Row="1"
                      Text="{Binding GameSearchText, UpdateSourceTrigger=PropertyChanged}"
                      PlaceholderText="Search games…"
                      FontSize="13" Padding="12,10" Margin="0,0,0,8" />

          <!-- Selected game info -->
          <Border Grid.Row="2" Background="{DynamicResource SuccessSoftBrush}"
                  CornerRadius="10" Padding="12,9" Margin="0,0,0,8"
                  Visibility="{Binding HasGameFolder, Converter={StaticResource BoolVis}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#x2714;" FontSize="13" Foreground="{DynamicResource SuccessBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedGame.Name, FallbackValue='Manual folder'}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding GameFolderDisplay}"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                <TextBlock Text="{Binding DetectedDlls}" FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="App" Foreground="{DynamicResource TextTertiaryBrush}"
                           FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ui:TextBox Text="{Binding AppIdText, UpdateSourceTrigger=PropertyChanged}"
                            Width="68" Height="26" FontFamily="Consolas"
                            FontSize="12" TextAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Loading spinner -->
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{Binding IsLoadingGames, Converter={StaticResource BoolVis}}">
            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
            <TextBlock Text="Scanning…" FontSize="12"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>

          <!-- Game list -->
          <Border Grid.Row="3" Background="{DynamicResource SurfaceSubtleBrush}"
                  CornerRadius="10" Padding="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding FilteredGames}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel IsVirtualizing="True"
                                            VirtualizationMode="Recycling" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="GameRow" Padding="12,9" Margin="2,1"
                            CornerRadius="8" Background="Transparent"
                            Cursor="Hand" MouseLeftButtonDown="GameRow_MouseDown">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                CornerRadius="6" Padding="8,3" VerticalAlignment="Center"
                                Margin="0,0,10,0" MinWidth="58">
                          <TextBlock Text="{Binding AppId}" FontFamily="Consolas" FontSize="11"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="GameRow" Property="IsMouseOver" Value="True">
                        <Setter TargetName="GameRow" Property="Background"
                                Value="{DynamicResource ControlHoverBrush}" />
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <!-- Refresh link -->
          <ui:Button Grid.Row="4" Content="Rescan" Command="{Binding RefreshGamesCommand}"
                     Appearance="Transparent" FontSize="10" Height="22" Margin="0,6,0,0"
                     HorizontalAlignment="Right"
                     Foreground="{DynamicResource TextTertiaryBrush}" />
        </Grid>
      </Border>

      <!-- RIGHT: DLC List -->
      <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" CornerRadius="14" Padding="14,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- DLC header -->
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding DlcCountLabel}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True"
                               Margin="8,0,0,0"
                               Visibility="{Binding IsFetching, Converter={StaticResource BoolVis}}" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="Fetch" Command="{Binding FetchDlcCommand}"
                       Appearance="Secondary" Height="28" FontSize="11" Margin="0,0,4,0" />
            <ui:Button Grid.Column="2" Content="All" Command="{Binding SelectAllCommand}"
                       Appearance="Secondary" Height="28" FontSize="11" Margin="0,0,4,0" />
            <ui:Button Grid.Column="3" Content="None" Command="{Binding DeselectAllCommand}"
                       Appearance="Secondary" Height="28" FontSize="11" />
          </Grid>

          <!-- DLC list area -->
          <Border Grid.Row="1" Background="{DynamicResource SurfaceSubtleBrush}"
                  CornerRadius="10" Padding="3">
            <Grid>
              <!-- Empty state -->
              <TextBlock Text="Select a game to load its DLCs"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding DlcList.Count}" Value="0" />
                          <Condition Binding="{Binding IsFetching}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <!-- Fetching spinner -->
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding IsFetching, Converter={StaticResource BoolVis}}">
                <ui:ProgressRing Width="24" Height="24" IsIndeterminate="True"
                                 HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Fetching DLCs…" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
              </StackPanel>

              <!-- DLC items -->
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                  <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DlcList.Count}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding DlcList}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="DlcRow" Padding="10,7" Margin="2,1"
                              CornerRadius="8" Background="Transparent">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                    Margin="0,0,6,0" />
                          <Border Grid.Column="1" Background="{DynamicResource SurfaceSubtleBrush}"
                                  CornerRadius="6" Padding="8,3" VerticalAlignment="Center"
                                  Margin="0,0,10,0" MinWidth="58">
                            <TextBlock Text="{Binding AppId}" FontFamily="Consolas"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                          </Border>
                          <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Border>
                      <DataTemplate.Triggers>
                        <Trigger SourceName="DlcRow" Property="IsMouseOver" Value="True">
                          <Setter TargetName="DlcRow" Property="Background"
                                  Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- ═══ RESULT BANNER ═══ -->
    <Border Grid.Row="2" CornerRadius="10" Padding="12,9" Margin="0,12,0,0"
            Visibility="{Binding ShowResult, Converter={StaticResource BoolVis}}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ResultSuccess}" Value="True">
              <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="&#x2718;" />
              <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ResultSuccess}" Value="True">
                  <Setter Property="Text" Value="&#x2714;" />
                  <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Grid.Column="1" Text="{Binding ResultMessage}"
                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultMessage}" />
        <ui:Button Grid.Column="2" Command="{Binding DismissResultCommand}"
                   Appearance="Transparent" Height="24" Width="24"
                   VerticalAlignment="Center" Padding="0"
                   Foreground="{DynamicResource TextTertiaryBrush}">
          <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
        </ui:Button>
      </Grid>
    </Border>

    <!-- ═══ BOTTOM BAR ═══ -->
    <Border Grid.Row="3" Style="{StaticResource SurfaceCardStyle}" CornerRadius="12"
            Padding="14,10" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Settings expander -->
        <Expander IsExpanded="False" VerticalAlignment="Center">
          <Expander.Header>
            <TextBlock Text="Settings" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          </Expander.Header>
          <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="Language" FontSize="11"
                         Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                        Width="120" Height="28" FontSize="11" />
            </StackPanel>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="Proxy" FontSize="11"
                         Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4" />
              <ui:TextBox Text="{Binding ProxyAddress, UpdateSourceTrigger=LostFocus}"
                          PlaceholderText="http://proxy:port" Width="160" Height="28" FontSize="11" />
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom">
              <CheckBox IsChecked="{Binding UnlockAll}" Margin="0,0,0,2">
                <TextBlock Text="Unlock all" FontSize="11" />
              </CheckBox>
              <CheckBox IsChecked="{Binding ExtraProtection}" Margin="0,0,0,2">
                <TextBlock Text="Extra protection" FontSize="11" />
              </CheckBox>
              <CheckBox IsChecked="{Binding ForceOffline}">
                <TextBlock Text="Force offline" FontSize="11" />
              </CheckBox>
            </StackPanel>
            <ui:Button Content="Load archive…" Click="BrowseCreamApiArchive_Click"
                       Appearance="Secondary" Height="28" FontSize="11" Margin="20,0,0,0"
                       VerticalAlignment="Bottom" />
          </StackPanel>
        </Expander>

        <!-- Spacer -->
        <Border Grid.Column="1" />

        <!-- Action buttons -->
        <ui:Button Grid.Column="2" Content="Restore" Command="{Binding RestoreCommand}"
                   Appearance="Secondary" Height="36" FontSize="12" Margin="0,0,8,0" />
        <ui:Button Grid.Column="3" Content="Apply" Command="{Binding ApplyCommand}"
                   Appearance="Primary" Height="48" FontSize="15" FontWeight="SemiBold"
                   MinWidth="160" HorizontalContentAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Page>
