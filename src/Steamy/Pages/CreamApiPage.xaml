<Page x:Class="Steamy.Pages.CreamApiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      Background="{DynamicResource WorkspaceBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis" />

    <!-- ===== Motion: whole-pixel entrances only, so text and lists stay crisp ============ -->
    <Style x:Key="RiseIn" TargetType="FrameworkElement">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="12" /></Setter.Value></Setter>
      <Style.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.44">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RiseInLate" TargetType="FrameworkElement" BasedOn="{StaticResource RiseIn}">
      <Style.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4" BeginTime="0:0:0.14">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.44" BeginTime="0:0:0.14">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="CardHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Game row: washes on hover and shows an accent bar when it is the picked game -->
    <Style x:Key="GameRow" TargetType="Border">
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- DLC row: checkbox plus name, lights up under the cursor -->
    <Style x:Key="DlcRow" TargetType="Border">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>

  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" Padding="40,28,40,56">
    <StackPanel MaxWidth="1320" HorizontalAlignment="Stretch">

      <!-- ===== Header ==================================================================== -->
      <Grid Style="{StaticResource RiseIn}" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource VioletSoftBrush}" VerticalAlignment="Center" Margin="0,0,12,0">
              <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="18" Foreground="{DynamicResource VioletBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="DLC Unlocker" Style="{StaticResource PageTitleStyle}" Margin="0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Border Width="22" Height="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Pick a game, choose the unlocker, select what should be unlocked — Apply writes the config and the proxy DLL."
                       Style="{StaticResource PageSubtitleStyle}" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:ProgressRing Width="18" Height="18" Margin="0,0,14,0" IsIndeterminate="True"
                           Visibility="{Binding IsApplying, Converter={StaticResource BoolVis}}" />
          <ui:Button Content="Restore" Appearance="Secondary" CornerRadius="10" Icon="{ui:SymbolIcon ArrowClockwise24}"
                     Margin="0,0,8,0" Command="{Binding RestoreCommand}" />
          <ui:Button Content="Apply" Appearance="Primary" CornerRadius="10" Padding="24,9" FontWeight="SemiBold"
                     Icon="{ui:SymbolIcon Play24}" Command="{Binding ApplyCommand}" />
        </StackPanel>
      </Grid>

      <!-- ===== Config strip ============================================================== -->
      <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="26" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="26" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="Unlocker" Style="{StaticResource CardHeading}" />
            <TextBlock Text="CreamAPI, SmokeAPI, Koalageddon or the Uplay/R2 unlocker — depending on the store the game came from."
                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
            <ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding SelectedMode}"
                      Height="34" Margin="0,10,0,0" />
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="Game folder" Style="{StaticResource CardHeading}" />
            <TextBlock Text="Start the game once so Steam writes its DLLs, then pick the install folder."
                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border CornerRadius="10" Padding="11,8"
                      Background="{DynamicResource SurfaceSubtleBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <TextBlock Text="{Binding GameFolderDisplay}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding GameFolder}" />
              </Border>
              <ui:Button Grid.Column="1" Content="Browse…" Appearance="Secondary" CornerRadius="10"
                         Margin="8,0,0,0" Click="BrowseGameFolder_Click" />
            </Grid>
            <TextBlock Text="{Binding DetectedDlls}" Foreground="{DynamicResource TextTertiaryBrush}"
                       FontSize="11.5" Margin="2,8,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Column="4">
            <TextBlock Text="DLL pack" Style="{StaticResource CardHeading}" />
            <TextBlock Text="Steamy already ships a CreamAPI pack. Import your own archive if you prefer a specific build."
                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Border CornerRadius="8" Padding="9,4" Background="{DynamicResource SurfaceSubtleBrush}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasDlls}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Pack missing" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasDlls}" Value="True">
                            <Setter Property="Text" Value="Pack ready" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
              <ui:Button Content="Import archive" Appearance="Secondary" CornerRadius="10" Margin="8,0,0,0"
                         Icon="{ui:SymbolIcon FolderOpen24}" Click="BrowseCreamApiArchive_Click" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== Games + DLCs ============================================================== -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="1.45*" />
        </Grid.ColumnDefinitions>

        <!-- Games -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Installed games" Style="{StaticResource CardHeading}" />
              <TextBlock Grid.Column="1" Text="{Binding GameCountLabel}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5" />
            </Grid>

            <ui:TextBox Text="{Binding GameSearchText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Search games…" Margin="0,12,0,8"
                        Icon="{ui:SymbolIcon Search24}" />

            <Grid Height="430">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding IsLoadingGames, Converter={StaticResource BoolVis}}">
                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                <TextBlock Text="Scanning your library…" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
              </StackPanel>

              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredGames}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource GameRow}" MouseLeftButtonDown="GameRow_MouseDown">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Width="26" Height="26" CornerRadius="8" Background="{Binding CoverColor}"
                                  VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding CoverGlyph}" FontSize="12" Foreground="#AAFFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding AppId}" FontSize="11" Margin="8,0,0,0"
                                     VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"
                                     Typography.NumeralAlignment="Tabular" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </StackPanel>
        </Border>

        <!-- DLCs -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="DLCs" Style="{StaticResource CardHeading}" />
                <TextBlock Text="{Binding DlcCountLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="11.5" Margin="0,3,0,0" />
              </StackPanel>
              <ui:Button Grid.Column="1" Content="Fetch" Appearance="Secondary" CornerRadius="9" Height="30"
                         FontSize="11.5" Margin="0,0,6,0" Icon="{ui:SymbolIcon ArrowClockwise24}"
                         Command="{Binding FetchDlcCommand}" />
              <ui:Button Grid.Column="2" Content="All" Appearance="Transparent" CornerRadius="9" Height="30"
                         FontSize="11.5" Padding="10,0" Margin="0,0,4,0"
                         Foreground="{DynamicResource TextSecondaryBrush}" Command="{Binding SelectAllCommand}" />
              <ui:Button Grid.Column="3" Content="None" Appearance="Transparent" CornerRadius="9" Height="30"
                         FontSize="11.5" Padding="10,0"
                         Foreground="{DynamicResource TextSecondaryBrush}" Command="{Binding DeselectAllCommand}" />
            </Grid>

            <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="12" Padding="6" Height="430">
              <Grid>
                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding DlcList.Count}" Value="0" />
                            <Condition Binding="{Binding IsFetching}" Value="False" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource VioletSoftBrush}" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="22" Foreground="{DynamicResource VioletBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="No DLCs loaded yet" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"
                             HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="Pick a game on the left and press Fetch to load every DLC Steam knows for it."
                             FontSize="12" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsFetching, Converter={StaticResource BoolVis}}">
                  <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" />
                  <TextBlock Text="Asking Steam for the DLC list…" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding DlcList.Count}" Value="0">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ScrollViewer.Style>
                  <ItemsControl ItemsSource="{Binding DlcList}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource DlcRow}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding AppId}" FontSize="11" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"
                                       Typography.NumeralAlignment="Tabular" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ===== Result + status =========================================================== -->
      <StackPanel Style="{StaticResource RiseInLate}" Margin="0,16,0,0">
        <Border CornerRadius="12" Padding="14,11" Margin="0,0,0,10"
                Visibility="{Binding ShowResult, Converter={StaticResource BoolVis}}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ResultSuccess}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="Info24" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0">
              <ui:SymbolIcon.Style>
                <Style TargetType="ui:SymbolIcon">
                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ResultSuccess}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
            <TextBlock Grid.Column="1" Text="{Binding ResultMessage}" FontSize="12.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
            <ui:Button Grid.Column="2" Appearance="Transparent" Height="24" Width="24" Padding="0"
                       Foreground="{DynamicResource TextTertiaryBrush}" Command="{Binding DismissResultCommand}">
              <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
            </ui:Button>
          </Grid>
        </Border>
        <TextBlock Text="{Binding Status}" FontSize="11.5" Margin="2,0,0,0"
                   Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
