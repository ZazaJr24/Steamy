<Page x:Class="Steamy.Pages.CreamApiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Steamy.ViewModels"
      xmlns:svc="clr-namespace:Steamy.Services"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis" />
  </Page.Resources>

  <Grid Margin="36,28,36,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header + actions in one row -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="DLC Unlocker" Style="{StaticResource PageTitleStyle}" Margin="0" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableModes}"
                SelectedItem="{Binding SelectedMode}"
                Width="150" Height="34" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
      <ui:Button Grid.Column="2" Content="Restore" Command="{Binding RestoreCommand}"
                 Appearance="Secondary" Height="34" FontSize="12" Padding="14,0" Margin="0,0,6,0" />
      <ui:Button Grid.Column="3" Content="Apply" Command="{Binding ApplyCommand}"
                 Appearance="Primary" Height="34" FontSize="13" FontWeight="SemiBold" Padding="24,0" />
    </Grid>

    <!-- Two columns -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="1.4*" />
      </Grid.ColumnDefinitions>

      <!-- Games -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox Text="{Binding GameSearchText, UpdateSourceTrigger=PropertyChanged}"
                      PlaceholderText="Search games…"
                      FontSize="12" Padding="10,7" />
          <ui:Button Grid.Column="1" Content="Browse…" Click="BrowseGameFolder_Click"
                     Appearance="Secondary" Height="34" FontSize="11" Padding="12,0" Margin="6,0,0,0" />
        </Grid>

        <!-- Selected game -->
        <Border Grid.Row="1" Background="{DynamicResource SuccessSoftBrush}"
                CornerRadius="8" Padding="10,7" Margin="0,0,0,6"
                Visibility="{Binding HasGameFolder, Converter={StaticResource BoolVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#x2714;" FontSize="11" Foreground="{DynamicResource SuccessBrush}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding SelectedGame.Name, FallbackValue='Manual folder'}"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ui:TextBox Grid.Column="2" Text="{Binding AppIdText, UpdateSourceTrigger=PropertyChanged}"
                        Width="60" Height="24" FontFamily="Consolas"
                        FontSize="11" TextAlignment="Center" Margin="8,0,0,0" />
          </Grid>
        </Border>

        <!-- Game list -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceSubtleBrush}"
                CornerRadius="10" Padding="2">
          <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoadingGames, Converter={StaticResource BoolVis}}">
              <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" />
              <TextBlock Text="Scanning…" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                         VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding FilteredGames}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="Row" Padding="10,6" Margin="1" CornerRadius="6"
                            Background="Transparent" Cursor="Hand"
                            MouseLeftButtonDown="GameRow_MouseDown">
                      <TextBlock Text="{Binding Name}" FontSize="12"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis" />
                    </Border>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background"
                                Value="{DynamicResource ControlHoverBrush}" />
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- DLCs -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding DlcCountLabel}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          <ui:Button Grid.Column="1" Content="Fetch" Command="{Binding FetchDlcCommand}"
                     Appearance="Secondary" Height="28" FontSize="11" Padding="10,0" Margin="0,0,4,0" />
          <ui:Button Grid.Column="2" Content="All" Command="{Binding SelectAllCommand}"
                     Appearance="Transparent" Height="28" FontSize="10" Padding="6,0"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,2,0" />
          <ui:Button Grid.Column="3" Content="None" Command="{Binding DeselectAllCommand}"
                     Appearance="Transparent" Height="28" FontSize="10" Padding="6,0"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceSubtleBrush}"
                CornerRadius="10" Padding="2">
          <Grid>
            <TextBlock Text="Select a game to load its DLCs"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DlcList.Count}" Value="0" />
                        <Condition Binding="{Binding IsFetching}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding IsFetching, Converter={StaticResource BoolVis}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DlcList.Count}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <ItemsControl ItemsSource="{Binding DlcList}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="Row" Padding="8,5" Margin="1" CornerRadius="6"
                            Background="Transparent">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background"
                                Value="{DynamicResource ControlHoverBrush}" />
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Result + status -->
    <StackPanel Grid.Row="2">
      <Border CornerRadius="8" Padding="12,8" Margin="0,8,0,0"
              Visibility="{Binding ShowResult, Converter={StaticResource BoolVis}}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ResultSuccess}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="&#x2718;" />
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ResultSuccess}" Value="True">
                    <Setter Property="Text" Value="&#x2714;" />
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Grid.Column="1" Text="{Binding ResultMessage}" FontSize="12"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <ui:Button Grid.Column="2" Command="{Binding DismissResultCommand}"
                     Appearance="Transparent" Height="22" Width="22" Padding="0"
                     Foreground="{DynamicResource TextTertiaryBrush}">
            <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
          </ui:Button>
        </Grid>
      </Border>
      <TextBlock Text="{Binding Status}" FontSize="10.5" Margin="2,6,0,0"
                 Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Grid>
</Page>
