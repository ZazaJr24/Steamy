<ResourceDictionary xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WorkspaceColor">#EEF2F8</Color>
  <SolidColorBrush x:Key="LauncherBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="LauncherForegroundBrush" Color="#000000" />
  <SolidColorBrush x:Key="PageBackgroundBrush" Color="#00000000" />
  <Thickness x:Key="PagePadding">28,22,28,30</Thickness>
  <CornerRadius x:Key="SurfaceCornerRadius">18</CornerRadius>
  <sys:Double x:Key="NavigationViewItemHeight">40</sys:Double>
  <SolidColorBrush x:Key="HeroForegroundBrush" Color="#F8FAFF" />
  <SolidColorBrush x:Key="HeroSecondaryForegroundBrush" Color="#BEBEC5" />
  <SolidColorBrush x:Key="HeroControlBackgroundBrush" Color="#550A0B10" />
  <SolidColorBrush x:Key="HeroControlBorderBrush" Color="#35FFFFFF" />
  <sys:Double x:Key="HeroShadeOpacity">1</sys:Double>
  <!-- Steamy Day: cool paper-white surfaces with the same blue accent and brand gradient as the
       dark palette. Keys must match Dark.xaml one to one. -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EEF2F8" />
  <SolidColorBrush x:Key="GameDetailsBackgroundBrush" Color="#FCF7F3" />
  <DrawingBrush x:Key="GameDetailsGradientBrush" Stretch="Fill">
    <DrawingBrush.Drawing><DrawingGroup>
      <GeometryDrawing><GeometryDrawing.Brush><RadialGradientBrush Center="0.12,0.03" GradientOrigin="0.12,0.03" RadiusX="0.75" RadiusY="0.9"><GradientStop Color="#46FCA86C" /><GradientStop Color="#00FCA86C" Offset="1" /></RadialGradientBrush></GeometryDrawing.Brush><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1" /></GeometryDrawing.Geometry></GeometryDrawing>
      <GeometryDrawing><GeometryDrawing.Brush><RadialGradientBrush Center="0.92,0.16" GradientOrigin="0.92,0.16" RadiusX="0.85" RadiusY="1"><GradientStop Color="#38E6737C" /><GradientStop Color="#00E6737C" Offset="1" /></RadialGradientBrush></GeometryDrawing.Brush><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1" /></GeometryDrawing.Geometry></GeometryDrawing>
    </DrawingGroup></DrawingBrush.Drawing>
  </DrawingBrush>
  <LinearGradientBrush x:Key="SidebarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#A6FFFFFF" Offset="0" /> <GradientStop Color="#88F6F9FF" Offset="0.5" /> <GradientStop Color="#A0F0F5FD" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#60FFFFFF" />
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#80FFFFFF" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#90FFFFFF" />
  <SolidColorBrush x:Key="SolidSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#B8FFFFFF" />
  <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#489AAEC8" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#55FFFFFF" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#609DAFC7" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#909DAFC7" />
  <SolidColorBrush x:Key="SidebarSeparatorBrush" Color="#3090A0B8" />

  <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
  <SolidColorBrush x:Key="AccentStrongBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3ECFD" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#059669" />
  <SolidColorBrush x:Key="DownloadAccentBrush" Color="#477BDB" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DDF6EC" />
  <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#FDF1D8" />
  <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDE4E4" />
  <SolidColorBrush x:Key="VioletBrush" Color="#7C3AED" />
  <SolidColorBrush x:Key="VioletSoftBrush" Color="#EEE7FD" />
  <SolidColorBrush x:Key="PinkBrush" Color="#DB2777" />
  <SolidColorBrush x:Key="PinkSoftBrush" Color="#FCE4F1" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#53627A" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

  <LinearGradientBrush x:Key="GlassSurfaceBrush" StartPoint="0,0" EndPoint="0.65,1">
    <GradientStop Color="#C4FFFFFF" Offset="0" /> <GradientStop Color="#70F4F8FF" Offset="0.45" /> <GradientStop Color="#90FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="GameDialogSurfaceBrush" Color="#FFFFFF" />
  <LinearGradientBrush x:Key="DialogSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F4FFFFFF" Offset="0" /> <GradientStop Color="#E8EEF4FD" Offset="0.55" /> <GradientStop Color="#ECEFEFFA" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Color="#FFFFFFFF" Offset="0" /> <GradientStop Color="#609BB2D1" Offset="0.5" /> <GradientStop Color="#BBFFFFFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardHoverGlassBrush" StartPoint="0,0" EndPoint="0.7,1">
    <GradientStop Color="#70FFFFFF" Offset="0" /><GradientStop Color="#20A6C6F1" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="NavigationViewItemBackgroundSelected" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#C0FFFFFF" Offset="0" /> <GradientStop Color="#70FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#30A6C6F1" />
  <SolidColorBrush x:Key="SidebarSelectedBorderBrush" Color="#80FFFFFF" />
  <RadialGradientBrush x:Key="AmbientBlueBrush" Center="0.14,0.02" GradientOrigin="0.14,0.02" RadiusX="0.75" RadiusY="0.95">
    <GradientStop Color="#80A3C3F1" Offset="0" /><GradientStop Color="#189DBCEE" Offset="0.55" /><GradientStop Color="#009DBCEE" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbientVioletBrush" Center="1,0.86" GradientOrigin="1,0.86" RadiusX="0.75" RadiusY="0.8">
    <GradientStop Color="#60C5B0EB" Offset="0" /><GradientStop Color="#18C5B0EB" Offset="0.6" /><GradientStop Color="#00C5B0EB" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbientTealBrush" Center="0,1" GradientOrigin="0,1" RadiusX="0.65" RadiusY="0.75">
    <GradientStop Color="#40A4DFE8" Offset="0" /><GradientStop Color="#00A4DFE8" Offset="1" />
  </RadialGradientBrush>

  <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#38BDF8" Offset="0" />
    <GradientStop Color="#6366F1" Offset="0.6" />
    <GradientStop Color="#A855F7" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BrandWashBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#3038BDF8" Offset="0" />
    <GradientStop Color="#1C6366F1" Offset="0.55" />
    <GradientStop Color="#00A855F7" Offset="1" />
  </LinearGradientBrush>
  <!-- Hero art stays dark in both themes so the white title on top of it is always readable. -->
  <LinearGradientBrush x:Key="HeroShadeBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#B80B0D12" Offset="0" />
    <GradientStop Color="#680B0D12" Offset="0.48" />
    <GradientStop Color="#080B0D12" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroBottomShadeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#000B0D12" Offset="0.35" />
    <GradientStop Color="#A80B0D12" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ScrimBrush" Color="#990F172A" />

  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#EEF2F8" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#EEF2F8" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#EFF3F9" />
  <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#E7EDF6" />
  <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#80D8E3F3" />
  <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#A0D8E3F3" />
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#BBFFFFFF" />
  <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#709AAEC8" />
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D8DFEB" />
  <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#C5CDDA" />

  <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6FFFFFF" />
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />

  <!-- WPF-UI reads these theme keys for every control template (buttons, text boxes, combo
       boxes, popups, content dialogs), so overriding them here rounds the whole app at once. -->
  <CornerRadius x:Key="ControlCornerRadius">10,10,10,10</CornerRadius>
  <CornerRadius x:Key="PopupCornerRadius">14,14,14,14</CornerRadius>
  <CornerRadius x:Key="DialogOverlayCornerRadius">20,20,20,20</CornerRadius>
  <CornerRadius x:Key="DialogFooterCornerRadius">12,12,12,12</CornerRadius>
</ResourceDictionary>
