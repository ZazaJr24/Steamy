<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Cool, neutral light palette that mirrors the graphite dark theme: soft blue-greys,
       a muted steel accent, no warm tint. -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EEF0F3" />
  <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F7F8FA" />
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#E6E9EE" />
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#DDE2EA" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FBFCFD" />
  <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#EAEDF1" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#E1E5EB" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#D4D9E1" />
  <SolidColorBrush x:Key="AccentBrush" Color="#0284C7" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#E0F2FE" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#059669" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DCFCE7" />
  <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#FEF3C7" />
  <SolidColorBrush x:Key="DangerBrush" Color="#E11D48" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFE4E6" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#64748B" />

  <!-- Softly rounded Fluent controls. WPF-UI reads these theme keys for every control
       template (buttons, text boxes, combo boxes, popups, content dialogs), so overriding
       them here rounds the whole app at once. -->
  <CornerRadius x:Key="ControlCornerRadius">12,12,12,12</CornerRadius>
  <CornerRadius x:Key="PopupCornerRadius">14,14,14,14</CornerRadius>
  <CornerRadius x:Key="DialogOverlayCornerRadius">20,20,20,20</CornerRadius>
  <CornerRadius x:Key="DialogFooterCornerRadius">12,12,12,12</CornerRadius>
</ResourceDictionary>
