<ResourceDictionary xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WorkspaceColor">#0C1018</Color>
  <SolidColorBrush x:Key="LauncherBackgroundBrush" Color="#000000" />
  <SolidColorBrush x:Key="LauncherForegroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="PageBackgroundBrush" Color="#00000000" />
  <Thickness x:Key="PagePadding">28,22,28,30</Thickness>
  <CornerRadius x:Key="SurfaceCornerRadius">18</CornerRadius>
  <sys:Double x:Key="NavigationViewItemHeight">40</sys:Double>
  <SolidColorBrush x:Key="HeroForegroundBrush" Color="#F8FAFF" />
  <SolidColorBrush x:Key="HeroSecondaryForegroundBrush" Color="#BEBEC5" />
  <SolidColorBrush x:Key="HeroControlBackgroundBrush" Color="#550A0B10" />
  <SolidColorBrush x:Key="HeroControlBorderBrush" Color="#35FFFFFF" />
  <sys:Double x:Key="HeroShadeOpacity">1</sys:Double>
  <!-- Artwork-tinted glass over a quiet midnight workspace. -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0C1018" />
  <SolidColorBrush x:Key="GameDetailsBackgroundBrush" Color="#18171B" />
  <DrawingBrush x:Key="GameDetailsGradientBrush" Stretch="Fill">
    <DrawingBrush.Drawing><DrawingGroup>
      <GeometryDrawing><GeometryDrawing.Brush><RadialGradientBrush Center="0.12,0.03" GradientOrigin="0.12,0.03" RadiusX="0.75" RadiusY="0.9"><GradientStop Color="#70F48232" /><GradientStop Color="#00F48232" Offset="1" /></RadialGradientBrush></GeometryDrawing.Brush><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1" /></GeometryDrawing.Geometry></GeometryDrawing>
      <GeometryDrawing><GeometryDrawing.Brush><RadialGradientBrush Center="0.92,0.16" GradientOrigin="0.92,0.16" RadiusX="0.85" RadiusY="1"><GradientStop Color="#88C2353B" /><GradientStop Color="#00C2353B" Offset="1" /></RadialGradientBrush></GeometryDrawing.Brush><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1" /></GeometryDrawing.Geometry></GeometryDrawing>
    </DrawingGroup></DrawingBrush.Drawing>
  </DrawingBrush>
  <LinearGradientBrush x:Key="SidebarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#50101824" Offset="0" /> <GradientStop Color="#38131C2A" Offset="0.5" /> <GradientStop Color="#60101824" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#18FFFFFF" />
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#25FFFFFF" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#7018202D" />
  <SolidColorBrush x:Key="SolidSurfaceBrush" Color="#18202D" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#98202A39" />
  <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#38242F40" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#403E4B60" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#20FFFFFF" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#45FFFFFF" />
  <SolidColorBrush x:Key="SidebarSeparatorBrush" Color="#20FFFFFF" />

  <SolidColorBrush x:Key="AccentBrush" Color="#E2E2E7" />
  <SolidColorBrush x:Key="AccentStrongBrush" Color="#C6C6CF" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#18FFFFFF" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
  <SolidColorBrush x:Key="DownloadAccentBrush" Color="#8CAFFF" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#0F2A21" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#2D2410" />
  <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#33171B" />
  <SolidColorBrush x:Key="VioletBrush" Color="#A78BFA" />
  <SolidColorBrush x:Key="VioletSoftBrush" Color="#221C3D" />
  <SolidColorBrush x:Key="PinkBrush" Color="#F472B6" />
  <SolidColorBrush x:Key="PinkSoftBrush" Color="#33172A" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5F9" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BCBCC4" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9898A1" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#0D0D10" />

  <LinearGradientBrush x:Key="GlassSurfaceBrush" StartPoint="0,0" EndPoint="0.65,1">
    <GradientStop Color="#7031394F" Offset="0" /> <GradientStop Color="#4819202E" Offset="0.45" /> <GradientStop Color="#58171D2B" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="GameDialogSurfaceBrush" Color="#18202D" />
  <LinearGradientBrush x:Key="DialogSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F8242C3D" Offset="0" /> <GradientStop Color="#F4151C29" Offset="0.55" /> <GradientStop Color="#F3212337" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Color="#65FFFFFF" Offset="0" /> <GradientStop Color="#15FFFFFF" Offset="0.5" /> <GradientStop Color="#30FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardHoverGlassBrush" StartPoint="0,0" EndPoint="0.7,1">
    <GradientStop Color="#08FFFFFF" Offset="0" /><GradientStop Color="#03FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="NavigationViewItemBackgroundSelected" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#38FFFFFF" Offset="0" /> <GradientStop Color="#18FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#10FFFFFF" />
  <SolidColorBrush x:Key="SidebarSelectedBorderBrush" Color="#25FFFFFF" />
  <RadialGradientBrush x:Key="AmbientBlueBrush" Center="0.14,0.02" GradientOrigin="0.14,0.02" RadiusX="0.75" RadiusY="0.95">
    <GradientStop Color="#50537CBB" Offset="0" /><GradientStop Color="#184B6AA8" Offset="0.55" /><GradientStop Color="#004B6AA8" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbientVioletBrush" Center="1,0.86" GradientOrigin="1,0.86" RadiusX="0.75" RadiusY="0.8">
    <GradientStop Color="#407E589F" Offset="0" /><GradientStop Color="#12675291" Offset="0.6" /><GradientStop Color="#00675291" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbientTealBrush" Center="0,1" GradientOrigin="0,1" RadiusX="0.65" RadiusY="0.75">
    <GradientStop Color="#204E9BB1" Offset="0" /><GradientStop Color="#004E9BB1" Offset="1" />
  </RadialGradientBrush>

  <!-- Brand gradient for the logo, the welcome hero and the primary call to action. -->
  <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#38BDF8" Offset="0" />
    <GradientStop Color="#6366F1" Offset="0.6" />
    <GradientStop Color="#A855F7" Offset="1" />
  </LinearGradientBrush>
  <!-- Very faint version of the brand gradient used as a wash behind hero content. -->
  <LinearGradientBrush x:Key="BrandWashBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#06FFFFFF" Offset="0" />
    <GradientStop Color="#03FFFFFF" Offset="0.55" />
    <GradientStop Color="#00FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <!-- Shades that keep white hero text readable on top of game art. -->
  <LinearGradientBrush x:Key="HeroShadeBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#B80B0D12" Offset="0" />
    <GradientStop Color="#680B0D12" Offset="0.48" />
    <GradientStop Color="#080B0D12" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroBottomShadeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#000B0D12" Offset="0.35" />
    <GradientStop Color="#A80B0D12" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ScrimBrush" Color="#B8050608" />

  <!-- Match Fluent input, navigation and flyout chrome to the workspace palette. -->
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#0C1018" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#0C1018" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#18202D" />
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#701B1B20" />
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#242A2A30" />
  <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#40151519" />
  <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#E015151A" />
  <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#301F1F24" />
  <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#38212126" />
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#A318202D" />
  <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#55242F40" />
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#18FFFFFF" />
  <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#20FFFFFF" />

  <!-- Dark labels keep the neutral light primary buttons readable. -->
  <SolidColorBrush x:Key="AccentButtonForeground" Color="#0D0D10" />
  <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0D0D10" />
  <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0D0D10" />
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0D0D10" />

  <!-- Softly rounded Fluent controls. -->
  <CornerRadius x:Key="ControlCornerRadius">10,10,10,10</CornerRadius>
  <CornerRadius x:Key="PopupCornerRadius">14,14,14,14</CornerRadius>
  <CornerRadius x:Key="DialogOverlayCornerRadius">20,20,20,20</CornerRadius>
  <CornerRadius x:Key="DialogFooterCornerRadius">12,12,12,12</CornerRadius>
</ResourceDictionary>
