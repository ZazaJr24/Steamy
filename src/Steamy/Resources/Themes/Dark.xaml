<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Midnight blue with transparent surfaces over a static ambient colour field. -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0D192D" />
  <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0C172A" />
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#263B608A" />
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#384579AA" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#207EA8DD" />
  <SolidColorBrush x:Key="SolidSurfaceBrush" Color="#172D48" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#3082AADD" />
  <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#127BACE8" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#40749CCF" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#386E9BD4" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#809DC3F2" />

  <SolidColorBrush x:Key="AccentBrush" Color="#78B5FF" />
  <SolidColorBrush x:Key="AccentStrongBrush" Color="#3B82F6" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#661F4474" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#0F2A21" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#2D2410" />
  <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#33171B" />
  <SolidColorBrush x:Key="VioletBrush" Color="#A78BFA" />
  <SolidColorBrush x:Key="VioletSoftBrush" Color="#221C3D" />
  <SolidColorBrush x:Key="PinkBrush" Color="#F472B6" />
  <SolidColorBrush x:Key="PinkSoftBrush" Color="#33172A" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5F9" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B1BDD1" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#91A0B8" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

  <LinearGradientBrush x:Key="GlassSurfaceBrush" StartPoint="0,0" EndPoint="0.65,1">
    <GradientStop Color="#2F91B6E8" Offset="0" /><GradientStop Color="#157698C9" Offset="0.6" /><GradientStop Color="#207C85C7" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="DialogSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#EC213B5B" Offset="0" /><GradientStop Color="#DC162C47" Offset="0.55" /><GradientStop Color="#E1222C4B" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Color="#365C6F90" Offset="0" /><GradientStop Color="#18516D93" Offset="0.55" /><GradientStop Color="#285E668D" Offset="1" />
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="AmbientBlueBrush" Center="0.87,0.04" GradientOrigin="0.87,0.04" RadiusX="0.85" RadiusY="0.85">
    <GradientStop Color="#805485CA" Offset="0" /><GradientStop Color="#243C6BAE" Offset="0.6" /><GradientStop Color="#003C6BAE" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbientVioletBrush" Center="0.08,0.94" GradientOrigin="0.08,0.94" RadiusX="0.72" RadiusY="0.9">
    <GradientStop Color="#605E438D" Offset="0" /><GradientStop Color="#005E438D" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbientTealBrush" Center="0.52,0.48" GradientOrigin="0.52,0.48" RadiusX="0.72" RadiusY="0.65">
    <GradientStop Color="#202D9FAA" Offset="0" /><GradientStop Color="#002D9FAA" Offset="1" />
  </RadialGradientBrush>

  <!-- Brand gradient for the logo, the welcome hero and the primary call to action. -->
  <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#38BDF8" Offset="0" />
    <GradientStop Color="#6366F1" Offset="0.6" />
    <GradientStop Color="#A855F7" Offset="1" />
  </LinearGradientBrush>
  <!-- Very faint version of the brand gradient used as a wash behind hero content. -->
  <LinearGradientBrush x:Key="BrandWashBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#2A38BDF8" Offset="0" />
    <GradientStop Color="#1A6366F1" Offset="0.55" />
    <GradientStop Color="#00A855F7" Offset="1" />
  </LinearGradientBrush>
  <!-- Shades that keep white hero text readable on top of game art. -->
  <LinearGradientBrush x:Key="HeroShadeBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#F20B0D12" Offset="0" />
    <GradientStop Color="#B30B0D12" Offset="0.48" />
    <GradientStop Color="#140B0D12" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroBottomShadeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#000B0D12" Offset="0.35" />
    <GradientStop Color="#E00B0D12" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ScrimBrush" Color="#B8050608" />

  <!-- Match Fluent input, navigation and flyout chrome to the workspace palette. -->
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#0D192D" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#0D192D" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#172D48" />
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#307CA3D3" />
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#40749CCF" />
  <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#187CA3D3" />
  <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#D01B3554" />
  <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#661F2B3D" />
  <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#801C2737" />
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#207EA8DD" />
  <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#127BACE8" />
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#80334154" />
  <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#A0404F64" />

  <!-- White text on primary (accent) buttons instead of the Fluent default black-on-light-accent. -->
  <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6FFFFFF" />
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />

  <!-- Softly rounded Fluent controls. -->
  <CornerRadius x:Key="ControlCornerRadius">10,10,10,10</CornerRadius>
  <CornerRadius x:Key="PopupCornerRadius">14,14,14,14</CornerRadius>
  <CornerRadius x:Key="DialogOverlayCornerRadius">20,20,20,20</CornerRadius>
  <CornerRadius x:Key="DialogFooterCornerRadius">12,12,12,12</CornerRadius>
</ResourceDictionary>
