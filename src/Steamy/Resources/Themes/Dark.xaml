<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Deep Cyber / Midnight palette. Rich obsidian surfaces with electric cyan/azure accents,
       sleek contrasts and polished glass depth. -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0A0D14" />
  <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#06080E" />
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#131926" />
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#1A2438" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#0F1420" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#141B2B" />
  <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#1B2439" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#232F4A" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#222D44" />
  <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#102844" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#0B2B1F" />
  <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#30230B" />
  <SolidColorBrush x:Key="DangerBrush" Color="#F43F5E" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#33131C" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#64748B" />

  <!-- Softly rounded Fluent controls. -->
  <CornerRadius x:Key="ControlCornerRadius">12,12,12,12</CornerRadius>
  <CornerRadius x:Key="PopupCornerRadius">14,14,14,14</CornerRadius>
  <CornerRadius x:Key="DialogOverlayCornerRadius">20,20,20,20</CornerRadius>
  <CornerRadius x:Key="DialogFooterCornerRadius">12,12,12,12</CornerRadius>
</ResourceDictionary>
