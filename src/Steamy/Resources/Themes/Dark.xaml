<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Steamy Night: near-black blue-grey surfaces, one electric blue accent and a sky → indigo →
       violet brand gradient. Every page reads its colours from these keys, so the light palette
       only has to redefine the same names. -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0D1017" />
  <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#D00D1424" />
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#151923" />
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#1B2130" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#B0121D30" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#AD1C2940" />
  <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#B02B3951" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#242A37" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#444D6488" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#43516A" />

  <SolidColorBrush x:Key="AccentBrush" Color="#78B5FF" />
  <SolidColorBrush x:Key="AccentStrongBrush" Color="#3B82F6" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2E4B" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#0F2A21" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#2D2410" />
  <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#33171B" />
  <SolidColorBrush x:Key="VioletBrush" Color="#A78BFA" />
  <SolidColorBrush x:Key="VioletSoftBrush" Color="#221C3D" />
  <SolidColorBrush x:Key="PinkBrush" Color="#F472B6" />
  <SolidColorBrush x:Key="PinkSoftBrush" Color="#33172A" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5F9" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3BED0" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#94A0B5" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

  <LinearGradientBrush x:Key="GlassSurfaceBrush" StartPoint="0,0" EndPoint="0.65,1">
    <GradientStop Color="#C22A3852" Offset="0" /><GradientStop Color="#B2162136" Offset="0.6" /><GradientStop Color="#CA172039" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Color="#50CDDFFF" Offset="0" /><GradientStop Color="#146CA6F0" Offset="0.55" /><GradientStop Color="#387A86CE" Offset="1" />
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="AmbientBlueBrush" Center="0.87,0.04" GradientOrigin="0.87,0.04" RadiusX="0.85" RadiusY="0.85">
    <GradientStop Color="#543877AF" Offset="0" /><GradientStop Color="#163877AF" Offset="0.6" /><GradientStop Color="#003877AF" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbientVioletBrush" Center="0.08,0.94" GradientOrigin="0.08,0.94" RadiusX="0.72" RadiusY="0.9">
    <GradientStop Color="#444C3689" Offset="0" /><GradientStop Color="#004C3689" Offset="1" />
  </RadialGradientBrush>

  <!-- Brand gradient for the logo, the welcome hero and the primary call to action. -->
  <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#38BDF8" Offset="0" />
    <GradientStop Color="#6366F1" Offset="0.6" />
    <GradientStop Color="#A855F7" Offset="1" />
  </LinearGradientBrush>
  <!-- Very faint version of the brand gradient used as a wash behind hero content. -->
  <LinearGradientBrush x:Key="BrandWashBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#2A38BDF8" Offset="0" />
    <GradientStop Color="#1A6366F1" Offset="0.55" />
    <GradientStop Color="#00A855F7" Offset="1" />
  </LinearGradientBrush>
  <!-- Shades that keep white hero text readable on top of game art. -->
  <LinearGradientBrush x:Key="HeroShadeBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#F20B0D12" Offset="0" />
    <GradientStop Color="#B30B0D12" Offset="0.48" />
    <GradientStop Color="#140B0D12" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroBottomShadeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#000B0D12" Offset="0.35" />
    <GradientStop Color="#E00B0D12" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ScrimBrush" Color="#B8050608" />

  <!-- White text on primary (accent) buttons instead of the Fluent default black-on-light-accent. -->
  <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6FFFFFF" />
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />

  <!-- Softly rounded Fluent controls. -->
  <CornerRadius x:Key="ControlCornerRadius">10,10,10,10</CornerRadius>
  <CornerRadius x:Key="PopupCornerRadius">14,14,14,14</CornerRadius>
  <CornerRadius x:Key="DialogOverlayCornerRadius">20,20,20,20</CornerRadius>
  <CornerRadius x:Key="DialogFooterCornerRadius">12,12,12,12</CornerRadius>
</ResourceDictionary>
