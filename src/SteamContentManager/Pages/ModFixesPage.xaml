<Page x:Class="SteamContentManager.Pages.ModFixesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
<Page.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></Page.Resources>
  <Grid Margin="30,26,30,30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Fixes" Style="{StaticResource PageTitleStyle}" Margin="0"/><TextBlock Text="Local compatibility and configuration helpers with reversible changes." Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,0"/></StackPanel>
      <ui:Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Appearance="Secondary" VerticalAlignment="Center"/>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer Grid.Column="0" Style="{StaticResource PageScrollHostStyle}" Padding="0,0,8,0">
        <ItemsControl ItemsSource="{Binding Fixes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,10" Padding="15">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="  ·  " Foreground="{DynamicResource TextTertiaryBrush}"/><TextBlock Text="{Binding VersionLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" FontSize="11.5" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="App " Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"/><TextBlock Text="{Binding GameAppId}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="  ·  " Foreground="{DynamicResource TextTertiaryBrush}"/><TextBlock Text="{Binding Compatibility}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" FontSize="12"/><TextBlock Text="Backup required" Foreground="{DynamicResource WarningBrush}" FontSize="10.5" HorizontalAlignment="Right" Margin="0,4,0,0" Visibility="{Binding BackupRequired, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <ScrollViewer Grid.Column="1" Style="{StaticResource PageScrollHostStyle}" Padding="12,0,0,0">
        <Border Style="{StaticResource SurfaceCardStyle}" Padding="17" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Safe local workflow" Style="{StaticResource CardTitleStyle}"/>
            <TextBlock Text="Fixes are limited to local configuration and compatibility tasks. Create a backup before applying changes." Style="{StaticResource MutedTextStyle}" FontSize="11.5" Margin="0,4,0,14"/>
            <TextBlock Text="Selected fix" Style="{StaticResource PillTextStyle}"/>
            <ComboBox ItemsSource="{Binding Fixes}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedFix}" Margin="0,5,0,14"/>
            <WrapPanel>
              <ui:Button Content="Validate" Command="{Binding ValidateCommand}" CommandParameter="{Binding SelectedFix}" Margin="0,0,6,6"/>
              <ui:Button Content="Create backup" Command="{Binding BackupCommand}" CommandParameter="{Binding SelectedFix}" Appearance="Secondary" Margin="0,0,6,6"/>
              <ui:Button Content="Apply fix" Command="{Binding ApplyCommand}" CommandParameter="{Binding SelectedFix}" Margin="0,0,6,6"/>
              <ui:Button Content="Reset" Command="{Binding ResetCommand}" CommandParameter="{Binding SelectedFix}" Appearance="Danger" Margin="0,0,6,6"/>
            </WrapPanel>
            <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="9" Padding="11" Margin="0,10,0,0"><StackPanel><TextBlock Text="Scope" Style="{StaticResource PillTextStyle}"/><TextBlock Text="No Steam authentication, DRM, license, or access-control behavior is modified." Style="{StaticResource MutedTextStyle}" FontSize="11.5" Margin="0,3,0,0"/></StackPanel></Border>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
