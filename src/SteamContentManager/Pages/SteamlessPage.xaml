<Page x:Class="SteamContentManager.Pages.SteamlessPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Page.Resources>

  <!--
    HorizontalScrollBarVisibility is Disabled on purpose: it makes the scroll viewer measure its
    content with the real viewport width. With a scrollbar enabled the content is measured with an
    infinite width, "Stretch" stops stretching and the layout collapses towards its content size.
  -->
  <ScrollViewer Style="{StaticResource PageScrollHostStyle}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Padding="22,16,22,26">
    <StackPanel HorizontalAlignment="Stretch">

      <!-- Header with the Steamless mark -->
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- Assembly-qualified pack URI: the mark lives in the application assembly, not in
             whatever assembly happens to host the page (which matters in tests as well). -->
        <Image Source="pack://application:,,,/SteamContentManager;component/Resources/steamless.png"
               Height="42"
               Stretch="Uniform"
               VerticalAlignment="Center"
               Margin="0,0,12,0"
               RenderOptions.BitmapScalingMode="HighQuality"
               ToolTip="Steamless — SteamStub unpacker by atom0s" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Steamless" Style="{StaticResource PageTitleStyle}" />
          <TextBlock Text="Steamless ships inside this app. Pick the game .exe, press Run — the unpacked build replaces it and the original stays as a .bak.exe backup."
                     Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>
        <ui:Button Grid.Column="2"
                   Content="ⓘ"
                   Command="{Binding ToggleInfoCommand}"
                   Appearance="Secondary"
                   Width="34"
                   Height="30"
                   Padding="0"
                   FontSize="14"
                   ToolTip="Show tool information"
                   VerticalAlignment="Center" />
      </Grid>

      <!--
        The bundled build is the default, so this bar only appears when it actually has something
        to say: a build you selected yourself, or a problem with the bundled one.
      -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="18"
              Padding="14,11"
              Margin="0,0,0,10"
              Visibility="{Binding ShowStatusStrip, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="28" Height="28" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}">
            <TextBlock Text="⚙" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Status}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding DisplaySteamlessPath}" Style="{StaticResource TertiaryTextStyle}"
                       FontSize="10.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding DisplaySteamlessPath}" />
          </StackPanel>
          <Border Grid.Column="2" Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="9" Padding="9,4"
                  VerticalAlignment="Center" ToolTip="Steamless version">
            <TextBlock Text="{Binding ToolVersion}" Style="{StaticResource TertiaryTextStyle}" FontSize="11" />
          </Border>
        </Grid>
      </Border>

      <!-- Workflow -->
      <!--
        A plain Border instead of ui:CardControl: the CardControl template wraps its content in a
        ContentPresenter that does not always stretch to the card width, which left the whole
        workflow squeezed to the right. A Border with Stretch content behaves the same everywhere.
      -->
      <Border x:Name="WorkflowCard"
              Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="18"
              Padding="18,16"
              Margin="0,0,0,10"
              HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch">
          <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Unpack workflow" Style="{StaticResource CardTitleStyle}" FontSize="14" />
              <TextBlock Text="{Binding BundleSummary}" Style="{StaticResource MutedTextStyle}"
                         FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:ProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="{Binding IsBusy}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <ui:Button Content="{Binding LogButtonLabel}"
                         Command="{Binding ToggleLogCommand}"
                         Appearance="Secondary"
                         ToolTip="Show or hide what the tool reported" />
              <ui:Button Content="Refresh"
                         Command="{Binding RefreshStatusCommand}"
                         Appearance="Secondary"
                         Margin="6,0,0,0"
                         ToolTip="Check the build once more" />
            <ui:Button Margin="6,0,0,0"
                       Content="{Binding AdvancedButtonLabel}"
                       Command="{Binding ToggleAdvancedCommand}"
                       Appearance="Secondary"
                       VerticalAlignment="Center"
                       ToolTip="Show your own Steamless build and extra arguments" />
            </StackPanel>
          </Grid>

          <!-- The one field that matters -->
          <TextBlock Text="Game executable to unpack" Style="{StaticResource PillTextStyle}" Margin="0,14,0,5" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding TargetExePath, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Paste the path to the game .exe or use Browse…"
                        LostFocus="PathBox_LostFocus"
                        VerticalAlignment="Center" />
            <ui:Button Grid.Column="1" Content="Browse…" Click="BrowseTargetButton_Click"
                       Appearance="Secondary" Margin="8,0,0,0" VerticalAlignment="Center" />
            <ui:Button Grid.Column="2" Content="Clear" Command="{Binding ClearTargetCommand}"
                       Appearance="Secondary" Margin="6,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{Binding TargetHint}" Style="{StaticResource MutedTextStyle}"
                     FontSize="11" Margin="2,5,0,0" TextWrapping="Wrap" />

          <!-- Everything optional, hidden until asked for -->
          <StackPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Your own Steamless build (optional)" Style="{StaticResource PillTextStyle}" Margin="0,14,0,5" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Text="{Binding SteamlessPath, UpdateSourceTrigger=PropertyChanged}"
                          PlaceholderText="Leave empty to use the bundled build"
                          LostFocus="PathBox_LostFocus"
                          VerticalAlignment="Center" />
              <ui:Button Grid.Column="1" Content="Browse…" Click="BrowseSteamlessButton_Click"
                         Appearance="Secondary" Margin="8,0,0,0" VerticalAlignment="Center" />
              <ui:Button Grid.Column="2" Content="Use bundled" Command="{Binding UseBundledBuildCommand}"
                         Appearance="Secondary" Margin="6,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="Extra arguments (optional)" Style="{StaticResource PillTextStyle}" Margin="0,14,0,5" />
            <ui:TextBox Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Leave empty for a normal unpack run" />
          </StackPanel>

          <!-- Actions -->
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding LastMessage}" Style="{StaticResource MutedTextStyle}"
                       FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            <ui:Button Grid.Column="1" Content="Cancel" Command="{Binding CancelRunCommand}"
                       IsEnabled="{Binding IsBusy}" Appearance="Secondary" Margin="0,0,6,0" />
            <ui:Button Grid.Column="2" Content="Undo rename" Command="{Binding UndoCommand}"
                       IsEnabled="{Binding CanUndo}" Appearance="Secondary" Margin="0,0,6,0"
                       ToolTip="Restore the .bak.exe backup" />
            <ui:Button Grid.Column="3" Content="Run" Command="{Binding RunCommand}"
                       IsEnabled="{Binding CanRun}" Appearance="Primary" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Backup hint -->
      <Border Background="{DynamicResource SurfaceSubtleBrush}"
              CornerRadius="18"
              Padding="14,9"
              Margin="0,0,0,10"
              Visibility="{Binding CanUndo, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Backup available." FontWeight="SemiBold" FontSize="12"
                     Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text=" Use Undo rename to restore the original build."
                     Style="{StaticResource MutedTextStyle}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Done popup -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="18"
              Padding="18"
              Margin="0,0,0,10"
              Visibility="{Binding ShowDone, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DoneSuccess}" Value="True">
                      <Setter Property="Background" Value="#1F42D39A" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="!" />
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DoneSuccess}" Value="True">
                        <Setter Property="Text" Value="✓" />
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding DoneTitle}" Style="{StaticResource CardTitleStyle}"
                       FontSize="14" Margin="10,0,10,0" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ui:Button Grid.Column="2" Content="Dismiss" Command="{Binding DismissDoneCommand}"
                       Appearance="Secondary" VerticalAlignment="Center" />
          </Grid>

          <TextBlock Text="{Binding DoneMessage}" Style="{StaticResource MutedTextStyle}"
                     FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center">
              <Run Text="Reversible:" FontWeight="SemiBold" />
              <Run Text="the original build stays next to the game as .bak.exe — Undo rename puts it back." />
            </TextBlock>
            <ui:Button Grid.Column="1" Content="Close" Command="{Binding CloseDoneCommand}" Appearance="Primary" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- The tool's own report, in the page instead of in a console window -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="18"
              Padding="16"
              Margin="0,0,0,10"
              Visibility="{Binding ShowLog, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding LogSummary}" Style="{StaticResource CardTitleStyle}" FontSize="13"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ui:Button Grid.Column="1" Content="Collapse" Command="{Binding ToggleLogCommand}" Appearance="Secondary" />
          </Grid>
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="12,10">
            <TextBlock Text="{Binding Output}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       FontFamily="Consolas"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>
        </StackPanel>
      </Border>

      <!-- Info card -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="18"
              Padding="16"
              Margin="0,0,0,10"
              Visibility="{Binding IsInfoVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <TextBlock Text="Tool information" Style="{StaticResource CardTitleStyle}" FontSize="13" />
          <TextBlock Text="{Binding InfoText}" Style="{StaticResource MutedTextStyle}"
                     FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
