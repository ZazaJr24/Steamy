<Page x:Class="SteamContentManager.Pages.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:SteamContentManager.Controls"
      xmlns:local="clr-namespace:SteamContentManager.Pages"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <local:EnumToShowBoolConverter x:Key="EnumTo_ShowBoolConverter" />
    <!-- keep local xmlns for correctness -->
    <Style x:Key="GalleryEmptyStateStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Margin" Value="2,12,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasCatalogItems}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Option rows and host chips inside the download dialog. The code-behind swaps
         Background/BorderBrush for the selected state using the same theme brushes. -->
    <Style x:Key="OptionRow" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="HostPill" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="DialogSectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="CharacterSpacing" Value="60" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <LinearGradientBrush x:Key="HeroBannerFade" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#00000000" Offset="0" />
      <GradientStop Color="#CC0E0F12" Offset="0.6" />
      <GradientStop Color="#F50E0F12" Offset="1" />
    </LinearGradientBrush>

    <!-- Dashboard stat tile -->
    <Style x:Key="StatTileStyle" TargetType="Border" BasedOn="{StaticResource SurfaceCardStyle}">
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Margin" Value="6,0" />
    </Style>

    <!-- Dashboard shortcut tile: icon badge + title + subtitle, click to navigate -->
    <Style x:Key="ShortcutTileStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="15,14" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ShortcutIconBadge" TargetType="Border">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <Grid>
    <Grid x:Name="MainContentGrid" Margin="32,26,24,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Header: title left, search + filter + refresh right -->
      <Grid Grid.Row="0" Margin="0,0,8,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Games" Style="{StaticResource PageTitleStyle}" Margin="0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CatalogCountLabel}" Margin="12,6,0,0" FontSize="12.5"
                     Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <ui:TextBox Grid.Column="2"
                    Width="300"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Search games…"
                    Icon="{ui:SymbolIcon Search24}"
                    FontSize="13"
                    MinHeight="38"
                    VerticalAlignment="Center" />
        <controls:FilterFlyout Grid.Column="3"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FilterSummary="{Binding FilterSummary}"
                               HasActiveFilters="{Binding HasActiveFilters}">
          <controls:FilterFlyout.FilterContent>
            <StackPanel>
              <TextBlock Text="Show" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedTypeFilter}" Margin="0,0,0,12" />
              <TextBlock Text="Sort" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Margin="0,0,0,12" />
              <TextBlock Text="Cards per page" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" />
              <CheckBox Content="Include adult games (NSFW)" IsChecked="{Binding NsfwScope, Converter={StaticResource EnumTo_ShowBoolConverter}, ConverterParameter=Show}" Margin="0,12,0,0" />
              <TextBlock Text="NSFW games are hidden by default and show with the adult label." Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
          </controls:FilterFlyout.FilterContent>
        </controls:FilterFlyout>
        <ui:Button Grid.Column="4"
                   Style="{StaticResource IconButtonStyle}"
                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                   Command="{Binding RefreshCatalogCommand}"
                   Appearance="Secondary"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   ToolTip="Refresh list" />
      </Grid>

      <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Margin="0,0,8,8"
                   Visibility="{Binding IsCatalogLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

      <ScrollViewer Grid.Row="2" Style="{StaticResource PageScrollHostStyle}" Padding="0,0,8,0">
        <StackPanel>
          <TextBlock Text="{Binding EmptyStateMessage}" Style="{StaticResource GalleryEmptyStateStyle}" />

          <ItemsControl ItemsSource="{Binding PagedCatalogItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:AdaptiveGridPanel MinItemWidth="176" Spacing="16" CoverRatio="1.5" FooterHeight="54" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Card"
                        CornerRadius="12"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        Cursor="Hand"
                        SnapsToDevicePixels="True"
                        MouseLeftButtonUp="GameCard_MouseLeftButtonUp"
                        Tag="{Binding}"
                        ToolTip="{Binding Name}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="53" />
                    </Grid.RowDefinitions>

                    <!-- Cover: rounded via brush instead of a clip geometry (cheaper, scales with the card) -->
                    <Border CornerRadius="11,11,0,0" Background="#0B0C0F">
                      <Grid>
                        <Border CornerRadius="11,11,0,0">
                          <Border.Background>
                            <ImageBrush ImageSource="{Binding ArtworkImage}" Stretch="UniformToFill" />
                          </Border.Background>
                        </Border>
                        <Border CornerRadius="11,11,0,0" Background="{DynamicResource SurfaceSubtleBrush}"
                                Visibility="{Binding IsArtworkLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="STEAM" Foreground="#3A3E47" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsArtworkFallback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border x:Name="Shine" CornerRadius="11,11,0,0" Background="#FFFFFF" Opacity="0" />
                        <Border Style="{StaticResource CoverBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                          <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource CoverBadgeTextStyle}" />
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                Style="{StaticResource CoverBadgeStyle}" ToolTip="Installed"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                          <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Installed" Style="{StaticResource CoverBadgeTextStyle}" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Border>

                    <!-- Footer -->
                    <StackPanel Grid.Row="1" Margin="12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="12.5" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding AppLabel}" Margin="0,3,0,0"
                                 Foreground="{DynamicResource TextTertiaryBrush}"
                                 FontSize="10.5" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Shine" Property="Opacity" Value="0.06" />
                  </Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Pager: flat, centered -->
          <Grid Margin="0,22,0,26">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding VisibleCountLabel}" FontSize="11.5"
                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ui:Button Style="{StaticResource IconButtonStyle}" Icon="{ui:SymbolIcon ChevronLeft24}"
                         Appearance="Transparent" Command="{Binding PreviousPageCommand}"
                         IsEnabled="{Binding CanGoPrevious}" ToolTip="Previous page" />
              <TextBlock Text="{Binding PageLabel}" Margin="14,0" FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
              <ui:Button Style="{StaticResource IconButtonStyle}" Icon="{ui:SymbolIcon ChevronRight24}"
                         Appearance="Transparent" Command="{Binding NextPageCommand}"
                         IsEnabled="{Binding CanGoNext}" ToolTip="Next page" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding UpdatedLabel}" FontSize="11"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <!-- Download dialog overlay -->
    <Grid x:Name="OverlayGrid" Visibility="Collapsed">
      <Border Background="#60000000" MouseLeftButtonUp="Overlay_Close" />
      <Border x:Name="DialogPanel"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="20"
              Width="560"
              MaxHeight="720"
              ClipToBounds="True">
        <Border.Clip>
          <RectangleGeometry Rect="0,0,560,720" RadiusX="20" RadiusY="20" />
        </Border.Clip>
        <Border.Effect>
          <DropShadowEffect BlurRadius="60" ShadowDepth="14" Direction="270" Color="#000000" Opacity="0.6" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Hero banner -->
          <Grid Grid.Row="0" Height="140">
            <Image x:Name="OverlayCover" Stretch="UniformToFill" VerticalAlignment="Center" />
            <Border Background="{StaticResource HeroBannerFade}" />
            <ui:Button Style="{StaticResource IconButtonStyle}"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Width="30" Height="30" MinHeight="30"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,12,14,0"
                       ToolTip="Close"
                       Click="OverlayCloseButton_Click">
              <ui:Button.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#000000" Opacity="0.5" />
              </ui:Button.Effect>
            </ui:Button>
            <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,14">
              <TextBlock x:Name="OverlayTitle" Text="Download Game"
                         Foreground="White"
                         FontSize="20" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis">
                <TextBlock.Effect>
                  <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#000000" Opacity="0.7" />
                </TextBlock.Effect>
              </TextBlock>
              <TextBlock x:Name="OverlayAppId" Text="App 0"
                         Foreground="#C7CBD8"
                         FontSize="11.5" Margin="0,3,0,0">
                <TextBlock.Effect>
                  <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#000000" Opacity="0.6" />
                </TextBlock.Effect>
              </TextBlock>
            </StackPanel>
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18,24,6">
            <StackPanel>
              <!-- SOURCE -->
              <TextBlock Text="SOURCE" Style="{StaticResource DialogSectionLabel}" />
              <WrapPanel Margin="0,0,0,2">
                <Border Style="{StaticResource HostPill}" x:Name="SourceRyuu" MouseLeftButtonUp="Source_Click" Tag="Ryuu"><TextBlock Text="Ryuu" FontSize="11" FontWeight="SemiBold" /></Border>
                <Border Style="{StaticResource HostPill}" x:Name="SourceZaza" MouseLeftButtonUp="Source_Click" Tag="Zaza"><TextBlock Text="Zaza" FontSize="11" FontWeight="SemiBold" /></Border>
                <Border Style="{StaticResource HostPill}" x:Name="SourceHubcap" MouseLeftButtonUp="Source_Click" Tag="Hubcap"><TextBlock Text="Hubcap" FontSize="11" FontWeight="SemiBold" /></Border>
                <Border Style="{StaticResource HostPill}" x:Name="SourceResonance" MouseLeftButtonUp="Source_Click" Tag="Resonance" ToolTip="Check the ResonanceManifests repository for this AppID"><TextBlock Text="Resonance" FontSize="11" FontWeight="SemiBold" /></Border>
              </WrapPanel>
              <TextBlock x:Name="SourceAvailabilityText" Text="" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />

              <Separator Margin="0,8,0,16" />

              <!-- DOWNLOAD LOCATION -->
              <TextBlock Text="DOWNLOAD LOCATION" Style="{StaticResource DialogSectionLabel}" />
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12,0" MinHeight="36">
                  <TextBlock x:Name="DownloadPathText" Text="Select a folder…"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             FontSize="12" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                </Border>
                <ui:Button Grid.Column="1" Content="Browse" Appearance="Secondary"
                           Margin="8,0,0,0" Click="BrowseFolderButton_Click" />
              </Grid>

              <Separator Margin="0,10,0,16" />

              <!-- CUSTOM ARCHIVE -->
              <TextBlock Text="CUSTOM ARCHIVE (OPTIONAL)" Style="{StaticResource DialogSectionLabel}" />
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12,0" MinHeight="36">
                  <TextBlock x:Name="CustomArchiveText" Text="No archive selected"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             FontSize="12" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                </Border>
                <ui:Button Grid.Column="1" Content="Browse" Appearance="Secondary"
                           Margin="8,0,0,0" Click="BrowseArchiveButton_Click" />
              </Grid>
              <TextBlock Text="Extract a .zip / .7z / .rar into the download folder after the manifest download."
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />

              <!-- Status -->
              <TextBlock x:Name="OverlayStatus" Text=""
                         Foreground="{DynamicResource AccentBrush}"
                         FontSize="11.5" Margin="0,14,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>

          <!-- Footer -->
          <Border Grid.Row="2" Padding="0"
                  CornerRadius="0,0,20,20">
            <StackPanel>
              <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />
              <Grid Margin="24,14,24,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Content="Close" Appearance="Secondary" Click="OverlayCloseButton_Click" />
                <ui:Button Grid.Column="2"
                           x:Name="StartButton"
                           Content="Start download"
                           Icon="{ui:SymbolIcon ArrowDownload24}"
                           Appearance="Primary"
                           Click="StartDownloadButton_Click" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
