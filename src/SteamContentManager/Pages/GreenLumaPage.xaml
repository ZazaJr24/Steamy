<Page x:Class="SteamContentManager.Pages.GreenLumaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Page.Resources>

  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" Padding="28,24,28,40">
    <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch">

      <!-- Header -->
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="GreenLuma 2024" Style="{StaticResource PageTitleStyle}"/>
          <TextBlock Text="Steam DLC Unlocker — generates the AppList folder used by GreenLuma to unlock DLC for games you own." Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>
        <ui:Button Grid.Column="1" Content="How it works" Icon="{ui:SymbolIcon Info24}" Command="{Binding ToggleInfoCommand}" Appearance="Secondary" VerticalAlignment="Center"/>
      </Grid>

      <!-- Info banner (toggled) -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14"
              Visibility="{Binding IsInfoVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <TextBlock Text="About GreenLuma" Style="{StaticResource CardTitleStyle}" FontSize="14"/>
          <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="GreenLuma is a Steam DLC unlocker that works by placing numbered .txt files inside an AppList folder in the Steam directory. Each file contains a single App ID. This page generates those files for you — it does not modify any game files or Steam binaries. You still need GreenLuma installed separately."/>
          <TextBlock Style="{StaticResource TertiaryTextStyle}" FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Folder structure: Steam\AppList\0.txt (containing an App ID), 1.txt, 2.txt, etc. GreenLuma reads this folder on Steam startup."/>
        </StackPanel>
      </Border>

      <!-- Status strip -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}">
            <TextBlock Text="🟢" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CardTitleStyle}"/>
            <TextBlock Text="{Binding SteamPathDisplay}" Style="{StaticResource TertiaryTextStyle}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <ui:Button Grid.Column="2" Content="Detect Steam" Command="{Binding DetectSteamCommand}" Appearance="Secondary" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- Steam path -->
      <Border Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Steam directory" Style="{StaticResource CardTitleStyle}" FontSize="14" Margin="0,0,0,4"/>
          <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11.5" Margin="0,0,0,12"
                     Text="The AppList folder will be created inside this Steam installation directory."/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SteamPathBox"
                        Text="{Binding SteamPath, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="C:\Program Files (x86)\Steam"
                        VerticalAlignment="Center"/>
            <ui:Button Grid.Column="1" Content="Browse…" Click="BrowseSteamPath_Click" Appearance="Secondary" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- App ID input -->
      <Border Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="DLC App IDs" Style="{StaticResource CardTitleStyle}" FontSize="14" Margin="0,0,0,4"/>
          <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11.5" Margin="0,0,0,12"
                     Text="Add the App IDs of DLCs you want to unlock. You can enter them one by one or paste a list (one per line, comma-separated, or space-separated)."/>

          <!-- Add single -->
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ui:TextBox x:Name="AppIdInput"
                        PlaceholderText="Enter an App ID (e.g. 12345) or paste multiple"
                        KeyDown="AppIdInput_KeyDown"
                        VerticalAlignment="Center"/>
            <ui:Button Grid.Column="1" Content="Add" Click="AddAppId_Click" Appearance="Primary" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </Grid>

          <!-- Bulk paste -->
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <ui:Button Content="Paste from clipboard" Click="PasteAppIds_Click" Appearance="Secondary" Margin="0,0,8,0"/>
            <ui:Button Content="Clear all" Command="{Binding ClearAllCommand}" Appearance="Danger"/>
            <TextBlock Text="{Binding AppIdCountLabel}" Style="{StaticResource TertiaryTextStyle}" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- App ID list -->
          <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="10" Padding="12,8" MinHeight="80" MaxHeight="300">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding AppIds}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Index}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10.5" FontFamily="Consolas" MinWidth="28" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding AppId}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"/>
                      <ui:Button Grid.Column="2" Content="✕" FontSize="10" Padding="4,2"
                                 Command="{Binding DataContext.RemoveAppIdCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 CommandParameter="{Binding AppId}" Appearance="Secondary" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Border>

      <!-- Actions -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding ActionStatus}" Style="{StaticResource MutedTextStyle}" FontSize="11.5" TextWrapping="Wrap"/>
          </StackPanel>
          <ui:Button Grid.Column="1" Content="Preview" Command="{Binding PreviewCommand}" Appearance="Secondary" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <ui:Button Grid.Column="2" Content="Generate AppList" Command="{Binding GenerateCommand}" Appearance="Primary" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- Preview output -->
      <Border Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,0,14"
              Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <TextBlock Text="Preview" Style="{StaticResource CardTitleStyle}" FontSize="14" Margin="0,0,0,8"/>
          <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                   FontFamily="Cascadia Code,Consolas" FontSize="11.5"
                   Background="{DynamicResource SurfaceSubtleBrush}" BorderThickness="0"
                   MinHeight="100" MaxHeight="300" VerticalScrollBarVisibility="Auto" Padding="9"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
