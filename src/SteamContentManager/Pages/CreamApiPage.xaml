<Page x:Class="SteamContentManager.Pages.CreamApiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:SteamContentManager.ViewModels"
      xmlns:svc="clr-namespace:SteamContentManager.Services"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis" />
  </Page.Resources>

  <Grid Margin="28,20,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ═══ HEADER ═══ -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="DLC Unlocker" Style="{StaticResource PageTitleStyle}" Margin="0" />
        <TextBlock Text="Select a game, pick a method, fetch DLCs, apply."
                   Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock Text="Method:" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding AvailableModes}"
                  SelectedItem="{Binding SelectedMode}"
                  Width="160" Height="32" FontSize="12" />
      </StackPanel>

      <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11"
                 Foreground="{DynamicResource TextTertiaryBrush}"
                 VerticalAlignment="Center" MaxWidth="250"
                 TextTrimming="CharacterEllipsis"
                 ToolTip="{Binding Status}" />
    </Grid>

    <!-- ═══ TWO-COLUMN BODY ═══ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1.3*" />
      </Grid.ColumnDefinitions>

      <!-- LEFT: Game Picker -->
      <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" CornerRadius="14" Padding="14,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Title + Browse -->
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding GameCountLabel}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <ui:Button Grid.Column="1" Content="Browse…" Click="BrowseGameFolder_Click"
                       Appearance="Secondary" Height="28" FontSize="11" />
          </Grid>

          <!-- Search -->
          <ui:TextBox Grid.Row="1"
                      Text="{Binding GameSearchText, UpdateSourceTrigger=PropertyChanged}"
                      PlaceholderText="Search games…"
                      Height="32" FontSize="12" Margin="0,0,0,8" />

          <!-- Selected game info -->
          <Border Grid.Row="2" Background="{DynamicResource SurfaceSubtleBrush}"
                  CornerRadius="8" Padding="10,7" Margin="0,0,0,8"
                  Visibility="{Binding HasGameFolder, Converter={StaticResource BoolVis}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding GameFolderDisplay}"
                           FontFamily="Consolas" FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding DetectedDlls}" FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="App" Foreground="{DynamicResource TextTertiaryBrush}"
                           FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ui:TextBox Text="{Binding AppIdText, UpdateSourceTrigger=PropertyChanged}"
                            Width="68" Height="26" FontFamily="Consolas"
                            FontSize="12" TextAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Loading spinner -->
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{Binding IsLoadingGames, Converter={StaticResource BoolVis}}">
            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
            <TextBlock Text="Scanning…" FontSize="12"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>

          <!-- Game list -->
          <Border Grid.Row="3" Background="{DynamicResource SurfaceSubtleBrush}"
                  CornerRadius="8" Padding="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding FilteredGames}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel IsVirtualizing="True"
                                            VirtualizationMode="Recycling" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="GameRow" Padding="8,6" Margin="1"
                            CornerRadius="6" Background="Transparent"
                            Cursor="Hand" MouseLeftButtonDown="GameRow_MouseDown">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding AppId}" FontFamily="Consolas" FontSize="10"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Width="52" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="GameRow" Property="IsMouseOver" Value="True">
                        <Setter TargetName="GameRow" Property="Background"
                                Value="{DynamicResource ControlHoverBrush}" />
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

      <!-- RIGHT: DLC List -->
      <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" CornerRadius="14" Padding="14,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- DLC header -->
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding DlcCountLabel}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True"
                               Margin="8,0,0,0"
                               Visibility="{Binding IsFetching, Converter={StaticResource BoolVis}}" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="Fetch" Command="{Binding FetchDlcCommand}"
                       Appearance="Secondary" Height="28" FontSize="11" Margin="0,0,4,0" />
            <ui:Button Grid.Column="2" Content="All" Command="{Binding SelectAllCommand}"
                       Appearance="Secondary" Height="28" FontSize="11" Margin="0,0,4,0" />
            <ui:Button Grid.Column="3" Content="None" Command="{Binding DeselectAllCommand}"
                       Appearance="Secondary" Height="28" FontSize="11" />
          </Grid>

          <!-- DLC list area -->
          <Border Grid.Row="1" Background="{DynamicResource SurfaceSubtleBrush}"
                  CornerRadius="8" Padding="2">
            <Grid>
              <!-- Empty state -->
              <TextBlock Text="Select a game to load its DLCs"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding DlcList.Count}" Value="0" />
                          <Condition Binding="{Binding IsFetching}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <!-- Fetching spinner -->
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding IsFetching, Converter={StaticResource BoolVis}}">
                <ui:ProgressRing Width="24" Height="24" IsIndeterminate="True"
                                 HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Fetching DLCs…" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
              </StackPanel>

              <!-- DLC items -->
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                  <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DlcList.Count}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding DlcList}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="DlcRow" Padding="6,5" Margin="1"
                              CornerRadius="6" Background="Transparent">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                    Margin="0,0,4,0" />
                          <TextBlock Grid.Column="1" Text="{Binding AppId}" FontFamily="Consolas"
                                     FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"
                                     Width="52" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Border>
                      <DataTemplate.Triggers>
                        <Trigger SourceName="DlcRow" Property="IsMouseOver" Value="True">
                          <Setter TargetName="DlcRow" Property="Background"
                                  Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- ═══ BOTTOM BAR ═══ -->
    <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" CornerRadius="12"
            Padding="14,10" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Settings expander -->
        <Expander IsExpanded="False" VerticalAlignment="Center">
          <Expander.Header>
            <TextBlock Text="Settings" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          </Expander.Header>
          <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="Language" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,3" />
              <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                        Width="120" Height="28" FontSize="11" />
            </StackPanel>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="Proxy" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,3" />
              <ui:TextBox Text="{Binding ProxyAddress, UpdateSourceTrigger=LostFocus}"
                          PlaceholderText="http://proxy:port" Width="160" Height="28" FontSize="11" />
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom">
              <CheckBox IsChecked="{Binding UnlockAll}" Margin="0,0,0,2">
                <TextBlock Text="Unlock all" FontSize="11" />
              </CheckBox>
              <CheckBox IsChecked="{Binding ExtraProtection}" Margin="0,0,0,2">
                <TextBlock Text="Extra protection" FontSize="11" />
              </CheckBox>
              <CheckBox IsChecked="{Binding ForceOffline}">
                <TextBlock Text="Force offline" FontSize="11" />
              </CheckBox>
            </StackPanel>
            <ui:Button Content="Load archive…" Click="BrowseCreamApiArchive_Click"
                       Appearance="Secondary" Height="28" FontSize="11" Margin="20,0,0,0"
                       VerticalAlignment="Bottom" />
          </StackPanel>
        </Expander>

        <!-- Result message -->
        <TextBlock Grid.Column="1" Text="{Binding ResultMessage}" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding ResultMessage}" Margin="12,0"
                   Visibility="{Binding ShowResult, Converter={StaticResource BoolVis}}" />

        <!-- Action buttons -->
        <ui:Button Grid.Column="2" Content="Restore" Command="{Binding RestoreCommand}"
                   Appearance="Secondary" Height="36" FontSize="12" Margin="0,0,8,0" />
        <ui:Button Grid.Column="3" Content="Apply" Command="{Binding ApplyCommand}"
                   Appearance="Primary" Height="36" FontSize="12" FontWeight="SemiBold"
                   MinWidth="100" HorizontalContentAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Page>
