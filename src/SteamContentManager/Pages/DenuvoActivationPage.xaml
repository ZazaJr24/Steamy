<Page x:Class="SteamContentManager.Pages.DenuvoActivationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Page.Resources>

  <ScrollViewer Style="{StaticResource PageScrollHostStyle}"
                HorizontalScrollBarVisibility="Disabled"
                Padding="32,34,32,48">
    <Grid MaxWidth="560" HorizontalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,10,0,26">
        <Border Width="48" Height="48" CornerRadius="15"
                Background="{DynamicResource AccentSoftBrush}"
                HorizontalAlignment="Center">
          <TextBlock Text="⚡"
                     FontSize="23"
                     Foreground="{DynamicResource AccentBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Denuvo Activation"
                   Style="{StaticResource PageTitleStyle}"
                   FontSize="28"
                   HorizontalAlignment="Center"
                   Margin="0,16,0,0" />
        <TextBlock Text="AppID eingeben. Ticket holen. Fertig."
                   Style="{StaticResource PageSubtitleStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" />
      </StackPanel>

      <Border Grid.Row="1"
              Style="{StaticResource SurfaceCardStyle}"
              Padding="28"
              Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="STEAM APPID"
                     Style="{StaticResource FieldLabelStyle}"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,10" />
          <ui:TextBox Text="{Binding ManualAppId, UpdateSourceTrigger=PropertyChanged}"
                      PlaceholderText="z. B. 2358720"
                      FontFamily="Consolas"
                      FontSize="21"
                      FontWeight="SemiBold"
                      Padding="16,13"
                      TextAlignment="Center"
                      IsEnabled="{Binding IsIdle}" />
          <ui:Button Content="Ticket holen"
                     Command="{Binding RunCommand}"
                     Appearance="Primary"
                     Height="48"
                     Margin="0,16,0,0"
                     FontSize="14"
                     HorizontalContentAlignment="Center" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Margin="0,15,0,0">
            <ui:ProgressRing Width="16"
                             Height="16"
                             Margin="0,0,8,0"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding Status}"
                       Style="{StaticResource MutedTextStyle}"
                       FontSize="11.5"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="480" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="2"
              Style="{StaticResource SurfaceCardStyle}"
              Padding="24"
              Margin="0,0,0,14"
              Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <Grid Margin="0,0,0,16">
            <TextBlock Text="Ticket erstellt"
                       Style="{StaticResource CardTitleStyle}"
                       FontSize="15" />
            <Border HorizontalAlignment="Right"
                    Style="{StaticResource AccentPillStyle}">
              <TextBlock Text="ERFOLG"
                         Style="{StaticResource AccentPillTextStyle}" />
            </Border>
          </Grid>
          <TextBlock Text="STEAM ID" Style="{StaticResource FieldLabelStyle}" />
          <TextBlock Text="{Binding SteamIdDisplay}"
                     FontFamily="Consolas"
                     FontSize="13"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Margin="0,2,0,14" />
          <TextBlock Text="ENCRYPTED APP TICKET" Style="{StaticResource FieldLabelStyle}" />
          <Border Background="{DynamicResource SurfaceSubtleBrush}"
                  CornerRadius="9"
                  Padding="11,9">
            <TextBox Text="{Binding TicketShort, Mode=OneWay}"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     BorderThickness="0"
                     Background="Transparent"
                     FontFamily="Consolas"
                     FontSize="11.5"
                     TextWrapping="Wrap"
                     MaxHeight="110"
                     VerticalScrollBarVisibility="Auto"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>
          <TextBlock Text="{Binding ConfigInfo}"
                     Style="{StaticResource MutedTextStyle}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Margin="0,12,0,0" />
          <ui:Button Content="Ergebnis verbergen"
                     Command="{Binding ClearResultCommand}"
                     Appearance="Secondary"
                     HorizontalAlignment="Right"
                     Margin="0,14,0,0" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="3">
        <Border Background="{DynamicResource WarningSoftBrush}"
                BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,12"
                Margin="0,0,0,12"
                Visibility="{Binding HasDownloadError, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="Generator nicht verfügbar"
                       Style="{StaticResource CardTitleStyle}"
                       FontSize="12.5" />
            <TextBlock Text="{Binding DownloadMessage}"
                       Style="{StaticResource MutedTextStyle}"
                       FontSize="11"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap" />
            <ui:Button Content="Generator auswählen"
                       Command="{Binding BrowseToolCommand}"
                       Appearance="Secondary"
                       HorizontalAlignment="Left"
                       Margin="0,10,0,0" />
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,12"
                Visibility="{Binding HasToolOutput, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="Generator-Ausgabe"
                       Style="{StaticResource CardTitleStyle}"
                       FontSize="12.5" />
            <TextBox Text="{Binding ToolOutput, Mode=OneWay}"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     BorderThickness="0"
                     Background="Transparent"
                     FontFamily="Consolas"
                     FontSize="10.5"
                     TextWrapping="Wrap"
                     MaxHeight="180"
                     VerticalScrollBarVisibility="Auto"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
