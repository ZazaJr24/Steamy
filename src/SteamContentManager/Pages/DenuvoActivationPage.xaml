<Page x:Class="SteamContentManager.Pages.DenuvoActivationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis" />
  </Page.Resources>

  <Grid Margin="28,20,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- HEADER -->
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="Denuvo Activation" Style="{StaticResource PageTitleStyle}" Margin="0" />
      <TextBlock Text="Search any Steam game or enter an AppID, configure options, and generate a ready-to-use package."
                 Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" />
    </StackPanel>

    <!-- MAIN SCROLL AREA -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
      <StackPanel MaxWidth="660" HorizontalAlignment="Center">

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SEARCH CARD                                        -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Style="{StaticResource SurfaceCardStyle}" CornerRadius="16" Padding="24,22">
          <StackPanel>

            <!-- Label row: icon + title + search spinner -->
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="30" Height="30" CornerRadius="15"
                      Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                <TextBlock Text="S" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="GAME / APPID" Style="{StaticResource FieldLabelStyle}" Margin="0" />
                <TextBlock Text="Hubcap API or Steam Store search" FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0" />
              </StackPanel>
              <ui:ProgressRing Grid.Column="2" Width="20" Height="20" IsIndeterminate="True"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolVis}}" />
            </Grid>

            <!-- Search input -->
            <ui:TextBox x:Name="SearchBox"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="e.g. 2358720 or Euro Truck Simulator 2"
                        FontSize="15" Padding="14,11"
                        KeyDown="SearchBox_KeyDown">
              <ui:TextBox.Style>
                <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
                  <Setter Property="IsEnabled" Value="True" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                      <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:TextBox.Style>
            </ui:TextBox>

            <!-- Suggestions dropdown (floating look) -->
            <Border Margin="0,6,0,0" Padding="6" CornerRadius="12"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1"
                    Visibility="{Binding Suggestions.Count, Converter={StaticResource CountVis}}">
              <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="16" ShadowDepth="4" Direction="270" />
              </Border.Effect>
              <ItemsControl ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="SugRow" Padding="14,11" Margin="2,1"
                            CornerRadius="10" Background="Transparent"
                            Cursor="Hand" MouseLeftButtonDown="Suggestion_MouseDown">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7"
                                Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center"
                                MinWidth="68">
                          <TextBlock Text="{Binding AppId}" FontFamily="Consolas" FontSize="12"
                                     Foreground="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="SugRow" Property="IsMouseOver" Value="True">
                        <Setter TargetName="SugRow" Property="Background"
                                Value="{DynamicResource ControlHoverBrush}" />
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <!-- Resolved game info bar -->
            <Border Margin="0,10,0,0" Padding="14,10" CornerRadius="10"
                    Background="{DynamicResource AccentSoftBrush}"
                    Visibility="{Binding ResolvedName, Converter={StaticResource StringVis}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#x2714;" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding ResolvedName, Mode=OneWay}" />
                </TextBlock>
              </Grid>
            </Border>

          </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- OPTIONS CARD                                       -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Style="{StaticResource SurfaceCardStyle}" CornerRadius="16" Padding="24,18"
                Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Text="PACKAGE OPTIONS" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,12" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- Proxy DLL -->
              <StackPanel>
                <TextBlock Text="Proxy DLL" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding ProxyDllOptions}"
                          SelectedItem="{Binding ProxyDllName}"
                          Width="150" Height="34" FontSize="12" />
              </StackPanel>

              <!-- Capcom -->
              <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                <CheckBox IsChecked="{Binding IsCapcomGame}" Margin="0,0,0,4">
                  <TextBlock Text="Capcom / REFramework" FontSize="12"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                </CheckBox>
              </StackPanel>

              <!-- Custom archive -->
              <StackPanel Grid.Column="4" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <TextBlock Text="{Binding CustomZipName}" FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,4" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" MaxWidth="160"
                           Visibility="{Binding CustomZipName, Converter={StaticResource StringVis}}" />
                <ui:Button Content="Add archive..." Command="{Binding BrowseZipCommand}"
                           Appearance="Secondary" Height="34" FontSize="11"
                           ToolTip="Include a custom .zip / .7z / .rar in the package" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- GENERATE CARD                                      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Style="{StaticResource SurfaceCardStyle}" CornerRadius="16" Padding="24,20"
                Margin="0,10,0,0">
          <StackPanel>
            <ui:Button Content="Generate Package" Command="{Binding GenerateCommand}"
                       Appearance="Primary"
                       Height="50" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center" />

            <!-- Progress area -->
            <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="10"
                    Background="{DynamicResource SurfaceSubtleBrush}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" />
                <TextBlock Text="{Binding Status}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- BOTTOM STATUS BAR                                  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" CornerRadius="12"
            Padding="16,10" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,10,0"
                VerticalAlignment="Center">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasDownloadError}" Value="True">
                  <Setter Property="Background" Value="#EF4444" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>

        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Status}" />

        <ui:Button Grid.Column="2" Content="Browse generator..."
                   Command="{Binding BrowseToolCommand}"
                   Appearance="Secondary" Height="30" FontSize="11"
                   Visibility="{Binding HasDownloadError, Converter={StaticResource BoolVis}}" />
      </Grid>
    </Border>
  </Grid>
</Page>
