<Page x:Class="SteamContentManager.Pages.DenuvoActivationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Page.Resources>

  <ScrollViewer Style="{StaticResource PageScrollHostStyle}"
                HorizontalScrollBarVisibility="Disabled"
                Padding="28,24,28,40">
    <StackPanel MaxWidth="700" HorizontalAlignment="Stretch">

      <!-- Header — left-aligned with icon -->
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="46" Height="46" CornerRadius="14"
                Background="{DynamicResource AccentSoftBrush}"
                VerticalAlignment="Center"
                Margin="0,0,14,0">
          <TextBlock Text="⚡"
                     FontSize="22"
                     Foreground="{DynamicResource AccentBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Denuvo Activation"
                     Style="{StaticResource PageTitleStyle}" />
          <TextBlock Text="AppID eingeben, Ticket abrufen, Config schreiben."
                     Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>
      </Grid>

      <!-- Step indicator -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="16,12"
              Margin="0,0,0,16">
        <Grid HorizontalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Step 1 -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="24" Height="24" CornerRadius="12"
                    Background="{DynamicResource AccentBrush}">
              <TextBlock Text="1" FontSize="12" FontWeight="Bold"
                         Foreground="White"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="AppID eingeben"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
          </StackPanel>

          <!-- Arrow -->
          <TextBlock Grid.Column="1" Text="→"
                     FontSize="14"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     VerticalAlignment="Center"
                     Margin="16,0" />

          <!-- Step 2 -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="24" Height="24" CornerRadius="12"
                    Background="{DynamicResource AccentSoftBrush}">
              <TextBlock Text="2" FontSize="12" FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Ticket holen"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
          </StackPanel>

          <!-- Arrow -->
          <TextBlock Grid.Column="3" Text="→"
                     FontSize="14"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     VerticalAlignment="Center"
                     Margin="16,0" />

          <!-- Step 3 -->
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="24" Height="24" CornerRadius="12"
                    Background="{DynamicResource AccentSoftBrush}">
              <TextBlock Text="3" FontSize="12" FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Config geschrieben"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- AppID input card -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="24,22"
              Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="STEAM APPID"
                     Style="{StaticResource FieldLabelStyle}"
                     Margin="0,0,0,10" />
          <ui:TextBox Text="{Binding ManualAppId, UpdateSourceTrigger=PropertyChanged}"
                      PlaceholderText="z. B. 2358720"
                      FontFamily="Consolas"
                      FontSize="24"
                      FontWeight="SemiBold"
                      Padding="18,15"
                      HorizontalAlignment="Stretch"
                      TextAlignment="Center"
                      IsEnabled="{Binding IsIdle}" />
          <ui:Button Content="Ticket holen"
                     Command="{Binding RunCommand}"
                     Appearance="Primary"
                     Height="48"
                     Margin="0,18,0,0"
                     FontSize="14"
                     HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Status bar -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="14,11"
              Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="28" Height="28" CornerRadius="14"
                  Background="{DynamicResource AccentSoftBrush}"
                  VerticalAlignment="Center">
            <ui:ProgressRing Width="14"
                             Height="14"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </Border>
          <TextBlock Grid.Column="1"
                     Text="{Binding Status}"
                     Style="{StaticResource MutedTextStyle}"
                     FontSize="12"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Margin="10,0,0,0" />
        </Grid>
      </Border>

      <!-- Result card (success) -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource SuccessBrush}"
              BorderThickness="1.5"
              CornerRadius="14"
              Padding="24"
              Margin="0,0,0,14"
              Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <!-- Result header -->
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="18"
                    Background="{DynamicResource AccentSoftBrush}"
                    VerticalAlignment="Center">
              <TextBlock Text="✓" FontSize="18" FontWeight="Bold"
                         Foreground="{DynamicResource SuccessBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1"
                       Text="Ticket erstellt"
                       Style="{StaticResource CardTitleStyle}"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
            <Border Grid.Column="2"
                    HorizontalAlignment="Right"
                    Style="{StaticResource AccentPillStyle}">
              <TextBlock Text="ERFOLG"
                         Style="{StaticResource AccentPillTextStyle}" />
            </Border>
          </Grid>

          <!-- Steam ID -->
          <TextBlock Text="STEAM ID" Style="{StaticResource FieldLabelStyle}" />
          <TextBlock Text="{Binding SteamIdDisplay}"
                     FontFamily="Consolas"
                     FontSize="13.5"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Margin="0,3,0,16" />

          <!-- Encrypted App Ticket -->
          <TextBlock Text="ENCRYPTED APP TICKET" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
          <Border Background="{DynamicResource SurfaceSubtleBrush}"
                  CornerRadius="10"
                  Padding="12,10">
            <TextBox Text="{Binding TicketShort, Mode=OneWay}"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     BorderThickness="0"
                     Background="Transparent"
                     FontFamily="Consolas"
                     FontSize="11.5"
                     TextWrapping="Wrap"
                     MaxHeight="110"
                     VerticalScrollBarVisibility="Auto"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>

          <!-- Config info and action -->
          <TextBlock Text="{Binding ConfigInfo}"
                     Style="{StaticResource MutedTextStyle}"
                     FontSize="11.5"
                     TextWrapping="Wrap"
                     Margin="0,14,0,0" />
          <ui:Button Content="Ergebnis verbergen"
                     Command="{Binding ClearResultCommand}"
                     Appearance="Secondary"
                     HorizontalAlignment="Right"
                     Margin="0,16,0,0" />
        </StackPanel>
      </Border>

      <!-- Download error warning -->
      <Border Background="{DynamicResource WarningSoftBrush}"
              BorderBrush="{DynamicResource WarningBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="16,14"
              Margin="0,0,0,14"
              Visibility="{Binding HasDownloadError, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="32" Height="32" CornerRadius="16"
                  Background="{DynamicResource WarningBrush}"
                  Opacity="0.15"
                  VerticalAlignment="Top" />
          <TextBlock Text="⚠" FontSize="16"
                     Foreground="{DynamicResource WarningBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Margin="8,6,0,0" />
          <StackPanel Grid.Column="1" Margin="14,0,0,0">
            <TextBlock Text="Generator nicht verfügbar"
                       Style="{StaticResource CardTitleStyle}"
                       FontSize="13" />
            <TextBlock Text="{Binding DownloadMessage}"
                       Style="{StaticResource MutedTextStyle}"
                       FontSize="11.5"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
            <ui:Button Content="Generator auswählen"
                       Command="{Binding BrowseToolCommand}"
                       Appearance="Secondary"
                       HorizontalAlignment="Left"
                       Margin="0,12,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Generator output -->
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="16,14"
              Visibility="{Binding HasToolOutput, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <TextBlock Text="Generator-Ausgabe"
                     Style="{StaticResource CardTitleStyle}"
                     FontSize="13" />
          <TextBox Text="{Binding ToolOutput, Mode=OneWay}"
                   IsReadOnly="True"
                   IsReadOnlyCaretVisible="False"
                   BorderThickness="0"
                   Background="Transparent"
                   FontFamily="Consolas"
                   FontSize="11"
                   TextWrapping="Wrap"
                   MaxHeight="180"
                   VerticalScrollBarVisibility="Auto"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,8,0,0" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
