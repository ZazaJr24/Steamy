<Page x:Class="SteamContentManager.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Page.Resources>
  <ScrollViewer Style="{StaticResource PageScrollHostStyle}" Padding="30,26,30,44">
    <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="ResonanceTools" Style="{StaticResource PageTitleStyle}" />
          <TextBlock Text="Library, downloads and tools at a glance." Style="{StaticResource PageSubtitleStyle}" Margin="0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource StatusPillStyle}" Margin="0,0,9,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
              <TextBlock Text="{Binding LibraryStatus}" Style="{StaticResource PillTextStyle}" />
            </StackPanel>
          </Border>
          <ui:Button Content="Refresh" Command="{Binding RefreshCommand}" Appearance="Secondary" />
        </StackPanel>
      </Grid>

      <!-- Search jumps straight into the games grid -->
      <Border Style="{StaticResource FilterBarStyle}" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ui:TextBox x:Name="DashboardSearch"
                      PlaceholderText="Search games by name or App ID and press Enter…"
                      Icon="{ui:SymbolIcon Search24}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      KeyDown="DashboardSearch_KeyDown" />
          <ui:Button Grid.Column="1" Content="Browse games" Icon="{ui:SymbolIcon Apps24}" Command="{Binding NavigateLibraryCommand}" Appearance="Primary" Margin="10,0,0,0" />
        </Grid>
      </Border>

      <Border CornerRadius="18" Background="{Binding FeaturedGame.CoverColor}" Margin="0,0,0,22" Height="260" ClipToBounds="True"
              BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <Grid>
          <Image Source="{Binding FeaturedGame.HeaderImage}" Stretch="UniformToFill" Opacity="0.55" />
          <Rectangle>
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#F010131B" Offset="0" />
                <GradientStop Color="#BF10131B" Offset="0.55" />
                <GradientStop Color="#3010131B" Offset="1" />
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <TextBlock Text="{Binding FeaturedGame.CoverGlyph}" FontSize="120" Foreground="#22FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,110,0" />
          <StackPanel VerticalAlignment="Bottom" Margin="26,22,26,24">
            <TextBlock Text="CONTINUE PLAYING" Style="{StaticResource PillTextStyle}" Foreground="#C9C3FF" />
            <TextBlock Text="{Binding FeaturedGame.Name}" FontSize="30" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,0" />
            <TextBlock Text="{Binding FeaturedSummary}" Foreground="#D6D9E4" FontSize="13" Margin="0,5,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <ui:Button Content="Open Games" Command="{Binding NavigateLibraryCommand}" Margin="0,0,8,0" />
              <ui:Button Content="Open Downloads" Command="{Binding NavigateDownloadsCommand}" Appearance="Secondary" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Margin="-6,0,-6,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource SurfaceCardStyle}" Margin="6,0,6,10" Grid.Row="0" Grid.Column="0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,14,0">
              <Border.Background><SolidColorBrush Color="#6C63FF" Opacity="0.15"/></Border.Background>
              <TextBlock Text="&#x25C8;" FontSize="20" Foreground="#6C63FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="LIBRARY" Style="{StaticResource PillTextStyle}"/>
              <TextBlock Text="{Binding LibraryCount}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,2"/>
              <TextBlock Text="indexed games" Style="{StaticResource MutedTextStyle}" FontSize="12"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Style="{StaticResource SurfaceCardStyle}" Margin="6,0,6,10" Grid.Row="0" Grid.Column="1">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,14,0">
              <Border.Background><SolidColorBrush Color="#4A9EFF" Opacity="0.15"/></Border.Background>
              <TextBlock Text="&#x2193;" FontSize="22" FontWeight="Bold" Foreground="#4A9EFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="ACTIVE DOWNLOADS" Style="{StaticResource PillTextStyle}"/>
              <TextBlock Text="{Binding ActiveDownloads}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,2"/>
              <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource MutedTextStyle}" FontSize="12"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Style="{StaticResource SurfaceCardStyle}" Margin="6,0,6,0" Grid.Row="1" Grid.Column="0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,14,0">
              <Border.Background><SolidColorBrush Color="#4ADE80" Opacity="0.15"/></Border.Background>
              <TextBlock Text="&#x26A1;" FontSize="20" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="CURRENT SPEED" Style="{StaticResource PillTextStyle}"/>
              <TextBlock Text="{Binding CurrentSpeed}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,2"/>
              <TextBlock Text="download throughput" Style="{StaticResource MutedTextStyle}" FontSize="12"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Style="{StaticResource SurfaceCardStyle}" Margin="6,0,6,0" Grid.Row="1" Grid.Column="1">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,14,0">
              <Border.Background><SolidColorBrush Color="#F59E0B" Opacity="0.15"/></Border.Background>
              <TextBlock Text="&#x2B24;" FontSize="18" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="DISK SPACE" Style="{StaticResource PillTextStyle}"/>
              <TextBlock Text="{Binding DiskSpace}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,2" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="available locally" Style="{StaticResource MutedTextStyle}" FontSize="12"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,11,0">
          <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Recent games" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/><ui:Button Grid.Column="1" Content="View all" Command="{Binding NavigateLibraryCommand}" Appearance="Secondary" /></Grid>
          <ItemsControl ItemsSource="{Binding RecentGames}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CoverCardStyle}" Width="215" Margin="0,4,12,12" Padding="0">
                  <Grid Height="194" ClipToBounds="True">
                    <Border Background="{Binding CoverColor}" />
                    <Image Source="{Binding ArtworkImage}" Stretch="UniformToFill" />
                    <Rectangle Fill="{StaticResource CoverFadeBrush}" />
                    <TextBlock Text="{Binding CoverGlyph}" FontSize="62" Foreground="#35FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsArtworkFallback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel VerticalAlignment="Bottom" Margin="13,13,13,13">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleStyle}" TextTrimming="CharacterEllipsis" Foreground="White" />
                      <TextBlock Text="{Binding Size}" Foreground="#C7CBD8" FontSize="11" Margin="0,3,0,0" />
                      <TextBlock Text="{Binding LastPlayed}" Foreground="#C7CBD8" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="11,0,0,0">
          <TextBlock Text="Workspace" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" Height="34" Padding="0,8,0,0" />
          <Border Style="{StaticResource SurfaceCardStyle}" Padding="17">
            <StackPanel>
              <TextBlock Text="Provider health" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,6" />
              <TextBlock Text="{Binding ProviderHealthSummary}" Style="{StaticResource TertiaryTextStyle}" FontSize="11.5" Margin="0,0,0,13" />
              <ItemsControl ItemsSource="{Binding Providers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Style="{StaticResource MutedTextStyle}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding StateLabel}" Style="{StaticResource TertiaryTextStyle}" FontSize="12"/></Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SurfaceCardStyle}" Padding="17" Margin="0,11,0,0">
            <StackPanel>
              <TextBlock Text="DepotDownloader" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="{Binding DepotDownloaderStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,6,0,0" />
              <TextBlock Text="{Binding DepotDownloaderDetail}" Style="{StaticResource MutedTextStyle}" FontSize="11.5" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SurfaceCardStyle}" Padding="17" Margin="0,11,0,0">
            <StackPanel>
              <TextBlock Text="Local library" Style="{StaticResource CardTitleStyle}" />
              <TextBlock Text="{Binding LibraryMessage}" Style="{StaticResource MutedTextStyle}" FontSize="11.5" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <TextBlock Text="Quick actions" Style="{StaticResource SectionTitleStyle}" />
          <WrapPanel>
            <ui:Button Content="Steamless" Command="{Binding NavigateSteamlessCommand}" Margin="0,0,8,8" />
            <ui:Button Content="Denuvo Activation" Command="{Binding NavigateDenuvoActivationCommand}" Appearance="Secondary" Margin="0,0,8,8" />
            <ui:Button Content="DLC Unlocker" Command="{Binding NavigateDlcUnlockerCommand}" Appearance="Secondary" Margin="0,0,8,8" />
            <ui:Button Content="Goldberg" Command="{Binding NavigateGoldbergCommand}" Appearance="Secondary" Margin="0,0,8,8" />
            <ui:Button Content="Online Fixes" Command="{Binding NavigateOnlineFixesCommand}" Appearance="Secondary" Margin="0,0,8,8" />
            <ui:Button Content="Game Fixes" Command="{Binding NavigateFixesCommand}" Appearance="Secondary" Margin="0,0,8,8" />
            <ui:Button Content="Downloads" Command="{Binding NavigateDownloadsCommand}" Appearance="Secondary" Margin="0,0,8,8" />
            <ui:Button Content="Settings" Command="{Binding NavigateSettingsCommand}" Appearance="Secondary" Margin="0,0,8,8" />
          </WrapPanel>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Page>
