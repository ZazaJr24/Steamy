<Page x:Class="SteamContentManager.Pages.BranchesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
  <Grid Margin="30,26,30,30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Branches" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="Branch information available through configured, authorized providers." Style="{StaticResource PageSubtitleStyle}" Margin="0" />
      </StackPanel>
      <ui:Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,14">
      <WrapPanel>
        <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock Text="No branch source is configured" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" />
        <TextBlock Text="  ·  Branch data is listed once a provider is set up; nothing is fetched automatically" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
        <TextBlock Text="  ·  Last check: " Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" />
        <TextBlock Text="{Binding LastRefresh}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
      </WrapPanel>
    </Border>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
      <DataGrid ItemsSource="{Binding Branches}" IsReadOnly="True" CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Branch" Binding="{Binding Name}" Width="2*"/>
          <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140"/>
          <DataGridTextColumn Header="Build" Binding="{Binding Build}" Width="115"/>
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
          <DataGridTextColumn Header="Last checked" Binding="{Binding LastChecked}" Width="140"/>
          <DataGridTextColumn Header="Request" Binding="{Binding RequestStatus}" Width="140"/>
          <DataGridTemplateColumn Header="Action" Width="130">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ui:Button Content="Request info" Command="{Binding DataContext.RequestCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Appearance="Secondary" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</Page>
