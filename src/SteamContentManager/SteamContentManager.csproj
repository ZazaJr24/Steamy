<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>SteamContentManager</RootNamespace>
    <AssemblyName>ResonanceTools</AssemblyName>
    <Version>0.0.2</Version>
    <FileVersion>0.0.2</FileVersion>
    <AssemblyVersion>0.0.2</AssemblyVersion>
    <ApplicationIcon />
    <Platforms>AnyCPU</Platforms>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="SharpCompress" Version="0.39.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
  </ItemGroup>

  <!-- Images used from XAML go in as WPF resources so they can be referenced by pack URI. -->
  <ItemGroup>
    <Resource Include="Resources\steamless.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\LICENSE-CloudRedirect.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\appid.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Data\appid.json')" />
  </ItemGroup>

  <!--
    Steamless ships inside the application: the user never has to download a tool. Only the
    command line build and the unpacker plugins are bundled — Steamless.CLI.exe needs the
    "Plugins" folder next to it, otherwise it cannot unpack anything. The files are shipped
    unmodified and keep their own license (see NOTICE.md in the same folder).
  -->
  <ItemGroup>
    <None Include="Tools\Steamless\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- CreamAPI replacement DLLs bundled for the DLC Unlocker (CreamAPI mode). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\CreamAPI\steam_api.dll" LogicalName="CreamAPI.steam_api.dll" />
    <EmbeddedResource Include="Resources\CreamAPI\steam_api64.dll" LogicalName="CreamAPI.steam_api64.dll" />
  </ItemGroup>
</Project>
