<ui:FluentWindow x:Class="SteamContentManager.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:SteamContentManager.Pages"
                 Title="ResonanceTools"
                 Height="900"
                 Width="1440"
                 MinHeight="620"
                 MinWidth="980"
                 WindowState="Maximized"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource AppBackgroundBrush}">
  <Grid Background="{DynamicResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0"
                 Title="ResonanceTools"
                 Height="34"
                 Background="{DynamicResource AppBackgroundBrush}"
                 Foreground="{DynamicResource TextSecondaryBrush}" />

    <Grid Grid.Row="1">
      <ui:NavigationView x:Name="RootNavigation"
                        PaneDisplayMode="Left"
                        OpenPaneLength="184"
                        CompactPaneLength="52"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleVisible="True"
                        IsFooterSeparatorVisible="True"
                        PaneTitle="RT"
                        Transition="None"
                        IsPaneOpen="True"
                        Background="{DynamicResource SidebarBackgroundBrush}">
        <ui:NavigationView.Header>
          <Border Height="0" Visibility="Collapsed" />
        </ui:NavigationView.Header>
        <ui:NavigationView.PaneHeader>
          <Border Margin="14,12,14,14"
                  Padding="10,9"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                  BorderThickness="1"
                  CornerRadius="12">
            <StackPanel Orientation="Horizontal">
              <Border Width="30" Height="30" CornerRadius="9"
                      Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="R" Foreground="{DynamicResource AccentBrush}"
                           FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Resonance" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock Text="Tools" Foreground="{DynamicResource TextTertiaryBrush}"
                           FontSize="10.5" Margin="0,1,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
        </ui:NavigationView.PaneHeader>

        <ui:NavigationView.MenuItems>
          <ui:NavigationViewItem Content="Dashboard"
                                 Icon="{ui:SymbolIcon Home24}"
                                 TargetPageType="{x:Type pages:DashboardPage}" />
          <ui:NavigationViewItem Content="Games"
                                 Icon="{ui:SymbolIcon Apps24}"
                                 TargetPageType="{x:Type pages:LibraryPage}" />

          <ui:NavigationViewItemSeparator />

          <ui:NavigationViewItem Content="Tools" Icon="{ui:SymbolIcon Wrench24}">
            <ui:NavigationViewItem.MenuItems>
              <ui:NavigationViewItem Content="Steamless"
                                     Icon="{ui:ImageIcon '/ResonanceTools;component/Resources/steamless.png'}"
                                     TargetPageType="{x:Type pages:SteamlessPage}" />
              <ui:NavigationViewItem Content="Denuvo Activation"
                                     Icon="{ui:SymbolIcon Key24}"
                                     TargetPageType="{x:Type pages:DenuvoActivationPage}" />
              <ui:NavigationViewItem Content="DLC Unlocker"
                                     Icon="{ui:SymbolIcon LockOpen24}"
                                     TargetPageType="{x:Type pages:CreamApiPage}" />
              <ui:NavigationViewItem Content="Goldberg"
                                     Icon="{ui:SymbolIcon Desktop24}"
                                     TargetPageType="{x:Type pages:GoldbergPage}" />
              <ui:NavigationViewItem Content="SteamAutoCrack"
                                     Icon="{ui:SymbolIcon Flash24}"
                                     TargetPageType="{x:Type pages:SteamAutoCrackerToolPage}" />
              <ui:NavigationViewItem Content="ColdLoader"
                                     Icon="{ui:SymbolIcon Play24}"
                                     TargetPageType="{x:Type pages:ColddloaderPage}" />
            </ui:NavigationViewItem.MenuItems>
          </ui:NavigationViewItem>

          <ui:NavigationViewItem Content="Fixes" Icon="{ui:SymbolIcon Shield24}">
            <ui:NavigationViewItem.MenuItems>
              <ui:NavigationViewItem Content="Online Fixes"
                                     Icon="{ui:SymbolIcon Cloud24}"
                                     TargetPageType="{x:Type pages:OnlineFixesPage}" />
              <ui:NavigationViewItem Content="Game Fixes"
                                     Icon="{ui:SymbolIcon ShieldTask24}"
                                     TargetPageType="{x:Type pages:GameFixesPage}" />
            </ui:NavigationViewItem.MenuItems>
          </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>

        <ui:NavigationView.FooterMenuItems>
          <ui:NavigationViewItem Content="Downloads"
                                 Icon="{ui:SymbolIcon ArrowDownload24}"
                                 TargetPageType="{x:Type pages:DownloadsPage}" />
          <ui:NavigationViewItem Content="Settings"
                                 Icon="{ui:SymbolIcon Settings24}"
                                 TargetPageType="{x:Type pages:SettingsPage}" />
        </ui:NavigationView.FooterMenuItems>
      </ui:NavigationView>
    </Grid>
  </Grid>
</ui:FluentWindow>
