<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the platform-independent parts of Steamy (sharing, VDF parsing). The sources are
       linked instead of referencing the WPF project, so the tests also run on Linux and macOS. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Steamy\Services\Catalog\SpotlightCatalog.cs" Link="Linked\SpotlightCatalog.cs" />
    <Compile Include="..\..\src\Steamy\Services\Catalog\GitHubManifestIndex.cs" Link="Linked\GitHubManifestIndex.cs" />
    <Compile Include="..\..\src\Steamy\Services\Steam\ManifestArchiveReader.cs" Link="Linked\ManifestArchiveReader.cs" />
    <Compile Include="..\..\src\Steamy\Models\DownloadJobState.cs" Link="Linked\DownloadJobState.cs" />
    <Compile Include="..\..\src\Steamy\Services\Download\DownloadPresentation.cs" Link="Linked\DownloadPresentation.cs" />
    <Compile Include="..\..\src\Steamy\Services\Download\DownloadJobPolicy.cs" Link="Linked\DownloadJobPolicy.cs" />
    <Compile Include="..\..\src\Steamy\Services\Download\LocalDownloadInspector.cs" Link="Linked\LocalDownloadInspector.cs" />
    <Compile Include="..\..\src\Steamy\Services\Download\DepotResumeState.cs" Link="Linked\DepotResumeState.cs" />
    <Compile Include="..\..\src\Steamy\Services\Download\DownloadOperationRegistry.cs" Link="Linked\DownloadOperationRegistry.cs" />
    <Compile Include="..\..\src\Steamy\Services\Steam\VdfParser.cs" Link="Linked\VdfParser.cs" />
    <Compile Include="..\..\src\Steamy\Services\Sharing\ShareModels.cs" Link="Linked\ShareModels.cs" />
    <Compile Include="..\..\src\Steamy\Services\Sharing\ManifestLibraryScanner.cs" Link="Linked\ManifestLibraryScanner.cs" />
    <Compile Include="..\..\src\Steamy\Services\Sharing\AppListIndex.cs" Link="Linked\AppListIndex.cs" />
    <Compile Include="..\..\src\Steamy\Services\Sharing\ShareArchiveBuilder.cs" Link="Linked\ShareArchiveBuilder.cs" />
    <Compile Include="..\..\src\Steamy\Services\Sharing\GitHubBatchUploader.cs" Link="Linked\GitHubBatchUploader.cs" />
    <Compile Include="..\..\src\Steamy\Services\Sharing\ShareHistoryStore.cs" Link="Linked\ShareHistoryStore.cs" />
    <Compile Include="..\..\src\Steamy\Services\Sharing\OwnedGames.cs" Link="Linked\OwnedGames.cs" />
    <Compile Include="..\..\src\Steamy\Services\Steam\SteamIdLookup.cs" Link="Linked\SteamIdLookup.cs" />
    <Compile Include="..\..\src\Steamy\Services\Storage\ArchiveExtractor.cs" Link="Linked\ArchiveExtractor.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
